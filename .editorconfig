root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,runsettings}]
indent_size = 2

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
indent_size = 4
