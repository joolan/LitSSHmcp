<UserControl x:Class="LitSSHmcp.App.Controls.DatasourceAiDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="AiSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeMicro}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AiSuggestionButton" TargetType="ui:Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 / 模型 / 历史 / 新对话 -->
        <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AppAccentSubtleBrush}">
                        <ui:SymbolIcon Symbol="Chat24" FontSize="16" Foreground="{DynamicResource AppAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="数据源 AI" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="只读分析当前数据库，不跨数据源" FontSize="10"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Content="新对话" Padding="8,2"
                                   Command="{Binding NewConversationCommand}"
                                   ToolTip="开始新的数据源 AI 对话"/>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Padding="4,2" Margin="4,0,0,0"
                                   ToolTip="收起 AI 助手" Click="OnClose"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Height="30" MinWidth="110" FontSize="11" Padding="6,0"
                              ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name" VerticalContentAlignment="Center"
                              MaxDropDownHeight="220" ToolTip="{Binding SelectedProvider.DisplayName}"/>
                    <ComboBox Grid.Column="2" Height="30" MinWidth="110" FontSize="11" Padding="6,0"
                              ItemsSource="{Binding HistorySessions}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                              MaxDropDownHeight="260" ToolTip="历史对话">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Subtitle}">
                                    <TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Settings24}" Padding="4,1" Margin="6,0,0,0"
                               Command="{Binding ManageSessionsCommand}"
                               ToolTip="管理历史会话：重命名、删除、打开"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 作用域条 -->
        <Border Grid.Row="1" Padding="12,7" Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource AppSuccessSubtleBrush}"
                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReadOnlyText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSuccessBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding ScopeText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                </DockPanel>
                <DockPanel Margin="0,3,0,0">
                    <TextBlock Text="{Binding SchemaSummary}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="8,1" Margin="8,0,0,0"
                               Command="{Binding RefreshContextCommand}" ToolTip="重新读取当前库/表结构"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 上下文 -->
        <Expander Grid.Row="2" Header="上下文（当前库 / 选中表 / 编辑器 SQL）"
                  IsExpanded="{Binding IsContextExpanded, Mode=TwoWay}" Margin="8,8,8,0"
                  Visibility="{Binding HasTurns, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding ContextText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="84" MaxHeight="180" Margin="4,6,4,0"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource AppFontMonoFamily}"
                     FontSize="{DynamicResource AppFontSizeMicro}" Padding="7"
                     Background="{DynamicResource AppCodeBgBrush}" BorderThickness="0"/>
        </Expander>

        <!-- 对话区 -->
        <Grid Grid.Row="3" Margin="8,8,8,0">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Turns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UserTime}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}"/>
                                    </DockPanel>

                                    <Border Background="{DynamicResource AppAccentSubtleBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                            Padding="8,5" Margin="0,6,0,0"
                                            Visibility="{Binding ResultMetaVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Database24" FontSize="12"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ResultMeta}" Margin="6,0,0,0"
                                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="{Binding StepsHeader}" IsExpanded="{Binding IsStepsExpanded, Mode=TwoWay}"
                                              Visibility="{Binding StepsVisibility}" Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                                            CornerRadius="{DynamicResource AppRadiusS}" Padding="7,5"
                                                            Margin="0,0,0,4">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Tool}" FontWeight="SemiBold"
                                                                           FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                                <TextBlock Text="{Binding Summary}" DockPanel.Dock="Right"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding CommandText}" TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ArgsJson}"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                       FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                            <Border Background="{DynamicResource AppAccentSubtleBrush}"
                                                                    CornerRadius="{DynamicResource AppRadiusS}" Padding="7,4"
                                                                    Margin="0,4,0,0"
                                                                    Visibility="{Binding ResultMetaVisibility}">
                                                                <TextBlock Text="{Binding ResultMeta}"
                                                                           FontSize="{DynamicResource AppFontSizeMicro}"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            </Border>
                                                            <Expander Header="工具输出" Visibility="{Binding ResultVisibility}"
                                                                      Margin="0,3,0,0">
                                                                <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True"
                                                                         TextWrapping="Wrap" MaxHeight="150"
                                                                         VerticalScrollBarVisibility="Auto"
                                                                         FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                         FontSize="{DynamicResource AppFontSizeMicro}"
                                                                         Background="{DynamicResource AppCodeBgBrush}"
                                                                         BorderThickness="0" Padding="6"/>
                                                            </Expander>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <local:MarkdownBox Margin="0,8,0,0"
                                                       Markdown="{Binding AssistantText, Mode=OneWay}"
                                                       IsStreaming="{Binding IsRunning}"
                                                       Visibility="{Binding AssistantVisibility}"
                                                       IsSelectionEnabled="True" IsTabStop="False"
                                                       VerticalScrollBarVisibility="Disabled"
                                                       HorizontalScrollBarVisibility="Disabled"
                                                       Background="Transparent" Padding="0" MinHeight="0"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppDangerBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding NoteVisibility}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Copy24}"
                                                   Padding="4,1" ToolTip="复制回答"
                                                   Visibility="{Binding AssistantVisibility}"
                                                   Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding AssistantText}"/>
                                        <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ProgressBar Height="2" IsIndeterminate="True" Margin="0,4,0,0"
                                                 Visibility="{Binding RunningVisibility}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" Padding="18,6">
                <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AppAccentSubtleBrush}"
                            HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Database24" FontSize="22"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="从当前数据库开始" FontWeight="SemiBold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="只读分析结构、生成 SQL、排查查询结果"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,14"/>
                    <ui:Button Style="{StaticResource AiSuggestionButton}" Content="解释当前 SQL"
                               Command="{Binding UseSuggestionCommand}"
                               CommandParameter="解释当前编辑器里的 SQL，指出潜在问题和优化点。"/>
                    <ui:Button Style="{StaticResource AiSuggestionButton}" Content="查看当前表结构"
                               Command="{Binding UseSuggestionCommand}"
                               CommandParameter="概括当前选中表的结构、主键和适合的查询方式。"/>
                    <ui:Button Style="{StaticResource AiSuggestionButton}" Content="排查一条查询"
                               Command="{Binding UseSuggestionCommand}"
                               CommandParameter="帮我排查一条查询；先问我 SQL 和期望结果，或分析当前编辑器 SQL。"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 输入区 -->
        <Border Grid.Row="4" Margin="8" Style="{DynamicResource CardBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Row="0" Grid.Column="0" x:Name="InputBox"
                            Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                            VerticalScrollBarVisibility="Auto" Padding="6" VerticalContentAlignment="Top"
                            PreviewKeyDown="OnInputKeyDown"
                            PlaceholderText="描述要分析的 SQL / 表 / 结果；Enter 发送，Shift+Enter 换行"/>
                <ui:Button Grid.Row="0" Grid.Column="1" Content="{Binding SendButtonText}"
                           Appearance="Primary" Width="58" Height="34" Padding="0" Margin="6,0,0,0"
                           Command="{Binding SendOrStopCommand}"/>
                <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <TextBlock Text="{Binding UsageText}" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource AppSurfaceAltBrush}" Padding="10,5"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="只读模式 · AI 生成的 SQL 每次都需要确认；结果摘要会自动回传当前会话"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
