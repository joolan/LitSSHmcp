<UserControl x:Class="LitSSHmcp.App.Controls.TerminalAiDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Chat24" FontSize="18"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="终端 AI 助手" FontWeight="SemiBold" FontSize="14"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" Height="30" Margin="8,0,6,0"
                              MinWidth="110" MaxWidth="220" Width="Auto"
                              HorizontalAlignment="Left"
                              FontSize="11" Padding="6,0"
                              ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Left"
                              MaxDropDownHeight="220"
                              ToolTip="{Binding SelectedProvider.DisplayName}"/>
                    <ui:Button Grid.Column="4" Content="新对话" Padding="8,2"
                               Command="{Binding NewConversationCommand}"
                               ToolTip="清空当前终端的 AI 对话历史（Ctrl+Shift+N）"/>
                </Grid>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding UsageText}" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding UsageText}"/>
                    <TextBlock Text="{Binding ScopeText}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AppDangerSubtleBrush}"
                BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="{Binding AutoApproveVisibility}">
            <TextBlock Text="{Binding AutoApproveText}" Foreground="{DynamicResource AppDangerBrush}"
                       TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"/>
        </Border>

        <Expander Grid.Row="2" Header="上下文（当前任务尾部，可编辑）"
                  IsExpanded="{Binding IsContextExpanded, Mode=TwoWay}" Margin="8,8,8,0">
            <StackPanel Margin="4,6,4,0">
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <CheckBox Content="发送时附带终端上下文" IsChecked="{Binding IncludeContext}"
                              VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="附加选中" Padding="8,2" Margin="0,0,6,0"
                                   Command="{Binding AttachSelectionCommand}"
                                   ToolTip="把左侧终端当前选中的文本附加到上下文（Ctrl+Shift+L）"/>
                        <ui:Button Content="刷新" Padding="10,2"
                                   Command="{Binding RefreshContextCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding ContextText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="130"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource AppFontMonoFamily}"
                         FontSize="{DynamicResource AppFontSizeMicro}" Padding="6"/>
            </StackPanel>
        </Expander>

        <ScrollViewer x:Name="ChatScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Margin="8,8,8,0">
            <ItemsControl ItemsSource="{Binding Turns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding UserTime}" DockPanel.Dock="Right" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                                </DockPanel>
                                <Border Background="{DynamicResource AppDangerSubtleBrush}"
                                        BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource AppRadiusS}" Padding="8,6"
                                        Margin="0,8,0,0" Visibility="{Binding ManualCommandVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="该提权命令未自动执行。填入终端后按 Enter，并输入 sudo 密码。"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}"/>
                                        <DockPanel Margin="0,5,0,0">
                                            <ui:Button DockPanel.Dock="Right" Content="填入终端" Padding="8,2"
                                                       Command="{Binding DataContext.FillTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding ManualCommand}"/>
                                            <TextBlock Text="{Binding ManualCommand}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       FontFamily="{DynamicResource AppFontMonoFamily}"
                                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Expander Header="{Binding StepsHeader}" IsExpanded="{Binding IsStepsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding StepsVisibility}" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                                        CornerRadius="{DynamicResource AppRadiusS}" Padding="7,5"
                                                        Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Tool}" FontWeight="SemiBold"
                                                                       FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                            <TextBlock Text="{Binding Summary}" DockPanel.Dock="Right"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding CommandText}" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ArgsJson}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                   FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                        <Expander Header="输出" Visibility="{Binding ResultVisibility}"
                                                                  Margin="0,3,0,0">
                                                            <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True"
                                                                     TextWrapping="Wrap" MaxHeight="140"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     FontFamily="{DynamicResource AppFontMonoFamily}"
                                                                     FontSize="{DynamicResource AppFontSizeMicro}"
                                                                     Background="{DynamicResource AppCodeBgBrush}"
                                                                     BorderThickness="0" Padding="6"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <local:MarkdownBox Margin="0,8,0,0"
                                                   Markdown="{Binding AssistantText, Mode=OneWay}"
                                                   IsStreaming="{Binding IsRunning}"
                                                   Visibility="{Binding AssistantVisibility}"
                                                   IsSelectionEnabled="True"
                                                   IsTabStop="False"
                                                   VerticalScrollBarVisibility="Disabled"
                                                   HorizontalScrollBarVisibility="Disabled"
                                                   Background="Transparent" Padding="0"
                                                   MinHeight="0"/>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppDangerBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding NoteVisibility}"/>
                                <DockPanel Margin="0,6,0,0">
                                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Copy24}"
                                               Padding="4,1"
                                               ToolTip="复制当前结果"
                                               Visibility="{Binding AssistantVisibility}"
                                               Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding AssistantText}"/>
                                    <TextBlock Text="{Binding Footer}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeMicro}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ProgressBar Height="2" IsIndeterminate="True" Margin="0,4,0,0"
                                             Visibility="{Binding RunningVisibility}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="8" Style="{DynamicResource CardBorderStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Row="0" Grid.Column="0" x:Name="InputBox"
                            Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                            VerticalScrollBarVisibility="Auto" Padding="6"
                            VerticalContentAlignment="Top"
                            PreviewKeyDown="OnInputKeyDown"
                            PlaceholderText="用中文描述要执行的运维操作；Enter 发送，Shift+Enter 换行（Ctrl+Shift+I 聚焦）"/>
                <ui:Button Grid.Row="0" Grid.Column="1" Content="{Binding SendButtonText}"
                           Appearance="Primary" Width="60" Height="34" Padding="0" Margin="6,0,0,0"
                           Command="{Binding SendOrStopCommand}"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
