<UserControl x:Class="LitSSHmcp.App.Controls.TerminalTabView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TileCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6,6,6,0">
            <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Folder24}" Padding="8,3" Margin="0,0,8,4"
                       ToolTip="显示 / 隐藏远程文件" AutomationProperties.Name="显示或隐藏远程文件"
                       Command="{Binding ToggleFileBrowserCommand}"/>
            <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowSync24}" Padding="8,3" Margin="0,0,8,4"
                       ToolTip="重新连接" AutomationProperties.Name="重新连接"
                       Command="{Binding ReconnectCommand}"/>
            <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Code24}" Padding="8,3" Margin="0,0,8,4"
                       ToolTip="命令片段" AutomationProperties.Name="命令片段" Click="OnSnippets"/>
            <ui:Button x:Name="AiButton" DockPanel.Dock="Left" Content="AI 助手"
                       Icon="{ui:SymbolIcon Chat24}" Padding="8,3"
                       Margin="0,0,8,4" ToolTip="终端 AI 助手（仅当前服务器，Ctrl+Shift+A）"
                       AutomationProperties.Name="终端 AI 助手" Click="OnToggleAi"/>
            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource TileCloseButton}" Margin="4,0,0,0"
                    ToolTip="关闭会话"
                    Visibility="{Binding DataContext.IsSshTiled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="SyncPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed"
                        ToolTip="{Binding DataContext.CommandSyncToolTip, RelativeSource={RelativeSource AncestorType=Window}}">
                <ui:ToggleSwitch IsChecked="{Binding IsSyncEnabled, Mode=TwoWay}"
                                 AutomationProperties.Name="开启命令同步"/>
                <TextBlock Text="{Binding DataContext.CommandSyncEffectiveCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=同步 {0}}"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileCol" Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AiSplitterCol" Width="Auto"/>
                <ColumnDefinition x:Name="AiCol" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="FilePanel" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,4,0"
                    Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppRadiusS}" Padding="6"
                    Visibility="{Binding ShowFileBrowser, Converter={StaticResource BoolToVis}}">
                <controls:RemoteFileBrowserView DataContext="{Binding FileBrowser}"/>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Grid.RowSpan="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                          DragCompleted="OnSplitterDragCompleted"
                          Visibility="{Binding ShowFileBrowser, Converter={StaticResource BoolToVis}}"/>

            <Grid Grid.Column="2" Grid.Row="0">
                <Border Background="{DynamicResource AppTerminalBgBrush}" CornerRadius="{DynamicResource AppRadiusS}">
                    <controls:TerminalView x:Name="Terminal" Session="{Binding}" Margin="4,8,4,4"/>
                </Border>
                <Border VerticalAlignment="Top" Margin="6" Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource AppDangerSubtleBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
                        BorderThickness="1" Panel.ZIndex="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="重新连接" Padding="10,2" Margin="8,0,0,0"
                                   Command="{Binding ReconnectCommand}"/>
                        <TextBlock Text="连接已断开" Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Column="2" Grid.Row="1" Margin="0,6,0,0">
                <ui:Button DockPanel.Dock="Right" Content="发送" Padding="16,4" Appearance="Primary" Margin="6,0,0,0" Click="OnSendInput"/>
                <ui:Button DockPanel.Dock="Right" Content="AI 分析" Padding="12,4" Margin="6,0,0,0"
                           ToolTip="把下方输入框的命令交给「运维专家」智能体分析（打开临时聊天，可修改后再发送）"
                           Click="OnAiAnalyze"/>
                <ui:TextBox FontWeight="Normal" x:Name="SendBox" KeyDown="OnSendBoxKeyDown"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="120"
                            VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="5"
                            PlaceholderText="在此输入或粘贴内容（可多行），Enter 发送、Shift+Enter 换行；或点「AI 分析」交给运维专家解读"/>
            </DockPanel>

            <GridSplitter x:Name="AiSplitter" Grid.Column="3" Grid.RowSpan="2" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed"
                          DragCompleted="OnAiSplitterDragCompleted"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <Border x:Name="AiPanel" Grid.Column="4" Grid.RowSpan="2" Margin="4,0,0,0" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppRadiusS}">
                <controls:TerminalAiDrawer x:Name="AiDrawer"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
