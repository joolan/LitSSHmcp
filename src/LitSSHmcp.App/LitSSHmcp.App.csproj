<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LitSSHmcp.Core\LitSSHmcp.Core.csproj" />
    <ProjectReference Include="..\LitSSHmcp.Agent\LitSSHmcp.Agent.csproj" />
  </ItemGroup>

  <!-- 应用图标资源：供窗口 Icon 与托盘图标在运行时加载 -->
  <ItemGroup>
    <Resource Include="Assets\LitSSH.ico" />
  </ItemGroup>

  <!-- AI 运维助手内置技能(运维技能 markdown): 随 App 输出到 skills/litssh-mcp-ops-skill -->
  <ItemGroup>
    <None Include="..\..\docs\litssh-mcp-ops-skill\**\*" Link="skills\litssh-mcp-ops-skill\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- AI 运维助手预置技能包(每个子目录一个技能): docs/skills/<name>/SKILL.md -> skills/<name>/SKILL.md -->
  <ItemGroup>
    <None Include="..\..\docs\skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 【同步约定】MCP 工具说明的唯一事实来源是 docs/TOOLS.md。
       这里把它嵌入 App 程序集, 供菜单"配置 → MCP工具说明"(McpToolsWindow) 展示。
       MCP 工具发生变动时, 必须同步更新: ① MCP 服务器端 Tools/*.cs 注解与 UsageGuideTools 内置清单
       ② docs/TOOLS.md ③ 本文件嵌入内容(无需改代码, 刷新文档即可) — 详见 docs/TOOLS.md 顶部"同步约定"。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\TOOLS.md" Link="docs\TOOLS.md" LogicalName="LitSSHmcp.App.docs.TOOLS.md" />
    <EmbeddedResource Include="..\..\docs\HELP.md" Link="docs\HELP.md" LogicalName="LitSSHmcp.App.docs.HELP.md" />
  </ItemGroup>
  <!-- 内嵌 VNC（noVNC，MPL-2.0）静态资源：随 App 输出到 novnc/，由 VncWebHost 在本机回环上提供 -->
  <ItemGroup>
    <None Include="Assets\novnc\**\*" Link="novnc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM 版本 = 编译期 API 面（Windows Hello 等 WinRT API 需要）；运行最低版本由默认 MinVersion(17763) 决定 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 应用版本（发布脚本会以 -p:Version=<tag> 覆盖）；「设置 → 关于」页面显示该值 -->
    <Version>1.5.1</Version>
    <!-- 应用图标：exe 文件图标 + 窗口/托盘运行时图标来源 -->
    <ApplicationIcon>Assets\LitSSH.ico</ApplicationIcon>
    <!-- ����������ͼ�� NotifyIcon���Ƴ� WinForms ��ʽ using�������� WPF ���ͣ�Button/TextBox/Application �ȣ����� -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
