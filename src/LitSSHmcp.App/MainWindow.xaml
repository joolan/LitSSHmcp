<ui:FluentWindow x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="LitSSH MCP Manager" Height="740" Width="1120"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LitSSH MCP Manager"/>

        <Menu Grid.Row="1" Margin="6,0">
            <MenuItem Header="资产(_A)">
                <MenuItem Header="数据源管理" Command="{Binding OpenDatasourceManagerCommand}"/>
                <MenuItem Header="应用管理" Command="{Binding OpenApplicationManagerCommand}"/>
                <Separator/>
                <MenuItem Header="资产拓扑(可视化编辑)" Command="{Binding OpenTopologyCommand}"/>
            </MenuItem>
            <MenuItem Header="安全(_S)">
                <MenuItem Header="安全设置" Command="{Binding OpenSecuritySettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="审计(_L)">
                <MenuItem Header="审计日志" Command="{Binding OpenAuditCommand}"/>
            </MenuItem>
            <MenuItem Header="配置(_C)">
                <MenuItem Header="工具分组设置..." Command="{Binding OpenToolGroupsCommand}"/>
                <Separator/>
                <MenuItem Header="导出配置..." Command="{Binding ExportConfigCommand}"/>
                <MenuItem Header="导入配置..." Command="{Binding ImportConfigCommand}"/>
            </MenuItem>
            <MenuItem Header="MCP工具说明" Command="{Binding OpenMcpToolsCommand}"/>
            <MenuItem Header="AI 运维助手" Command="{Binding OpenAgentCommand}"/>
        </Menu>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：服务器列表 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="SSH 服务器" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="添加" Command="{Binding AddServerCommand}" Width="54" Margin="0,0,4,4" Padding="2,3"/>
                    <Button Content="刷新" Command="{Binding LoadServersCommand}" Width="54" Margin="0,0,4,4" Padding="2,3"/>
                </WrapPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                <ListBox x:Name="ServerList" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         MouseDoubleClick="OnServerDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                         ContextMenuOpening="OnListContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="连接" Click="OnConnectClick"/>
                            <MenuItem Header="编辑" Click="OnEditServerClick"/>
                            <Separator/>
                            <MenuItem Header="采集快照" Click="OnSnapshotRefreshClick"/>
                            <MenuItem Header="快照历史" Click="OnSnapshotHistoryClick"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="OnDeleteServerClick"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="已禁用" Foreground="{DynamicResource AppDangerBrush}"
                                               FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"
                                               ToolTip="该服务器已禁用: 不出现在 MCP 的 ssh_list_servers, 不可连接/建链, 拓扑发现跳过">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Host, Mode=OneWay}"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding Port, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}"/>

            <!-- 右：会话标签 -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <TabControl ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="✕"
                                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="16" Height="16" Padding="0" FontSize="10"
                                        Background="Transparent" BorderThickness="0" ToolTip="关闭会话"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="160"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="测试连接" Command="{Binding TestConnectionCommand}" Padding="10,3" Margin="6,0,0,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <TextBox Grid.Row="1" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="6"
                                         FontFamily="Consolas" Background="{DynamicResource AppCodeBgBrush}" Foreground="{DynamicResource AppCodeTextBrush}"/>

                                <Grid Grid.Row="2" Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Padding="5" Margin="0,0,6,0"
                                             FontFamily="Consolas" KeyDown="OnCommandKeyDown"/>
                                    <Button Grid.Column="1" Content="执行" Command="{Binding ExecuteCommand}" Padding="16,5" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="清空" Command="{Binding ClearOutputCommand}" Padding="10,5"/>
                                </Grid>

                                <DockPanel Grid.Row="3">
                                    <TextBlock DockPanel.Dock="Top" Text="最近活动" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ListBox ItemsSource="{Binding RecentActivity}" FontFamily="Consolas" FontSize="11" Padding="2">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                     <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                     <Run Text="  "/>
                                                     <Run Text="{Binding Command, Mode=OneWay}"/>
                                                     <Run Text="  "/>
                                                     <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <TextBlock Text="从左侧双击服务器，或右键选择「连接」，即可打开会话"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSessions}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
