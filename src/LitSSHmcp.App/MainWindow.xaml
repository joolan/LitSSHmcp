<ui:FluentWindow x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="LitSSH MCP Manager" Height="740" Width="1160"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <controls:MainPageVisibilityConverter x:Key="PageVis"/>
        <controls:MainPageAppearanceConverter x:Key="PageAppearance"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LitSSH MCP Manager"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8">
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <ui:Button Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent" Width="44" Height="44"
                                   HorizontalAlignment="Center" ToolTip="设置（安全 / 工具分组 / 导入导出）" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Home24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="主页（服务器 / 会话）"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Home}"
                                   Command="{Binding NavigateHomeCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Server24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="SSH 服务器管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Servers}"
                                   Command="{Binding NavigateServersCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Database24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="数据源管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=DataSources}"
                                   Command="{Binding NavigateDataSourcesCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Apps24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="应用管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Applications}"
                                   Command="{Binding NavigateApplicationsCommand}"/>
                        <Separator Margin="10,4,10,8"/>
                        <ui:Button Icon="{ui:SymbolIcon Share24}" Appearance="Transparent" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="资产拓扑（独立窗口）" Command="{Binding OpenTopologyCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon History24}" Appearance="Transparent" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="审计日志（独立窗口）" Command="{Binding OpenAuditCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Book24}" Appearance="Transparent" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="MCP 工具说明" Command="{Binding OpenMcpToolsCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Chat24}" Appearance="Primary" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="AI 运维助手" Command="{Binding OpenAgentCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧主区域：页面宿主 -->
            <Grid Grid.Column="1">
                <!-- 主页：服务器 + 会话 -->
                <Grid Margin="10"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="180"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 服务器列表 -->
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Server24" FontSize="16" Margin="0,0,6,0"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Text="SSH 服务器" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Padding="10,3" Margin="0,0,6,0" Command="{Binding AddServerCommand}"/>
                            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="10,3" Command="{Binding LoadServersCommand}"/>
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                        <ListBox x:Name="ServerList" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                 MouseDoubleClick="OnServerDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                                 ContextMenuOpening="OnListContextMenuOpening" Background="Transparent" BorderThickness="0">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="连接" Click="OnConnectClick"/>
                                    <MenuItem Header="编辑" Click="OnEditServerClick"/>
                                    <Separator/>
                                    <MenuItem Header="采集快照" Click="OnSnapshotRefreshClick"/>
                                    <MenuItem Header="快照历史" Click="OnSnapshotHistoryClick"/>
                                    <Separator/>
                                    <MenuItem Header="删除" Click="OnDeleteServerClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="已禁用" Foreground="{DynamicResource AppDangerBrush}"
                                                       FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"
                                                       ToolTip="该服务器已禁用: 不出现在 MCP 的 ssh_list_servers, 不可连接/建链, 拓扑发现跳过">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Host, Mode=OneWay}"/>
                                            <Run Text=":"/>
                                            <Run Text="{Binding Port, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 会话标签 -->
                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <TabControl ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="16" Height="16" Padding="0" FontSize="10"
                                                Background="Transparent" BorderThickness="0" ToolTip="关闭会话"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="160"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="测试连接" Padding="10,3" Margin="6,0,0,0" Command="{Binding TestConnectionCommand}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <TextBox Grid.Row="1" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="6"
                                                 FontFamily="Consolas" Background="{DynamicResource AppCodeBgBrush}" Foreground="{DynamicResource AppCodeTextBrush}"/>

                                        <Grid Grid.Row="2" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" Padding="5" Margin="0,0,6,0"
                                                     FontFamily="Consolas" KeyDown="OnCommandKeyDown"/>
                                            <ui:Button Grid.Column="1" Content="执行" Padding="16,5" Margin="0,0,6,0" Appearance="Primary" Command="{Binding ExecuteCommand}"/>
                                            <ui:Button Grid.Column="2" Content="清空" Padding="12,5" Command="{Binding ClearOutputCommand}"/>
                                        </Grid>

                                        <DockPanel Grid.Row="3">
                                            <TextBlock DockPanel.Dock="Top" Text="最近活动" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ListBox ItemsSource="{Binding RecentActivity}" FontFamily="Consolas" FontSize="11" Padding="2" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Command, Mode=OneWay}"/>
                                                            <Run Text="  "/>
                                                            <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AppAccentBrush}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>

                        <TextBlock Text="从左侧双击服务器，或右键选择「连接」，即可打开会话"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSessions}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- SSH 服务器管理 -->
                <views:ServerManageView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}"/>

                <!-- 数据源管理 -->
                <views:DatasourceManageView DataContext="{Binding DatasourcePage}"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}"/>

                <!-- 应用管理 -->
                <views:ApplicationManageView DataContext="{Binding ApplicationPage}"
                                             Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
