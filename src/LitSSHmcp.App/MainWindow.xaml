<Window x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LitSSH MCP Manager" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- 左侧：服务器列表 -->
        <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="SSH 服务器" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="刷新" Command="{Binding LoadServersCommand}" Margin="0,0,5,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="添加" Command="{Binding AddServerCommand}" Width="45" Margin="0,0,3,0"/>
                    <Button Content="编辑" Command="{Binding EditServerCommand}" Width="45" Margin="0,0,3,0"/>
                    <Button Content="删除" Command="{Binding DeleteServerCommand}" Width="45"/>
                </StackPanel>
            </Grid>

            <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Padding="3">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6" Margin="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Foreground="Gray" FontSize="10">
                                    <Run Text="{Binding Host, Mode=OneWay}"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding Port, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="10" 
                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 中间：服务器详情 -->
        <DockPanel Grid.Column="1" Grid.RowSpan="2" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="服务器详情" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            
            <Button DockPanel.Dock="Bottom" Content="测试连接" Command="{Binding TestConnectionCommand}" 
                    Padding="10,8" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
            
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedServer}">
                        <TextBlock Text="名称:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Name}" Margin="0,0,0,10" Foreground="#333333"/>
                        
                        <TextBlock Text="主机:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Host}" Margin="0,0,0,10" Foreground="#333333"/>
                        
                        <TextBlock Text="端口:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Port}" Margin="0,0,0,10" Foreground="#333333"/>
                        
                        <TextBlock Text="用户名:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Username}" Margin="0,0,0,10" Foreground="#333333"/>
                        
                        <TextBlock Text="描述:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Description}" Margin="0,0,0,10" Foreground="#333333" TextWrapping="Wrap"/>
                        
                        <TextBlock Text="标签:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding TagsText}" Margin="0,0,0,10" Foreground="#333333"/>
                        
                        <TextBlock Text="提权方式:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding SelectedServerSudoType, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,5" Foreground="#333333"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- 右上角：命令执行 -->
        <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Top" Text="命令执行" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="5" Margin="0,0,5,0"
                         FontFamily="Consolas"/>
                <Button Grid.Column="1" Content="执行" Command="{Binding ExecuteCommandCommand}" Padding="15,5"/>
            </Grid>
            <TextBox Text="{Binding CommandOutput, Mode=OneWay}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="5"
                     FontFamily="Consolas" Background="#1E1E1E" Foreground="#DCDCDC"/>
        </DockPanel>

        <!-- 右下角：活动日志 -->
        <DockPanel Grid.Column="2" Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="最近活动" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,5,0,0" Foreground="Gray"/>
            <ListBox ItemsSource="{Binding AuditLogs}" Padding="3">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="2" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding ServerName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" - " Foreground="Gray"/>
                                    <Run Text="{Binding Command, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           Foreground="Gray" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>