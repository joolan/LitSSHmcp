<ui:FluentWindow x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="LitSSH MCP Manager" Height="740" Width="1160"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <controls:MainPageVisibilityConverter x:Key="PageVis"/>
        <controls:MainPageAppearanceConverter x:Key="PageAppearance"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LitSSH MCP Manager"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8">
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <ui:Button Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent" Width="44" Height="44"
                                   HorizontalAlignment="Center" ToolTip="设置（安全 / 工具分组 / 导入导出）" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Home24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="主页（快捷入口 / 数据看板）"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Home}"
                                   Command="{Binding NavigateHomeCommand}" Click="OnHomeNavClick"/>
                        <ui:Button Icon="{ui:SymbolIcon Server24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="SSH 服务器管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Servers}"
                                   Command="{Binding NavigateServersCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Database24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="数据源管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=DataSources}"
                                   Command="{Binding NavigateDataSourcesCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon Apps24}" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="应用管理"
                                   Appearance="{Binding CurrentPage, Converter={StaticResource PageAppearance}, ConverterParameter=Applications}"
                                   Command="{Binding NavigateApplicationsCommand}"/>
                        <Separator Margin="10,4,10,8"/>
                        <ui:Button Icon="{ui:SymbolIcon Share24}" Appearance="Transparent" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="资产拓扑（独立窗口）" Command="{Binding OpenTopologyCommand}"/>
                        <ui:Button Icon="{ui:SymbolIcon History24}" Appearance="Transparent" Width="44" Height="44" Margin="0,0,0,4"
                                   HorizontalAlignment="Center" ToolTip="审计日志（独立窗口）" Command="{Binding OpenAuditCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧主区域：页面宿主 -->
            <Grid Grid.Column="1">
                <!-- 主页：服务器 + 会话 -->
                <!-- 主页：快捷入口 + 数据看板 + AI 快捷提问 -->
                <Grid x:Name="HomeView" Margin="16"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="主页" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <TextBlock Text="快捷入口" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <WrapPanel Margin="0,0,0,20">
                                <ui:Button Content="SSH 会话管理" Icon="{ui:SymbolIcon Server24}" Padding="14,6" Margin="0,0,8,8"
                                           Command="{Binding OpenSessionManagerCommand}"/>
                                <ui:Button Content="资产拓扑" Icon="{ui:SymbolIcon Share24}" Padding="14,6" Margin="0,0,8,8"
                                           Command="{Binding OpenTopologyCommand}"/>
                                <ui:Button Content="审计日志" Icon="{ui:SymbolIcon History24}" Padding="14,6" Margin="0,0,8,8"
                                           Command="{Binding OpenAuditCommand}"/>
                                <ui:Button Content="AI 运维助手" Icon="{ui:SymbolIcon Chat24}" Padding="14,6" Margin="0,0,8,8"
                                           Command="{Binding OpenAgentCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="数据看板" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <WrapPanel Margin="0,0,0,20">
                                <Border Style="{DynamicResource CardBorderStyle}" Width="200" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开 SSH 服务器管理" MouseLeftButtonUp="OnHomeServersClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ServerCount}" FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Text="SSH 服务器" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppDangerBrush}">
                                            <Run Text="已禁用 "/>
                                            <Run Text="{Binding DisabledServerCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="200" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开数据源管理" MouseLeftButtonUp="OnHomeDatasourcesClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DatasourceCount}" FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Text="数据源" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="200" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开应用管理" MouseLeftButtonUp="OnHomeApplicationsClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ApplicationCount}" FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Text="应用" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="200" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开端口转发" MouseLeftButtonUp="OnHomePortForwardClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PortForwardCount}" FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Text="端口转发规则" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppSuccessBrush}">
                                            <Run Text="运行中 "/>
                                            <Run Text="{Binding PortForwardRunningCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="200" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开文件/文件夹同步" MouseLeftButtonUp="OnHomeSyncClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SyncTaskCount}" FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Text="同步任务" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppSuccessBrush}">
                                            <Run Text="启用 "/>
                                            <Run Text="{Binding SyncTaskEnabledCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="AI 快捷提问" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="True"
                                               Visibility="{Binding HasHomeAttachments, Converter={StaticResource BoolToVis}}">
                                        <ui:Button DockPanel.Dock="Right" Style="{DynamicResource ActionRowButton}" Content="清除全部"
                                                   Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnHomeClearAttachments"/>
                                        <ItemsControl ItemsSource="{Binding HomeAttachments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                                            Padding="8,3" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>

                                    <TextBox x:Name="HomeAskBox" Text="{Binding HomeQuestion, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="90" MaxHeight="220" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Top" Padding="2" PreviewKeyDown="OnHomeAskKeyDown"
                                             ToolTip="Enter 发送 / Shift+Enter 换行"/>

                                    <DockPanel Margin="0,6,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="发送" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                                   Padding="16,5" Click="OnHomeSend"/>
                                        <ui:Button Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Padding="8,4" Click="OnHomeMore"
                                                   ToolTip="添加图片 / 文件">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="添加图片…" Click="OnHomeAddImage"/>
                                                    <MenuItem Header="添加文件…" Click="OnHomeAddFile"/>
                                                    <MenuItem Header="清除全部附件" Click="OnHomeClearAttachments"/>
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Enter 发送 / Shift+Enter 换行；发送时会把文字与附件填入 AI 运维助手的输入区（若助手输入区已有内容会先确认）。"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SSH 服务器管理 -->
                <Grid x:Name="ServersView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}">
                    <views:ServerManageView/>
                </Grid>

                <!-- 数据源管理 -->
                <Grid x:Name="DataSourcesView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}">
                    <views:DatasourceManageView DataContext="{Binding DatasourcePage}"/>
                </Grid>

                <!-- 应用管理 -->
                <Grid x:Name="ApplicationsView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}">
                    <views:ApplicationManageView DataContext="{Binding ApplicationPage}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
