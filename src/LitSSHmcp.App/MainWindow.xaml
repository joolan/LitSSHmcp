<ui:FluentWindow x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="LitSSH MCP Manager" Height="950" Width="1400" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <controls:MainPageVisibilityConverter x:Key="PageVis"/>
        <controls:MainPageAppearanceConverter x:Key="PageAppearance"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SideNavButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Path=(controls:KeyboardFocusRing.ShowRing), RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LitSSH MCP Manager"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8">
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="设置（安全 / 工具分组 / 导入导出）"
                                   AutomationProperties.Name="设置" Command="{Binding OpenSettingsCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="主页（快捷入口 / 数据看板）" AutomationProperties.Name="主页"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateHomeCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="首页" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="AI 运维助手"
                                   AutomationProperties.Name="AI 运维助手"
                                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding OpenAgentCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Agent}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Agent}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Chat24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="AI" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                        MinWidth="14" Height="14" CornerRadius="7" Padding="3,0"
                                        Background="{DynamicResource AppAccentBrush}"
                                        ToolTip="{Binding AgentBadgeTooltip}"
                                        Visibility="{Binding ShowAgentBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AgentBadgeText}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="打开 SSH 会话管理"
                                   AutomationProperties.Name="SSH 会话管理" Command="{Binding OpenSessionManagerCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Server24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="会话" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                        <Separator Margin="10,4,10,6"/>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="SSH 服务器管理" AutomationProperties.Name="SSH 服务器管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateServersCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="服务器" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="数据源管理" AutomationProperties.Name="数据源管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateDataSourcesCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Database24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="数据源" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="应用管理" AutomationProperties.Name="应用管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateApplicationsCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="应用" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="远程桌面（RDP / VNC）" AutomationProperties.Name="远程桌面"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateRemoteDesktopsCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="桌面" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="Jenkins 多连接" AutomationProperties.Name="Jenkins"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateJenkinsCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Jenkins}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Jenkins}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Jenkins" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                        MinWidth="14" Height="14" CornerRadius="7" Padding="3,0"
                                        Background="{DynamicResource AppAccentBrush}"
                                        ToolTip="{Binding JenkinsBadgeTooltip}"
                                        Visibility="{Binding ShowJenkinsBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding JenkinsBadgeText}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="Kubernetes 多集群只读视图" AutomationProperties.Name="Kubernetes"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateKubernetesCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Kubernetes}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Kubernetes}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Cloud24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="K8s" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <Separator Margin="10,4,10,6"/>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="资产拓扑（独立窗口）"
                                   AutomationProperties.Name="资产拓扑" Command="{Binding OpenTopologyCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Share24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="拓扑" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="审计日志（独立窗口）"
                                   AutomationProperties.Name="审计日志" Command="{Binding OpenAuditCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="审计" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧主区域：页面宿主 -->
            <Grid Grid.Column="1">
                <!-- 主页：本机运行中心 + 资产概览 + 帮助入口 -->
                <Grid x:Name="HomeView" Margin="16,12,16,12"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <views:HomeDashboardView DataContext="{Binding}"/>

                            <Border Style="{DynamicResource CardBorderStyle}" Padding="10,6" Margin="0,12,0,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="15"
                                                       Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="使用说明" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="8,0,14,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="快速上手" Icon="{ui:SymbolIcon Play24}" Tag="QuickStart"
                                                   Height="30" Padding="8,2" Appearance="Transparent" BorderThickness="0" Margin="0,0,6,0" Click="OnOpenHelp"/>
                                        <ui:Button Content="功能说明" Icon="{ui:SymbolIcon Document24}" Tag="Features"
                                                   Height="30" Padding="8,2" Appearance="Transparent" BorderThickness="0" Margin="0,0,6,0" Click="OnOpenHelp"/>
                                        <ui:Button Content="快捷键" Icon="{ui:SymbolIcon Code24}" Tag="Shortcuts"
                                                   Height="30" Padding="8,2" Appearance="Transparent" BorderThickness="0" Margin="0,0,6,0" Click="OnOpenHelp"/>
                                        <ui:Button Content="安全与审批" Icon="{ui:SymbolIcon ShieldCheckmark24}" Tag="Security"
                                                   Height="30" Padding="8,2" Appearance="Transparent" BorderThickness="0" Margin="0,0,6,0" Click="OnOpenHelp"/>
                                        <ui:Button Content="MCP 工具说明" Icon="{ui:SymbolIcon PlugConnected24}" Tag="McpTools"
                                                   Height="30" Padding="8,2" Appearance="Transparent" BorderThickness="0" Click="OnOpenHelp"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+K 命令面板 · 可搜索页面 / 工具 / 动作"
                                               VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SSH 服务器管理 -->
                <Grid x:Name="ServersView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}">
                    <views:ServerManageView/>
                </Grid>

                <!-- 数据源管理 -->
                <Grid x:Name="DataSourcesView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}">
                    <views:DatasourceManageView DataContext="{Binding DatasourcePage}"/>
                </Grid>

                <!-- 应用管理 -->
                <Grid x:Name="ApplicationsView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}">
                    <views:ApplicationManageView DataContext="{Binding ApplicationPage}"/>
                </Grid>

                <!-- 远程桌面（RDP / VNC） -->
                <Grid x:Name="RemoteDesktopsView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}">
                    <views:RemoteDesktopManageView DataContext="{Binding RemoteDesktopPage}"/>
                </Grid>

                <!-- Jenkins 多连接 -->
                <Grid x:Name="JenkinsPage"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Jenkins}">
                    <views:JenkinsView DataContext="{Binding JenkinsPage}"/>
                </Grid>

                <Grid x:Name="KubernetesPage"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Kubernetes}">
                    <views:KubernetesView DataContext="{Binding KubernetesPage}"/>
                </Grid>

                <!-- AI 运维助手（常驻页面，切换导航不停止任务） -->
                <Grid x:Name="AgentPage"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Agent}">
                    <ContentControl Content="{Binding AgentPageView}"/>

                    <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                                Visibility="{Binding IsAgentDetached, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Chat24" FontSize="44" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="AI 助手正在独立窗口运行" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="任务会继续执行；可以激活独立窗口，或收回主界面。"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="激活独立窗口" Appearance="Primary" Padding="14,5" Margin="0,0,8,0"
                                       Command="{Binding ActivateAgentCommand}"/>
                            <ui:Button Content="收回主界面" Padding="14,5"
                                       Command="{Binding DockAgentCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
