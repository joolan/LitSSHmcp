<ui:FluentWindow x:Class="LitSSHmcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="LitSSH MCP Manager" Height="860" Width="1400" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <controls:MainPageVisibilityConverter x:Key="PageVis"/>
        <controls:MainPageAppearanceConverter x:Key="PageAppearance"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SideNavButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LitSSH MCP Manager"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,8">
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="设置（安全 / 工具分组 / 导入导出）"
                                   AutomationProperties.Name="设置" Command="{Binding OpenSettingsCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="主页（快捷入口 / 数据看板）" AutomationProperties.Name="主页"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateHomeCommand}" Click="OnHomeNavClick">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="首页" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="打开 AI 运维助手"
                                   AutomationProperties.Name="AI 运维助手" Command="{Binding OpenAgentCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="AI" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="打开 SSH 会话管理"
                                   AutomationProperties.Name="SSH 会话管理" Command="{Binding OpenSessionManagerCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Server24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="会话" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                        <Separator Margin="10,4,10,6"/>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="SSH 服务器管理" AutomationProperties.Name="SSH 服务器管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateServersCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="服务器" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="数据源管理" AutomationProperties.Name="数据源管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateDataSourcesCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Database24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="数据源" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="应用管理" AutomationProperties.Name="应用管理"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateApplicationsCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="应用" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Width="56" Height="54" Padding="0" Margin="0,0,0,2" HorizontalAlignment="Center"
                                   ToolTip="远程桌面（RDP / VNC）" AutomationProperties.Name="远程桌面"
                                   Appearance="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Command="{Binding NavigateRemoteDesktopsCommand}">
                            <Grid Width="56" Height="54">
                                <Border Background="{DynamicResource AppSelectionBrush}" CornerRadius="6"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}"/>
                                <Border Width="3" Background="{DynamicResource AppAccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,10"
                                        Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="桌面" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Button>
                        <Separator Margin="10,4,10,6"/>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="资产拓扑（独立窗口）"
                                   AutomationProperties.Name="资产拓扑" Command="{Binding OpenTopologyCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Share24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="拓扑" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource SideNavButtonStyle}" Appearance="Transparent" Width="56" Height="54" Padding="0" Margin="0,0,0,2"
                                   HorizontalAlignment="Center" ToolTip="审计日志（独立窗口）"
                                   AutomationProperties.Name="审计日志" Command="{Binding OpenAuditCommand}">
                            <StackPanel VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="审计" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧主区域：页面宿主 -->
            <Grid Grid.Column="1">
                <!-- 主页：服务器 + 会话 -->
                <!-- 主页：快捷入口 + 数据看板 + AI 快捷提问 -->
                <Grid x:Name="HomeView" Margin="16"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Home}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <controls:PageHeader Icon="Home24" Title="主页" Subtitle="AI 快捷提问与资产概览"/>

                            <TextBlock Text="AI 快捷提问" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="True"
                                               Visibility="{Binding HasHomeAttachments, Converter={StaticResource BoolToVis}}">
                                        <ui:Button DockPanel.Dock="Right" Style="{DynamicResource ActionRowButton}" Content="清除全部"
                                                   Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnHomeClearAttachments"/>
                                        <ItemsControl ItemsSource="{Binding HomeAttachments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                                            Padding="8,3" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeMicro}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>

                                    <ui:TextBox x:Name="HomeAskBox" Text="{Binding HomeQuestion, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="90" MaxHeight="220" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Top" Padding="2" PreviewKeyDown="OnHomeAskKeyDown"
                                             PlaceholderText="描述你要排查的问题，例如：web-01 上 nginx 502 怎么排查？"
                                             ToolTip="Enter 交给 AI 助手 / Shift+Enter 换行"/>

                                    <DockPanel Margin="0,6,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="交给 AI 助手" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                                   Padding="16,5" Click="OnHomeSend"/>
                                        <ui:Button Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Padding="8,4" Click="OnHomeMore"
                                                   ToolTip="添加图片 / 文件">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="添加图片…" Click="OnHomeAddImage"/>
                                                    <MenuItem Header="添加文件…" Click="OnHomeAddFile"/>
                                                    <MenuItem Header="清除全部附件" Click="OnHomeClearAttachments"/>
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Enter 交给 AI 助手 / Shift+Enter 换行；只会填入助手输入区，不会自动发送（若助手输入区已有内容会先确认）。"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"/>
                            <TextBlock Text="提示：Ctrl+K 打开命令面板，可搜索页面、工具与动作。"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding HomeStatusMessage}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"
                                       Visibility="{Binding HasHomeStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HomeStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="资产概览" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <WrapPanel Margin="0,0,0,16">
                                <Border Style="{DynamicResource CardBorderStyle}" Width="250" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开 SSH 服务器管理" MouseLeftButtonUp="OnHomeServersClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ServerCount}" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="SSH 服务器" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppAccentBrush}" Margin="0,4,0,0">
                                                <Run Text="活跃会话 "/>
                                                <Run Text="{Binding ActiveSessionCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppDangerBrush}"
                                                       Visibility="{Binding HasDisabledServers, Converter={StaticResource BoolToVis}}">
                                                <Run Text="已禁用 "/>
                                                <Run Text="{Binding DisabledServerCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Server24" FontSize="22" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AppAccentBrush}" Opacity="0.85"/>
                                    </Grid>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="250" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开数据源管理" MouseLeftButtonUp="OnHomeDatasourcesClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DatasourceCount}" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="数据源" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="MySQL / PostgreSQL / Redis" FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Database24" FontSize="22" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AppAccentBrush}" Opacity="0.85"/>
                                    </Grid>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="250" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开应用管理" MouseLeftButtonUp="OnHomeApplicationsClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ApplicationCount}" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="应用" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="拓扑节点与应用路径" FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Apps24" FontSize="22" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AppAccentBrush}" Opacity="0.85"/>
                                    </Grid>
                                </Border>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="250" Margin="0,0,12,12"
                                        Cursor="Hand" ToolTip="打开远程桌面（RDP / VNC）" MouseLeftButtonUp="OnHomeRemoteDesktopClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RemoteDesktopCount}" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="远程桌面" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="RDP / VNC · 支持 SSH 隧道" FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Desktop24" FontSize="22" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AppAccentBrush}" Opacity="0.85"/>
                                    </Grid>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="任务与工具" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}" Margin="0,0,0,8"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,20">
                                <WrapPanel>
                                    <Border Width="230" Margin="0,0,12,8" Padding="6" Background="Transparent"
                                            Cursor="Hand" ToolTip="打开端口转发" MouseLeftButtonUp="OnHomePortForwardClick">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Share24" FontSize="20" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppAccentBrush}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="端口转发 "/><Run Text="{Binding PortForwardCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppSuccessBrush}"
                                                           Visibility="{Binding HasRunningPortForwards, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="运行中 "/><Run Text="{Binding PortForwardRunningCount, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="230" Margin="0,0,12,8" Padding="6" Background="Transparent"
                                            Cursor="Hand" ToolTip="打开文件/文件夹同步" MouseLeftButtonUp="OnHomeSyncClick">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppAccentBrush}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="同步任务 "/><Run Text="{Binding SyncTaskCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppSuccessBrush}"
                                                           Visibility="{Binding HasEnabledSyncTasks, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="已启用 "/><Run Text="{Binding SyncTaskEnabledCount, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="230" Margin="0,0,12,8" Padding="6" Background="Transparent"
                                            Cursor="Hand" ToolTip="打开触发事件（git / webhook / 备份）" MouseLeftButtonUp="OnHomeTriggerClick">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Flash24" FontSize="20" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppAccentBrush}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="触发事件 "/><Run Text="{Binding TriggerCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppSuccessBrush}"
                                                           Visibility="{Binding HasEnabledTriggers, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="已启用 "/><Run Text="{Binding TriggerEnabledCount, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SSH 服务器管理 -->
                <Grid x:Name="ServersView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Servers}">
                    <views:ServerManageView/>
                </Grid>

                <!-- 数据源管理 -->
                <Grid x:Name="DataSourcesView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=DataSources}">
                    <views:DatasourceManageView DataContext="{Binding DatasourcePage}"/>
                </Grid>

                <!-- 应用管理 -->
                <Grid x:Name="ApplicationsView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Applications}">
                    <views:ApplicationManageView DataContext="{Binding ApplicationPage}"/>
                </Grid>

                <!-- 远程桌面（RDP / VNC） -->
                <Grid x:Name="RemoteDesktopsView"
                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=RemoteDesktops}">
                    <views:RemoteDesktopManageView DataContext="{Binding RemoteDesktopPage}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
