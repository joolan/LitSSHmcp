<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 应用自研样式：引用语义 token（DynamicResource，随主题切换） -->

    <!-- 全局窗口底色/前景（WPF-UI 不样式化普通 Window；隐式样式会沿类型层级命中所有窗口） -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="UserBubbleStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppUserBubbleBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="MaxWidth" Value="720"/>
    </Style>

    <Style x:Key="AssistantCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppAssistantBubbleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MaxWidth" Value="1040"/>
    </Style>

    <Style x:Key="StepCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusS}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- 表格 / 分组：默认 WPF 模板在深色下仍为浅色，这里统一 token 化 -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppRadiusS}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppRadiusM}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}"
                                              Margin="0,0,0,8"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

