<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <controls:GroupLabelConverter x:Key="GroupLabel"/>

    <Style x:Key="CollapsibleAssetGroupContainerStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander Margin="0,2,0,4" HorizontalAlignment="Stretch"
                              controls:GroupExpanderBehavior.GroupName="{Binding Name}">
                        <Expander.Header>
                            <DockPanel Margin="2,4,0,4">
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24"
                                               FontSize="{DynamicResource AppFontSizeBody}" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="{Binding Name, Converter={StaticResource GroupLabel}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                           FontSize="{DynamicResource AppFontSizeMicro}" Margin="4,0,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Expander.Header>
                        <ItemsPresenter/>
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
