<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:LitSSHmcp.App.ViewModels"
                    xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">

    <!-- 会话内容模板（App 级共享）：SSH 会话窗口与「分离的独立会话窗口」共用，保证两边渲染一致 -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="TileCloseButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 交互式终端标签内容（左：远程文件；右：终端） -->
    <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
        <controls:TerminalTabView/>
    </DataTemplate>

    <!-- 本机 PowerShell 终端标签内容（ConPTY，AI 与用户共享会话） -->
    <DataTemplate DataType="{x:Type vm:LocalTerminalSessionViewModel}">
        <controls:LocalTerminalTabView/>
    </DataTemplate>
</ResourceDictionary>
