    <Color x:Key="DangerColor">#FFFF99A4</Color>
    <Color x:Key="AccentSubtleColor">#224CC2FF</Color>
    <Color x:Key="DangerSubtleColor">#1FFF99A4</Color>
    <Color x:Key="SuccessColor">#FF6CCB5F</Color>
