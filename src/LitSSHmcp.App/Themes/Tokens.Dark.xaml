    <SolidColorBrush x:Key="NodeContainerBorderBrush" Color="{StaticResource NodeContainerBorderColor}"/>
    <SolidColorBrush x:Key="NodeDeployBgBrush" Color="{StaticResource NodeDeployBgColor}"/>
