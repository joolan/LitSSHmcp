    <SolidColorBrush x:Key="NodeDomainBgBrush" Color="{StaticResource NodeDomainBgColor}"/>
    <SolidColorBrush x:Key="NodeDomainBorderBrush" Color="{StaticResource NodeDomainBorderColor}"/>
    <SolidColorBrush x:Key="NodePortBgBrush" Color="{StaticResource NodePortBgColor}"/>
