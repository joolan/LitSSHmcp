    <Color x:Key="HoverColor">#1AFFFFFF</Color>
    <Color x:Key="NavHoverColor">#26FFFFFF</Color>
    <Color x:Key="PressedColor">#26FFFFFF</Color>
    <Color x:Key="SelectionColor">#332E9BFF</Color>
    <Color x:Key="BorderSubtleColor">#14FFFFFF</Color>
    <Color x:Key="BorderHoverColor">#4DFFFFFF</Color>
    <Color x:Key="NodeServerBgColor">#FF14304A</Color>
