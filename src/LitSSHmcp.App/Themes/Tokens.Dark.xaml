    <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource WarningColor}"/>
