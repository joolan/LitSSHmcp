<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 浅色主题 token -->
    <Color x:Key="AppBgColor">#FFF3F3F3</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF7F7F7</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#1A000000</Color>
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#99000000</Color>
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="DangerColor">#FFC42B1C</Color>
    <Color x:Key="SuccessColor">#FF0F7B0F</Color>
    <Color x:Key="WarningColor">#FF9D5D00</Color>
    <Color x:Key="CodeBgColor">#FFF6F6F6</Color>
    <Color x:Key="CodeTextColor">#FF1F1F1F</Color>
    <Color x:Key="UserBubbleColor">#FFD6E9FF</Color>
    <Color x:Key="AssistantBubbleColor">#FFFFFFFF</Color>
    <Color x:Key="HoverColor">#0F000000</Color>
    <Color x:Key="SelectionColor">#220067C0</Color>
    <Color x:Key="NodeServerBgColor">#FFEEF3FB</Color>
    <Color x:Key="NodeServerBorderColor">#FF9BB7E0</Color>
    <Color x:Key="NodeAppBgColor">#FFFFF4E5</Color>
