    <SolidColorBrush x:Key="NodeMqBgBrush" Color="{StaticResource NodeMqBgColor}"/>
    <SolidColorBrush x:Key="NodeMqBorderBrush" Color="{StaticResource NodeMqBorderColor}"/>
    <SolidColorBrush x:Key="NodeTextBrush" Color="{StaticResource NodeTextColor}"/>
    <SolidColorBrush x:Key="NodeTextSubBrush" Color="{StaticResource NodeTextSubColor}"/>
    <SolidColorBrush x:Key="AppCodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="AppCodeStringBrush" Color="{StaticResource CodeStringColor}"/>
    <SolidColorBrush x:Key="AppCodeNumberBrush" Color="{StaticResource CodeNumberColor}"/>
    <SolidColorBrush x:Key="AppCodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>

