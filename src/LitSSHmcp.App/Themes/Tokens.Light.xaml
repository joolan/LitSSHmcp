    <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource DangerColor}"/>
