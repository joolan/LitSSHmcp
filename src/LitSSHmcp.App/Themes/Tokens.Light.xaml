<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 浅色主题 token -->
    <Color x:Key="AppBgColor">#FFF3F3F3</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF7F7F7</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#1A000000</Color>
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#99000000</Color>
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="DangerColor">#FFC42B1C</Color>
    <Color x:Key="SuccessColor">#FF0F7B0F</Color>
    <Color x:Key="WarningColor">#FF9D5D00</Color>
    <Color x:Key="CodeBgColor">#FFF6F6F6</Color>
    <Color x:Key="CodeTextColor">#FF1F1F1F</Color>
    <Color x:Key="UserBubbleColor">#FFD6E9FF</Color>
    <Color x:Key="AssistantBubbleColor">#FFFFFFFF</Color>
    <Color x:Key="HoverColor">#0F000000</Color>
    <Color x:Key="SelectionColor">#220067C0</Color>
    <Color x:Key="CodeKeywordColor">#FF0000C0</Color>
    <Color x:Key="CodeStringColor">#FFA31515</Color>
    <Color x:Key="CodeNumberColor">#FF098658</Color>
    <Color x:Key="CodeCommentColor">#FF008000</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="AppCodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="AppCodeTextBrush" Color="{StaticResource CodeTextColor}"/>
    <SolidColorBrush x:Key="AppUserBubbleBrush" Color="{StaticResource UserBubbleColor}"/>
    <SolidColorBrush x:Key="AppAssistantBubbleBrush" Color="{StaticResource AssistantBubbleColor}"/>
    <SolidColorBrush x:Key="AppHoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="AppSelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="AppCodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="AppCodeStringBrush" Color="{StaticResource CodeStringColor}"/>
    <SolidColorBrush x:Key="AppCodeNumberBrush" Color="{StaticResource CodeNumberColor}"/>
    <SolidColorBrush x:Key="AppCodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>

    <CornerRadius x:Key="AppRadiusS">4</CornerRadius>
    <CornerRadius x:Key="AppRadiusM">8</CornerRadius>
    <CornerRadius x:Key="AppRadiusL">12</CornerRadius>
</ResourceDictionary>
