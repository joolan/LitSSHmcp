    <SolidColorBrush x:Key="NodeContainerBgBrush" Color="{StaticResource NodeContainerBgColor}"/>
    <SolidColorBrush x:Key="NodeContainerBorderBrush" Color="{StaticResource NodeContainerBorderColor}"/>
    <SolidColorBrush x:Key="NodeDeployBgBrush" Color="{StaticResource NodeDeployBgColor}"/>
    <SolidColorBrush x:Key="NodeDeployBorderBrush" Color="{StaticResource NodeDeployBorderColor}"/>
    <SolidColorBrush x:Key="NodeDomainBgBrush" Color="{StaticResource NodeDomainBgColor}"/>
    <SolidColorBrush x:Key="NodeDomainBorderBrush" Color="{StaticResource NodeDomainBorderColor}"/>
    <SolidColorBrush x:Key="NodePortBgBrush" Color="{StaticResource NodePortBgColor}"/>
    <SolidColorBrush x:Key="NodePortBorderBrush" Color="{StaticResource NodePortBorderColor}"/>
    <SolidColorBrush x:Key="NodeCertBgBrush" Color="{StaticResource NodeCertBgColor}"/>
    <SolidColorBrush x:Key="NodeCertBorderBrush" Color="{StaticResource NodeCertBorderColor}"/>
    <SolidColorBrush x:Key="NodeSystemBgBrush" Color="{StaticResource NodeSystemBgColor}"/>
    <SolidColorBrush x:Key="NodeSystemBorderBrush" Color="{StaticResource NodeSystemBorderColor}"/>
    <SolidColorBrush x:Key="NodeMqBgBrush" Color="{StaticResource NodeMqBgColor}"/>
    <SolidColorBrush x:Key="NodeMqBorderBrush" Color="{StaticResource NodeMqBorderColor}"/>
    <SolidColorBrush x:Key="NodeTextBrush" Color="{StaticResource NodeTextColor}"/>
    <SolidColorBrush x:Key="NodeTextSubBrush" Color="{StaticResource NodeTextSubColor}"/>
    <SolidColorBrush x:Key="AppCodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="AppCodeStringBrush" Color="{StaticResource CodeStringColor}"/>
    <SolidColorBrush x:Key="AppCodeNumberBrush" Color="{StaticResource CodeNumberColor}"/>
    <SolidColorBrush x:Key="AppCodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>

    <CornerRadius x:Key="AppRadiusS">4</CornerRadius>
    <CornerRadius x:Key="AppRadiusM">8</CornerRadius>
    <CornerRadius x:Key="AppRadiusL">12</CornerRadius>
