<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 把 WPF-UI 常用表面/文本/边框键对齐到 App token，避免同一窗口出现两套视觉语言。 -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF232323"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF161616"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF6CCB5F"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100"/>
</ResourceDictionary>
