<UserControl x:Class="LitSSHmcp.App.Views.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Info24" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="关于 LitSSH MCP" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="VersionBadge" Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource AppRadiusS}" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="版本 …" FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12"
                       Text="Windows 平台下的 SSH / 数据库运维 MCP 服务器，并配套桌面管理端（App）与浏览器端 Web 助手。让 AI 智能体安全地通过 SSH 管理远程服务器，贯通 MySQL / PostgreSQL / Redis 数据源与资产拓扑，并支持远程桌面（RDP / VNC），支撑跨服务器 / 应用 / 容器 / 数据库的全链路故障排查。"/>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="最近更新亮点" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• Memory 可回滚：新增历史快照表，更新 / 删除 / 归档前自动留存（含向量与 owner/scope）；每个 MemoryId 保留最近 40 版、孤儿快照 30 天清理；桌面「记忆管理」与 Web「记忆库」支持右键查看历史 / 回滚 / 归档，管理员 API 同步提供。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 存储维护：设置新增「存储维护」Tab，统计 config / agent.db / audit.db / snapshots.db / spill / jobs / logs / skills 占用；支持清理 Memory 历史、过期 spill、孤儿会话目录与审计归档（清理后重建剩余哈希链），并展示配置 / 库迁移状态。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• App 结构治理：IUserDialogService / IWindowService 收敛 UI 边界，Agent / Topology / DbWorkbench 多轮拆分；新增 IAppServices 最小组合根与 IConfigReloadable，配置冲突时可统一重新加载已打开窗口。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 本地工具精简：工作区 / 记忆 / 落盘 / 本机终端合并为 18 个工具，统一 mode/action 语义；系统提示、技能与工具清单门禁同步。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 质量门禁：全量测试与覆盖率分程序集阈值、七域风险门禁（工具目录 / 授权 / 路径 / 命令 / 脱敏 / Web / 结构预算）持续守住回归。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• Web 助手：Kestrel 零构建 SPA，独立账号库（PBKDF2-SHA256 210k 迭代、连续失败指数锁定），每个 AI 会话运行在独立 AgentRuntime 子进程；WebSocket 流式聊天、审批实时推送与 REST 对账，会话目录文件浏览 / 下载，图片附件与全屏预览、会话级模型切换，手机端响应式布局。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 运维与安全：审计 UserId / HMAC-SHA256 链、按会话隔离状态机、PathGuard 防越界、脚本永不免审、应用锁与 Windows Hello、本机 PowerShell 终端 + AI 本地 CLI、外部 MCP 接入、RDP / VNC、MCP Resources、资产拓扑与数据库工作台。"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="开源与许可" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="项目开源地址："/>
                        <Hyperlink NavigateUri="https://github.com/joolan/LitSSHmcp" RequestNavigate="OnRequestNavigate">https://github.com/joolan/LitSSHmcp</Hyperlink>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="许可证：本项目采用 "/>
                        <Run FontWeight="SemiBold" Text="MIT 许可证（MIT License）"/>
                        <Run Text="，可自由使用、修改、分发与商用，请保留原始版权与许可声明。"/>
                    </TextBlock>
                    <TextBlock Text="Copyright (c) 2026 LitSSH" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="MCP 核心能力（AI 可调用的工具）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6"
                               Text="通过 Model Context Protocol（stdio）向任意 MCP 客户端暴露 36 个默认外部工具（另有 1 个宿主内部审批工具），覆盖以下能力域（可在「工具分组」按部署裁剪）："/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• SSH 运维：命令执行、sudo 提权、连接测试/状态、批量与目录文件上传下载、目录浏览。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 数据源：MySQL / PostgreSQL 只读查询、执行计划、写操作与诊断（连接数/慢查询/锁/复制），Redis 只读与写/管理命令、诊断；支持直连或 SSH 隧道，密码仅本机保存、不暴露给 AI。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 容器与服务：Docker 容器/镜像/日志/inspect/stats，systemd 服务状态与日志。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 本机终端：local_shell 在硬白名单内执行本机 CLI（逐次人工审批），支持多终端并行与按 cursor 增量读取输出。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 日志与 Java：按关键字/正则检索日志、发现日志文件，Java 进程/线程栈/堆内存/JVM 信息。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 快照与拓扑：整机快照（资源/端口进程服务/证书/Docker/systemd/安全巡检），资产拓扑总览、依赖查询与自动发现，以及图查询（搜索 / 邻域 / 有向链路 / 影响面 / 证据解释）与拓扑时间线、快照 Diff。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 聚合体检：按应用聚合所在服务器进程/容器/端口与依赖数据源的连通性，支撑全链路排障。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 安全与审计：命令/SQL 过滤、敏感操作桌面审批、文件传输路径白名单、TOFU 主机密钥校验、按目标限流，全部操作写入 HMAC-SHA256 哈希链审计。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• MCP 资源（Resources）：以只读方式向 MCP 客户端暴露服务器清单 / 数据源清单 / 使用指南 / 资产拓扑 / 最新快照概览（litssh:// 资源与模板），供浏览与挂载为上下文；不含密码、禁用项排除，按启用的工具分组裁剪。"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="桌面 App 核心功能" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 主页看板：快捷入口 + 服务器/数据源/应用统计，支持 AI 快捷提问（含附件）。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 服务器管理：表格增删改查与排序、右键菜单（连接/编辑/采集快照/快照历史/删除），独立「SSH 会话管理」窗口含交互式终端（同一服务器最多 4 个，内置 SFTP 文件可视化上传/下载）。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 服务器连接增强：跳板机（ProxyJump，经另一台已配置服务器中转）、SSH 密钥生成（ed25519 / rsa，公钥一键复制）、凭据轮换提醒。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 远程桌面：RDP / VNC 连接管理（密码仅本机 DPAPI 加密、可经 SSH 隧道访问内网桌面），内嵌多标签查看器（标签可分离 / 收回）与外部客户端打开。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 本机终端：ConPTY 真实本机 PowerShell 终端；AI 本地 CLI 在白名单内执行本机命令（人工审批、超时与进程树清理），单个 AI 会话最多并行管理 4 个独立终端。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 批量执行 / 快速命令：多台服务器并行下发命令；内置快速命令（一键巡检、磁盘/inode/内存/端口/进程/大目录/日志/容器/网络）与「一键巡检」，写操作执行前确认。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 数据源 / 应用管理 + 数据库工作台：维护数据源与应用；工作台支持 SQL 查询/对象浏览/表数据分页预览、Redis 键浏览（分批扫描、补全类型/TTL/大小、DB 切换、大结果集警告）、只读/写入模式与审计。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 资产拓扑：可视化编辑——拖动/缩放节点、拖拽创建关系、自动正交避障连线、网格吸附、撤销重做、导出图片。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 快照：整机态势采集 + 历史查看 + 趋势图（内存 / 磁盘 / Swap / 负载）。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 终端录像：交互式终端会话以 asciicast 记录并支持倍速回放（合规/复盘）。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 触发事件：本机/远程动作流水线（Git / Webhook / 目录与数据库备份），定时与同步事件触发，附「总览」编排可视化。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 审计日志：按服务器/数据源/会话/用户筛选与关键字检索、复制、导出 CSV、哈希链完整性校验（UserId 已纳入链）。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• AI 运维助手：内置大模型智能体，内嵌 MCP 客户端调用全部工具（审批/过滤/审计与第三方客户端一致），流式输出、多模型热切换、多会话、只读模式、Markdown 渲染、任务计划、长期记忆；思考过程展示、技能选择器、提示词模板、计划模式、工具级审批策略、用量/成本面板；智能体体系（通用聊天 / 运维专家 / 数据库分析，可自定义、按会话记忆）与系统提示软件变更护栏。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• Web 助手（浏览器端）：独立账号库与登录限速、会话级子进程隔离、流式聊天与实时审批、文件浏览下载、图片附件与全屏预览、会话级模型切换，桌面与 Web 会话进度轻量对账。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• MCP 工具说明：集中查看工具参数与路由并一键复制到提示词，与 docs/TOOLS.md 双向同步。"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="• 外观：基于 WPF-UI（Fluent）的现代界面，支持深色 / 浅色 / 跟随系统主题与强调色。"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="技术栈" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text=".NET 8（桌面 App、MCP 服务器与 Web 助手）· .NET 10（CLI）· WPF + WPF-UI（Fluent）· ASP.NET Core / Kestrel + WebSocket（Web 助手）· Microsoft.Extensions.AI + ModelContextProtocol SDK · OpenAI 兼容大模型（DeepSeek / 通义千问 / Kimi / 智谱 GLM / 硅基流动 / 本地 Ollama 等）· SSH.NET · MySQL / PostgreSQL / Redis 驱动 · SQLite（审计 / 快照 / 会话 / 拓扑 / 账号）· PBKDF2-SHA256 + DPAPI（密码 / 凭据加密）· AvalonEdit（SQL 编辑器）· RDP ActiveX / WebView2 + noVNC（远程桌面查看器）。"/>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"
                       Text="如有问题或建议，欢迎在 GitHub 仓库提交 Issue 或 Pull Request。"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
