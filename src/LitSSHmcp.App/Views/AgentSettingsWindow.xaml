<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AgentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        Title="AI 助手设置" Height="700" Width="900" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI 助手设置"/>

        <Grid Grid.Row="1" Margin="14,0,14,12">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="Tabs" Grid.Row="0">
                <!-- ===== Tab 1：助手设置（全局，所有模型/会话共用）===== -->
                <TabItem Header="助手设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                        <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="以下为『全局』设置：所有模型与会话共用，不随对话模型切换。外观（主题/强调色）见主程序「设置 → 外观」。"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="系统附加提示（可选）:"/><ui:TextBox FontWeight="Normal" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <TextBlock Text="技能根目录（空=用 %APPDATA%\LitSSH\skills 稳定目录，首次自动把随包 skills/ 复制过去；其下每个子目录一个技能，含 SKILL.md；该绝对路径会注入系统提示）:"/><ui:TextBox FontWeight="Normal" Text="{Binding SkillsDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="工作区目录（Agent 文档工具 ops_doc_* 只能在此读写；空=我的文档\LitSSH）:"/><ui:TextBox FontWeight="Normal" Text="{Binding WorkspaceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="MCP 服务器 exe 路径（空=自动探测 App 目录 mcp/）:"/><ui:TextBox FontWeight="Normal" Text="{Binding McpServerPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                <Separator Margin="0,8,0,8"/>
                                <TextBlock Text="上下文与输出" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="上下文保留条数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding ContextLimit, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,16,0"/>
                                    <TextBlock Text="上下文 token 上限:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding ContextTokenLimit, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,16,0"/>
                                    <TextBlock Text="最大工具轮数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding MaxToolIterations, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="冷启动/重载历史轮数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding ColdStartRecentTurns, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,8,0"/>
                                    <TextBlock Text="(仅向模型注入最近 N 轮，更早由滚动摘要代表；0=不限制。只影响模型上下文，界面仍可翻看全部)"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="回答风格:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ResponseStyles}" SelectedItem="{Binding ResponseStyle, Mode=TwoWay}" Width="120" Margin="6,0,16,0"/>
                                    <TextBlock Text="(concise=只讲重点 / standard / detailed)" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="单个工具结果注入上限(字符):" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding ToolResultMaxChars, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,16,0"/>
                                    <TextBlock Text="最大工具轮数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding MaxToolIterations, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="单轮墙钟预算(秒, 0=不限):" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BudgetMaxTurnSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,16,0"
                                                ToolTip="一条用户消息的完整工具循环超过该墙钟时间即停止本轮并提示，防止失控调用"/>
                                    <TextBlock Text="会话成本上限(¥, 0=不限):" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BudgetMaxSessionCost, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0"
                                                ToolTip="当前会话累计估算成本（按模型入/出价）达到上限后阻止发送；仅当所选模型已填价格时生效"/>
                                </StackPanel>
                                <CheckBox Content="自动摘要（裁剪旧轮次时压缩成摘要，按轮边界裁剪以保持工具配对）" IsChecked="{Binding AutoSummarize, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="精简工具描述（发送给模型时截短 MCP 工具描述以省 token，详见 mcp_usage_guide）" IsChecked="{Binding CompactToolDescriptions, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="大结果落盘（超出上限的工具结果存为 spill 句柄，模型按需分段读取）" IsChecked="{Binding SpillLargeToolResults, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="落盘目录（空=默认）:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding SpillDir, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="6,0,16,0"/>
                                    <TextBlock Text="保留天数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding SpillRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0"/>
                                </StackPanel>
                                <CheckBox Content="启用子代理（run_subagent：独立上下文的只读取证，只回摘要）" IsChecked="{Binding EnableSubAgent, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="只读模式（仅向模型暴露只读工具）" IsChecked="{Binding ReadOnly, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Margin="26,0,0,8" FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Text="只读模式保留的工具（按 MCP 只读注解 readOnlyHint）：查询/读取/诊断/巡检类——ssh_list_servers、ssh_get_server_status、ssh_get_sudo_status、ssh_test_connection、ssh_snapshot_get、ssh_get_command_history、ssh_list_files；datasource_list、datasource_test_connection、*_get_sql_history、mysql_query/mysql_explain/mysql_diagnostics、postgres_query/explain/diagnostics、redis_read/redis_diagnostics；docker_ps/logs/inspect/stats/images、service_query、log_query、java_processes/java_diagnostics、topology_get_overview/get_dependencies/discover、app_health_snapshot、mcp_usage_guide/self_check/list_sessions；以及本地只读工具（skill_list/read、spill_list/read/grep、ops_doc_read/list、update_plan、run_subagent）。不含执行/写入/审批类：ssh_execute_command/sudo、ssh_upload*/download*、mysql/postgres/redis 的 *_execute、docker_restart/exec、service_restart 等。"/>

                                <TextBlock Text="允许的工具分组（全勾 = 不限制）" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                <ItemsControl ItemsSource="{Binding ToolGroupOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Width="165" Margin="0,2,10,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="长期记忆 / RAG（远程 Embeddings 向量化，向量存本机 SQLite 并本地检索，可选）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}" Padding="8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="14" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource AppWarningBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Text="长期记忆为『全局共享』配置——所有模型与会话共用同一 Embeddings 端点/模型/Key，不随对话模型切换；请保持稳定，且向量模型维度要一致，否则历史向量将无法检索或报错。"/>
                                    </DockPanel>
                                </Border>
                                <CheckBox Content="启用长期记忆（历史会话 + 工作区文档向量检索）" IsChecked="{Binding MemoryEnabled}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MemoryConfigWarning}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppWarningBrush}"
                                           Visibility="{Binding HasMemoryConfigWarning, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Embeddings Endpoint（如 https://api.openai.com/v1）:"/><ui:TextBox FontWeight="Normal" Text="{Binding MemoryEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Embeddings 模型名（如 text-embedding-3-small / bge-m3）:"/><ui:TextBox FontWeight="Normal" Text="{Binding MemoryModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Embeddings API Key（留空复用对话模型 Key；本机加密存储）:"/><PasswordBox FontWeight="Normal" x:Name="MemoryApiKeyBox" PasswordChar="●" Margin="0,0,0,6" PasswordChanged="OnMemoryApiKeyChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="召回条数 TopK:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding MemoryTopK, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                    <ui:Button Content="测试 Embeddings" Padding="12,3" Margin="16,0,8,0" Click="OnTestEmbeddings"
                                               ToolTip="用当前页填写的端点/模型/Key 发起一次向量化请求（无需先保存）；Key 留空复用当前启用对话模型的 Key"/>
                                    <ui:Button Content="查看记忆统计" Padding="12,3" Click="OnMemoryStats"
                                               ToolTip="读取本机 agent.db 记忆库：总条数、按类别分布、已过时条数与库文件位置"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MemoryStatsText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" FontFamily="Consolas" FontSize="11"/>

                                <TextBlock Text="会话保留策略（0 = 不限）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="最多会话数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding RetentionMaxSessions, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                    <TextBlock Text="每会话消息上限:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding RetentionMaxMessages, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                    <TextBlock Text="保留天数:" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="本机终端（AI 执行本地 CLI）" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                <CheckBox Content="启用本机 CLI 工具（local_shell）— 默认关闭" IsChecked="{Binding LocalEnabled, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <TextBlock Text="Shell 路径（空=自动 pwsh/powershell）:" Margin="0,0,0,3"/>
                                <ui:TextBox FontWeight="Normal" Text="{Binding LocalShellPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="起始工作目录（空=用户主目录）:" Margin="0,0,0,3"/>
                                <ui:TextBox FontWeight="Normal" Text="{Binding LocalWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="CLI 白名单（每行一个；仅白名单内命令可执行，其余直接拒绝）:" Margin="0,0,0,3"/>
                                <ui:TextBox FontWeight="Normal" Text="{Binding LocalAllowedCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="命令超时(秒):" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding LocalTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                    <TextBlock Text="输出上限(字符):" VerticalAlignment="Center"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding LocalMaxOutputChars, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="已记住「总是允许」的命令（前缀匹配；逐条移除可恢复审批）:" Margin="0,6,0,3"/>
                                <ListBox ItemsSource="{Binding LocalAutoApproved}" MaxHeight="100" BorderThickness="0"
                                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <ui:Button Grid.Column="1" Content="移除" Padding="8,2" Margin="8,0,0,0"
                                                           Command="{Binding DataContext.RemoveAutoApprovedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 2：大模型设置（每个模型自身的参数）===== -->
                <TabItem Header="大模型设置">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="模型服务商（每家可挂多个模型）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="添加" Padding="12,3" Click="OnAdd"/>
                                    <TextBlock Text="(右键：删除/启停/测试连接)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ProviderList" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnProviderRightClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="删除" Click="OnRemove"/>
                                            <MenuItem Header="启用 / 停用" Click="OnToggleEnabled"/>
                                            <Separator/>
                                            <MenuItem Header="测试连接" Click="OnTestConnection"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="以下为『当前选中服务商』的配置：Endpoint/API Key/采样与重试等厂家级共享，其下可挂多个模型，各模型单独启用与配置视觉。"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="名称:"/><ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="服务商（选择后自动填写 Endpoint 与模型列表，之后只需填 API Key）:"/>
                                    <ComboBox ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                    <TextBlock Text="Endpoint（OpenAI 兼容基地址，可手动修改）:"/><ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                    <TextBlock Text="模型列表（勾选的模型会出现在「AI 运维助手 / 临时聊天」的模型下拉中，按厂家分组选择）:" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <ItemsControl ItemsSource="{Binding SelectedProvider.Models}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0" FontWeight="Normal" VerticalContentAlignment="Center"
                                                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="10,0,8,0"/>
                                                    <CheckBox Grid.Column="2" Content="支持视觉" IsChecked="{Binding SupportsVision, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              ToolTip="该模型是否可接收图片附件（不同模型能力不同，逐模型配置）"/>
                                                    <ui:TextBox Grid.Column="3" FontWeight="Normal" Width="46" Margin="0,0,4,0"
                                                                VerticalContentAlignment="Center"
                                                                Text="{Binding InputPrice, UpdateSourceTrigger=PropertyChanged}"
                                                                ToolTip="输入价格（每百万 token，用于成本估算；0=未填）"/>
                                                    <ui:TextBox Grid.Column="4" FontWeight="Normal" Width="46" Margin="0,0,8,0"
                                                                VerticalContentAlignment="Center"
                                                                Text="{Binding OutputPrice, UpdateSourceTrigger=PropertyChanged}"
                                                                ToolTip="输出价格（每百万 token，用于成本估算；0=未填）"/>
                                                    <ui:Button Grid.Column="5" Content="删除" Padding="8,2" Click="OnRemoveModel"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                        <ComboBox IsEditable="True" ItemsSource="{Binding SelectedPresetModelNames}"
                                                  Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="260" Height="28" Padding="10,4" FontWeight="Normal"
                                                  ToolTip="从预设候选选择，或手动输入任意模型名"/>
                                        <ui:Button Content="添加模型" Padding="10,3" Margin="6,0,0,0" Click="OnAddModel"/>
                                        <TextBlock Text="(下拉为该服务商预设候选，也可手输)" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="API Key（本机加密存储）:"/>
                                    <PasswordBox FontWeight="Normal" x:Name="ApiKeyBox" PasswordChar="●" Margin="0,0,0,6" PasswordChanged="OnApiKeyChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="temperature:" VerticalAlignment="Center"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.Temperature, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,16,0"/>
                                        <TextBlock Text="maxTokens(0=默认):" VerticalAlignment="Center"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.MaxTokens, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="超时(秒):" VerticalAlignment="Center"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                        <TextBlock Text="重试次数:" VerticalAlignment="Center"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.MaxRetries, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,16,0"/>
                                        <TextBlock Text="并发上限:" VerticalAlignment="Center"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedProvider.MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0"/>
                                    </StackPanel>
                                <TextBlock Text="提示：切换启用/停用会立即保存；其余字段修改后点右下角「保存」。"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ===== Tab 3：归档记录 ===== -->
                <TabItem Header="归档记录">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="12,4" Click="OnRefreshArchived"/>
                            <TextBlock Text="已归档的会话不会出现在会话列表中；可恢复到会话区或永久删除。"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}">
                            <ListBox x:Name="ArchiveList" ItemsSource="{Binding ArchivedSessions}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontFamily="Microsoft YaHei"/>
                                                <TextBlock Text="{Binding UpdatedText}" FontSize="10"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="恢复到会话区" Padding="10,3" Margin="0,0,6,0" Click="OnRestoreArchived"/>
                                                <ui:Button Content="删除" Padding="10,3" Click="OnDeleteArchived"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ===== Tab：记忆管理（浏览/按类别过滤/删除/清空；更换 Embeddings 模型前清空旧向量）===== -->
                <TabItem Header="记忆管理">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="类别:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding MemoryKindFilters}" SelectedItem="{Binding MemoryKindFilter, Mode=TwoWay}"
                                          Width="110" Margin="0,0,12,0"
                                          ToolTip="全部=不限；task=任务复盘 / script=脚本经验 / asset=资产经验 / raw=会话与文档片段"/>
                                <ui:Button Content="刷新" Padding="12,4" Margin="0,0,8,0" Click="OnReloadMemories"/>
                                <ui:Button Content="删除选中" Padding="12,4" Margin="0,0,8,0" Click="OnDeleteMemory"/>
                                <ui:Button Content="清空全部记忆" Padding="12,4" Click="OnClearMemory"
                                           ToolTip="删除记忆库全部条目（含会话片段/任务复盘/脚本/资产经验）。更换 Embeddings 模型或向量维度时必须清空，否则历史向量不可检索。需二次确认"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="记忆是 AI 的长期经验库（本机 agent.db）。删除单条用于纠错；更换 Embeddings 模型前请「清空全部」，否则旧维度向量无法检索。"/>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}">
                            <ListBox ItemsSource="{Binding MemoryEntries}" SelectedItem="{Binding SelectedMemoryEntry, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding Content}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontFamily="Microsoft YaHei"/>
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="10" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ===== Tab：智能体（可切换的角色设定：系统提示附加段 + 回答风格覆盖）===== -->
                <TabItem Header="智能体">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="智能体列表（预置 3 个，均可编辑/删除）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="添加" Padding="12,3" Click="OnAddAgent"/>
                                    <TextBlock Text="(点「删除」移除所选)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="AgentList" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BuiltinText}" FontSize="10"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="智能体只改变系统提示最末尾的『当前智能体』段（角色设定 + 可选风格覆盖），不改动工具与技能；主窗口与临时聊天可在模型下拉旁切换，且按会话记忆。"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="名称:"/><ui:TextBox FontWeight="Normal" Text="{Binding SelectedAgent.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="描述（列表展示，可空）:"/><ui:TextBox FontWeight="Normal" Text="{Binding SelectedAgent.Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="系统提示附加段（追加到『## 当前智能体』下；预置通用聊天可留空）:"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding SelectedAgent.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" VerticalScrollBarVisibility="Auto"
                                                FontFamily="Consolas" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="回答风格覆盖:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AgentStyleOptions}" SelectedItem="{Binding SelectedAgent.ResponseStyle, Mode=TwoWay}"
                                                  Width="130" Margin="6,0,16,0" ToolTip="空=跟随全局回答风格；选中后覆盖全局『回答风格』的篇幅规定（作用于该智能体）"/>
                                        <TextBlock Text="(空=跟随全局 / concise / standard / detailed)" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:Button Content="删除所选智能体" Padding="12,3" Click="OnRemoveAgent" HorizontalAlignment="Left"
                                               ToolTip="删除后引用它的会话下次打开时回退到全局默认智能体"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- ===== Tab：MCP 服务器（内置可停用；外部可增删，启用前必须连接校验通过）===== -->
                <TabItem Header="MCP 服务器">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="MCP 服务器列表（内置置顶，仅可启停）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="添加外部" Padding="12,3" Click="OnAddMcp"/>
                                    <TextBlock Text="(内置不可删)" VerticalAlignment="Center" FontSize="10" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcpServer}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="6" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeText}" FontSize="10"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="10"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="外部 MCP 由第三方实现：其工具**不经过本程序的审批/过滤/审计**（只读模式仅按其自报的 annotations.readOnlyHint 过滤）。启用前必须「校验连接」通过；校验失败也可保存（保持停用）。保存后关闭本窗口即重建连接。"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="名称:"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="类型:" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedMcpServer.TypeText}" Margin="6,0,16,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="传输:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding McpTransportOptions}"
                                                  SelectedItem="{Binding SelectedMcpServer.Transport, Mode=TwoWay}"
                                                  Width="110" Margin="6,0,16,0" IsEnabled="{Binding SelectedMcpServer.IsExternal}"
                                                  ToolTip="stdio=本机子进程（command/args/env）；http=远程 SSE / Streamable HTTP（url/headers）"/>
                                        <TextBlock Text="状态:" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedMcpServer.EnabledText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 内置条目：只说明来路，配置见「助手设置 → MCP 服务器 exe 路径」 -->
                                    <StackPanel Visibility="{Binding SelectedMcpServer.Builtin, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Text="内置 LitSSH MCP：本机 stdio 子进程，exe 路径在「助手设置 → MCP 服务器 exe 路径」配置；此处只能启用/停用（停用后 AI 将没有本机服务器/数据源等运维工具）。"/>
                                    </StackPanel>

                                    <!-- stdio（外部） -->
                                    <StackPanel Visibility="{Binding SelectedMcpServer.ShowStdio, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="command（可执行文件，绝对路径或 PATH 中的命令名）:"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.Command, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="例：npx 或 C:\tools\mcp\server.exe" Margin="0,0,0,6"/>
                                        <TextBlock Text="args（每行一个参数）:"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" FontFamily="Consolas" Margin="0,0,0,6"
                                                    PlaceholderText="例：&#10;-y&#10;@modelcontextprotocol/server-filesystem&#10;C:\data"/>
                                        <TextBlock Text="env（每行 KEY=VALUE，值按当前 Windows 用户 DPAPI 加密保存）:"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.EnvText, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" FontFamily="Consolas" Margin="0,0,0,6"
                                                    PlaceholderText="例：API_KEY=xxxx"/>
                                    </StackPanel>

                                    <!-- http（外部） -->
                                    <StackPanel Visibility="{Binding SelectedMcpServer.ShowHttp, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="url（http:// 或 https:// 端点，支持 SSE / Streamable HTTP）:"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.Url, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="例：https://mcp.example.com/mcp" Margin="0,0,0,6"/>
                                        <TextBlock Text="headers（每行 Name: Value，值按当前 Windows 用户 DPAPI 加密保存）:"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedMcpServer.HeadersText, UpdateSourceTrigger=PropertyChanged}"
                                                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" FontFamily="Consolas" Margin="0,0,0,6"
                                                    PlaceholderText="例：Authorization: Bearer xxxx"/>
                                    </StackPanel>

                                    <Separator Margin="0,8,0,8"/>
                                    <TextBlock Text="{Binding SelectedMcpServer.ValidationText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="校验连接" Padding="12,4" Click="OnValidateMcp" Margin="0,0,8,0"
                                                   ToolTip="连接一次并列出工具数（15 秒超时），不改变启用状态"/>
                                        <ui:Button Content="{Binding SelectedMcpServer.EnableButtonText}" Padding="12,4" Click="OnToggleMcp" Margin="0,0,8,0"
                                                   ToolTip="外部 MCP 启用前必须校验通过；内置 MCP 直接启停"/>
                                        <ui:Button Content="删除" Padding="12,4" Click="OnRemoveMcp"
                                                   Visibility="{Binding SelectedMcpServer.IsExternal, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="删除所选外部 MCP（内置不可删）"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- ===== Tab：提示词模板（用户自定义斜杠快捷指令）===== -->
                <TabItem Header="提示词模板">
                    <views:PromptTemplatesView/>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="重新加载" Padding="12,4" Margin="0,0,6,0" Click="OnReload"/>
                    <ui:Button Content="保存" Padding="16,4" Appearance="Primary" Click="OnSave"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
