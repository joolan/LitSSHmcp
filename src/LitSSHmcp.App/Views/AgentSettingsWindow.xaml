<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AgentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI 助手设置" Height="700" Width="900" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI 助手设置"/>

        <Grid Grid.Row="1" Margin="14,0,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">
                <!-- ===== Tab 1：助手设置（全局，所有模型/会话共用）===== -->
                <TabItem Header="助手设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                        <Border Style="{DynamicResource CardBorderStyle}" MaxWidth="700" HorizontalAlignment="Left">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="以下为『全局』设置：所有模型与会话共用，不随对话模型切换。"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="界面主题:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Width="140" Margin="6,0,10,0"/>
                                    <TextBlock Text="(system=跟随系统 / light / dark)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="强调色:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent, Mode=TwoWay}" Width="140" Margin="6,0,10,0"/>
                                    <TextBlock Text="(影响主按钮/选中高亮)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Text="系统附加提示（可选）:"/><ui:TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <TextBlock Text="技能目录（空=用内置 litssh-mcp-ops-skill）:"/><ui:TextBox Text="{Binding SkillsDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="工作区目录（Agent 文档工具 ops_doc_* 只能在此读写；空=我的文档\LitSSH）:"/><ui:TextBox Text="{Binding WorkspaceDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="MCP 服务器 exe 路径（空=自动探测 App 目录 mcp/）:"/><ui:TextBox Text="{Binding McpServerPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>

                                <Separator Margin="0,8,0,8"/>
                                <TextBlock Text="上下文与输出" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="上下文保留条数:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding ContextLimit, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,16,0"/>
                                    <TextBlock Text="上下文 token 上限:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding ContextTokenLimit, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,16,0"/>
                                    <TextBlock Text="最大工具轮数:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding MaxToolIterations, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="回答风格:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ResponseStyles}" SelectedItem="{Binding ResponseStyle, Mode=TwoWay}" Width="120" Margin="6,0,16,0"/>
                                    <TextBlock Text="(concise=只讲重点 / standard / detailed)" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="单个工具结果注入上限(字符):" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding ToolResultMaxChars, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0"/>
                                </StackPanel>
                                <CheckBox Content="自动摘要（裁剪旧轮次时压缩成摘要，按轮边界裁剪以保持工具配对）" IsChecked="{Binding AutoSummarize, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="精简工具描述（发送给模型时截短 MCP 工具描述以省 token，详见 mcp_usage_guide）" IsChecked="{Binding CompactToolDescriptions, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="大结果落盘（超出上限的工具结果存为 spill 句柄，模型按需分段读取）" IsChecked="{Binding SpillLargeToolResults, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="落盘目录（空=默认）:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding SpillDir, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="6,0,16,0"/>
                                    <TextBlock Text="保留天数:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding SpillRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0"/>
                                </StackPanel>
                                <CheckBox Content="启用子代理（run_subagent：独立上下文的只读取证，只回摘要）" IsChecked="{Binding EnableSubAgent, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <CheckBox Content="只读模式（仅向模型暴露只读工具）" IsChecked="{Binding ReadOnly, Mode=TwoWay}" Margin="0,0,0,6"/>

                                <TextBlock Text="允许的工具分组（全勾 = 不限制）" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                <ItemsControl ItemsSource="{Binding ToolGroupOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Width="165" Margin="0,2,10,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="长期记忆 / RAG（Embeddings + 本地向量检索，可选）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}" Padding="8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="14" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource AppWarningBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Text="长期记忆为『全局共享』配置——所有模型与会话共用同一 Embeddings 端点/模型/Key，不随对话模型切换；请保持稳定，且向量模型维度要一致，否则历史向量将无法检索或报错。"/>
                                    </DockPanel>
                                </Border>
                                <CheckBox Content="启用长期记忆（历史会话 + 工作区文档向量检索）" IsChecked="{Binding MemoryEnabled}" Margin="0,0,0,4"/>
                                <TextBlock Text="Embeddings Endpoint（如 https://api.openai.com/v1）:"/><ui:TextBox Text="{Binding MemoryEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Embeddings 模型名（如 text-embedding-3-small / bge-m3）:"/><ui:TextBox Text="{Binding MemoryModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <TextBlock Text="Embeddings API Key（留空复用对话模型 Key；本机加密存储）:"/><ui:TextBox Text="{Binding MemoryApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="召回条数 TopK:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding MemoryTopK, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="会话保留策略（0 = 不限）" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="最多会话数:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding RetentionMaxSessions, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                    <TextBlock Text="每会话消息上限:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding RetentionMaxMessages, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                    <TextBlock Text="保留天数:" VerticalAlignment="Center"/>
                                    <ui:TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 2：大模型设置（每个模型自身的参数）===== -->
                <TabItem Header="大模型设置">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="大模型接入（可多模型）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="添加" Padding="12,3" Click="OnAdd"/>
                                    <TextBlock Text="(右键：删除/启停/测试连接)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ProviderList" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnProviderRightClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="删除" Click="OnRemove"/>
                                            <MenuItem Header="启用 / 停用" Click="OnToggleEnabled"/>
                                            <Separator/>
                                            <MenuItem Header="测试连接" Click="OnTestConnection"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{DynamicResource CardBorderStyle}" MaxWidth="560" HorizontalAlignment="Left">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="以下为『当前选中模型自身』的参数，每个模型独立保存。"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="名称:"/><ui:TextBox Text="{Binding SelectedProvider.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="类型（openai=OpenAI 兼容端点）:"/><ui:TextBox Text="{Binding SelectedProvider.Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Endpoint（如 https://api.deepseek.com/v1）:"/><ui:TextBox Text="{Binding SelectedProvider.Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="模型名 model（如 deepseek-chat）:"/><ui:TextBox Text="{Binding SelectedProvider.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Text="API Key（本机加密存储）:"/>
                                    <PasswordBox x:Name="ApiKeyBox" PasswordChar="●" Margin="0,0,0,6" PasswordChanged="OnApiKeyChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="temperature:" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding SelectedProvider.Temperature, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,16,0"/>
                                        <TextBlock Text="maxTokens(0=默认):" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding SelectedProvider.MaxTokens, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="超时(秒):" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding SelectedProvider.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0"/>
                                        <TextBlock Text="重试次数:" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding SelectedProvider.MaxRetries, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,16,0"/>
                                        <TextBlock Text="并发上限:" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding SelectedProvider.MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="提示：切换启用/停用会立即保存；其余字段修改后点右下角「保存」。"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="重新加载" Padding="12,4" Margin="0,0,6,0" Click="OnReload"/>
                    <ui:Button Content="保存" Padding="16,4" Appearance="Primary" Click="OnSave"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
