<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="AI 运维助手" Height="840" Width="1280" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 复用：hover 显示但不撑开（常占位、仅切透明度/命中） -->
        <Style x:Key="HoverRevealStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid AllowDrop="True" DragOver="OnComposerDragOver" Drop="OnComposerDrop" PreviewKeyDown="OnWindowPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title=""/>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：会话侧栏 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,12">
                    <TextBlock Text="AI 运维助手" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <Button Style="{DynamicResource ActionRowButton}" Padding="4" Margin="6,0,0,0"
                            Click="OnOpenSettings" ToolTip="AI 助手设置">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15"/>
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Top" Style="{DynamicResource ActionRowButton}" HorizontalAlignment="Stretch"
                        Margin="0,0,0,2" Command="{Binding NewSessionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="新建任务" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Top" Style="{DynamicResource ActionRowButton}" HorizontalAlignment="Stretch"
                        Margin="0,0,0,14" Click="OnOpenWorkspace">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="打开工作区" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock DockPanel.Dock="Top" Text="{Binding Sessions.Count, StringFormat='会话 ({0})'}"
                           FontWeight="SemiBold" Margin="4,2,0,6"/>
                <ui:TextBox FontWeight="Normal" DockPanel.Dock="Top" Margin="0,0,0,8" PlaceholderText="搜索会话…"
                            Text="{Binding SessionFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox x:Name="SessionList" ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="OnSessionListRightClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="10"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名" Click="OnRenameSession"/>
                            <MenuItem Header="归档" Click="OnArchiveSession"/>
                            <MenuItem Header="删除" Click="OnDeleteSession"/>
                            <Separator/>
                            <MenuItem Header="打开工作区文件夹" Click="OnOpenWorkspace"/>
                            <Separator/>
                            <MenuItem Header="清空显示" Click="OnClearDisplay"/>
                            <MenuItem Header="导出 Markdown" Click="OnExport"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：对话 -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 任务计划卡片 -->
                <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8"
                        Visibility="{Binding PlanVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding PlanHeader}" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Plan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource AppSuccessBrush}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Turns}" Margin="4,2,8,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,16" HorizontalAlignment="Stretch">
                                    <!-- 用户气泡：气泡仅包消息；时间/操作在气泡外一行，常占位不下撑 -->
                                    <Border Background="Transparent">
                                        <StackPanel>
                                            <Border Style="{DynamicResource UserBubbleStyle}" Cursor="Hand" MouseLeftButtonUp="OnUserClick"
                                                    ToolTip="点击展开/折叠本轮工具过程">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13"/>
                                                    <ItemsControl ItemsSource="{Binding Images}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="6" Margin="0,0,6,6" Cursor="Hand" MouseLeftButtonUp="OnPreviewImage"
                                                                        ToolTip="点击查看大图" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                                    <controls:ImageThumb SourcePath="{Binding}" Width="150" Height="100"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Style="{StaticResource HoverRevealStyle}" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding UserTime}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ui:Button Appearance="Transparent" Padding="4" ToolTip="重发"
                                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                                           Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Appearance="Transparent" Padding="4" ToolTip="编辑（载入输入框）"
                                                           Icon="{ui:SymbolIcon Edit24}" Click="OnEditTurn"/>
                                                <ui:Button Appearance="Transparent" Padding="4" ToolTip="复制"
                                                           Icon="{ui:SymbolIcon Copy24}" Click="OnCopyUserMessage"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 工具过程 -->
                                    <Expander Visibility="{Binding ToolsVisibility}" IsExpanded="{Binding ShowTools, Mode=TwoWay}"
                                              Margin="0,10,0,0" Padding="6">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding ToolHeader}" FontSize="11" Foreground="{DynamicResource AppWarningBrush}"/>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander Margin="0,3" Padding="4">
                                                            <Expander.Header>
                                                                <DockPanel LastChildFill="False" MinWidth="380">
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontWeight="SemiBold" FontSize="11">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tail}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                                                <ui:Button Content="重试" FontSize="10" Padding="8,1" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                           Visibility="{Binding RetryVisibility}"
                                                                           Command="{Binding DataContext.RetryStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>

                                    <!-- 助手回答卡片 -->
                                    <Border Style="{DynamicResource AssistantCardStyle}" Margin="0,9,0,0"
                                            Visibility="{Binding AssistantVisibility}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Chat24" FontSize="15" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <controls:MarkdownBox Markdown="{Binding AssistantText}"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" FontSize="12"
                                                       Margin="0,3,0,0" Visibility="{Binding NoteVisibility}"/>
                                            <TextBlock Text="运行中…" Foreground="{DynamicResource AppAccentBrush}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding RunningVisibility}"/>
                                            <!-- hover 显示：复制 + 用时（常占位） -->
                                            <StackPanel Style="{StaticResource HoverRevealStyle}" Orientation="Horizontal" Margin="0,6,0,0">
                                                <ui:Button Appearance="Transparent" Padding="4" ToolTip="复制回答"
                                                           Icon="{ui:SymbolIcon Copy24}" Click="OnCopyAnswer"/>
                                                <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10"
                                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空态引导 -->
                <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="440">
                    <ui:SymbolIcon Symbol="Chat24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="开始与 AI 运维助手对话" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="用自然语言让它查整机态势、排障、看日志、执行运维操作。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="例如：看下该服务器整机态势 / 排查 nginx 502" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                </Grid>

                <!-- 集成式输入区（可拖高） -->
                <Border Grid.Row="2" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusL}" Padding="10" Margin="0,10,0,0"
                        AllowDrop="True" PreviewDragOver="OnComposerDragOver" PreviewDrop="OnComposerDrop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部拖拽把手：调整输入区高度 -->
                        <Thumb Grid.Row="0" Height="6" HorizontalAlignment="Stretch" Cursor="SizeNS" Background="Transparent"
                               ToolTip="拖动调整输入区高度" DragDelta="OnComposerResize">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!-- 附件芯片（有附件时显示） -->
                        <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="True"
                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource ActionRowButton}" Padding="6,2" Margin="8,0,0,6"
                                    VerticalAlignment="Top" Click="OnClearAttachments" ToolTip="清除全部附件">
                                <TextBlock Text="清除全部" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="6,4" Margin="0,0,6,6"
                                            Cursor="Hand" MouseLeftButtonUp="OnPreviewAttachment" ToolTip="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:ImageThumb SourcePath="{Binding Path}" Width="24" Height="24" Margin="0,0,6,0">
                                                <controls:ImageThumb.Style>
                                                    <Style TargetType="controls:ImageThumb">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:ImageThumb.Style>
                                            </controls:ImageThumb>
                                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                            <Button Style="{DynamicResource ActionRowButton}" Padding="2" Margin="6,0,0,0"
                                                    Click="OnRemoveAttachment" ToolTip="移除">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <ui:TextBox FontWeight="Normal" x:Name="InputBox" Grid.Row="2" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" MinHeight="64" MaxHeight="400" TextWrapping="Wrap"
                                    BorderThickness="0" Background="Transparent"
                                    VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei" FontSize="13"
                                    PreviewKeyDown="OnInputKeyDown"
                                    AllowDrop="True" PreviewDragOver="OnComposerDragOver" PreviewDrop="OnComposerDrop"
                                    PlaceholderText="今天帮你做些什么？"
                                    ToolTip="Enter 发送；Shift+Enter 换行；可拖入图片/文档或 Ctrl+V 粘贴图片"/>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Appearance="Transparent" Padding="6" ToolTip="更多（清空显示 / 导出 / 设置）"
                                       Icon="{ui:SymbolIcon Add24}" Click="OnComposerMore">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="添加图片…" Click="OnAddImage"/>
                                        <MenuItem Header="添加文件…" Click="OnAddFile"/>
                                        <MenuItem Header="清除全部附件" Click="OnClearAttachments"/>
                                        <Separator/>
                                        <MenuItem Header="清空显示" Click="OnClearDisplay"/>
                                        <MenuItem Header="导出 Markdown" Click="OnExport"/>
                                        <Separator/>
                                        <MenuItem Header="AI 助手设置" Click="OnOpenSettings"/>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>

                            <!-- 上下文占用：环形进度，悬浮看详情 -->
                            <Border Grid.Column="1" Width="22" Height="22" Background="Transparent" Margin="12,0,8,0"
                                    VerticalAlignment="Center" ToolTip="{Binding ContextInfo}">
                                <controls:ContextRing Percent="{Binding ContextPercent}"/>
                            </Border>

                            <ui:Button Grid.Column="3" Content="取消编辑" Padding="10,4" Margin="0,0,8,0"
                                       Command="{Binding CancelEditCommand}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

                            <!-- 模型连接状态点 -->
                            <Ellipse Grid.Column="4" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="{Binding StatusMessage}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModelStatus}" Value="ready">
                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModelStatus}" Value="connecting">
                                                <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModelStatus}" Value="error">
                                                <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <ComboBox Grid.Column="5" ItemsSource="{Binding ComboProviders}" SelectedItem="{Binding SelectedProvider}"
                                      DisplayMemberPath="Name" Width="180" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                      ToolTip="{Binding StatusMessage}"/>

                            <ui:Button Grid.Column="6" Appearance="Primary" Width="42" Height="34" Padding="0"
                                       Command="{Binding SendOrStopCommand}" ToolTip="{Binding SendButtonText}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Send24" FontSize="16">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:SymbolIcon Symbol="Stop24" FontSize="16">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
