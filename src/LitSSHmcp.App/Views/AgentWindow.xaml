<Window x:Class="LitSSHmcp.App.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="AI 运维助手" Height="800" Width="1200" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：会话列表 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="AI 助手设置" Width="96" Padding="6,3" Margin="0,0,6,0" Click="OnOpenSettings"/>
                <Button Content="新建" Width="56" Padding="6,3" Command="{Binding NewSessionCommand}"/>
            </StackPanel>
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4"
                     Text="{Binding SessionFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="按标题搜索会话"/>
            <ListBox x:Name="SessionList" ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}"
                     DisplayMemberPath="Title">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSessionRightClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名" Click="OnRenameSession"/>
                        <MenuItem Header="删除" Click="OnDeleteSession"/>
                        <Separator/>
                        <MenuItem Header="打开工作区文件夹" Click="OnOpenWorkspace"/>
                        <Separator/>
                        <MenuItem Header="清空显示" Click="OnClearDisplay"/>
                        <MenuItem Header="导出 Markdown" Click="OnExport"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E5E5E5"/>

        <!-- 右：对话 -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 任务计划（update_plan 驱动；深色更醒目） -->
            <Expander Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding PlanVisibility}" IsExpanded="True"
                      BorderThickness="0" Padding="8,4" Background="#2F3640" Foreground="White">
                <Expander.Header>
                    <TextBlock Text="{Binding PlanHeader}" Foreground="White" FontWeight="SemiBold"/>
                </Expander.Header>
                <Border Background="#3B4252" Padding="8,6" CornerRadius="3">
                    <ItemsControl ItemsSource="{Binding Plan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Glyph}" Width="18" Foreground="#A3BE8C"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#ECEFF4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Expander>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Background="#FAFAFA">
                <ItemsControl ItemsSource="{Binding Turns}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,7" HorizontalAlignment="Stretch">
                                <!-- 用户指令（点击展开/折叠本轮工具过程） -->
                                <Border HorizontalAlignment="Right" Background="#D6E9FF" CornerRadius="6"
                                        Padding="9,7" Cursor="Hand" MouseLeftButtonUp="OnUserClick"
                                        ToolTip="点击展开/折叠本轮工具过程">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13"/>
                                        <DockPanel Margin="0,3,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="重发" FontSize="10" Padding="6,0,6,0" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="重新生成这一轮的回答"/>
                                                <Button Content="编辑" FontSize="10" Padding="6,0,6,0"
                                                        Click="OnEditTurn" ToolTip="编辑该指令并重发（会替换其后的对话）"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UserTime}" FontSize="10" Foreground="#5A6B7A"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 工具过程（运行中展开，完成后自动折叠） -->
                                <Expander Visibility="{Binding ToolsVisibility}" IsExpanded="{Binding ShowTools, Mode=TwoWay}"
                                          Margin="0,4,0,0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="6">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding ToolHeader}" FontSize="11" Foreground="#7A6000"/>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Margin="0,2" BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="4">
                                                        <Expander.Header>
                                                            <DockPanel LastChildFill="False" MinWidth="360">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontWeight="SemiBold" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#7A6000"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#0A66C2"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Tail}" FontSize="10" Foreground="Gray"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas"
                                                                       FontSize="11" Foreground="#444"/>
                                                            <Button Content="重试" FontSize="10" Padding="8,1" HorizontalAlignment="Left"
                                                                    Margin="0,4,0,0" Visibility="{Binding RetryVisibility}"
                                                                    Command="{Binding DataContext.RetryStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>

                                <!-- 助手回答 -->
                                <Border Visibility="{Binding AssistantVisibility}" HorizontalAlignment="Stretch"
                                        Background="#F2F2F2" CornerRadius="6" Padding="9,7" Margin="0,4,0,0">
                                    <StackPanel>
                                        <controls:MarkdownBox Markdown="{Binding AssistantText}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="#C0392B" TextWrapping="Wrap" FontSize="12"
                                                   Margin="0,3,0,0" Visibility="{Binding NoteVisibility}"/>
                                        <TextBlock Text="运行中…" Foreground="#0A66C2" FontSize="11" Margin="0,2,0,0"
                                                   Visibility="{Binding RunningVisibility}"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right" Content="复制" FontSize="10" Padding="6,0,6,0"
                                                    Margin="6,0,0,0" Click="OnCopyAnswer" ToolTip="复制本条回答"/>
                                            <TextBlock Text="{Binding Footer}" Foreground="Gray" FontSize="10"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,6,0,0">
                    <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ContextInfo}" Foreground="#888" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="取消编辑" Width="80" Padding="8,4" Margin="6,0,0,0"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Left" Text="模型:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                              DisplayMemberPath="Name" HorizontalAlignment="Left" Width="260" VerticalContentAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" MinHeight="52" MaxHeight="140" Padding="5"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                             KeyDown="OnInputKeyDown"
                             ToolTip="Enter 发送，Shift+Enter 换行"/>
                    <Button Grid.Column="1" Content="{Binding SendButtonText}" Width="70" Margin="6,0,0,0"
                            Command="{Binding SendOrStopCommand}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
