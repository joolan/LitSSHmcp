<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="AI 运维助手" Height="820" Width="1240" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI 运维助手"/>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：会话侧栏 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="AI 助手设置" Padding="10,4" Margin="0,0,6,0" Click="OnOpenSettings"/>
                    <ui:Button Content="新建" Padding="12,4" Appearance="Primary" Command="{Binding NewSessionCommand}"/>
                </StackPanel>
                <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,8" PlaceholderText="搜索会话…"
                            Text="{Binding SessionFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox x:Name="SessionList" ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnSessionRightClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontFamily="Microsoft YaHei"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名" Click="OnRenameSession"/>
                            <MenuItem Header="删除" Click="OnDeleteSession"/>
                            <Separator/>
                            <MenuItem Header="打开工作区文件夹" Click="OnOpenWorkspace"/>
                            <Separator/>
                            <MenuItem Header="清空显示" Click="OnClearDisplay"/>
                            <MenuItem Header="导出 Markdown" Click="OnExport"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource AppBorderBrush}"/>

            <!-- 右：对话 -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 任务计划卡片 -->
                <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8"
                        Visibility="{Binding PlanVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding PlanHeader}" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Plan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource AppSuccessBrush}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Turns}" Margin="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8" HorizontalAlignment="Stretch">
                                    <!-- 用户气泡 -->
                                    <Border Style="{DynamicResource UserBubbleStyle}" Cursor="Hand" MouseLeftButtonUp="OnUserClick"
                                            ToolTip="点击展开/折叠本轮工具过程">
                                        <StackPanel>
                                            <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13"/>
                                            <DockPanel Margin="0,3,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:Button Content="重发" FontSize="10" Padding="8,1" Margin="0,0,4,0"
                                                               Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" ToolTip="重新生成这一轮的回答"/>
                                                    <ui:Button Content="编辑" FontSize="10" Padding="8,1"
                                                               Click="OnEditTurn" ToolTip="编辑该指令并重发（会替换其后的对话）"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UserTime}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 工具过程 -->
                                    <Expander Visibility="{Binding ToolsVisibility}" IsExpanded="{Binding ShowTools, Mode=TwoWay}"
                                              Margin="0,4,0,0" Padding="6">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding ToolHeader}" FontSize="11" Foreground="{DynamicResource AppWarningBrush}"/>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander Margin="0,3" Padding="4">
                                                            <Expander.Header>
                                                                <DockPanel LastChildFill="False" MinWidth="380">
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontWeight="SemiBold" FontSize="11">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tail}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                                                <ui:Button Content="重试" FontSize="10" Padding="8,1" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                           Visibility="{Binding RetryVisibility}"
                                                                           Command="{Binding DataContext.RetryStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>

                                    <!-- 助手回答卡片 -->
                                    <Border Style="{DynamicResource AssistantCardStyle}" Margin="0,4,0,0"
                                            Visibility="{Binding AssistantVisibility}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Chat24" FontSize="15" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <controls:MarkdownBox Markdown="{Binding AssistantText}"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" FontSize="12"
                                                       Margin="0,3,0,0" Visibility="{Binding NoteVisibility}"/>
                                            <TextBlock Text="运行中…" Foreground="{DynamicResource AppAccentBrush}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding RunningVisibility}"/>
                                            <DockPanel Margin="0,2,0,0">
                                                <ui:Button DockPanel.Dock="Right" Content="复制" FontSize="10" Padding="8,1" Margin="6,0,0,0"
                                                           Click="OnCopyAnswer" ToolTip="复制本条回答"/>
                                                <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空态引导 -->
                <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="420">
                    <ui:SymbolIcon Symbol="Chat24" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="开始与 AI 运维助手对话" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="用自然语言让它查整机态势、排障、看日志、执行运维操作。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="例如：看下该服务器整机态势 / 排查 nginx 502" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                </Grid>

                <!-- 输入区 -->
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="2,6,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ContextInfo}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ui:Button DockPanel.Dock="Right" Content="取消编辑" Padding="10,4" Margin="6,0,0,0"
                                   Command="{Binding CancelEditCommand}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock DockPanel.Dock="Left" Text="模型:" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Left" Width="280" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" MinHeight="56" MaxHeight="150" TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                    KeyDown="OnInputKeyDown"
                                    PlaceholderText="输入指令…（Enter 发送，Shift+Enter 换行）"/>
                        <ui:Button Grid.Column="1" Content="{Binding SendButtonText}" Width="86" Height="56" Margin="8,0,0,0"
                                   Appearance="Primary" Command="{Binding SendOrStopCommand}"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
