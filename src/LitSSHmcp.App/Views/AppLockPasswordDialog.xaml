<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AppLockPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="应用锁密码" Height="330" Width="420" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="应用锁密码"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,0">
            <TextBlock x:Name="HeaderText" Text="设置密码" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock x:Name="OldLabel" Text="当前密码" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <PasswordBox FontWeight="Normal" x:Name="OldBox" Margin="0,0,0,10" KeyDown="OnBoxKeyDown"/>

            <TextBlock x:Name="NewLabel" Text="新密码（至少 6 位）" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <PasswordBox FontWeight="Normal" x:Name="NewBox" Margin="0,0,0,10" KeyDown="OnBoxKeyDown"/>

            <TextBlock x:Name="ConfirmLabel" Text="确认新密码" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <PasswordBox FontWeight="Normal" x:Name="ConfirmBox" Margin="0,0,0,10" KeyDown="OnBoxKeyDown"/>

            <TextBlock x:Name="ErrorText" Text="" Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,14">
            <ui:Button Content="取消" Padding="14,5" IsCancel="True" Click="OnCancel"/>
            <ui:Button x:Name="OkButton" Content="确定" Appearance="Primary" Padding="14,5" Margin="8,0,0,0" Click="OnOk"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
