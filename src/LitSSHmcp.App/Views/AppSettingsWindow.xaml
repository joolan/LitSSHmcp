<ui:FluentWindow x:Class="LitSSHmcp.App.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:LitSSHmcp.App.Views"
        Title="设置" Height="820" Width="1100" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="设置"/>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppRadiusM}" Padding="8">
                <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                         SelectedIndex="{Binding SelectedIndex, ElementName=SettingsTabs, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="外观" Padding="12,10"/>
                    <ListBoxItem Content="终端" Padding="12,10"/>
                    <ListBoxItem Content="命令片段" Padding="12,10"/>
                    <ListBoxItem Content="安全设置" Padding="12,10"/>
                    <ListBoxItem Content="工具分组" Padding="12,10"/>
                    <ListBoxItem Content="导入 / 导出" Padding="12,10"/>
                    <ListBoxItem Content="存储维护" Padding="12,10"/>
                    <ListBoxItem Content="MCP 工具说明" Padding="12,10"/>
                    <ListBoxItem Content="关于" Padding="12,10"/>
                </ListBox>
            </Border>

            <TabControl x:Name="SettingsTabs" Grid.Column="1" Margin="12,0,0,0"
                        SelectedIndex="0" Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="外观">
                    <views:AppearanceSettingsView x:Name="AppearanceView"/>
                </TabItem>
                <TabItem Header="终端">
                    <views:TerminalSettingsView/>
                </TabItem>
                <TabItem Header="命令片段">
                    <views:SnippetEditorView/>
                </TabItem>
                <TabItem Header="安全设置">
                    <views:SecuritySettingsView x:Name="SecurityView"/>
                </TabItem>
                <TabItem Header="工具分组">
                    <views:ToolGroupsView x:Name="ToolGroupsView"/>
                </TabItem>
                <TabItem Header="导入 / 导出">
                    <views:ConfigTransferView x:Name="TransferView"/>
                </TabItem>
                <TabItem Header="存储维护">
                    <views:StorageSettingsView x:Name="StorageView"/>
                </TabItem>
                <TabItem Header="MCP 工具说明">
                    <views:McpToolsView/>
                </TabItem>
                <TabItem Header="关于">
                    <views:AboutView/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
