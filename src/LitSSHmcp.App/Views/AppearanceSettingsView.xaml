<UserControl x:Class="LitSSHmcp.App.Views.AppearanceSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="以下为整个 APP 的外观设置（所有窗口共用），切换即时生效。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="界面主题:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Width="160" Margin="6,0,10,0"/>
                    <TextBlock Text="(system=跟随系统 / light / dark)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="强调色:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent, Mode=TwoWay}" Width="160" Margin="6,0,10,0"/>
                    <TextBlock Text="(影响主按钮/选中高亮)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="重新加载" Padding="12,4" Margin="0,0,6,0" Click="OnReload"/>
                <ui:Button Content="保存" Padding="16,4" Appearance="Primary" Click="OnSave"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</UserControl>
