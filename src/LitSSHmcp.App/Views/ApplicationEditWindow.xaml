<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ApplicationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding WindowTitle}" Height="620" Width="460"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" MaxWidth="410" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="名称 *" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="类型 (java/nginx/docker/...)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Docker 容器名 (可选, type=docker 时填, 用于匹配容器)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                                ToolTip="与 'docker ps' 的 NAMES 一致；拓扑发现据此自动建立 应用→服务器 关系"/>

                    <TextBlock Text="应用路径 (可选, 部署目录/jar/可执行文件路径)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                                ToolTip="如 /opt/order/order.jar 或 /www/server/nginx；自动发现时会尝试推断并预填"/>

                    <TextBlock Text="主机 (可选)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="端口 (可选)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="日志路径 (每行一条, 可选; 供 log_tail/log_grep 按应用查日志)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding LogPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="52" FontFamily="Consolas" Margin="0,0,0,10"
                                ToolTip="如 /var/log/myapp/app.log 或 /opt/myapp/logs/；须在安全设置 security.logs.allowedPaths 白名单内"/>

                    <TextBlock Text="描述 (可选)" Margin="0,0,0,2"/>
                    <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="16,10,16,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Width="90" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                <ui:Button Content="保存" Width="90" Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
