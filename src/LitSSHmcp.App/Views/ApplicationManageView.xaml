<UserControl x:Class="LitSSHmcp.App.Views.ApplicationManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Apps24" FontSize="20" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock Text="应用" Style="{DynamicResource PageTitleStyle}"/>
                </DockPanel>
                <TextBlock Text="app: 拓扑节点；双击编辑"
                           Style="{DynamicResource PageSubtitleStyle}"/>
            </StackPanel>
            <ui:TextBox Grid.Column="1" Style="{DynamicResource PageSearchBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="搜索名称 / 主机 / 容器…" VerticalAlignment="Center"
                        AutomationProperties.Name="搜索应用"/>
        </Grid>

        <GroupBox Grid.Row="1" Header="应用" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding AddCommand}"/>
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding RefreshCommand}"/>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <ListView x:Name="AppList" ItemsSource="{Binding FilteredApplications}" SelectedItem="{Binding SelectedApplication}"
                              Padding="3" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                              ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑" Click="OnEditClick"/>
                                <Separator/>
                                <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="容器名" Width="140" DisplayMemberBinding="{Binding ContainerName}"/>
                                <GridViewColumn Header="主机" Width="160" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="端口" Width="70" DisplayMemberBinding="{Binding Port}"/>
                                <GridViewColumn Header="描述" Width="240" DisplayMemberBinding="{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding FilteredApplications.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="还没有应用" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="添加应用节点后，AI 与资产拓扑即可识别并管理它。"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                        <ui:Button Content="添加应用" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                   HorizontalAlignment="Center" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
