<UserControl x:Class="LitSSHmcp.App.Views.ApplicationManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LitSSHmcp.App;component/Themes/GroupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <controls:GroupLabelConverter x:Key="GroupLabel"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Grid.Row="0" Icon="Apps24" Title="应用"
                             Subtitle="app: 拓扑节点；双击编辑">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索名称 / 主机 / 容器" VerticalAlignment="Center"
                                AutomationProperties.Name="搜索应用"/>
                    <CheckBox Content="卡片视图" IsChecked="{Binding IsCardView}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="12,4"
                               Margin="8,0,0,0" Command="{Binding AddCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <Border Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource AppDangerSubtleBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
                        BorderThickness="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="重试" Padding="10,2" Margin="8,0,0,0"
                                   Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                    </DockPanel>
                </Border>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding RefreshCommand}"/>
            <ui:Button Content="列" Padding="12,4" Margin="0,0,6,6" Click="OnChooseColumns" ToolTip="显示/隐藏列"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="8">
            <Grid>
                <Grid>
                    <ListView x:Name="AppList" ItemsSource="{Binding GroupedApplications}" SelectedItem="{Binding SelectedApplication}"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                              Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                              ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True"
                              controls:GroupExpanderBehavior.StorageKey="application.groups">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑" Click="OnEditClick"/>
                                <Separator/>
                                <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource CollapsibleAssetGroupContainerStyle}"/>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="容器名" Width="140" DisplayMemberBinding="{Binding ContainerName}"/>
                                <GridViewColumn Header="主机" Width="160" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="端口" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="描述" Width="240" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="操作" Width="74">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Padding="5"
                                                           ToolTip="编辑" AutomationProperties.Name="编辑应用"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="5"
                                                           Foreground="{DynamicResource AppDangerBrush}" ToolTip="删除"
                                                           AutomationProperties.Name="删除应用"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding FilteredApplications}" MaxWidth="1000" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource CardBorderStyle}" Width="300" Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource AppAccentSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="10"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSubtitle}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Host}" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,8,0,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <Run Text="端口 "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding ContainerName, Mode=OneWay}"/>
                                                <Run Text=" · 分组 "/><Run Text="{Binding Group, Mode=OneWay, Converter={StaticResource GroupLabel}}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <ui:Button Content="编辑" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="删除" Padding="10,3" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource AppDangerBrush}"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding FilteredApplications.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="{Binding EmptyHint}"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="添加应用" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                       Command="{Binding AddCommand}"
                                       Visibility="{Binding ShowEmptyAction, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button Content="清空搜索" Icon="{ui:SymbolIcon Dismiss24}" Padding="14,5"
                                       Click="OnClearSearch"
                                       Visibility="{Binding ShowClearSearch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource AppCardBrush}" Opacity="0.72" Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
