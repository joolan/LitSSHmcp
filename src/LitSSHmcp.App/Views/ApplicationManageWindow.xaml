<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.ApplicationManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="应用管理" Height="480" Width="780"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="应用管理"/>
        <Grid Grid.Row="1">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="应用 (app: 拓扑节点)" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="添加" Command="{Binding AddCommand}" Width="64" Padding="6,4" Margin="0,0,6,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Width="64" Padding="6,4"/>
                </StackPanel>

                <ListView x:Name="AppList" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                          Padding="3" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                          ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Click="OnEditClick"/>
                            <MenuItem Header="删除" Click="OnDeleteClick"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="容器名" Width="140" DisplayMemberBinding="{Binding ContainerName}"/>
                            <GridViewColumn Header="主机" Width="160" DisplayMemberBinding="{Binding Host}"/>
                            <GridViewColumn Header="端口" Width="70" DisplayMemberBinding="{Binding Port}"/>
                            <GridViewColumn Header="描述" Width="240" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </GroupBox>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="4,6,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Grid>
    </Grid>
</ui:FluentWindow>
