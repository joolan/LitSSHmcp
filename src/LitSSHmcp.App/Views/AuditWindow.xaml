<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        xmlns:models="clr-namespace:LitSSHmcp.Core.Models;assembly=LitSSHmcp.Core"
        Title="审计日志" Height="800" Width="1600" MinWidth="1200"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:BooleanNotToVisibilityConverter x:Key="BoolNotToVis"/>

        <Style x:Key="AuditDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="AuditDetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="AuditCodeValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <DataTemplate DataType="{x:Type models:CommandAuditLog}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="时间" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="会话" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding SessionId}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="用户" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding UserDisplay}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="工具" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Tool}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="类型" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Category}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="服务器" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="状态" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="决策" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Decision}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="退出码" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding ExitCode}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="文件" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <TextBlock Text="命令" Style="{StaticResource AuditDetailLabel}"/>
                <Border Background="{DynamicResource AppCodeBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Command}" Style="{StaticResource AuditCodeValue}" Margin="0"/>
                </Border>
                <TextBlock Text="结果" Style="{StaticResource AuditDetailLabel}"/>
                <Border Background="{DynamicResource AppCodeBgBrush}" CornerRadius="4" Padding="8">
                    <TextBlock Text="{Binding Result}" Style="{StaticResource AuditCodeValue}" Margin="0"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:SqlAuditLog}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="时间" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="会话" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding SessionId}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="用户" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding UserDisplay}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="工具" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Tool}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="数据源" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding DataSourceName}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="类型" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Category}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="操作" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Operation}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="状态" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="决策" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding Decision}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="影响行数" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding RowsAffected}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="耗时" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding DurationMs, StringFormat='{}{0:F1} ms'}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <TextBlock Text="SQL / Redis 命令" Style="{StaticResource AuditDetailLabel}"/>
                <Border Background="{DynamicResource AppCodeBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Sql}" Style="{StaticResource AuditCodeValue}" Margin="0"/>
                </Border>
                <TextBlock Text="结果" Style="{StaticResource AuditDetailLabel}"/>
                <Border Background="{DynamicResource AppCodeBgBrush}" CornerRadius="4" Padding="8">
                    <TextBlock Text="{Binding Result}" Style="{StaticResource AuditCodeValue}" Margin="0"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:AuditSession}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="会话 ID" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding SessionId}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="客户端" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding ClientName}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="版本" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding ClientVersion}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="归属用户" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding OwnerUserId}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="首次活动" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="最近活动" Width="72" Style="{StaticResource AuditDetailLabel}"/>
                    <TextBlock Text="{Binding LastSeenAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource AuditDetailValue}" Margin="0"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="审计日志"/>

        <controls:PageHeader Grid.Row="1" Margin="10,8,10,0" Icon="History24" Title="审计日志"
                             Subtitle="命令 / SQL / 会话审计 · 哈希链可校验">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="导出 CSV" Icon="{ui:SymbolIcon Save24}" Padding="12,4" Margin="0,0,8,0"
                               Click="OnExport"/>
                    <ui:Button Content="校验完整性" Icon="{ui:SymbolIcon ShieldCheckmark24}" Padding="12,4" Margin="0,0,8,0"
                               Click="OnVerify" ToolTip="校验审计哈希链：检测审计记录是否被篡改/删除"/>
                    <ui:Button Content="重置" Padding="12,4" Margin="0,0,8,0" Click="OnReset"/>
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Padding="12,4"
                               Click="OnRefresh"/>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="2">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:TextBox x:Name="KeywordBox" Width="260" Margin="0,0,12,6"
                            PlaceholderText="命令 / SQL / 服务器 / 会话 / 用户…"
                            KeyDown="OnFilterKeyDown"/>
                <TextBlock Text="服务器/数据源 ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:TextBox x:Name="FilterBox" Width="180" Margin="0,0,12,6"
                            ToolTip="按服务器 ID 或数据源 ID 过滤"
                            KeyDown="OnFilterKeyDown"/>
                <TextBlock Text="会话 ID:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:TextBox x:Name="SessionBox" Width="220" Margin="0,0,12,6"
                            ToolTip="只显示某个 MCP 会话产生的记录；当前会话 ID 见 mcp_self_check 输出"
                            KeyDown="OnFilterKeyDown"/>
                <TextBlock Text="条数:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:TextBox x:Name="LimitBox" Width="64" Text="200" Margin="0,0,0,6"
                            KeyDown="OnFilterKeyDown"/>
            </WrapPanel>

            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="类型:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedIndex="{Binding CategoryIndex}" Width="132" Margin="0,0,12,6"
                          ToolTip="按事件类型过滤: 全部 / 执行 / 审批拦截 / 只读探测 / 列表元数据 / 文件传输 / 本地工具"/>
                <CheckBox Content="含归档" IsChecked="{Binding IncludeHistory}" VerticalAlignment="Center" Margin="0,0,12,6"
                          ToolTip="包含超过保留天数、已移动到历史归档表的记录（永久保留）"/>
            </WrapPanel>

            <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" SelectionChanged="OnAuditTabChanged">
            <TabItem Header="命令审计">
                <Grid>
                <ListView x:Name="CommandList" ItemsSource="{Binding CommandLogs}" Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeMicro}"
                          SelectionChanged="OnAuditSelectionChanged"
                          PreviewMouseRightButtonDown="OnListPreviewRightClick" controls:GridViewSort.Enabled="True">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <GridViewColumn Header="会话" Width="180" DisplayMemberBinding="{Binding SessionId}"/>
                            <GridViewColumn Header="用户" Width="100" DisplayMemberBinding="{Binding UserDisplay}"/>
                            <GridViewColumn Header="工具" Width="160" DisplayMemberBinding="{Binding Tool}"/>
                            <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="服务器" Width="100" DisplayMemberBinding="{Binding ServerName}"/>
                            <GridViewColumn Header="命令" Width="320" DisplayMemberBinding="{Binding Command}"/>
                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="决策" Width="110" DisplayMemberBinding="{Binding Decision}"/>
                            <GridViewColumn Header="退出码" Width="60" DisplayMemberBinding="{Binding ExitCode}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasItems, ElementName=CommandList, Converter={StaticResource BoolNotToVis}}">
                    <ui:SymbolIcon Symbol="History24" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="暂无命令审计记录" Style="{DynamicResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="调整筛选条件，或点击刷新重新加载。" Style="{DynamicResource EmptyStateHintStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="SQL/Redis审计">
                <Grid>
                <ListView x:Name="SqlList" ItemsSource="{Binding SqlLogs}" Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeMicro}"
                          SelectionChanged="OnAuditSelectionChanged"
                          PreviewMouseRightButtonDown="OnListPreviewRightClick" controls:GridViewSort.Enabled="True">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <GridViewColumn Header="会话" Width="180" DisplayMemberBinding="{Binding SessionId}"/>
                            <GridViewColumn Header="用户" Width="100" DisplayMemberBinding="{Binding UserDisplay}"/>
                            <GridViewColumn Header="工具" Width="160" DisplayMemberBinding="{Binding Tool}"/>
                            <GridViewColumn Header="数据源" Width="120" DisplayMemberBinding="{Binding DataSourceName}"/>
                            <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="操作" Width="70" DisplayMemberBinding="{Binding Operation}"/>
                            <GridViewColumn Header="SQL/Redis命令" Width="320" DisplayMemberBinding="{Binding Sql}"/>
                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="决策" Width="110" DisplayMemberBinding="{Binding Decision}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasItems, ElementName=SqlList, Converter={StaticResource BoolNotToVis}}">
                    <ui:SymbolIcon Symbol="Database24" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="暂无 SQL / Redis 审计记录" Style="{DynamicResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="调整筛选条件，或点击刷新重新加载。" Style="{DynamicResource EmptyStateHintStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="会话">
                <Grid>
                <ListView x:Name="SessionsList" ItemsSource="{Binding Sessions}" Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeMicro}"
                          SelectionChanged="OnAuditSelectionChanged"
                          PreviewMouseRightButtonDown="OnListPreviewRightClick" controls:GridViewSort.Enabled="True">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="会话ID" Width="230" DisplayMemberBinding="{Binding SessionId}"/>
                            <GridViewColumn Header="客户端" Width="190" DisplayMemberBinding="{Binding ClientName}"/>
                            <GridViewColumn Header="版本" Width="100" DisplayMemberBinding="{Binding ClientVersion}"/>
                            <GridViewColumn Header="首次活动" Width="170" DisplayMemberBinding="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <GridViewColumn Header="最近活动" Width="170" DisplayMemberBinding="{Binding LastSeenAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasItems, ElementName=SessionsList, Converter={StaticResource BoolNotToVis}}">
                    <ui:SymbolIcon Symbol="Server24" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="暂无会话记录" Style="{DynamicResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="MCP 客户端建立会话后，这里会显示会话信息。" Style="{DynamicResource EmptyStateHintStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                </Grid>
            </TabItem>
            </TabControl>

            <Border x:Name="AuditDetailDrawer" Grid.Column="1" Width="380" Margin="8,0,0,0" Padding="12"
                    Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding HasSelectedAuditItem, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Padding="4"
                                   Appearance="Transparent" ToolTip="关闭详情" AutomationProperties.Name="关闭审计详情"
                                   Click="OnCloseAuditDetail"/>
                        <ui:Button DockPanel.Dock="Right" Content="复制" Padding="8,2" Margin="0,0,6,0"
                                   ToolTip="复制当前详情" Click="OnCopyAuditDetail"/>
                        <TextBlock Text="审计详情" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding SelectedAuditItem}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </Grid>
</Grid>
    </Grid>
</ui:FluentWindow>
