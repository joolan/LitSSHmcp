<Window x:Class="LitSSHmcp.App.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="审计日志" Height="620" Width="1200" MinWidth="960"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="筛选(服务器ID/数据源ID):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="FilterBox" VerticalContentAlignment="Center" MinWidth="140" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="命令关键字:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="KeywordBox" VerticalContentAlignment="Center" MinWidth="140" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="4" Text="条数:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="5" x:Name="LimitBox" Width="70" Text="200" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="6" Content="刷新" Width="70" Padding="6,4" Margin="0,0,6,0" Click="OnRefresh"/>
            <Button Grid.Column="7" Content="导出CSV" Width="90" Padding="6,4" Margin="0,0,6,0" Click="OnExport"/>
            <CheckBox Grid.Column="8" Content="含归档" IsChecked="{Binding IncludeHistory}" VerticalAlignment="Center" Margin="0,0,10,0"
                      ToolTip="包含超过保留天数、已移动到历史归档表的记录(永久保留)"/>
            <Button Grid.Column="9" Content="校验完整性" Width="100" Padding="6,4" Click="OnVerify"
                    ToolTip="校验审计哈希链: 检测审计记录是否被篡改/删除"/>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="命令审计">
                <ListView x:Name="CommandList" ItemsSource="{Binding CommandLogs}" Padding="3" FontFamily="Consolas" FontSize="11"
                          PreviewMouseRightButtonDown="OnListPreviewRightClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <GridViewColumn Header="服务器" Width="120" DisplayMemberBinding="{Binding ServerName}"/>
                            <GridViewColumn Header="命令" Width="420" DisplayMemberBinding="{Binding Command}"/>
                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="退出码" Width="60" DisplayMemberBinding="{Binding ExitCode}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="SQL/Redis审计">
                <ListView x:Name="SqlList" ItemsSource="{Binding SqlLogs}" Padding="3" FontFamily="Consolas" FontSize="11"
                          PreviewMouseRightButtonDown="OnListPreviewRightClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <GridViewColumn Header="数据源" Width="140" DisplayMemberBinding="{Binding DataSourceName}"/>
                            <GridViewColumn Header="操作" Width="70" DisplayMemberBinding="{Binding Operation}"/>
                            <GridViewColumn Header="SQL/Redis命令" Width="430" DisplayMemberBinding="{Binding Sql}"/>
                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,6,0,0" Foreground="Gray"/>
    </Grid>
</Window>
