<ui:FluentWindow x:Class="LitSSHmcp.App.Views.BackupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="备份历史" Height="560" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="备份历史"/>
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="12,4,12,8">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="12,4" Click="OnRefresh"/>
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="12,0,12,8">
            <ListView x:Name="HistoryList" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件" Width="380" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="时间" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="加密" Width="90" DisplayMemberBinding="{Binding EncryptedText}"/>
                        <GridViewColumn Header="路径" Width="240" DisplayMemberBinding="{Binding Path}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="12,0,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="校验完整性" Padding="12,4" Margin="0,0,6,0" Click="OnVerify"/>
                <ui:Button Content="恢复…" Padding="12,4" Margin="0,0,6,0" Click="OnRestore"/>
                <ui:Button Content="删除" Padding="12,4" Click="OnDelete"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
