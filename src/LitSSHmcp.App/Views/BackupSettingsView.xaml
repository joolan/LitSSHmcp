<UserControl x:Class="LitSSHmcp.App.Views.BackupSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="阿里云 OSS" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeSubtitle}"/>
                    <TextBlock Text="{Binding OssSecretHint}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Endpoint" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding OssEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="oss-cn-hangzhou.aliyuncs.com"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bucket" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding OssBucket, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AccessKeyId" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding OssAccessKeyId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AccessKeySecret" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="OssSecretBox" Height="34" Padding="8,4" PasswordChar="●"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OSS 前缀" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding OssPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <CheckBox Content="使用 HTTPS" IsChecked="{Binding OssUseHttps}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="保存 OSS 配置" Appearance="Primary" Padding="12,4" Margin="0,0,8,0" Click="OnSaveOss"/>
                    <ui:Button Content="测试 OSS 连接" Padding="12,4" Click="OnTestOss"/>
                </StackPanel>
                <Border Background="{DynamicResource AppWarningSubtleBrush}" BorderBrush="{DynamicResource AppWarningBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="10,8" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="提示：配置中的部分密钥使用 Windows DPAPI 本地用户加密，备份迁移到其他电脑或其他 Windows 用户后可能无法解密，需要重新填写。请妥善保管备份密码。"/>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="OSS 备份…" Padding="12,4" Margin="0,0,6,0" Click="OnOssBackups"/>
                <ui:Button Content="恢复向导" Padding="12,4" Margin="0,0,6,0" Click="OnRestore"/>
                <ui:Button Content="立即备份" Padding="12,4" Margin="0,0,6,0" Click="OnRunNow"/>
                <ui:Button Content="新建计划" Appearance="Primary" Padding="12,4" Click="OnAdd"/>
            </StackPanel>
            <TextBlock Text="定时备份计划" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeSubtitle}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}">
            <ListView x:Name="PlanList" ItemsSource="{Binding Plans}" BorderThickness="0" Background="Transparent"
                      SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                      MouseDoubleClick="OnPlanDoubleClick"
                      PreviewMouseRightButtonDown="OnPlanRightClick">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="立即备份" Click="OnRunNow"/>
                        <MenuItem Header="编辑…" Click="OnEdit"/>
                        <MenuItem Header="备份历史…" Click="OnHistory"/>
                        <Separator/>
                        <MenuItem Header="安装 Windows 计划任务" Click="OnInstallTask"/>
                        <MenuItem Header="移除 Windows 计划任务" Click="OnRemoveTask"/>
                        <Separator/>
                        <MenuItem Header="删除计划" Click="OnDelete"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="计划" Width="150" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="状态" Width="76" DisplayMemberBinding="{Binding EnabledText}"/>
                        <GridViewColumn Header="兜底" Width="84" DisplayMemberBinding="{Binding FallbackText}"/>
                        <GridViewColumn Header="调度" Width="150" DisplayMemberBinding="{Binding ScheduleText}"/>
                        <GridViewColumn Header="项目" Width="220" DisplayMemberBinding="{Binding ItemsText}"/>
                        <GridViewColumn Header="目标目录" Width="220" DisplayMemberBinding="{Binding TargetDirectory}"/>
                        <GridViewColumn Header="OSS" Width="90" DisplayMemberBinding="{Binding OssText}"/>
                        <GridViewColumn Header="上次运行" Width="190" DisplayMemberBinding="{Binding LastRunText}"/>
                        <GridViewColumn Header="下次运行" Width="160" DisplayMemberBinding="{Binding NextRunText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="4,8,4,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消备份" Padding="12,4" IsEnabled="{Binding IsRunning}" Click="OnCancel"/>
            </StackPanel>
            <ProgressBar Height="5" IsIndeterminate="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
