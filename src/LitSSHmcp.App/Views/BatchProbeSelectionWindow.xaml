<ui:FluentWindow x:Class="LitSSHmcp.App.Views.BatchProbeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择批量探测服务器" Height="560" Width="560" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="选择批量探测服务器"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12,8" Margin="16,8,16,8">
            <DockPanel>
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="全选" Padding="10,3" Margin="0,0,6,0" Command="{Binding SelectAllCommand}"/>
                    <ui:Button Content="清空" Padding="10,3" Command="{Binding ClearSelectionCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Servers}" Margin="16,0,16,8"
                 BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                 Background="{DynamicResource AppSurfaceBrush}" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalContentAlignment="Center" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Host}" Margin="10,0,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Text="（已禁用）" Margin="8,0,0,0" Foreground="{DynamicResource AppDangerBrush}"
                                       Visibility="{Binding Disabled, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,12">
            <ui:Button Content="取消" Padding="18,4" Margin="0,0,8,0" Click="OnCancel"/>
            <ui:Button Content="开始探测" Appearance="Primary" Padding="18,4" Click="OnStart"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
