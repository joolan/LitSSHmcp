<ui:FluentWindow x:Class="LitSSHmcp.App.Views.CloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="关闭 LitSSH" Height="240" Width="460" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="关闭 LitSSH"/>

        <StackPanel Grid.Row="1" Margin="16,4,16,0">
            <TextBlock Text="关闭主程序时希望：" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="· 最小化到托盘：在后台继续运行（SSH 会话 / AI 任务不受影响），双击托盘图标可恢复主界面。&#x0a;&#x0a;· 退出程序：关闭应用并断开所有 SSH 会话。"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,14">
            <ui:Button Content="最小化到托盘" Appearance="Primary" Padding="14,5" Click="OnMinimize"/>
            <ui:Button Content="退出程序" Padding="14,5" Margin="8,0,8,0" Click="OnExit"/>
            <ui:Button Content="取消" Padding="14,5" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
