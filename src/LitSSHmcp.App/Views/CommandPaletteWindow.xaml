<ui:FluentWindow x:Class="LitSSHmcp.App.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="命令面板" Height="520" Width="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="命令面板"/>

        <ui:TextBox Grid.Row="1" x:Name="SearchBox" Margin="16,8,16,8"
                    PlaceholderText="搜索页面、工具或动作…"
                    TextChanged="OnSearchTextChanged"/>

        <ListBox Grid.Row="2" x:Name="ActionList" Margin="16,0,16,0"
                 BorderThickness="0" Background="Transparent"
                 IsTextSearchEnabled="False"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="↑↓ 选择 · Enter 执行 · Esc 关闭"
                   Margin="16,8,16,12" FontSize="11"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
    </Grid>
</ui:FluentWindow>
