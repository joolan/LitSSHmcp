<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="目标已存在同名项" Height="230" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="目标已存在同名项"/>

        <StackPanel Grid.Row="1" Margin="16,8,16,0">
            <TextBlock Text="目标位置已存在同名文件/文件夹：" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="80"/>
        </StackPanel>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="16,10,16,12">
            <ui:Button Content="覆盖" Padding="14,4" Appearance="Primary" Margin="0,0,8,0" Click="OnOverwrite"/>
            <ui:Button Content="全部覆盖" Padding="14,4" Margin="0,0,8,0" Click="OnOverwriteAll"/>
            <ui:Button Content="跳过" Padding="14,4" Margin="0,0,8,0" Click="OnSkip"/>
            <ui:Button Content="全部跳过" Padding="14,4" Margin="0,0,8,0" Click="OnSkipAll"/>
            <ui:Button Content="取消" Padding="14,4" IsCancel="True" Click="OnCancel"/>
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
