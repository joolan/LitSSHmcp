<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DatabaseCreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新建数据库用户" Height="400" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="新建数据库用户"/>

        <StackPanel Grid.Row="1" Margin="18,8,18,8">
            <TextBlock Text="用户名" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
            <ui:TextBox x:Name="UserNameBox" FontWeight="Normal" Margin="0,0,0,8"/>

            <TextBlock Text="Host（MySQL 使用，PostgreSQL 忽略）" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
            <ui:TextBox x:Name="HostBox" FontWeight="Normal" Text="%" Margin="0,0,0,8"/>

            <TextBlock Text="初始密码" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox" FontWeight="Normal" Margin="0,0,0,4" PasswordChar="●"/>

            <TextBlock Text="MySQL 若启用 validate_password，密码需满足当前策略（通常至少 8 位，含大小写、数字、特殊字符）。"
                       TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,8"/>

            <CheckBox x:Name="CanLoginBox" Content="允许登录（PostgreSQL LOGIN）" IsChecked="True" Margin="0,0,0,4"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDangerBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,14">
            <ui:Button Content="取消" Padding="18,4" Margin="0,0,8,0" Click="OnCancel"/>
            <ui:Button Content="创建" Appearance="Primary" Padding="18,4" Click="OnCreate"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
