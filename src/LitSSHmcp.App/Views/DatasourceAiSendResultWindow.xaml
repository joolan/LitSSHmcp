<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DatasourceAiSendResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="发送查询结果给 AI" Height="430" Width="560" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="发送查询结果给 AI"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="16,4,16,12" Padding="12,10">
            <StackPanel>
                <TextBlock Text="选择要发送到数据源 AI 的结果范围" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="16,0,16,12" Padding="14,10">
            <StackPanel>
                <RadioButton x:Name="First20Option" GroupName="Range" IsChecked="True" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="前 20 行（推荐）" FontWeight="SemiBold"/>
                        <TextBlock Text="最省 token，适合大多数排查；AI 会知道总取回行数和是否截断。"
                                   Margin="0,2,0,0" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SelectedRowsOption" GroupName="Range" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="当前选中行" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedRowsHint" Margin="0,2,0,0"
                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CurrentResultOption" GroupName="Range" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="当前结果页（最多 200 行）" FontWeight="SemiBold"/>
                        <TextBlock Text="适合需要整体观察数据分布；行数过多时会截断。"
                                   Margin="0,2,0,0" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MetadataOnlyOption" GroupName="Range">
                    <StackPanel>
                        <TextBlock Text="仅元信息（不发数据行）" FontWeight="SemiBold"/>
                        <TextBlock Text="只发送列名、行数、错误或计划摘要，适合敏感数据。"
                                   Margin="0,2,0,0" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" MinWidth="76" Padding="12,5" Margin="0,0,8,0"
                           IsCancel="True" Click="OnCancel"/>
                <ui:Button Content="发送给 AI" MinWidth="96" Padding="14,5" Appearance="Primary"
                           Click="OnSend"/>
            </StackPanel>
            <TextBlock Text="发送内容会作为一轮用户消息加入当前数据源 AI 会话。"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
