<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DatasourceAiSessionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="数据源 AI 会话管理" Height="560" Width="820" MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="数据源 AI 会话管理"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="16,4,16,10" Padding="12,8">
            <DockPanel>
                <ui:SymbolIcon Symbol="History24" FontSize="16"
                               Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="仅管理当前数据源 / 当前库的 AI 会话" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScopeText" Margin="0,3,0,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="历史会话" FontWeight="SemiBold" Margin="12,9,10,7"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ListBox x:Name="SessionList" Grid.Row="1" BorderThickness="0"
                             ItemsSource="{Binding Sessions}"
                             SelectionChanged="OnSelectionChanged"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="会话名称" FontWeight="SemiBold"/>
                    <ui:TextBox x:Name="TitleBox" Margin="0,7,0,0" Height="34"
                                PlaceholderText="输入会话名称"/>
                    <TextBlock Text="重命名只影响本地历史显示，不会修改审计日志中的 SQL 记录。"
                               Margin="0,7,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                            Padding="10,8" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="提示" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="打开会话会切换到该历史对话；删除后不可恢复。执行记录仍保留在审计日志中。"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="关闭" MinWidth="76" Padding="12,5" Margin="0,0,8,0"
                           IsCancel="True" Click="OnClose"/>
                <ui:Button Content="删除" MinWidth="76" Padding="12,5" Margin="0,0,8,0"
                           Foreground="{DynamicResource AppDangerBrush}" Click="OnDelete"/>
                <ui:Button Content="重命名" MinWidth="82" Padding="12,5" Margin="0,0,8,0"
                           Click="OnRename"/>
                <ui:Button Content="打开会话" MinWidth="90" Padding="14,5" Appearance="Primary"
                           Click="OnOpen"/>
            </StackPanel>
            <TextBlock Text="双击历史会话可直接打开。"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
