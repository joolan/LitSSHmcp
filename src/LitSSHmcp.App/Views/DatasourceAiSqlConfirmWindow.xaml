<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DatasourceAiSqlConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="确认 AI 生成的 SQL" Height="540" Width="760" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="确认 AI 生成的 SQL"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="16,4,16,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                        Background="{DynamicResource AppAccentSubtleBrush}" VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Code24" FontSize="18"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="AI 生成了一条只读查询，请选择处理方式" FontWeight="SemiBold"
                               FontSize="{DynamicResource AppFontSizeBody}"/>
                    <TextBlock x:Name="TargetText" Margin="0,3,0,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReasonText" Margin="0,2,0,0"
                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="{DynamicResource AppSuccessSubtleBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                        <TextBlock Text="只读" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSuccessBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="4" Padding="7,3">
                        <TextBlock Text="单条" FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="16,0,16,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,9,10,6">
                    <TextBlock Text="将要执行的 SQL" FontWeight="SemiBold"
                               FontSize="{DynamicResource AppFontSizeCaption}" VerticalAlignment="Center"/>
                    <ui:Button DockPanel.Dock="Right" Content="复制 SQL" Padding="10,2"
                               Click="OnCopySql"/>
                </DockPanel>
                <TextBox x:Name="SqlBox" Margin="12,0,12,12" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource AppFontMonoFamily}"
                         FontSize="{DynamicResource AppFontSizeCaption}"
                         Background="{DynamicResource AppCodeBgBrush}"
                         Foreground="{DynamicResource AppCodeTextBrush}"
                         BorderThickness="0" Padding="10"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,0,16,14">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                <TextBlock Text="直接执行后，列名、行数与前 20 行摘要会自动回传到 AI 会话。"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" MinWidth="76" Padding="12,5" Margin="0,0,8,0"
                           IsCancel="True" Click="OnCancel"/>
                <ui:Button Content="插入编辑器" MinWidth="96" Padding="14,5" Margin="0,0,8,0"
                           Click="OnInsert"/>
                <ui:Button Content="直接执行" MinWidth="96" Padding="14,5" Appearance="Primary"
                           Click="OnExecute"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
