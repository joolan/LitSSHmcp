<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DatasourceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="编辑数据源" Height="760" Width="660" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="编辑数据源"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanEdit}">
                <StackPanel>
                    <TextBlock Text="连接" Style="{DynamicResource SectionTitleStyle}"/>

                    <controls:FormRow Label="名称" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="类型" HelpText="MySQL: 只读/写 SQL、执行计划、诊断；Redis: 只读/写命令、诊断；PostgreSQL: 只读/写 SQL">
                        <ComboBox SelectedIndex="{Binding TypeIndex}">
                            <ComboBoxItem Content="MySQL"/>
                            <ComboBoxItem Content="Redis"/>
                            <ComboBoxItem Content="PostgreSQL"/>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="主机地址" IsRequired="True" HelpText="数据库 IP 或主机名，可与应用日志中的地址对应">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="端口" HelpText="MySQL 3306 / Redis 6379 / PostgreSQL 5432；切换类型时自动带出">
                        <ui:TextBox FontWeight="Normal" Width="100" HorizontalAlignment="Left"
                                    Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="用户名" HelpText="MySQL/PostgreSQL 账号；Redis 6+ ACL 用户名，无 ACL 可留空">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="PasswordRow" Label="密码" HelpText="仅保存在本机（DPAPI 加密），不会通过 MCP 暴露给 AI">
                        <PasswordBox FontWeight="Normal"/>
                    </controls:FormRow>

                    <controls:FormRow Label="默认库" HelpText="MySQL/PostgreSQL 默认数据库名；Redis 填 DB 索引 0..15，留空=DB0">
                        <ui:TextBox FontWeight="Normal" Text="{Binding DefaultDatabase, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="访问模式">
                        <ComboBox SelectedIndex="{Binding AccessModeIndex}">
                            <ComboBoxItem Content="直连"/>
                            <ComboBoxItem Content="经 SSH 隧道"/>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="跳板服务器" HelpText="仅隧道模式需要；选“自动”时按 ssh → 数据源关系推导">
                        <ComboBox SelectedIndex="{Binding TunnelServerIndex}"
                                  ItemsSource="{Binding TunnelServerOptions}"
                                  IsEnabled="{Binding IsTunnelMode}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="描述">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="标签" HelpText="多个标签用逗号分隔">
                        <ui:TextBox FontWeight="Normal" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="分组" HelpText="相同分组的数据源会在列表中归为一组；可留空">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="资产标识" HelpText="同一数据库实例的多条连接配置填相同值；留空则按数据源 Id 归并">
                        <ui:TextBox FontWeight="Normal" Text="{Binding AssetKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="实例标识" HelpText="Redis 等无稳定 UUID 的兜底身份；MySQL/PostgreSQL 通常留空，由探测自动填充">
                        <ui:TextBox FontWeight="Normal" Text="{Binding InstanceKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="主机别名" HelpText="额外主机名/IP，逗号分隔；用于把直连/隧道配置识别为同一实例">
                        <ui:TextBox FontWeight="Normal" Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <TextBlock Text="运行环境" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="运行环境" HelpText="表示数据库实例实际运行在哪里；不要和上面的访问模式/隧道混淆">
                        <ComboBox ItemsSource="{Binding RuntimeKindOptions}" SelectedIndex="{Binding RuntimeKindIndex}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="SSH 服务器" HelpText="仅 SSH 服务器环境需要选择；只列出配置了 AssetKey 的服务器">
                        <ComboBox ItemsSource="{Binding SshTargetOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="AssetKey" SelectedValue="{Binding SelectedSshAssetKey}"
                                  IsEnabled="{Binding IsSshRuntime}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="Docker 应用" HelpText="仅 Docker 环境需要选择；只列出 Type=docker 且配置了 AssetKey 的应用">
                        <ComboBox ItemsSource="{Binding DockerTargetOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="AssetKey" SelectedValue="{Binding SelectedDockerAssetKey}"
                                  IsEnabled="{Binding IsDockerRuntime}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="容器名" HelpText="Docker 环境必填：容器名或 Compose service 至少填一个">
                        <ui:TextBox FontWeight="Normal" Text="{Binding RuntimeContainerName, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsDockerRuntime}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="Compose service" HelpText="Docker 环境必填：容器名或 Compose service 至少填一个">
                        <ui:TextBox FontWeight="Normal" Text="{Binding RuntimeComposeService, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsDockerRuntime}"/>
                    </controls:FormRow>

                    <TextBlock Text="治理" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="只读">
                        <CheckBox Content="只读数据源（拒绝写操作）" IsChecked="{Binding ReadOnlyMode}"
                                  ToolTip="勾选后该数据源上的 mysql_execute / redis_execute 一律拒绝"/>
                    </controls:FormRow>

                    <controls:FormRow Label="限额">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最大行数" VerticalAlignment="Center"/>
                            <ui:TextBox FontWeight="Normal" Width="60" Margin="4,0,12,0"
                                        Text="{Binding MaxRowsText, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="留空 = 默认（工具默认/上限 1000）"/>
                            <TextBlock Text="超时(秒)" VerticalAlignment="Center"/>
                            <ui:TextBox FontWeight="Normal" Width="60" Margin="4,0,12,0"
                                        Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="留空 = 默认 30 秒"/>
                            <CheckBox Content="启用连接池" IsChecked="{Binding UsePooling}" VerticalAlignment="Center"
                                      ToolTip="仅直连生效；经 SSH 隧道时自动禁用"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="写审批">
                        <ComboBox ItemsSource="{Binding WriteApprovalOptions}"
                                  SelectedIndex="{Binding WriteApprovalIndex}"
                                  ToolTip="写操作审批策略；“自动放行”仅用于受信任目标，仍受硬拦截规则约束"/>
                    </controls:FormRow>

                    <TextBlock Text="TLS" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="SSL">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="180" ItemsSource="{Binding SslModeOptions}" SelectedIndex="{Binding SslModeIndex}"
                                      IsEnabled="{Binding SupportsSsl}"
                                      ToolTip="MySQL/PostgreSQL 连接 TLS 策略；旧版数据库握手失败时可选“禁用”"/>
                            <CheckBox Content="允许公钥获取" IsChecked="{Binding AllowPublicKeyRetrieval}"
                                      IsEnabled="{Binding IsMySql}" Margin="12,0,0,0" VerticalAlignment="Center"
                                      ToolTip="仅 MySQL：caching_sha2_password 在非 TLS 连接下需要允许获取服务端公钥"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="CA证书" HelpText="仅在 VerifyCA / VerifyFull 时需要；可选本地 PEM/CRT/CER">
                        <controls:PathPicker Value="{Binding SslCaFile, Mode=TwoWay}"
                                             IsEnabled="{Binding SupportsSsl}"
                                             Title="选择 CA 证书文件"
                                             Filter="证书文件|*.pem;*.crt;*.cer;*.der|所有文件|*.*"
                                             Placeholder="可选：本地 PEM 格式 CA 证书路径"/>
                    </controls:FormRow>

                    <TextBlock Text="提示：账号密码仅人工录入，MCP 工具只暴露主机/端口/账号，密码永不返回给 AI。"
                               Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Style="{DynamicResource DialogFooterPanelStyle}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="保存" Appearance="Primary" MinWidth="88" Margin="0,0,8,0" IsDefault="True"
                           Command="{Binding SaveCommand}"
                           Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <ui:Button Content="{Binding CancelButtonText}" MinWidth="88" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <ui:Button Content="测试连接" Padding="12,4" Margin="0,0,10,0"
                       Command="{Binding TestConnectionCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
