<UserControl x:Class="LitSSHmcp.App.Views.DatasourceManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LitSSHmcp.App;component/Themes/GroupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <controls:DatasourceTypeConverter x:Key="DatasourceType"/>
        <controls:AccessModeConverter x:Key="AccessMode"/>
        <controls:GroupLabelConverter x:Key="GroupLabel"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Grid.Row="0" Icon="Database24" Title="数据源"
                             Subtitle="账号密码仅本机 DPAPI 加密保存，不会给 AI 开放">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索名称 / 主机 / 类型" VerticalAlignment="Center"
                                AutomationProperties.Name="搜索数据源"/>
                    <CheckBox Content="卡片视图" IsChecked="{Binding IsCardView}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="12,4"
                               Margin="8,0,0,0" Command="{Binding AddCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <Border Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource AppDangerSubtleBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
                        BorderThickness="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="重试" Padding="10,2" Margin="8,0,0,0"
                                   Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                    </DockPanel>
                </Border>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding RefreshCommand}"/>
            <ui:Button Content="列" Padding="12,4" Margin="0,0,6,6" Click="OnChooseColumns" ToolTip="显示/隐藏列"/>
            <ui:Button Content="打开工作台" Icon="{ui:SymbolIcon Database24}" Padding="12,4" Margin="0,0,6,6"
                       Command="{Binding WorkbenchCommand}"
                       ToolTip="只读数据库工作台：对象浏览 / SQL 查询 / 分页 / 导出 CSV（仅 MySQL / PostgreSQL）"/>
        </WrapPanel>

        <Border Grid.Row="2">
            <Grid>
                <Grid>
                    <ListView x:Name="DsList" ItemsSource="{Binding GroupedDataSources}" SelectedItem="{Binding SelectedDataSource}"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                              Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.IsVirtualizingWhenGrouping="False" ScrollViewer.CanContentScroll="False" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                              ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True"
                              controls:GroupExpanderBehavior.StorageKey="datasource.groups">
                        <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建 AI 会话" Click="OnNewAiSessionClick"/>
                            <Separator/>
                            <MenuItem x:Name="WorkbenchMenuItem" Header="打开工作台" Click="OnWorkbenchClick"/>
                                <MenuItem Header="测试连接" Click="OnTestClick"/>
                                <MenuItem Header="编辑" Click="OnEditClick"/>
                                <Separator/>
                                <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource CollapsibleAssetGroupContainerStyle}"/>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="类型" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource DatasourceType}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="主机" Width="150" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="端口" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="账号" Width="110" DisplayMemberBinding="{Binding Username}"/>
                                <GridViewColumn Header="访问模式" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccessMode, Converter={StaticResource AccessMode}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="默认库" Width="110" DisplayMemberBinding="{Binding DefaultDatabase}"/>
                                <GridViewColumn Header="描述" Width="170" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="操作" Width="74">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                           ToolTip="编辑" AutomationProperties.Name="编辑数据源"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                           Foreground="{DynamicResource AppDangerBrush}" ToolTip="删除"
                                                           AutomationProperties.Name="删除数据源"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding FilteredDataSources}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource CardBorderStyle}" Width="300" Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource AppAccentSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource DatasourceType}}" FontSize="10"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AppDangerSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="只读" FontSize="10"
                                                               Foreground="{DynamicResource AppDangerBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSubtitle}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Host}" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,8,0,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <Run Text="端口 "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding AccessMode, Mode=OneWay, Converter={StaticResource AccessMode}}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="默认库 "/><Run Text="{Binding DefaultDatabase, Mode=OneWay}"/>
                                                <Run Text=" · 分组 "/><Run Text="{Binding Group, Mode=OneWay, Converter={StaticResource GroupLabel}}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <ui:Button Content="打开工作台" Appearance="Primary" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.OpenWorkbenchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="测试" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.TestItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="编辑" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="删除" Padding="10,3" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource AppDangerBrush}"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding FilteredDataSources.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Database24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="{Binding EmptyHint}"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="添加数据源" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                       Command="{Binding AddCommand}"
                                       Visibility="{Binding ShowEmptyAction, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button Content="清空搜索" Icon="{ui:SymbolIcon Dismiss24}" Padding="14,5"
                                       Click="OnClearSearch"
                                       Visibility="{Binding ShowClearSearch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource AppCardBrush}" Opacity="0.72" Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
