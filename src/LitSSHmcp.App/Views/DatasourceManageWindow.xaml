<Window x:Class="LitSSHmcp.App.Views.DatasourceManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据源管理" Height="520" Width="880"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="数据源 (账号密码仅本机DPAPI加密保存, 不对AI开放)" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="添加" Command="{Binding AddCommand}" Width="64" Padding="6,4" Margin="0,0,6,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Width="64" Padding="6,4"/>
                </StackPanel>

                <ListView x:Name="DsList" ItemsSource="{Binding DataSources}" SelectedItem="{Binding SelectedDataSource}"
                          Padding="3" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                          ContextMenuOpening="OnListContextMenuOpening">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="测试连接" Click="OnTestClick"/>
                            <MenuItem Header="编辑" Click="OnEditClick"/>
                            <MenuItem Header="删除" Click="OnDeleteClick"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="主机" Width="150" DisplayMemberBinding="{Binding Host}"/>
                            <GridViewColumn Header="端口" Width="55" DisplayMemberBinding="{Binding Port}"/>
                            <GridViewColumn Header="账号" Width="110" DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="访问模式" Width="90" DisplayMemberBinding="{Binding AccessMode}"/>
                            <GridViewColumn Header="默认库" Width="110" DisplayMemberBinding="{Binding DefaultDatabase}"/>
                            <GridViewColumn Header="描述" Width="170" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </GroupBox>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="4,6,0,0" Foreground="Gray" TextWrapping="Wrap"/>
    </Grid>
</Window>
