<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DbWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="{Binding WindowTitle}" Height="760" Width="1200" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewMouseDown="OnWindowPreviewMouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 对象树节点：展开/选中双向绑定 + 展开时懒加载 -->
        <Style x:Key="DbTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <EventSetter Event="Expanded" Handler="OnObjectTreeExpanded"/>
        </Style>
        <!-- 片段菜单行：无边框、悬停高亮（菜单观感） -->
        <Style x:Key="FlatMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid PreviewMouseDown="OnRootPreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"/>

        <!-- 顶部工具条 + 模式 -->
        <DockPanel Grid.Row="1" Margin="12,10,12,0" LastChildFill="True">
            <Border DockPanel.Dock="Top" Style="{DynamicResource CardBorderStyle}" Padding="10,7" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="数据源:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ComboBox Width="190" DisplayMemberPath="Name"
                              ItemsSource="{Binding Datasources}" SelectedItem="{Binding SelectedDatasource}"/>
                    <TextBlock Text="库:" VerticalAlignment="Center" Margin="12,0,6,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Visibility="{Binding IsSqlDb, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Width="170" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}"
                              Visibility="{Binding IsSqlDb, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="DB:" VerticalAlignment="Center" Margin="12,0,6,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Visibility="{Binding IsRedisDb, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Width="60" VerticalContentAlignment="Center"
                              ItemsSource="{Binding RedisDatabases}" SelectedItem="{Binding SelectedRedisDb}"
                              Visibility="{Binding IsRedisDb, Converter={StaticResource BoolToVis}}"
                              ToolTip="Redis DB 索引（切换后自动重新扫描）"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="刷新" Padding="10,3" Margin="12,0,0,0"
                               Command="{Binding RefreshCommand}"/>
                    <CheckBox x:Name="WriteModeToggle" Content="⚠ 写入模式" Margin="20,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsWriteMode, Mode=TwoWay}"
                              IsEnabled="{Binding CanWrite}"
                              ToolTip="默认只读。勾选后可执行写操作（UPDATE/INSERT/DELETE/DDL）；危险语句会被拦截，敏感语句执行前需确认。只读数据源无法开启。"/>
                    <ui:Button x:Name="SnippetButton" Padding="10,3" Margin="12,0,0,0"
                               Content="{Binding SnippetButtonLabel}"
                               ToolTip="收藏的片段（随当前 数据源 · 库）；点击展开、选择后追加到输入框"
                               Click="OnToggleSnippetPanel"/>
                    <ui:Button x:Name="HistoryButton" Padding="10,3" Margin="8,0,0,0"
                               Content="{Binding HistoryButtonLabel}"
                               ToolTip="查询历史（最近使用在前）；点击展开、选择后填入输入框"
                               Click="OnToggleHistoryPanel"/>
                </StackPanel>
            </Border>

            <!-- SQL 片段下拉（菜单样式） -->
            <Popup x:Name="SnippetPopup" StaysOpen="True" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=SnippetButton}" Placement="Bottom"
                   IsOpen="{Binding IsSnippetPanelOpen, Mode=TwoWay}">
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="280" MaxWidth="460"
                        Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding SnippetHeader}" FontSize="12" Padding="10,6,10,4"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <Separator Margin="4,0,4,4"/>
                        <TextBlock Text="（无）" FontSize="12" Padding="10,6" Foreground="{DynamicResource AppTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSnippets}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <ItemsControl ItemsSource="{Binding Snippets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatMenuButton}"
                                                    Width="26" Height="26" Padding="0" Margin="2,0,0,0"
                                                    HorizontalContentAlignment="Center" Content="✕" ToolTip="删除此片段（需确认）"
                                                    Click="OnDeleteSnippetClick"/>
                                            <Button Style="{StaticResource FlatMenuButton}" HorizontalAlignment="Stretch"
                                                    Padding="10,5" ToolTip="{Binding Sql}"
                                                    Content="{Binding Display}" Click="OnUseSnippetClick"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Separator Margin="4,4,4,4"/>
                        <Button Style="{StaticResource FlatMenuButton}" HorizontalAlignment="Stretch"
                                Padding="10,5" Content="收藏当前 SQL"
                                Command="{Binding SaveSnippetCommand}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 查询历史下拉 -->
            <Popup x:Name="HistoryPopup" StaysOpen="True" AllowsTransparency="True"
                   PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Bottom"
                   IsOpen="{Binding IsHistoryPanelOpen, Mode=TwoWay}">
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="300" MaxWidth="600"
                        Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="10,6,10,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatMenuButton}" Content="清空"
                                    Padding="6,2" Command="{Binding ClearHistoryCommand}"/>
                            <TextBlock Text="查询历史（最近使用在前）" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </DockPanel>
                        <Separator Margin="4,0,4,4"/>
                        <TextBlock Text="（暂无历史）" FontSize="12" Padding="10,6" Foreground="{DynamicResource AppTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoryCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FlatMenuButton}" HorizontalAlignment="Stretch"
                                                Padding="10,5" ToolTip="{Binding}"
                                                Command="{Binding DataContext.UseHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="560"
                                                       HorizontalAlignment="Left"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
            <Border DockPanel.Dock="Top" Visibility="{Binding ShowWriteBanner, Converter={StaticResource BoolToVis}}"
                    Background="#FDECEA" BorderBrush="#D13438" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" Foreground="#D13438" FontWeight="SemiBold"
                           Text="{Binding WriteBannerText}"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="200"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：对象浏览 -->
                <Grid Grid.Column="0">
                    <!-- SQL：对象树（表 / 视图 / 存储过程 → 列 / 索引） -->
                    <DockPanel Visibility="{Binding IsSqlDb, Converter={StaticResource BoolToVis}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="8,2" Margin="4,0,0,0"
                                       ToolTip="重新加载对象树" Command="{Binding RefreshObjectsCommand}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectFilterHint}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <ui:TextBox FontWeight="Normal" Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="搜索对象…（前缀命中优先）"/>
                        </DockPanel>

                        <!-- 选中对象条：库 · 表名 · 列数/行数 + 备注，右侧快捷预览/生成 SELECT -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="6,4" CornerRadius="4"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                Visibility="{Binding HasSelectedObject, Converter={StaticResource BoolToVis}}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="预览" Padding="8,2" Margin="4,0,0,0"
                                               Command="{Binding PreviewCommand}" ToolTip="预览前 100 行"/>
                                    <ui:Button Content="生成 SELECT" Padding="8,2" Margin="4,0,0,0"
                                               Command="{Binding GenerateSelectCommand}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedObjectBar}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedObjectBar}"/>
                                    <TextBlock Text="{Binding SelectedObjectComment}" FontSize="11"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSelectedComment, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TreeView ItemsSource="{Binding ObjectTree}" BorderThickness="0" Background="Transparent"
                                  ItemContainerStyle="{StaticResource DbTreeItemStyle}"
                                  SelectedItemChanged="OnObjectTreeSelected"
                                  MouseDoubleClick="OnObjectTreeDoubleClick"
                                  ContextMenuOpening="OnObjectTreeMenuOpening"
                                  PreviewMouseRightButtonDown="OnObjectTreeRightDown">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="刷新对象" Command="{Binding RefreshObjectsCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="预览选中表" Command="{Binding PreviewCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="生成 SELECT" Command="{Binding GenerateSelectCommand}"/>
                                    <MenuItem Header="生成 INSERT" Command="{Binding GenerateInsertCommand}"/>
                                    <MenuItem Header="生成 COUNT(*)" Command="{Binding GenerateCountCommand}"/>
                                    <MenuItem Header="生成 CALL" Command="{Binding GenerateCallCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="生成 CREATE TABLE (DDL)" Command="{Binding GenerateDdlCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="复制对象名" Click="OnCopyObjectName"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}"
                                                          ItemContainerStyle="{StaticResource DbTreeItemStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,1"
                                                ToolTip="{Binding Tooltip}">
                                        <ui:SymbolIcon Width="14" Height="14" FontSize="14" VerticalAlignment="Center"
                                                       Margin="0,0,5,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Table24"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                                            <Setter Property="Symbol" Value="Folder24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="View">
                                                            <Setter Property="Symbol" Value="Eye24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Procedure">
                                                            <Setter Property="Symbol" Value="Braces24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Column">
                                                            <Setter Property="Symbol" Value="Textbox24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Index">
                                                            <Setter Property="Symbol" Value="ArrowSort24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="ForeignKey">
                                                            <Setter Property="Symbol" Value="Link24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" FontSize="11"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- Redis：键浏览（分批 SCAN + 时间预算，百万级键不卡死） -->
                    <DockPanel Visibility="{Binding IsRedisDb, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="键（SCAN，分批加载）" FontWeight="SemiBold" Margin="2,0,0,4"/>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="扫描" Padding="8,3" Margin="6,0,0,0"
                                           Command="{Binding ScanKeysCommand}" ToolTip="从头扫描（每次最多 2 秒 / 20 批，之后可「继续」）"/>
                                <ui:Button DockPanel.Dock="Right" Content="继续" Padding="8,3" Margin="4,0,0,0"
                                           Command="{Binding ScanMoreCommand}" ToolTip="继续上次未完成的扫描（再给 2 秒预算）"/>
                                <ui:Button DockPanel.Dock="Right" Content="停止" Padding="8,3" Margin="4,0,0,0"
                                           Command="{Binding StopScanCommand}" ToolTip="停止当前扫描 / 补全（Esc）"/>
                                <ui:TextBox Text="{Binding KeyPattern, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="MATCH 模式，如 user:*" KeyDown="OnKeyPatternKeyDown"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <ui:Button DockPanel.Dock="Right" Content="补全类型/TTL/大小" Padding="8,3" Margin="6,0,0,0"
                                           Command="{Binding LoadKeyMetaCommand}"
                                           ToolTip="对已加载的键分批执行 TYPE/TTL/MEMORY USAGE（每批 50、10 秒预算）。MEMORY USAGE 会消耗 Redis CPU，键很多时分多次点。"/>
                                <ComboBox DockPanel.Dock="Right" Width="72" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding RedisKeyTypeOptions}" SelectedItem="{Binding RedisKeyTypeFilter}"
                                          ToolTip="按类型过滤（本地过滤；需先补全类型）"/>
                                <ui:TextBox Text="{Binding RedisKeyFilter, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="本地过滤键名…（不回服务端）"/>
                            </DockPanel>
                            <ProgressBar Height="4" Margin="0,4,0,0" IsIndeterminate="{Binding IsScanning}"
                                         Visibility="{Binding HasScanProgress, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ScanProgress}" Margin="2,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Visibility="{Binding HasScanProgress, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <GroupBox Header="键（双击查看值 · 类型/TTL/大小可「补全」）" Padding="4">
                            <ListView x:Name="RedisKeyList"
                                      ItemsSource="{Binding RedisKeysView}"
                                      SelectedItem="{Binding SelectedRedisKey}"
                                      MouseDoubleClick="OnKeyDoubleClick"
                                      PreviewMouseRightButtonDown="OnRedisKeyRightDown"
                                      PreviewKeyDown="OnRedisKeyListKeyDown"
                                      controls:GridViewSort.Enabled="True">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="查看值"
                                                  Command="{Binding UseKeyCommand}"
                                                  CommandParameter="{Binding SelectedRedisKey}"/>
                                        <MenuItem Header="补全类型/TTL/大小"
                                                  Command="{Binding LoadKeyMetaCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="复制键名"
                                                  Command="{Binding CopyKeyCommand}"
                                                  CommandParameter="{Binding SelectedRedisKey}"/>
                                        <MenuItem Header="生成 GET 到输入框"
                                                  Command="{Binding KeyToEditorCommand}"
                                                  CommandParameter="{Binding SelectedRedisKey}"/>
                                        <Separator/>
                                        <MenuItem Header="删除键（写入模式）"
                                                  Command="{Binding DeleteKeyCommand}"
                                                  CommandParameter="{Binding SelectedRedisKey}"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="键" Width="230" DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="类型" Width="70" DisplayMemberBinding="{Binding TypeDisplay}"/>
                                        <GridViewColumn Header="TTL" Width="90" DisplayMemberBinding="{Binding TtlDisplay}"/>
                                        <GridViewColumn Header="大小/元素数" Width="110" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- 右：查询 + 结果 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="820">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,0" CornerRadius="4" Padding="8,3" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                               MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="✕" Margin="6,0,0,0" Padding="4,0" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ui:Button Content="+ 新建查询" Padding="8,2" Margin="4,0,0,0" Command="{Binding AddTabCommand}"/>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="{Binding EditorLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SqlHint}" Margin="4,0,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button DockPanel.Dock="Right" Content="{Binding SaveSnippetLabel}" Padding="8,2"
                                       Command="{Binding SaveSnippetCommand}"
                                       ToolTip="把输入框中的内容收藏为当前 数据源·库 的片段"/>
                            <ui:Button DockPanel.Dock="Right" Content="打开 .sql" Padding="8,2" Margin="0,0,6,0"
                                       Command="{Binding OpenSqlFileCommand}" ToolTip="打开 SQL 脚本文件到编辑器"/>
                            <ui:Button DockPanel.Dock="Right" Content="保存 .sql" Padding="8,2" Margin="0,0,6,0"
                                       Command="{Binding SaveSqlFileCommand}" ToolTip="把编辑器内容保存为 .sql 文件"/>
                            <ui:Button DockPanel.Dock="Right" Content="格式化" Padding="8,2" Margin="0,0,6,0"
                                       Command="{Binding FormatSqlCommand}" ToolTip="美化 SQL（主要子句换行、关键字大写）"/>
                        </DockPanel>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource AppCodeBgBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWriteMode}" Value="True">
                                        <Setter Property="BorderBrush" Value="#D13438"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <avalonedit:TextEditor x:Name="SqlBox" FontFamily="Consolas" FontSize="13"
                                 ShowLineNumbers="True" SyntaxHighlighting="TSQL" WordWrap="False"
                                 BorderThickness="0" Background="Transparent" Padding="6"
                                 Foreground="{DynamicResource AppCodeTextBrush}"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="OnSqlKeyDown"/>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS"
                                  ToolTip="拖动调整 SQL 输入区高度"/>

                    <DockPanel Grid.Row="3">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                            <ui:Button DockPanel.Dock="Left" Content="执行 (Ctrl+Enter)" Appearance="Primary" Padding="12,4"
                                       Command="{Binding ExecuteCommand}"
                                       Visibility="{Binding ShowReadExecute, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button DockPanel.Dock="Left" Content="⚠ 执行写入 (Ctrl+Enter)" Appearance="Danger" Padding="12,4"
                                       Command="{Binding ExecuteCommand}"
                                       Visibility="{Binding ShowWriteExecute, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button DockPanel.Dock="Left" Content="导出 ▾" Padding="12,4" Margin="8,0,0,0"
                                       Click="OnExportMenu">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="导出 CSV" Command="{Binding ExportCsvCommand}"/>
                                        <MenuItem Header="导出 JSON" Command="{Binding ExportJsonCommand}"/>
                                        <MenuItem Header="导出 Excel (.xlsx)" Command="{Binding ExportExcelCommand}"/>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button DockPanel.Dock="Left" Content="更多 ▾" Padding="12,4" Margin="8,0,0,0"
                                       Click="OnMoreMenu"
                                       Visibility="{Binding IsSqlDb, Converter={StaticResource BoolToVis}}">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="执行计划 (EXPLAIN)" Command="{Binding ExplainCommand}"/>
                                        <MenuItem Header="刷新对象列表" Command="{Binding RefreshObjectsCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="AI 分析此 SQL…" Click="OnAnalyzeSql"/>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <Border DockPanel.Dock="Left" Margin="12,0,0,0" Padding="6,2" CornerRadius="3" Background="#D13438"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowWriteBanner, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="写入模式" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <ui:Button DockPanel.Dock="Right" Content="下一页 ▶" Padding="10,4" Margin="6,0,0,0"
                                       Command="{Binding NextPageCommand}"
                                       Visibility="{Binding ShowPaging, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button DockPanel.Dock="Right" Content="◀ 上一页" Padding="10,4"
                                       Command="{Binding PrevPageCommand}"
                                       Visibility="{Binding ShowPaging, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0"
                                       Text="{Binding PageLabel}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Visibility="{Binding ShowPaging, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ResultSetTabs}" Margin="0,0,0,4"
                                      Visibility="{Binding HasMultipleResults, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,4,0" CornerRadius="4" Padding="8,2" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectResultTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding Label}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RedisKeyInfo}" Margin="2,0,0,6"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Visibility="{Binding HasRedisKeyInfo, Converter={StaticResource BoolToVis}}"/>

                        <Grid>
                            <TextBlock Text="执行查询，或右键对象列表「预览选中表」查看结果"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Results}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding ShowPlan}" Value="False"/>
                                                    <Condition Binding="{Binding ShowMessages}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Visibility="{Binding ShowResultGrid, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding RowHeaderActualWidth, ElementName=ResultGrid}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl x:Name="FilterRow" Grid.Column="1" ItemsSource="{Binding Columns, ElementName=ResultGrid}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBox Width="{Binding ActualWidth}" Tag="{Binding Header}" Margin="0,0,1,0"
                                                         Padding="2,0" Height="22" TextChanged="OnColumnFilterChanged"
                                                         ToolTip="按此列筛选（包含匹配）"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <DataGrid Grid.Row="1" x:Name="ResultGrid" ItemsSource="{Binding Results}" IsReadOnly="True"
                                      AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="All" GridLinesVisibility="All" SelectionUnit="Cell"
                                      LoadingRow="OnResultLoadingRow" AutoGeneratedColumns="OnAutoGeneratedColumns"
                                      SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      FontFamily="Consolas" FontSize="12" MouseDoubleClick="OnResultDoubleClick"
                                      AutoGeneratingColumn="OnAutoGeneratingColumn"
                                      PreviewMouseRightButtonDown="OnResultRightDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制单元格" Click="OnCopyCell"/>
                                            <MenuItem Header="复制整行" Click="OnCopyRow"/>
                                            <MenuItem Header="复制全部结果" Click="OnCopyAll"/>
                                            <MenuItem Header="复制为 INSERT 语句" Click="OnCopyInsert"/>
                                            <Separator/>
                                            <MenuItem Header="查看完整内容…" Click="OnViewCell"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>

                            <DockPanel Visibility="{Binding ShowPlan, Converter={StaticResource BoolToVis}}">
                                <ui:Button DockPanel.Dock="Top" Content="关闭计划" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,4"
                                           Command="{Binding ClosePlanCommand}"/>
                                <Grid>
                                    <TreeView ItemsSource="{Binding PlanNodes}" BorderThickness="0" Background="Transparent"
                                              Visibility="{Binding HasPlanTree, Converter={StaticResource BoolToVis}}">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontFamily="Consolas"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <TextBox IsReadOnly="True" Text="{Binding PlanText}" FontFamily="Consolas" FontSize="12"
                                             Background="#1E1E1E" Foreground="#DDDDDD" BorderThickness="0" Padding="8"
                                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPlanTree}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </DockPanel>

                            <DockPanel Visibility="{Binding ShowMessages, Converter={StaticResource BoolToVis}}">
                                <ui:Button DockPanel.Dock="Top" Content="清空消息" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,4"
                                           Command="{Binding ClearMessagesCommand}"/>
                                <ListBox ItemsSource="{Binding Messages}" FontFamily="Consolas" FontSize="11"
                                         BorderThickness="0" Background="Transparent"/>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="12,8,12,12">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
