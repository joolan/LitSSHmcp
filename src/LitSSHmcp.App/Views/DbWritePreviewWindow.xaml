<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DbWritePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="执行前预览 — 数据库写入" Height="620" Width="820" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="执行前预览 — 数据库写入"/>

        <Border Grid.Row="1" Background="#FDECEA" BorderBrush="#D13438" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="12,0,12,8">
            <TextBlock TextWrapping="Wrap" Foreground="#D13438" FontWeight="SemiBold"
                       Text="⚠ 即将执行写操作，将直接修改数据库且不可撤销。请核对下方 SQL 与影响范围后再执行。"/>
        </Border>

        <TextBlock Grid.Row="2" Text="将要执行的 SQL" FontWeight="SemiBold" Margin="12,0,12,4"/>

        <TextBox Grid.Row="3" x:Name="SqlBox" Margin="12,0,12,8" Height="110" FontFamily="Consolas"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource AppSurfaceAltBrush}"/>

        <DockPanel Grid.Row="4" Margin="12,0,12,0">
            <TextBlock x:Name="PreviewSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <Border x:Name="SampleBorder" Style="{DynamicResource CardBorderStyle}" Padding="2">
                <DataGrid x:Name="SampleGrid" IsReadOnly="True" AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="All"
                          GridLinesVisibility="All" SelectionUnit="Cell" EnableRowVirtualization="True"
                          FontFamily="Consolas" FontSize="12"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="5" Margin="12,10,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="⚠ 执行写入" Appearance="Danger" Padding="16,5" Margin="0,0,8,0" Click="OnExecute"/>
                <ui:Button Content="取消" Width="80" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
            <TextBlock Text="确认无误后点击「执行写入」" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
