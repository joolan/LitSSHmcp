<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DbWritePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="执行前预览 - 数据库写入" Height="640" Width="860" MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PreviewLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeMicro}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PreviewValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="执行前预览 - 数据库写入"/>

        <Border Grid.Row="1" Background="{DynamicResource AppDangerSubtleBrush}"
                BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="12,0,12,8">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" FontSize="18"
                               Foreground="{DynamicResource AppDangerBrush}" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}" FontWeight="SemiBold"
                           Text="即将执行写操作，将直接修改数据库且不可撤销。请核对下方 SQL 与影响范围后再执行。"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="12,0,12,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="执行摘要" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}"/>
                    <Border x:Name="SensitiveBadge" DockPanel.Dock="Right" Background="{DynamicResource AppDangerSubtleBrush}"
                            CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                        <TextBlock Text="敏感写操作" FontSize="10" Foreground="{DynamicResource AppDangerBrush}"/>
                    </Border>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Width="240" Margin="0,0,16,0">
                        <TextBlock Text="目标" Style="{StaticResource PreviewLabel}"/>
                        <TextBlock x:Name="TargetText" Style="{StaticResource PreviewValue}"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,16,0">
                        <TextBlock Text="操作" Style="{StaticResource PreviewLabel}"/>
                        <TextBlock x:Name="OperationText" Style="{StaticResource PreviewValue}"/>
                    </StackPanel>
                    <StackPanel MinWidth="160">
                        <TextBlock Text="影响范围" Style="{StaticResource PreviewLabel}"/>
                        <TextBlock x:Name="ImpactText" Style="{StaticResource PreviewValue}" FontWeight="SemiBold"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="NoteText" FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Expander x:Name="SqlExpander" Grid.Row="3" Margin="12,0,12,8" Padding="8" IsExpanded="True"
                  Header="将要执行的 SQL">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="复制 SQL" Padding="8,2" Margin="8,0,0,0"
                           VerticalAlignment="Top" Click="OnCopySql"/>
                <TextBox x:Name="SqlBox" Height="150" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeCaption}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{DynamicResource AppCodeBgBrush}" Foreground="{DynamicResource AppCodeTextBrush}"
                         BorderThickness="0" Padding="8"/>
            </DockPanel>
        </Expander>

        <Expander x:Name="SampleExpander" Grid.Row="4" Margin="12,0,12,8" Padding="4"
                  Header="受影响样本行" Visibility="Collapsed">
            <Border Style="{DynamicResource CardBorderStyle}" Padding="2">
                <DataGrid x:Name="SampleGrid" IsReadOnly="True" AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="All"
                          GridLinesVisibility="All" SelectionUnit="Cell" EnableRowVirtualization="True"
                          MaxHeight="220" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeCaption}"/>
            </Border>
        </Expander>

        <DockPanel Grid.Row="6" Margin="16,4,16,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="⚠ 执行写入" Appearance="Danger" Padding="16,5" Margin="0,0,8,0" Click="OnExecute"/>
                <ui:Button Content="取消" MinWidth="80" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
            <TextBlock Text="确认无误后点击「执行写入」" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
