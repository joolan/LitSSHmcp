<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.DesktopLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面登录（归因）" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="桌面登录（归因）"/>
        <StackPanel Grid.Row="1" Margin="16,0,16,14">
            <TextBlock TextWrapping="Wrap"
                       Text="使用 Web 助手账号登录后，新会话与审计记为该用户；桌面不做权限限制（仅归因）。未登录时归因为 local。"/>
            <TextBlock Text="用户名:" Margin="0,12,0,2"/>
            <ui:TextBox x:Name="UsernameBox" PlaceholderText="Web 账号用户名"/>
            <TextBlock Text="密码:" Margin="0,8,0,2"/>
            <PasswordBox x:Name="PasswordBox" Padding="8,6"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="取消" Width="88" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
                <ui:Button x:Name="LoginButton" Content="登录" Width="88" Appearance="Primary" Click="OnLogin" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
