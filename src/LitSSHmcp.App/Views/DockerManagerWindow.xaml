<ui:FluentWindow x:Class="LitSSHmcp.App.Views.DockerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Docker 查看/管理" Height="720" Width="1100" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DockerInfoText}" FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Left" Content="刷新" Padding="12,4" Margin="0,0,8,0"
                                   Command="{Binding RefreshCommand}"/>
                        <CheckBox DockPanel.Dock="Right" Content="包含已停止" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowStopped, Mode=TwoWay}"/>
                        <ui:TextBox FontWeight="Normal" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="搜索名称 / 镜像 / ID" Margin="0,0,8,0"/>
                    </DockPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding ContainersView}" SelectedItem="{Binding SelectedContainer}"
                         BorderThickness="0" Background="Transparent" Padding="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,2" CornerRadius="5"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StateGlyph}" Margin="0,0,7,0"
                                               VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Image}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                            <Run Text="CPU "/><Run Text="{Binding CpuText, Mode=OneWay}"/>
                                            <Run Text="  ·  MEM "/><Run Text="{Binding MemText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedContainerTitle}"
                               FontSize="{DynamicResource AppFontSizeSubtitle}" FontWeight="SemiBold"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedContainer.StateText}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,12,0"/>
                        <ui:Button Content="启动" Padding="10,3" Margin="0,0,5,0" Command="{Binding StartCommand}"
                                   ToolTip="启动容器"/>
                        <ui:Button Content="停止" Padding="10,3" Margin="0,0,5,0" Command="{Binding StopCommand}"
                                   ToolTip="停止容器"/>
                        <ui:Button Content="重启" Padding="10,3" Margin="0,0,5,0" Command="{Binding RestartCommand}"
                                   ToolTip="重启容器"/>
                        <ui:Button Content="暂停" Padding="10,3" Margin="0,0,5,0" Command="{Binding PauseCommand}"
                                   ToolTip="暂停容器"/>
                        <ui:Button Content="恢复" Padding="10,3" Command="{Binding UnpauseCommand}"
                                   ToolTip="恢复已暂停容器"/>
                    </StackPanel>
                </DockPanel>

                <TabControl>
                    <TabItem Header="概览">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="名称" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="ID" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContainer.Id}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                                <TextBlock Grid.Row="2" Text="镜像" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContainer.Image}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="状态" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedContainer.StateText}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="4" Text="端口" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedContainer.Ports}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="5" Text="启动时间" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedContainer.CreatedAt}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="6" Text="运行时长" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedContainer.RunningFor}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="7" Text="CPU" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedContainer.CpuText}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="8" Text="内存" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedContainer.MemText}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="9" Text="网络 IO" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedContainer.NetText}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="10" Text="磁盘 IO" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedContainer.BlockText}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="11" Text="PIDs" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedContainer.PidsText}" Margin="0,6,0,0"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="日志">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Left" Content="刷新日志" Padding="12,3"
                                           Command="{Binding LoadLogsCommand}"/>
                                <TextBlock Text="最近 300 行" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </DockPanel>
                            <TextBox Text="{Binding LogsText, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="{DynamicResource AppFontMonoFamily}"
                                     FontSize="{DynamicResource AppFontSizeMicro}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="详情">
                        <DockPanel Margin="8">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <ui:Button DockPanel.Dock="Left" Content="加载详情" Padding="12,3"
                                           Command="{Binding LoadInspectCommand}"/>
                                <TextBlock Text="docker inspect（只读）" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </DockPanel>
                            <TextBox Text="{Binding InspectText, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="{DynamicResource AppFontMonoFamily}"
                                     FontSize="{DynamicResource AppFontSizeMicro}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="16,0,16,10"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
    </Grid>
</ui:FluentWindow>
