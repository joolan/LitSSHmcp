<ui:FluentWindow x:Class="LitSSHmcp.App.Views.FirewallManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="系统防火墙" Height="720" Width="1180" MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BackendText}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeSubtitle}"/>
                            <Border Background="{DynamicResource AppAccentSubtleBrush}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="默认策略: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="{Binding DefaultPolicyText}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="  ·  区域: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="{Binding ZoneText}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="  ·  SSH 端口: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                            <TextBlock Text="{Binding SshPortText}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="刷新" Padding="12,4" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
                        <ui:Button Content="新建规则" Padding="12,4" Command="{Binding NewRuleCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="350" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <TabControl Grid.Column="0">
                    <TabItem Header="规则列表">
                        <DockPanel Margin="6">
                            <ui:TextBox DockPanel.Dock="Top" FontWeight="Normal" Margin="0,0,0,6"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="搜索方向 / 动作 / 端口 / 来源"/>
                            <ListView ItemsSource="{Binding RulesView}" SelectedItem="{Binding SelectedRule}"
                                      BorderThickness="0" Background="Transparent" Padding="2">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="方向" Width="65" DisplayMemberBinding="{Binding DirectionText}"/>
                                        <GridViewColumn Header="动作" Width="65" DisplayMemberBinding="{Binding ActionText}"/>
                                        <GridViewColumn Header="端口/服务" Width="130" DisplayMemberBinding="{Binding Target}"/>
                                        <GridViewColumn Header="协议" Width="65" DisplayMemberBinding="{Binding Protocol}"/>
                                        <GridViewColumn Header="来源 → 目标" Width="190" DisplayMemberBinding="{Binding SourceTargetText}"/>
                                        <GridViewColumn Header="持久化" Width="110" DisplayMemberBinding="{Binding Persistence}"/>
                                        <GridViewColumn Header="备注" Width="150" DisplayMemberBinding="{Binding Comment}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="结构化">
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                       Text="nftables / iptables 结构化只读；UFW / firewalld 请使用“规则列表”。"/>
                            <ListView ItemsSource="{Binding StructuredRules}"
                                      BorderThickness="0" Background="Transparent" Padding="2">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding Kind}"/>
                                        <GridViewColumn Header="表/族" Width="100" DisplayMemberBinding="{Binding Table}"/>
                                        <GridViewColumn Header="链" Width="110" DisplayMemberBinding="{Binding Chain}"/>
                                        <GridViewColumn Header="目标/动作" Width="100" DisplayMemberBinding="{Binding Target}"/>
                                        <GridViewColumn Header="规则/表达式" Width="420" DisplayMemberBinding="{Binding Rule}"/>
                                        <GridViewColumn Header="备注" Width="120" DisplayMemberBinding="{Binding Comment}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="原始规则">
                        <TextBox Text="{Binding RawRulesText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource AppFontMonoFamily}"
                                 FontSize="{DynamicResource AppFontSizeMicro}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </TabItem>
                    <TabItem Header="备份">
                        <DockPanel Margin="6">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="刷新备份" Padding="12,4" Margin="0,0,8,0"
                                           Command="{Binding RefreshBackupsCommand}"/>
                                <ui:Button Content="恢复选中" Padding="12,4" Margin="0,0,8,0"
                                           Command="{Binding RestoreBackupCommand}"/>
                                <ui:Button Content="打开备份目录" Padding="12,4"
                                           Command="{Binding OpenBackupFolderCommand}"/>
                            </StackPanel>
                            <ListView ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                      BorderThickness="0" Background="Transparent" Padding="2">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="时间" Width="160" DisplayMemberBinding="{Binding CreatedAtText}"/>
                                        <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding BackendText}"/>
                                        <GridViewColumn Header="内容" Width="180" DisplayMemberBinding="{Binding Summary}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="12"
                        IsEnabled="{Binding CanEdit}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold"
                                       FontSize="{DynamicResource AppFontSizeSubtitle}" Margin="0,0,0,10"/>

                            <TextBlock Text="协议" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding Protocol, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <TextBlock Text="端口（必填；支持 80,443 / 5000:5010）" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ui:TextBox FontWeight="Normal" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                            <TextBlock Text="或服务名（如 ssh / http，端口留空）" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ui:TextBox FontWeight="Normal" Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                            <StackPanel Visibility="{Binding CanUseAddress, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AddressLabel}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AddressModeOptions}" SelectedItem="{Binding AddressMode, Mode=TwoWay}" Margin="0,0,0,6"/>
                                <ui:TextBox FontWeight="Normal" Text="{Binding RuleAddress, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsAddressSpecified, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,0,8"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CanUseZone, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="区域（空=默认区域）" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                                <ui:TextBox FontWeight="Normal" Text="{Binding Zone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            </StackPanel>

                            <TextBlock Text="策略" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action, Mode=TwoWay}" Margin="0,0,0,8"/>

                            <TextBlock Text="方向" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Direction, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEditOutbound}" Margin="0,0,0,8"/>

                            <TextBlock Text="备注" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,2"/>
                            <ui:TextBox FontWeight="Normal" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,10"
                                       Text="支持多个端口，如 80,88；端口范围 UFW 用 5000:5010，firewalld 用 5000-5010。默认防火墙无法完全管理 Docker 容器端口。SSH 端口规则禁止在此修改。"/>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{Binding SaveButtonText}" Appearance="Primary" Padding="12,4" Margin="0,0,8,0"
                                           Command="{Binding SaveRuleCommand}"/>
                                <ui:Button Content="删除选中" Padding="12,4" Margin="0,0,8,0"
                                           Command="{Binding DeleteRuleCommand}"/>
                                <ui:Button Content="取消编辑" Padding="12,4" Command="{Binding CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="16,0,16,10"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
    </Grid>
</ui:FluentWindow>
