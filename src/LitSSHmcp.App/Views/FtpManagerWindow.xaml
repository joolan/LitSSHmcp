<ui:FluentWindow x:Class="LitSSHmcp.App.Views.FtpManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="760" Width="1220" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>

        <DockPanel Grid.Row="1" Margin="12,6,12,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="连接" Appearance="Primary" Padding="12,4" Margin="0,0,6,0" Click="OnConnect"/>
                <ui:Button Content="断开" Padding="12,4" Margin="0,0,6,0" Click="OnDisconnect"/>
                <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="10,4" Margin="0,0,6,0" Click="OnRefresh"/>
                <ui:Button Content="暂停" Padding="10,4" Margin="0,0,6,0" Click="OnPauseTransfers"/>
                <ui:Button Content="继续" Padding="10,4" Margin="0,0,6,0" Click="OnResumeTransfers"/>
                <ui:Button Content="取消传输" Padding="10,4" Margin="0,0,6,0" Click="OnCancelTransfers"/>
                <ui:Button Content="重试失败" Padding="10,4" Margin="0,0,6,0" Click="OnRetryFailed"/>
                <TextBlock Text="冲突" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <ComboBox x:Name="ConflictPolicyBox" Width="92" Height="30" FontSize="11"
                          SelectionChanged="OnConflictPolicyChanged">
                    <ComboBoxItem Content="询问" Tag="Ask"/>
                    <ComboBoxItem Content="覆盖" Tag="Overwrite"/>
                    <ComboBoxItem Content="跳过" Tag="Skip"/>
                    <ComboBoxItem Content="重命名" Tag="Rename"/>
                    <ComboBoxItem Content="续传" Tag="Resume"/>
                </ComboBox>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="12,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>

        <Border Grid.Row="2" Margin="12,6,12,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource AppWarningSubtleBrush}" BorderBrush="{DynamicResource AppWarningBrush}"
                BorderThickness="1" Visibility="{Binding IsInsecure, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="当前站点使用明文 FTP：账号密码和文件内容不加密，建议改用 FTPS。"
                       Foreground="{DynamicResource AppWarningBrush}"/>
        </Border>

        <Grid Grid.Row="3" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="本地" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="上级" Padding="8,3" Margin="0,0,4,0" Click="OnLocalUp"/>
                    <Button Content="刷新" Padding="8,3" Margin="0,0,4,0" Click="OnLocalRefresh"/>
                    <Button Content="新建文件夹" Padding="8,3" Margin="0,0,4,0" Click="OnLocalNewFolder"/>
                    <Button Content="删除" Padding="8,3" Click="OnLocalDelete"/>
                </WrapPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Local.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,4" Padding="4,3"
                         KeyDown="OnLocalPathKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Local.StatusMessage}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                <ListView x:Name="LocalList" ItemsSource="{Binding Local.Items}" SelectedItem="{Binding Local.SelectedItem}"
                          SelectionMode="Extended" SelectionChanged="OnLocalSelectionChanged"
                          AllowDrop="True" DragOver="OnLocalDragOver" Drop="OnLocalDrop"
                          PreviewMouseLeftButtonDown="OnLocalPreviewMouseDown"
                          PreviewMouseMove="OnLocalPreviewMouseMove"
                          MouseDoubleClick="OnLocalDoubleClick" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="修改时间" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <ui:Button Content="上传 →" Padding="10,4" Margin="0,0,0,6" Appearance="Primary" Click="OnUpload"/>
                <ui:Button Content="← 下载" Padding="10,4" Click="OnDownload"/>
            </StackPanel>

            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="远程" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="上级" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteUp"/>
                    <Button Content="刷新" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteRefresh"/>
                    <Button Content="新建文件夹" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteNewFolder"/>
                    <Button Content="重命名" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteRename"/>
                    <Button Content="删除" Padding="8,3" Click="OnRemoteDelete"/>
                </WrapPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,4" Padding="4,3"
                         KeyDown="OnRemotePathKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" TextTrimming="CharacterEllipsis"/>
                <ListView x:Name="RemoteList" ItemsSource="{Binding RemoteItems}" SelectedItem="{Binding SelectedItem}"
                          SelectionMode="Extended" SelectionChanged="OnRemoteSelectionChanged"
                          AllowDrop="True" DragOver="OnRemoteDragOver" Drop="OnRemoteDrop"
                          PreviewMouseLeftButtonDown="OnRemotePreviewMouseDown"
                          PreviewMouseMove="OnRemotePreviewMouseMove"
                          MouseDoubleClick="OnRemoteDoubleClick" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="权限" Width="100" DisplayMemberBinding="{Binding Permissions}"/>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="修改时间" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="4" Margin="10,0,10,10">
            <TextBlock DockPanel.Dock="Top" Text="传输队列" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border Style="{DynamicResource CardBorderStyle}" Padding="8,4">
                <ListBox ItemsSource="{Binding Queue.Items}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Direction}" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding StartedText}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <ProgressBar Grid.Column="4" Height="14" Minimum="0" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="5" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
