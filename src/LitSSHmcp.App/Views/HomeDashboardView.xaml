<UserControl x:Class="LitSSHmcp.App.Views.HomeDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontMonoFamily}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="MetricHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeMicro}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MetricRingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontMonoFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LiveChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource AppSuccessSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SegmentGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeMicro}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssetRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssetCountStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontMonoFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
        </Style>
        <Style x:Key="MetricStatusBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AppSuccessSubtleBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource AppWarningSubtleBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="critical">
                    <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="critical">
                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 顶部状态：机器、健康评分、运行时长 -->
        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,12" DataContext="{Binding HomeDashboard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Server24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Text="本机运行中心" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,10,0"/>
                        <Border x:Name="HealthChip">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource LiveChipStyle}">
                                    <Setter Property="Background" Value="{DynamicResource AppSuccessSubtleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthWarning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppWarningSubtleBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHealthCritical}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthWarning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHealthCritical}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HealthText}" FontSize="{DynamicResource AppFontSizeMicro}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHealthCritical}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding MachineSummaryText}" Margin="0,8,0,0"
                               FontSize="{DynamicResource AppFontSizeBody}"/>
                    <TextBlock Text="{Binding CpuName}" Margin="0,3,0,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                    <TextBlock Text="{Binding HealthReasonText}" Margin="0,5,0,0"
                               FontSize="{DynamicResource AppFontSizeMicro}"
                               Style="{StaticResource MetricStatusText}"
                               Tag="{Binding HealthReasonLevel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProcessCountText}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastUpdatedText}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ui:Button Command="{Binding TogglePauseCommand}" Appearance="Transparent" BorderThickness="0"
                                   Height="20" Padding="4,0" Margin="0,0,2,0" VerticalAlignment="Center"
                                   ToolTip="{Binding LiveActionText}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LiveStatusText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent" BorderThickness="0"
                                   Height="20" Width="22" Padding="0" VerticalAlignment="Center"
                                   ToolTip="立即刷新" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Grid Width="108" Height="108">
                        <controls:ContextRing Percent="{Binding HealthPercent}" InvertScale="True"
                                              Width="108" Height="108"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HealthScore}" FontFamily="{DynamicResource AppFontMonoFamily}"
                                       FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="健康分" FontSize="{DynamicResource AppFontSizeMicro}"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 四张核心指标卡 -->
        <UniformGrid Columns="4" Margin="0,12,0,0" DataContext="{Binding HomeDashboard}">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Code24" FontSize="16"
                                       Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Text="CPU" Style="{StaticResource MetricLabelStyle}"/>
                        <Border Style="{StaticResource MetricStatusBorder}" Tag="{Binding CpuStatusLevel}">
                            <TextBlock Text="{Binding CpuStatusText}" Style="{StaticResource MetricStatusText}"
                                       Tag="{Binding CpuStatusLevel}"/>
                        </Border>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CpuPercentText}" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="{Binding CpuDetailText}" Style="{StaticResource MetricHintStyle}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="58" Height="58" VerticalAlignment="Center">
                            <controls:ContextRing Percent="{Binding CpuFraction}" Width="58" Height="58"/>
                            <TextBlock Text="{Binding CpuPercentText}" Style="{StaticResource MetricRingTextStyle}"/>
                        </Grid>
                    </Grid>
                    <controls:MetricSparkline Values="{Binding CpuHistory}" Height="34" Margin="0,8,0,0"
                                              Stroke="{DynamicResource AppAccentBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Database24" FontSize="16"
                                       Foreground="{DynamicResource AppSuccessBrush}"/>
                        <TextBlock Text="内存" Style="{StaticResource MetricLabelStyle}"/>
                        <Border Style="{StaticResource MetricStatusBorder}" Tag="{Binding MemoryStatusLevel}">
                            <TextBlock Text="{Binding MemoryStatusText}" Style="{StaticResource MetricStatusText}"
                                       Tag="{Binding MemoryStatusLevel}"/>
                        </Border>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding MemoryPercentText}" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="{Binding MemoryDetailText}" Style="{StaticResource MetricHintStyle}"/>
                            <TextBlock Text="{Binding MemorySecondaryText}" Style="{StaticResource MetricHintStyle}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="58" Height="58" VerticalAlignment="Center">
                            <controls:ContextRing Percent="{Binding MemoryFraction}" Width="58" Height="58"/>
                            <TextBlock Text="{Binding MemoryPercentText}" Style="{StaticResource MetricRingTextStyle}"/>
                        </Grid>
                    </Grid>
                    <controls:MetricSparkline Values="{Binding MemoryHistory}" Height="34" Margin="0,8,0,0"
                                              Stroke="{DynamicResource AppSuccessBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="16"
                                       Foreground="{DynamicResource AppWarningBrush}"/>
                        <TextBlock Text="磁盘" Style="{StaticResource MetricLabelStyle}"/>
                        <Border Style="{StaticResource MetricStatusBorder}" Tag="{Binding DiskStatusLevel}">
                            <TextBlock Text="{Binding DiskStatusText}" Style="{StaticResource MetricStatusText}"
                                       Tag="{Binding DiskStatusLevel}"/>
                        </Border>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DiskPercentText}" Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="{Binding DiskDetailText}" Style="{StaticResource MetricHintStyle}"/>
                            <TextBlock Text="{Binding DiskIoText}" Style="{StaticResource MetricHintStyle}"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="58" Height="58" VerticalAlignment="Center">
                            <controls:ContextRing Percent="{Binding DiskFraction}" Width="58" Height="58"/>
                            <TextBlock Text="{Binding DiskPercentText}" Style="{StaticResource MetricRingTextStyle}"/>
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding DiskSummaryText}" Style="{StaticResource MetricHintStyle}" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Share24" FontSize="16"
                                       Foreground="#FF9B8CFF"/>
                        <TextBlock Text="网络" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NetworkDownText}" Style="{StaticResource MetricValueStyle}" FontSize="26"/>
                    <TextBlock Text="{Binding NetworkUpText}" Style="{StaticResource MetricHintStyle}"
                               FontSize="{DynamicResource AppFontSizeBody}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <controls:MetricSparkline Values="{Binding NetworkHistory}" Height="46" Margin="0,8,0,0"
                                              Stroke="#FF9B8CFF"/>
                    <TextBlock Text="{Binding NetworkDetailText}" Style="{StaticResource MetricHintStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 趋势 + TOP 进程 + 资产概览 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0"
                    Style="{DynamicResource CardBorderStyle}" Padding="14,12"
                    DataContext="{Binding HomeDashboard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="History24" FontSize="16"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Text="本机趋势" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="1 分钟" Command="{Binding SetTrendRangeCommand}" CommandParameter="1 分钟">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrendRange1m}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="5 分钟" Command="{Binding SetTrendRangeCommand}" CommandParameter="5 分钟">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrendRange5m}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="15 分钟" Command="{Binding SetTrendRangeCommand}" CommandParameter="15 分钟">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrendRange15m}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <controls:MetricTrendChart Series="{Binding TrendSeries}" StartLabel="{Binding TrendStartLabel}"
                                               MinHeight="190" Margin="0,8,0,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Margin="0,0,12,0"
                    Style="{DynamicResource CardBorderStyle}" Padding="14,12"
                    DataContext="{Binding HomeDashboard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="16"
                                           Foreground="{DynamicResource AppSuccessBrush}"/>
                            <TextBlock Text="进程 TOP" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CPU" Command="{Binding SetProcessSortCommand}" CommandParameter="CPU">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessSortCpu}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="内存" Command="{Binding SetProcessSortCommand}" CommandParameter="内存">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessSortMemory}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Processes}" Margin="0,10,0,0">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RankText}" FontFamily="{DynamicResource AppFontMonoFamily}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                   FontFamily="{DynamicResource AppFontMonoFamily}"
                                                   FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    </Grid>
                                    <ProgressBar Height="3" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding BarPercent, Mode=OneWay}"
                                                 Foreground="{DynamicResource AppAccentBrush}"
                                                 Background="{DynamicResource AppBorderSubtleBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 资产概览：服务器 / 数据源 / 应用 / 远程桌面 / 端口转发 / 同步 / 触发 -->
            <Border Grid.Column="3" Style="{DynamicResource CardBorderStyle}" Padding="14,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="16"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Text="资产概览" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="点击进入管理" VerticalAlignment="Center"
                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                    </DockPanel>

                    <StackPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开 SSH 服务器管理"
                                Command="{Binding NavigateServersCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Server24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="SSH 服务器" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}">
                                        <Run Text="活跃会话 "/><Run Text="{Binding ActiveSessionCount, Mode=OneWay}"/>
                                        <Run Text=" · 已禁用 "/><Run Text="{Binding DisabledServerCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ServerCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开数据源管理"
                                Command="{Binding NavigateDataSourcesCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Database24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppSuccessBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="数据源" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock Text="MySQL / PostgreSQL / Redis" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DatasourceCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开应用管理"
                                Command="{Binding NavigateApplicationsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Apps24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppWarningBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="应用" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock Text="拓扑节点与应用路径" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ApplicationCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开远程桌面（RDP / VNC）"
                                Command="{Binding NavigateRemoteDesktopsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="远程桌面" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock Text="RDP / VNC · 支持 SSH 隧道" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding RemoteDesktopCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开端口转发"
                                Command="{Binding OpenPortForwardCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Share24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="端口转发" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}">
                                        <Run Text="运行中 "/><Run Text="{Binding PortForwardRunningCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding PortForwardCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开文件/文件夹同步"
                                Command="{Binding OpenSyncCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppSuccessBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="同步任务" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}">
                                        <Run Text="已启用 "/><Run Text="{Binding SyncTaskEnabledCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SyncTaskCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource AssetRowButton}" ToolTip="打开触发事件（git / webhook / 备份）"
                                Command="{Binding OpenTriggerCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Flash24" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppWarningBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="触发事件" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBlock FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}">
                                        <Run Text="已启用 "/><Run Text="{Binding TriggerEnabledCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TriggerCount}" Style="{StaticResource AssetCountStyle}"/>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="10"
                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
