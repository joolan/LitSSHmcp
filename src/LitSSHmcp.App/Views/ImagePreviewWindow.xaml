<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="图片预览" Height="720" Width="920" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="图片预览"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppSurfaceAltBrush}">
            <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="Caption" Margin="10,6,10,10" FontSize="11"
                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</ui:FluentWindow>
