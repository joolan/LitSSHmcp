<UserControl x:Class="LitSSHmcp.App.Views.JenkinsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        xmlns:vm="clr-namespace:LitSSHmcp.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:BooleanNotToVisibilityConverter x:Key="BoolNotToVis"/>
        <controls:JenkinsStatusIconConverter x:Key="JenkinsStatusIcon"/>
        <controls:JenkinsStatusBrushConverter x:Key="JenkinsStatusBrush"/>

        <Style x:Key="JenkinsJobItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="JenkinsJobRefTemplate">
            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="5,4"
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                       Command="{Binding DataContext.OpenJobRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       CommandParameter="{Binding}">
                <Grid MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Play24" FontSize="13"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </ui:Button>
        </DataTemplate>

        <DataTemplate x:Key="JenkinsJobTemplate">
            <Grid Margin="{Binding Indent}" MinHeight="26" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{Binding ExpandGlyph}" Width="20" Height="24"
                           Padding="0" Appearance="Transparent" BorderThickness="0"
                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                           Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}"/>
                <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="15"
                                   Foreground="{DynamicResource AppWarningBrush}"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ui:SymbolIcon Symbol="{Binding StatusKind, Converter={StaticResource JenkinsStatusIcon}}"
                                   FontSize="14"
                                   Foreground="{Binding StatusKind, Converter={StaticResource JenkinsStatusBrush}}"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolNotToVis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="{Binding StatusText}"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding Path}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="JenkinsMetaBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="JenkinsSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="JenkinsBuildItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Icon="Play24" Title="Jenkins"
                             Subtitle="连接、View 与构建任务">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="10,5"
                               Command="{Binding RefreshCommand}"/>
                    <ui:Button Content="添加连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Padding="12,5" Margin="2,0,0,0"
                               Command="{Binding AddConnectionCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <Border Padding="10,6" CornerRadius="7"
                        Background="{DynamicResource AppDangerSubtleBrush}"
                        BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppDangerBrush}"/>
                </Border>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource JenkinsSectionCard}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="PlugConnected24" FontSize="18"
                               Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}"
                          SelectedItem="{Binding SelectedConnection}"
                          MinWidth="280" MaxWidth="520" HorizontalAlignment="Left"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding EnvironmentDisplay}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ui:Button Grid.Column="2" Content="编辑" Icon="{ui:SymbolIcon Settings24}"
                           Padding="10,5" Margin="10,0,0,0"
                           Command="{Binding EditConnectionCommand}"/>

                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="10,8" CornerRadius="7" Margin="0,0,0,8"
                Background="{DynamicResource AppAccentSubtleBrush}"
                BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                Visibility="{Binding ShowQueuePanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <ui:Button DockPanel.Dock="Left" Content="{Binding QueueToggleText}" Icon="{ui:SymbolIcon ChevronRight24}"
                               Padding="10,4" Margin="0,0,10,0"
                               Command="{Binding ToggleQueueCommand}"/>
                    <ui:Button DockPanel.Dock="Right" Content="刷新队列" Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="10,4" Margin="8,0,0,0"
                               Command="{Binding RefreshQueueCommand}"/>
                    <TextBlock Text="{Binding QueueSummary}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding QueueItems}" Margin="0,7,0,0"
                              Visibility="{Binding IsQueueExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="5"
                                    Background="{DynamicResource AppCardBrush}"
                                    BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Flash24" FontSize="14"
                                                   Foreground="{DynamicResource AppAccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Content="取消" Padding="9,3"
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               Command="{Binding DataContext.CancelQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="230"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="10"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,8">
                        <StackPanel>
                            <TextBlock Text="任务" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeSubtitle}"/>
                            <TextBlock Text="{Binding SearchSummary}" Style="{DynamicResource MutedTextStyle}"
                                       Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SearchResultCount}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}" Width="Auto"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="搜索任务、文件夹或路径"
                                    AutomationProperties.Name="搜索 Jenkins 任务"/>
                    </Grid>

                    <TabControl Grid.Row="2" Grid.RowSpan="3" SelectedIndex="{Binding SidebarTabIndex}"
                                BorderThickness="0" Background="Transparent">
                        <TabItem Header="VIEW">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="VIEW" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="2,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}"
                                              DisplayMemberPath="DisplayName" MinHeight="30"
                                              ToolTip="{Binding SelectedViewDescription}"/>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <ListBox ItemsSource="{Binding JobRows}" SelectedItem="{Binding SelectedRow}"
                                             Visibility="{Binding HasSearch, Converter={StaticResource BoolNotToVis}}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ItemContainerStyle="{StaticResource JenkinsJobItemStyle}"
                                             ItemTemplate="{StaticResource JenkinsJobTemplate}"/>
                                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedRow}"
                                             Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource JenkinsJobItemStyle}"
                                             ItemTemplate="{StaticResource JenkinsJobTemplate}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasJobs, Converter={StaticResource BoolNotToVis}}">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="38"
                                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        <TextBlock Text="暂无任务" Style="{DynamicResource EmptyStateTitleStyle}" Margin="0,10,0,0"/>
                                        <TextBlock Text="选择连接或 View 后加载任务" Style="{DynamicResource EmptyStateHintStyle}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="最近访问">
                            <Grid>
                                <ListBox ItemsSource="{Binding FilteredRecentJobs}" SelectedItem="{Binding SelectedRow}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource JenkinsJobItemStyle}"
                                         ItemTemplate="{StaticResource JenkinsJobTemplate}"/>
                                <TextBlock Text="还没有最近访问的任务" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Style="{DynamicResource MutedTextStyle}"
                                           Visibility="{Binding HasFilteredRecent, Converter={StaticResource BoolNotToVis}}"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="收藏">
                            <Grid>
                                <ListBox ItemsSource="{Binding FilteredFavorites}" SelectedItem="{Binding SelectedRow}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource JenkinsJobItemStyle}"
                                         ItemTemplate="{StaticResource JenkinsJobTemplate}"/>
                                <TextBlock Text="还没有收藏的任务" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Style="{DynamicResource MutedTextStyle}"
                                           Visibility="{Binding HasFilteredFavorites, Converter={StaticResource BoolNotToVis}}"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource JenkinsSectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Play24" FontSize="21"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{Binding SelectedJobTitle}"
                                           FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedJobPath}" Margin="30,3,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedJobDescription}" Margin="30,5,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasJobDescription, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="30,8,0,0">
                                <Border Style="{StaticResource JenkinsMetaBadge}">
                                    <TextBlock Text="{Binding SelectedJobTypeLabel}"/>
                                </Border>
                                <Border Style="{StaticResource JenkinsMetaBadge}">
                                    <TextBlock Text="{Binding SelectedConnection.EnvironmentDisplay}"/>
                                </Border>
                                <Border Style="{StaticResource JenkinsMetaBadge}"
                                        Visibility="{Binding HasTunnel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="SSH 隧道"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedBuildStatusText}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="{Binding FavoriteActionText}" Icon="{ui:SymbolIcon Info24}"
                                       Padding="10,5" Margin="0,0,6,0"
                                       Command="{Binding ToggleFavoriteCommand}"/>
                            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Padding="10,5"
                                       Command="{Binding RefreshBuildCommand}"/>
                            <ui:Button Content="停止" Icon="{ui:SymbolIcon Stop24}"
                                       Padding="10,5"
                                       Foreground="{DynamicResource AppDangerBrush}"
                                       Command="{Binding StopBuildCommand}"/>
                            <ui:Button Content="构建" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                       Padding="14,5" Command="{Binding BuildCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="345" MinWidth="280"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource JenkinsSectionCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="构建参数" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Parameters.Count}"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TypeHint}"
                                                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="1">
                                                        <ui:TextBox FontWeight="Normal"
                                                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                    ToolTip="{Binding Description}"
                                                                    Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                                        <ComboBox ItemsSource="{Binding Choices}"
                                                                  SelectedItem="{Binding SelectedChoice}"
                                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"
                                                                  VerticalContentAlignment="Center"/>
                                                        <CheckBox Content="启用" VerticalAlignment="Center"
                                                                  IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"/>
                                                        <PasswordBox PasswordChanged="OnParameterPasswordChanged"
                                                                     Visibility="{Binding IsSecret, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="文件参数暂不支持在此上传，请到 Jenkins 页面执行"
                                                                   Style="{DynamicResource MutedTextStyle}"
                                                                   Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="该任务无参数" Style="{DynamicResource MutedTextStyle}"
                                               Visibility="{Binding HasParameters, Converter={StaticResource BoolNotToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource JenkinsSectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="构建历史" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BuildCount}"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox x:Name="BuildHistoryList" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnBuildHistoryPreviewMouseWheel"
                                             ItemContainerStyle="{StaticResource JenkinsBuildItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="9,7" CornerRadius="7" BorderThickness="1"
                                                        BorderBrush="{DynamicResource AppBorderSubtleBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Building}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AppWarningSubtleBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="SUCCESS">
                                                                    <Setter Property="Background" Value="{DynamicResource AppSuccessSubtleBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="FAILURE">
                                                                    <Setter Property="Background" Value="{DynamicResource AppDangerSubtleBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="1,0,9,0"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource AppTextTertiaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Building}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Result}" Value="SUCCESS">
                                                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Result}" Value="FAILURE">
                                                                            <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding TimestampText}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                                   FontSize="{DynamicResource AppFontSizeMicro}"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ui:Button Content="加载更多" Icon="{ui:SymbolIcon ChevronRight24}"
                                               HorizontalAlignment="Center" Padding="12,4" Margin="0,6,0,0"
                                               Visibility="{Binding HasMoreBuilds, Converter={StaticResource BoolToVis}}"
                                               Command="{Binding LoadMoreBuildsCommand}"/>
                                    <TextBlock Text="暂无构建记录" Style="{DynamicResource MutedTextStyle}"
                                               Visibility="{Binding HasBuilds, Converter={StaticResource BoolNotToVis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Style="{StaticResource JenkinsSectionCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="14,12,14,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <ui:SymbolIcon Symbol="Code24" FontSize="17"
                                                   Foreground="{DynamicResource AppAccentBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="构建详情" Style="{DynamicResource SectionTitleStyle}" Margin="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedBuildStatusText}" Margin="10,0,0,0"
                                               FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="跟随" IsChecked="{Binding IsLogFollow}" Margin="0,0,10,0"
                                              ToolTip="日志增长时自动滚动到底部"/>
                                    <ui:Button Content="刷新日志" Icon="{ui:SymbolIcon ArrowSync24}"
                                               Padding="10,5"
                                               Command="{Binding RefreshLogCommand}"/>
                                </StackPanel>
                            </DockPanel>
                            <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
                                <TabItem Header="日志">
                                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Padding="12,8"
                                             Background="{DynamicResource AppCodeBgBrush}"
                                             Foreground="{DynamicResource AppCodeTextBrush}"
                                             FontFamily="{DynamicResource AppFontMonoFamily}"
                                             FontSize="{DynamicResource AppFontSizeMicro}"
                                             TextChanged="OnLogTextChanged"/>
                                </TabItem>
                                <TabItem Header="阶段">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding PipelineStages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,7" Margin="0,0,0,5" CornerRadius="6"
                                                                Background="{DynamicResource AppSurfaceAltBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="当前构建没有 Pipeline 阶段信息"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{DynamicResource MutedTextStyle}"
                                                   Visibility="{Binding HasStages, Converter={StaticResource BoolNotToVis}}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="产物">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Artifacts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,7" Margin="0,0,0,5" CornerRadius="6"
                                                                Background="{DynamicResource AppSurfaceAltBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding RelativePath}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="当前构建没有产物"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{DynamicResource MutedTextStyle}"
                                                   Visibility="{Binding HasArtifacts, Converter={StaticResource BoolNotToVis}}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="测试">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <WrapPanel Margin="4,6,0,10"
                                                       Visibility="{Binding HasTestReport, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TestReport.Total, StringFormat=总计 {0}}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding TestReport.Passed, StringFormat=通过 {0}}" Margin="0,0,14,0"
                                                           Foreground="{DynamicResource AppSuccessBrush}"/>
                                                <TextBlock Text="{Binding TestReport.Failed, StringFormat=失败 {0}}" Margin="0,0,14,0"
                                                           Foreground="{DynamicResource AppDangerBrush}"/>
                                                <TextBlock Text="{Binding TestReport.Skipped, StringFormat=跳过 {0}}"/>
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding TestReport.Failures}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,7" Margin="0,0,0,5" CornerRadius="6"
                                                                Background="{DynamicResource AppDangerSubtleBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ClassName}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding ErrorDetails}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                                           TextWrapping="Wrap" MaxHeight="80"
                                                                           ToolTip="{Binding ErrorDetails}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="当前构建没有测试报告"
                                                       HorizontalAlignment="Center" Margin="0,20,0,0"
                                                       Style="{DynamicResource MutedTextStyle}"
                                                       Visibility="{Binding HasTestReport, Converter={StaticResource BoolNotToVis}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource AppCardBrush}" Opacity="0.62"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="38" Height="38"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource AppAccentBrush}"/>
        </Border>
    </Grid>
</UserControl>
