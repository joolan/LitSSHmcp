<ui:FluentWindow x:Class="LitSSHmcp.App.Views.JobListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="长任务" Height="640" Width="1040" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="长任务"/>

        <Grid Grid.Row="1" Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="刷新" Click="OnRefreshClick" Padding="12,5" Margin="0,0,8,0"/>
                <CheckBox x:Name="AutoRefresh" Content="自动刷新(2s)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="JobGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="OnJobSelectionChanged"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="任务" Binding="{Binding JobId}" Width="*"/>
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="150"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/>
                        <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="70"/>
                        <DataGridTextColumn Header="创建" Binding="{Binding CreatedAtText}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="任务详情" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DetailBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="查看结果" Click="OnResultClick" Padding="12,5" x:Name="ResultButton" IsEnabled="False"/>
                        <ui:Button Content="取消任务" Click="OnCancelClick" Padding="12,5" Margin="8,0,0,0"
                                   x:Name="CancelButton" IsEnabled="False"/>
                        <ui:Button Content="关闭" Click="OnCloseClick" Padding="12,5" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
