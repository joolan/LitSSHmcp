<ui:FluentWindow x:Class="LitSSHmcp.App.Views.KubernetesConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="{Binding WindowTitle}" Height="880" Width="620" MinWidth="540" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <controls:FormRow Label="连接名称" IsRequired="True"
                                      HelpText="例如：自检测试集群、正式集群、阿里云 ACK 生产">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="环境类型" HelpText="仅用于展示和风险提示；生产环境默认只读">
                        <ComboBox ItemsSource="{Binding EnvironmentOptions}" DisplayMemberPath="Label"
                                  SelectedIndex="{Binding SelectedEnvironmentIndex}" VerticalContentAlignment="Center"/>
                    </controls:FormRow>

                    <controls:FormRow Label="环境标签" HelpText="可选；例如“北京测试”“华东生产”。留空时显示环境类型">
                        <ui:TextBox FontWeight="Normal" Text="{Binding EnvironmentLabel, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="集群类型" HelpText="阿里云 ACK 仍使用标准 kubeconfig；这里仅做标识">
                        <ComboBox ItemsSource="{Binding ProviderOptions}" DisplayMemberPath="Label"
                                  SelectedIndex="{Binding SelectedProviderIndex}" VerticalContentAlignment="Center"/>
                    </controls:FormRow>

                    <controls:FormRow Label="访问方式" IsRequired="True"
                                      HelpText="本机不能直达 API Server 时，可选择一台能访问内网的 SSH 服务器执行 kubectl">
                        <ComboBox ItemsSource="{Binding AccessOptions}" DisplayMemberPath="Label"
                                  SelectedIndex="{Binding SelectedAccessIndex}" VerticalContentAlignment="Center"/>
                    </controls:FormRow>

                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}"
                            Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="本机 kubectl" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <controls:FormRow Label="kubeconfig 路径"
                                              HelpText="可留空使用默认 ~/.kube/config；与下方内容二选一">
                                <ui:TextBox FontWeight="Normal" Text="{Binding KubeconfigPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="C:\Users\me\.kube\config"/>
                            </controls:FormRow>
                            <controls:FormRow Label="kubeconfig 内容" HelpText="{Binding KubeconfigHint}">
                                <StackPanel>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding KubeconfigContent, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" Height="92" TextWrapping="NoWrap"
                                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                PlaceholderText="apiVersion: v1&#x0a;clusters: ..."/>
                                    <CheckBox Content="清除之前保存的 kubeconfig 内容" Margin="0,6,0,0"
                                              IsChecked="{Binding ClearSavedContent}"
                                              Visibility="{Binding HasSavedKubeconfigContent, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </controls:FormRow>
                            <controls:FormRow Label="kubectl 路径" HelpText="本机没有配置 PATH 时可填写完整路径">
                                <ui:TextBox FontWeight="Normal" Text="{Binding KubectlPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="kubectl"/>
                            </controls:FormRow>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}"
                            Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="通过 SSH 服务器执行 kubectl" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="适合阿里云 ACK 私网 API Server：kubectl 和 kubeconfig 已在该 SSH 服务器上配置好。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <controls:FormRow Label="SSH 服务器" IsRequired="True">
                                <ComboBox ItemsSource="{Binding SshServers}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding RemoteSshServerId}"
                                          VerticalContentAlignment="Center"/>
                            </controls:FormRow>
                            <controls:FormRow Label="远端 kubeconfig 路径" HelpText="可留空使用服务器默认 kubeconfig">
                                <ui:TextBox FontWeight="Normal" Text="{Binding RemoteKubeconfigPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="/home/ops/.kube/config"/>
                            </controls:FormRow>
                            <controls:FormRow Label="远端 kubectl 路径" HelpText="k3s 通常已有 kubectl 软链；没有时可填写包装脚本路径">
                                <ui:TextBox FontWeight="Normal" Text="{Binding RemoteKubectlPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="kubectl"/>
                            </controls:FormRow>
                        </StackPanel>
                    </Border>

                    <controls:FormRow Label="Context" HelpText="留空使用 kubeconfig 当前 context">
                        <ui:TextBox FontWeight="Normal" Text="{Binding ContextName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="例如：ack-prod"/>
                    </controls:FormRow>

                    <controls:FormRow Label="默认 Namespace" HelpText="留空表示全部/默认；仍可在主页面切换筛选">
                        <ui:TextBox FontWeight="Normal" Text="{Binding DefaultNamespace, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="default"/>
                    </controls:FormRow>

                    <controls:FormRow Label="超时（秒）">
                        <ui:TextBox FontWeight="Normal" Width="100" HorizontalAlignment="Left"
                                    Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="操作策略">
                        <StackPanel>
                            <CheckBox Content="允许写操作（扩缩容、重启、回滚、删除 Pod、节点调度）" IsChecked="{Binding AllowWrites, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="危险操作前二次确认（为后续写操作预留）" Margin="0,6,0,0"
                                      IsChecked="{Binding RequireConfirmation, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="启用此连接" Margin="0,6,0,0"
                                      IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="描述">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" Height="56" TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"/>
                    </controls:FormRow>

                    <Border Padding="10,8" CornerRadius="6" Margin="0,8,0,0"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="False" Style="{DynamicResource DialogFooterPanelStyle}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="删除连接" Icon="{ui:SymbolIcon Delete24}" MinWidth="92"
                           Foreground="{DynamicResource AppDangerBrush}"
                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                           Command="{Binding DeleteCommand}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="测试连接" MinWidth="92" Margin="0,0,8,0" Command="{Binding TestConnectionCommand}"/>
                <ui:Button Content="保存" MinWidth="88" Appearance="Primary" Margin="0,0,8,0"
                           IsDefault="True" Command="{Binding SaveCommand}"/>
                <ui:Button Content="取消" MinWidth="88" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
