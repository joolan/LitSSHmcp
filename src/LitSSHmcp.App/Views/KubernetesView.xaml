<UserControl x:Class="LitSSHmcp.App.Views.KubernetesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:BooleanNotToVisibilityConverter x:Key="BoolNotToVis"/>
        <Style x:Key="K8sCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="K8sStatCard" TargetType="Border" BasedOn="{StaticResource K8sCard}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="K8sTable" TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Icon="Cloud24" Title="Kubernetes"
                             Subtitle="多集群只读视图 · 自检 / 测试 / 生产 / 阿里云 ACK">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="自动刷新" IsChecked="{Binding IsAutoRefreshEnabled}"
                              VerticalAlignment="Center" Margin="0,0,6,0"
                              ToolTip="按选定间隔自动刷新当前集群"/>
                    <ComboBox ItemsSource="{Binding AutoRefreshOptions}" SelectedItem="{Binding AutoRefreshSeconds}"
                              Width="90" Margin="0,0,2,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="秒" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="10,5"
                               Command="{Binding RefreshCommand}"/>
                    <ui:Button Content="添加集群" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Padding="12,5" Margin="2,0,0,0" Command="{Binding AddConnectionCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <StackPanel>
                    <Border Padding="10,6" CornerRadius="7" Background="{DynamicResource AppDangerSubtleBrush}"
                            BorderBrush="{DynamicResource AppDangerBrush}" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                    </Border>
                    <Border Padding="10,6" CornerRadius="7" Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,6,0,0"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource K8sCard}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="PlugConnected24" FontSize="18"
                               Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}"
                          DisplayMemberPath="DisplayName" MinWidth="260" MaxWidth="420"
                          HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="12" Margin="0,0,5,0"
                                           Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionEnvironment}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding ConnectionProvider}" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource AppWarningSubtleBrush}" BorderBrush="{DynamicResource AppWarningBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8,3"
                            Visibility="{Binding IsHighRiskConnection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="12" Margin="0,0,4,0"
                                           Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="生产环境 · 只读" FontSize="{DynamicResource AppFontSizeMicro}"
                                       Foreground="{DynamicResource AppWarningBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ComboBox Grid.Column="3" ItemsSource="{Binding NamespaceFilters}" SelectedItem="{Binding SelectedNamespace}"
                          MinWidth="150" MaxWidth="220" Margin="10,0,0,0" VerticalContentAlignment="Center"
                          ToolTip="按命名空间筛选工作负载、Pod 和事件"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Padding="8,5" ToolTip="编辑当前连接"
                               Command="{Binding EditConnectionCommand}"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Padding="8,5" Appearance="Transparent"
                               ToolTip="删除当前连接" Command="{Binding DeleteConnectionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource K8sStatCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AppAccentSubtleBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Cloud24" FontSize="17" Foreground="{DynamicResource AppAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="集群版本" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Version}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource K8sStatCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AppSuccessSubtleBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Server24" FontSize="17" Foreground="{DynamicResource AppSuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="节点就绪" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NodeHealth}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource K8sStatCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AppAccentSubtleBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="17" Foreground="{DynamicResource AppAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pod 运行" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PodHealth}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource K8sStatCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AppWarningSubtleBrush}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="17" Foreground="{DynamicResource AppWarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Warning 事件" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WarningHealth}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="3">
            <TabItem Header="巡检">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="巡检结论" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding HealthStatusText}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="节点异常" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding HealthNodeIssueCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="Pod 异常" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding HealthPodIssueCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="工作负载异常" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding HealthWorkloadIssueCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource K8sStatCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="存储 / 事件" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0">
                                    <Run Text="{Binding HealthStorageIssueCount, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding HealthWarningCount, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource K8sCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="14,12,14,8">
                                <TextBlock Text="只读巡检问题" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding HealthIssueCount}"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </DockPanel>
                            <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding HealthIssues}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="级别" Width="65" DisplayMemberBinding="{Binding Severity}"/>
                                        <GridViewColumn Header="分类" Width="85" DisplayMemberBinding="{Binding Category}"/>
                                        <GridViewColumn Header="命名空间" Width="130" DisplayMemberBinding="{Binding Namespace}"/>
                                        <GridViewColumn Header="对象" Width="210" DisplayMemberBinding="{Binding Object}"/>
                                        <GridViewColumn Header="问题" Width="620" DisplayMemberBinding="{Binding Message}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Grid.Row="1" Text="未发现明显异常" Style="{DynamicResource MutedTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasHealthIssues, Converter={StaticResource BoolNotToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

                        <TabItem Header="发布对比">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource K8sCard}" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Foreground="{DynamicResource AppAccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="基线" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding CompareBaseline}" MinWidth="220" Margin="0,0,12,0"
                                      VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Connections}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding CompareTarget}" MinWidth="220" VerticalContentAlignment="Center"/>
                            <CheckBox Grid.Column="3" Content="仅显示差异" IsChecked="{Binding ShowOnlyDifferences}"
                                      VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <ui:Button Grid.Column="4" Content="开始对比" Icon="{ui:SymbolIcon Play24}"
                                       Appearance="Primary" Padding="12,5" Command="{Binding CompareReleasesCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="基线工作负载" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ComparisonBaselineCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="目标工作负载" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ComparisonTargetCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource K8sStatCard}">
                            <StackPanel>
                                <TextBlock Text="差异项" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ComparisonDifferenceCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource K8sStatCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="单边存在" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ComparisonMissingCount}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Padding="10,6" CornerRadius="7" Margin="0,0,0,8"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            Visibility="{Binding HasCompareStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CompareStatusMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Border>

                    <TabControl Grid.Row="3">
                        <TabItem Header="工作负载差异">
                            <Border Style="{StaticResource K8sCard}" Padding="0" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="14,12,14,8">
                                        <TextBlock Text="镜像 / 副本 / 资源 / 状态" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding ComparisonDifferenceCount}"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                                    </DockPanel>
                                    <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding ComparisonRows}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="命名空间" Width="110" DisplayMemberBinding="{Binding Namespace}"/>
                                                <GridViewColumn Header="类型" Width="85" DisplayMemberBinding="{Binding Kind}"/>
                                                <GridViewColumn Header="名称" Width="145" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="基线镜像" Width="210" DisplayMemberBinding="{Binding BaselineImage}"/>
                                                <GridViewColumn Header="目标镜像" Width="210" DisplayMemberBinding="{Binding TargetImage}"/>
                                                <GridViewColumn Header="基线副本" Width="65" DisplayMemberBinding="{Binding BaselineReplicas}"/>
                                                <GridViewColumn Header="目标副本" Width="65" DisplayMemberBinding="{Binding TargetReplicas}"/>
                                                <GridViewColumn Header="基线资源" Width="130" DisplayMemberBinding="{Binding BaselineResources}"/>
                                                <GridViewColumn Header="目标资源" Width="130" DisplayMemberBinding="{Binding TargetResources}"/>
                                                <GridViewColumn Header="差异" Width="115" DisplayMemberBinding="{Binding Difference}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Grid.Row="1" Text="没有差异项" Style="{DynamicResource MutedTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasComparisonRows, Converter={StaticResource BoolNotToVis}}"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Ingress 差异">
                            <Border Style="{StaticResource K8sCard}" Padding="0" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="14,12,14,8">
                                        <TextBlock Text="Host / Class" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                    </DockPanel>
                                    <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding IngressComparisonRows}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="命名空间" Width="110" DisplayMemberBinding="{Binding Namespace}"/>
                                                <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="基线 Class" Width="110" DisplayMemberBinding="{Binding BaselineClass}"/>
                                                <GridViewColumn Header="目标 Class" Width="110" DisplayMemberBinding="{Binding TargetClass}"/>
                                                <GridViewColumn Header="基线 Host" Width="210" DisplayMemberBinding="{Binding BaselineHosts}"/>
                                                <GridViewColumn Header="目标 Host" Width="210" DisplayMemberBinding="{Binding TargetHosts}"/>
                                                <GridViewColumn Header="差异" Width="115" DisplayMemberBinding="{Binding Difference}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Grid.Row="1" Text="没有 Ingress 差异" Style="{DynamicResource MutedTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasIngressComparisonRows, Converter={StaticResource BoolNotToVis}}"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

                        <TabItem Header="节点">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource K8sCard}" Margin="0,0,10,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="14,12,14,8">
                                <TextBlock Text="节点状态" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding NodeCount}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ui:Button Content="Cordon" Padding="8,3" MinWidth="64"
                                               Command="{Binding CordonNodeCommand}" ToolTip="禁止新的 Pod 调度到选中节点"/>
                                    <ui:Button Content="Uncordon" Padding="8,3" MinWidth="72" Margin="4,0,0,0"
                                               Command="{Binding UncordonNodeCommand}" ToolTip="恢复选中节点调度"/>
                                </StackPanel>
                            </DockPanel>
                            <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="节点" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="状态" Width="110" DisplayMemberBinding="{Binding Status}"/>
                                        <GridViewColumn Header="角色" Width="120" DisplayMemberBinding="{Binding Roles}"/>
                                        <GridViewColumn Header="版本" Width="120" DisplayMemberBinding="{Binding Version}"/>
                                        <GridViewColumn Header="CPU 容量" Width="85">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding CpuDisplay}" ToolTip="{Binding Cpu}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="CPU 用量" Width="115">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding CpuUsageDisplay}" ToolTip="{Binding CpuUsageTooltip}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="内存容量" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding MemoryDisplay}" ToolTip="{Binding Memory}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="内存用量" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding MemoryUsageDisplay}" ToolTip="{Binding MemoryUsageTooltip}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Pod" Width="55" DisplayMemberBinding="{Binding Pods}"/>
                                        <GridViewColumn Header="年龄" Width="75" DisplayMemberBinding="{Binding Age}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Grid.Row="1" Text="暂无节点数据" Style="{DynamicResource MutedTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNodes, Converter={StaticResource BoolNotToVis}}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource K8sCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="14,12,14,8">
                                <TextBlock Text="命名空间" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding NamespaceCount}" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </DockPanel>
                            <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding Namespaces}">
                                <ListView.View>
