                            </ListView>
                            <TextBlock Grid.Row="1" Text="暂无 PVC 数据" Style="{DynamicResource MutedTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasPvcs, Converter={StaticResource BoolNotToVis}}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource K8sCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="14,12,14,8">
                                <TextBlock Text="StorageClass" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="集群级 · K3s 默认 local-path" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                            </DockPanel>
                            <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding StorageClasses}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Provisioner" Width="170" DisplayMemberBinding="{Binding Provisioner}"/>
                                        <GridViewColumn Header="回收策略" Width="80" DisplayMemberBinding="{Binding ReclaimPolicy}"/>
                                        <GridViewColumn Header="默认" Width="55" DisplayMemberBinding="{Binding Default}"/>
                                        <GridViewColumn Header="年龄" Width="50" DisplayMemberBinding="{Binding Age}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Grid.Row="1" Text="暂无 StorageClass 数据" Style="{DynamicResource MutedTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasStorageClasses, Converter={StaticResource BoolNotToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="事件">
                <Border Style="{StaticResource K8sCard}" Margin="0,8,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="14,12,14,8">
                            <TextBlock Text="集群事件" Style="{DynamicResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding SelectedNamespace}" Foreground="{DynamicResource AppTextTertiaryBrush}"/>
                        </DockPanel>
                        <ListView Grid.Row="1" Style="{StaticResource K8sTable}" ItemsSource="{Binding Events}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="原因" Width="150" DisplayMemberBinding="{Binding Reason}"/>
                                    <GridViewColumn Header="命名空间" Width="140" DisplayMemberBinding="{Binding Namespace}"/>
                                    <GridViewColumn Header="对象" Width="220" DisplayMemberBinding="{Binding Object}"/>
                                    <GridViewColumn Header="消息" Width="480" DisplayMemberBinding="{Binding Message}"/>
                                    <GridViewColumn Header="次数" Width="55" DisplayMemberBinding="{Binding Count}"/>
                                    <GridViewColumn Header="年龄" Width="75" DisplayMemberBinding="{Binding Age}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="暂无事件数据" Style="{DynamicResource MutedTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasEvents, Converter={StaticResource BoolNotToVis}}"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8"
                Visibility="{Binding HasNoConnection, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AppAccentSubtleBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <ui:SymbolIcon Symbol="Cloud24" FontSize="28" Foreground="{DynamicResource AppAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="还没有 K8s 集群连接" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="添加自检/测试、正式环境或阿里云 ACK，使用 kubeconfig 或 SSH 服务器上的 kubectl 进行只读查看。"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <ui:Button Content="添加集群连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                           Padding="14,6" HorizontalAlignment="Center" Command="{Binding AddConnectionCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
