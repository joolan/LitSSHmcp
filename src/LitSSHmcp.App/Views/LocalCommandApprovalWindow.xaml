<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.LocalCommandApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机命令审批" Width="640" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="本机命令审批"/>
        <StackPanel Grid.Row="1" Margin="16,0,16,14">
            <TextBlock Text="AI 请求在本机 PowerShell 终端执行以下命令：" TextWrapping="Wrap"/>
            <TextBlock x:Name="SessionText" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,3,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="CwdText" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,3,0,8"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="CommandText" IsReadOnly="True" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="13"
                     TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource AppCodeBgBrush}" Padding="8" BorderThickness="0"/>
            <TextBlock Text="仅白名单内的 CLI 会被放行；命令与输出对用户可见。请确认无误后再允许。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="放行范围（默认仅允许一次；白名单与危险拦截仍然生效）" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <CheckBox x:Name="RoundBox" Content="本轮次内允许全部命令（不建议：后续命令不再逐条确认，下一条用户消息后恢复审批）"
                      Margin="2,0,0,2" Checked="OnRoundChecked"/>
            <CheckBox x:Name="SessionBox" Content="本次 AI 会话期间允许全部命令（不建议：本会话后续命令均不再确认）" Foreground="{DynamicResource AppDangerBrush}"
                      Margin="2,0,0,2" Checked="OnSessionChecked"/>
            <TextBlock x:Name="SessionHint" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeCaption}"
                       Margin="2,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="拒绝" Width="96" Margin="0,0,8,0" Click="OnDeny" IsCancel="True"/>
                <ui:Button Content="总是允许此命令" Width="150" Margin="0,0,8,0" Click="OnAlways" ToolTip="写入配置永久记住该命令（重启/升级后仍有效）"/>
                <ui:Button Content="允许一次" Appearance="Primary" Width="96" Click="OnAllow" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
