<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.LogSliceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="筛选日志并保存" Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="筛选日志并保存"/>
        <StackPanel Grid.Row="1" Margin="16,0,16,14">
            <TextBlock Text="源日志" Margin="0,0,0,4" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>

            <TextBlock Text="关键字 / 正则（留空 = 不过滤）" Margin="0,10,0,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ui:TextBox x:Name="KeywordBox" MinHeight="30" VerticalContentAlignment="Center"
                        PlaceholderText="例如：/api/order、Exception、timeout|refused"/>

            <CheckBox x:Name="TimeCheck" Content="按时间范围过滤" Margin="0,10,0,0"
                      Checked="OnTimeCheckChanged" Unchecked="OnTimeCheckChanged"/>
            <Grid x:Name="RangePanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="开始时间" Margin="0,0,0,6"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ui:TextBox x:Name="StartBox" MinHeight="30" VerticalContentAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Bottom" Margin="10,0,10,7"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="结束时间" Margin="0,0,0,6"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ui:TextBox x:Name="EndBox" MinHeight="30" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="LimitCheck" Content="只扫描最近 N 行（不勾选 = 整个文件，大文件可能较慢）"
                      Margin="0,10,0,0" Checked="OnLimitCheckChanged" Unchecked="OnLimitCheckChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:TextBox x:Name="ScanLinesBox" Width="120" MinHeight="30" VerticalContentAlignment="Center"
                            Text="200000" IsEnabled="False"/>
                <TextBlock Text="行" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock Text="输出文件（远端绝对路径，同名文件会被覆盖）" Margin="0,10,0,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ui:TextBox x:Name="OutputBox" MinHeight="30" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="NoteText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="命令会在右侧终端执行；完成后点文件面板的刷新按钮，找到输出文件再下载。时间过滤支持行首 ISO（yyyy-MM-dd HH:mm:ss / T）、yyyy/MM/dd 和 nginx/Apache 的 [dd/Mon/yyyy:HH:mm:ss；syslog 请改用关键字。"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="开始写入" Appearance="Primary" Width="110" Margin="0,0,8,0"
                           Click="OnOk" IsDefault="True"/>
                <ui:Button Content="取消" Width="86" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
