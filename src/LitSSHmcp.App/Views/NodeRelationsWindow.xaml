<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.NodeRelationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="节点关系" Height="480" Width="660"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="节点关系"/>
        <Grid Grid.Row="1">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>

        <ListView Grid.Row="1" x:Name="RelationList" SelectionChanged="OnSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="起点" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FromLabel}" ToolTip="{Binding From}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#222222"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FromIsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="#B00020"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="关系" Width="100" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="终点" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ToLabel}" ToolTip="{Binding To}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#222222"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToIsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="#B00020"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="备注" Width="110" DisplayMemberBinding="{Binding Note}"/>
                    <GridViewColumn Header="来源" Width="80" DisplayMemberBinding="{Binding Source}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="关系类型:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" x:Name="TypeBox" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="2" Text="备注:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="NoteBox" VerticalContentAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存修改" Width="90" Padding="6,4" Margin="0,0,6,0" Click="OnSave"/>
            <Button Content="删除选中" Width="90" Padding="6,4" Margin="0,0,6,0" Click="OnDelete"/>
            <Button Content="关闭" Width="70" Padding="6,4" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Grid>
    </Grid>
</ui:FluentWindow>
