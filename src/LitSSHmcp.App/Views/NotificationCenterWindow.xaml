<ui:FluentWindow x:Class="LitSSHmcp.App.Views.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="通知中心" Height="640" Width="900" MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="通知中心"/>

        <DockPanel Grid.Row="1" Margin="16,8,16,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="通知设置" Padding="12,4" Margin="0,0,8,0" Click="OnOpenSettings"/>
                <ui:Button Content="全部已读" Padding="12,4" Margin="0,0,8,0" Click="OnMarkAllRead"/>
                <ui:Button Content="清空" Padding="12,4" Click="OnClear"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="2" Margin="16,0,16,0">
            <TabItem Header="消息">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="210" Margin="0,0,8,0"
                                 ToolTip="搜索标题/来源/内容" TextChanged="OnFilterChanged"/>
                        <ComboBox x:Name="TypeFilter" Width="180" Margin="0,0,8,0"
                                  SelectionChanged="OnFilterChanged" ToolTip="消息类型"/>
                        <ComboBox x:Name="SeverityFilter" Width="120" Margin="0,0,8,0"
                                  SelectionChanged="OnFilterChanged" ToolTip="严重级别"/>
                        <CheckBox x:Name="UnreadOnly" Content="仅未读" VerticalAlignment="Center"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="NotificationList"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource AppAccentBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                <TextBlock Text="{Binding TypeText}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="投递记录">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="刷新" Padding="12,4" Margin="0,0,8,0" Click="OnRefreshDeliveries"/>
                        <ui:Button Content="重试选中" Padding="12,4" Click="OnRetryDelivery"/>
                        <TextBlock x:Name="DeliveryStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}"/>
                    </StackPanel>
                    <DataGrid x:Name="DeliveryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False"
                              CanUserDeleteRows="False" RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="130"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="170"/>
                            <DataGridTextColumn Header="渠道" Binding="{Binding Channel}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="尝试" Binding="{Binding Attempts}" Width="60"/>
                            <DataGridTextColumn Header="下次重试" Binding="{Binding NextAttemptText}" Width="130"/>
                            <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="通知持久化到本机；渠道与消息类型路由可在通知设置中配置。"
                   Margin="16,8,16,12" FontSize="{DynamicResource AppFontSizeMicro}"
                   Foreground="{DynamicResource AppTextTertiaryBrush}"/>
    </Grid>
</ui:FluentWindow>
