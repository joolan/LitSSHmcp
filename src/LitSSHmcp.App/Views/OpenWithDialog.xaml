<ui:FluentWindow x:Class="LitSSHmcp.App.Views.OpenWithDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="打开方式" Height="520" Width="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="打开方式"/>

        <TextBlock Grid.Row="1" x:Name="FileText" Margin="14,6,14,8" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>

        <ListBox Grid.Row="2" x:Name="List" Margin="14,0,14,0" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Exe}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="14,10,14,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="确定" Appearance="Primary" Padding="18,4" IsDefault="True" Margin="0,0,8,0" Click="OnOk"/>
                <ui:Button Content="取消" Padding="16,4" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
            <ui:Button Content="浏览…" Padding="14,4" Click="OnBrowse"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
