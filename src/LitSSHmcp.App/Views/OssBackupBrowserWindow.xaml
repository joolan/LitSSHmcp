<ui:FluentWindow x:Class="LitSSHmcp.App.Views.OssBackupBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OSS 备份" Height="620" Width="1120" MinHeight="460" MinWidth="860"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OSS 备份"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="12,4,12,8">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="12,4" Click="OnRefresh"/>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EndpointText" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="12,0,12,8">
            <ListView x:Name="OssList" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件" Width="360" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="时间" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding EncryptedText}"/>
                        <GridViewColumn Header="OSS 路径" Width="360" DisplayMemberBinding="{Binding Key}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="12,0,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="下载到…" Appearance="Primary" Padding="12,4" Margin="0,0,8,0" Click="OnDownload"/>
                <ui:Button Content="关闭" Padding="12,4" Click="OnClose"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
