<UserControl x:Class="LitSSHmcp.App.Views.PerformanceDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18,8,18,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="刷新" Padding="12,4" Margin="0,0,6,0" Command="{Binding RefreshCommand}"/>
                    <ui:Button Content="复制诊断" Padding="12,4" Margin="0,0,6,0" Command="{Binding CopyCommand}"/>
                    <ui:Button Content="打开日志目录" Padding="12,4" Command="{Binding OpenLogFolderCommand}"/>
                </StackPanel>
                <TextBlock Text="性能诊断" FontSize="{DynamicResource AppFontSizeTitle}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding Summary}" Margin="0,12,0,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastUpdatedText}" Margin="0,4,0,0"
                       FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"/>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,14,0,0" Padding="0">
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Margin="12,0,0,0"
                                           FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding LogStatus}" Margin="0,14,0,6"
                       FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextTertiaryBrush}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding RecentLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource AppFontMonoFamily}"
                     FontSize="{DynamicResource AppFontSizeMicro}"
                     Background="{DynamicResource AppSurfaceAltBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
