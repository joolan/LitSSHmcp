<UserControl x:Class="LitSSHmcp.App.Views.PetSettingsView"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Border Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="桌面宠物" FontSize="{DynamicResource AppFontSizeTitle}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <CheckBox Content="启用桌面宠物" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,12"
                               Text="宠物使用独立透明置顶窗口，主程序最小化到托盘后仍会显示。当前版本使用程序内占位宠物；后续支持 PNG / GIF 素材包导入。"/>
                    <TextBlock Text="主程序最小化时点击宠物会恢复主程序并打开 AI 运维助手；主程序已显示时点击会切换到 AI 运维助手。按住鼠标左键可拖动宠物位置。" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="宠物素材" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ComboBox Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,6"
                              ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button Content="制作素材包…" Padding="12,4" Margin="0,0,6,6" Click="OnCreateAsset"/>
                        <ui:Button Content="编辑素材包…" Padding="12,4" Margin="0,0,6,6" Click="OnEditAsset"/>
                        <ui:Button Content="复制素材" Padding="12,4" Margin="0,0,6,6" Click="OnCopyAsset"/>
                        <ui:Button Content="重命名素材" Padding="12,4" Margin="0,0,6,6" Click="OnRenameAsset"/>
                        <ui:Button Content="导入文件夹…" Padding="12,4" Margin="0,0,6,6" Click="OnImportFolder"/>
                        <ui:Button Content="导入 ZIP…" Padding="12,4" Margin="0,0,6,6" Click="OnImportZip"/>
                        <ui:Button Content="删除素材" Padding="12,4" Margin="0,0,6,6" Click="OnDeleteAsset"/>
                        <ui:Button Content="导出素材" Padding="12,4" Margin="0,0,6,6" Click="OnExportAsset"/>
                        <ui:Button Content="重置位置" Padding="12,4" Margin="0,0,0,6" Click="OnResetPosition"/>
                    </WrapPanel>
                    <TextBlock Text="素材包需包含 pet.json，支持 PNG 序列帧和 GIF；单帧最大 1024×1024，素材包最大 50MB。内置示例采用 MIT 许可，可编辑或导出作为模板，导出包包含来源与许可证信息。" Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}" Padding="8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Image x:Name="PreviewImage" Width="160" Height="160" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="素材预览" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="{DynamicResource AppFontSizeMicro}"/>
                                <TextBlock x:Name="CacheInfoText" TextWrapping="Wrap" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                           FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="缩放" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Scale, StringFormat={}{0:0.0}x}" Width="54"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding Scale, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="透明度" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat={}{0:P0}}" Width="54"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Opacity, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="移动速度" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Speed, StringFormat={}{0} px/s}" Width="80"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider Minimum="10" Maximum="240" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding Speed, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <CheckBox Content="允许自动移动" IsChecked="{Binding MovementEnabled, Mode=TwoWay}" Margin="0,0,0,6"/>
                    <CheckBox Content="窗口置顶" IsChecked="{Binding TopMost, Mode=TwoWay}" Margin="0,0,0,6"/>
                    <CheckBox Content="减少动态效果（停止自动移动和动画）" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="保存并应用" Appearance="Primary" Padding="14,5" Click="OnSave"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
