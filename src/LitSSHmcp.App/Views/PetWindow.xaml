<Window x:Class="LitSSHmcp.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="LitSSH Pet" Width="160" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        PreviewMouseLeftButtonDown="OnMouseDown"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseLeftButtonUp="OnMouseUp"
        Closing="OnClosing">
    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开 AI 运维助手" Click="OnOpenAi"/>
                <MenuItem Header="隐藏宠物" Click="OnHidePet"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Image x:Name="PetImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="False"/>
        <Popup x:Name="BubblePopup"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               Placement="Top" AllowsTransparency="True" StaysOpen="False" IsHitTestVisible="True">
            <Border x:Name="BubbleBorder" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10,7" MaxWidth="220">
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap"
                           FontSize="{DynamicResource AppFontSizeCaption}"/>
            </Border>
        </Popup>
    </Grid>
</Window>
