<ui:FluentWindow x:Class="LitSSHmcp.App.Views.PortForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:LitSSHmcp.Core.Models;assembly=LitSSHmcp.Core"
        Title="端口转发" Height="640" Width="900"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="端口转发（本地 / 远程 / 动态 SOCKS）"/>

        <DockPanel Grid.Row="1" Margin="10,8,10,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Padding="12,3" Margin="0,0,6,0" Command="{Binding AddCommand}"/>
                <ui:Button Content="保存定义" Icon="{ui:SymbolIcon Save24}" Padding="12,3" Command="{Binding SaveCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="10,0,10,10" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <!-- 行1：名称（最左）… 状态 · 操作（最右） -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button DockPanel.Dock="Right" Content="删除" Padding="10,3" Margin="6,0,0,0" Click="OnRemove"/>
                                        <ui:Button DockPanel.Dock="Right" Content="停止" Padding="10,3" Margin="6,0,0,0"
                                                   IsEnabled="{Binding IsRunning}" Click="OnStop"/>
                                        <ui:Button DockPanel.Dock="Right" Content="启动" Padding="10,3" Appearance="Primary" Margin="6,0,0,0"
                                                   IsEnabled="{Binding IsIdle}" Click="OnStart"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center"
                                               MinWidth="150" HorizontalAlignment="Right" Margin="12,0,12,0"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="名称:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ui:TextBox FontWeight="Normal" Width="360" PlaceholderText="规则名称（例：本机→Jenkins）"
                                                   Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 行2：服务器 · 类型 · 自动启动 -->
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding ServerId, Mode=TwoWay}" Width="190" Margin="0,0,16,0"/>
                                    <TextBlock Text="类型:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Type, Mode=TwoWay}" Width="170" Margin="0,0,16,0"/>
                                    <CheckBox Content="打开时自动启动" IsChecked="{Binding AutoStart, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </WrapPanel>

                                <!-- 行3：监听地址/端口 · 目标（动态转发隐藏） -->
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="本机监听:"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PortForwardType.Remote}">
                                                        <Setter Property="Text" Value="服务器监听:"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PortForwardType.Dynamic}">
                                                        <Setter Property="Text" Value="SOCKS 监听:"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BindHost, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,6,0"
                                               PlaceholderText="127.0.0.1" ToolTip="监听地址；留空 = 0.0.0.0（对所有网卡开放，谨慎）"/>
                                    <TextBlock Text="⚠ 对所有网卡开放" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AppDangerBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BindHost}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BindPortText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,4,0"
                                               ToolTip="1-65535"/>
                                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PortForwardType.Dynamic}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="目标 Host:"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PortForwardType.Remote}">
                                                            <Setter Property="Text" Value="回连目标:"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,6,0"
                                                   PlaceholderText="127.0.0.1"
                                                   ToolTip="本地转发：经服务器到达的目标；远程转发：服务器可达、回连到的目标"/>
                                        <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ui:TextBox FontWeight="Normal" Text="{Binding TargetPortText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                   ToolTip="1-65535"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
