<ui:FluentWindow x:Class="LitSSHmcp.App.Views.PortForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="端口转发" Height="640" Width="900"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="端口转发（本地 / 远程 / 动态 SOCKS）"/>

        <DockPanel Grid.Row="1" Margin="10,8,10,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Padding="12,3" Margin="0,0,6,0" Command="{Binding AddCommand}"/>
                <ui:Button Content="保存定义" Icon="{ui:SymbolIcon Save24}" Padding="12,3" Command="{Binding SaveCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="10,0,10,10" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="删除" Padding="10,3" Margin="6,0,0,0" Click="OnRemove"/>
                                    <ui:Button DockPanel.Dock="Right" Content="停止" Padding="10,3" Margin="6,0,0,0" Click="OnStop"/>
                                    <ui:Button DockPanel.Dock="Right" Content="启动" Padding="10,3" Appearance="Primary" Margin="6,0,0,0" Click="OnStart"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                </DockPanel>

                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding ServerId, Mode=TwoWay}" Width="160" Margin="0,0,12,0"/>
                                    <TextBlock Text="类型:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" Width="110"/>
                                </WrapPanel>

                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="监听 Host:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BindHost, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding BindPortText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0"/>
                                    <TextBlock Text="目标 Host:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBox FontWeight="Normal" Text="{Binding TargetPortText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,12,0"/>
                                    <CheckBox Content="打开时自动启动" IsChecked="{Binding AutoStart, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
