<UserControl x:Class="LitSSHmcp.App.Views.PromptTemplatesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：模板列表 -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="提示词模板" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="（/开头的快捷指令）" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,2"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="新增" Padding="12,4" Command="{Binding AddCommand}"/>
                <ui:Button Content="删除" Padding="12,4" Margin="6,0,0,0" Command="{Binding DeleteCommand}"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding CommandPreview}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding Description}" FontSize="10" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- 右：编辑 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="命令名（输入框里以「/命令名」触发，不含斜杠）:" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="说明（在选择面板中显示）:" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Selected.Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="提示词正文（选中后填入输入框，可再补充）:" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Selected.Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                            Height="260" TextWrapping="Wrap" FontFamily="Microsoft YaHei" VerticalContentAlignment="Top"/>

                <DockPanel Margin="0,10,0,0">
                    <ui:Button DockPanel.Dock="Right" Content="保存" Padding="18,4" Appearance="Primary" Command="{Binding SaveCommand}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </DockPanel>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="提示：保存后在 AI 助手输入框键入 / 即可看到这些模板；选中后提示词会填入输入框，你补充目标服务器/数据源后回车发送。内置命令（/技能、/临时聊天 等）不受影响。"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
