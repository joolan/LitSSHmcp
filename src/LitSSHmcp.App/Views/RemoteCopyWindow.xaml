<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="复制到远程服务器" Height="660" Width="960" MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="复制到远程服务器"/>

        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：待复制列表 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBrowserMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="源服务器:" FontSize="11" Margin="0,0,0,2"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding SourceTargets}" SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="Name" ToolTip="左侧源服务器（可与右侧互换）"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SourceSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SourceServerText}"/>
                <Border Style="{DynamicResource CardBorderStyle}" Padding="4">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sources}" SelectionMode="Extended" BorderThickness="0" Background="Transparent">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowserMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="8,0,0,0" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowserMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <controls:RemoteFileBrowserView DataContext="{Binding SourceBrowser}"/>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：目标 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标服务器:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="Name"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标地址:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}"
                              DisplayMemberPath="Label"
                              ToolTip="选择源服务器连接目标所用的地址：内网地址走服务器间内网通道（更快）"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标目录:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="目标目录（可在下方浏览切换；也可直接编辑）"/>
                </Grid>

                <WrapPanel Grid.Row="3" Margin="0,0,0,6">
                    <CheckBox Content="压缩传输 (-z)" IsChecked="{Binding Compress}" Margin="0,0,14,0"/>
                    <CheckBox Content="覆盖同名" IsChecked="{Binding Overwrite}" Margin="0,0,14,0"
                              ToolTip="勾选=目标同名文件直接覆盖；取消=跳过目标已存在的同名文件，并在完成后提示跳过数量（rsync/tar 均生效）"/>
                    <CheckBox Content="直连失败时询问是否内存中转" IsChecked="{Binding AllowRelayFallback}" Margin="0,0,14,0"
                              ToolTip="勾选后：直连不可用时会弹出确认框，由你决定是否改用「经本机内存中转」；不勾选则直接失败"/>
                    <ComboBox ItemsSource="{Binding AuthModes}" SelectedIndex="{Binding AuthModeIndex}" Width="150"
                              ToolTip="认证方式：自动=优先源机免密，否则用目标密码(需源机装 sshpass)"/>
                </WrapPanel>

                <Border Grid.Row="4" Style="{DynamicResource CardBorderStyle}" Padding="6">
                    <controls:RemoteFileBrowserView DataContext="{Binding TargetBrowser}"/>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="12,8,12,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="12,10,12,12">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="直连依赖源机可达目标（内网）且具备 rsync/tar；密码直连需源机安装 sshpass。"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="开始传输" Appearance="Primary" Width="100" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
                <ui:Button Content="关闭" Width="80" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
