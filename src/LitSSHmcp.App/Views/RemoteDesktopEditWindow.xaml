<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteDesktopEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="远程桌面连接" Height="760" Width="660" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="远程桌面连接"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="连接" Style="{DynamicResource SectionTitleStyle}"/>

                    <controls:FormRow Label="名称" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="协议" HelpText="RDP 使用系统 mstsc；VNC 使用本地 VNC 查看器">
                        <ComboBox SelectedIndex="{Binding ProtocolIndex}">
                            <ComboBoxItem Content="RDP（Windows 远程桌面）"/>
                            <ComboBoxItem Content="VNC"/>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="主机地址" IsRequired="True" HelpText="目标 IP / 主机名；经隧道时为 SSH 服务器代理">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="端口" HelpText="RDP 默认 3389，VNC 默认 5900（切换协议时自动带出）">
                        <ui:TextBox FontWeight="Normal" Width="100" HorizontalAlignment="Left"
                                    Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="用户名">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="PasswordRow" Label="密码" HelpText="仅保存在本机（DPAPI 加密），不会暴露给 AI">
                        <PasswordBox FontWeight="Normal"/>
                    </controls:FormRow>

                    <controls:FormRow Label="域" HelpText="RDP 可选，例如 CORP">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="隧道服务器" HelpText="经该 SSH 服务器建立本地隧道后连接；选“直连”则本机直连">
                        <ComboBox SelectedIndex="{Binding TunnelServerIndex}" ItemsSource="{Binding TunnelServerOptions}"/>
                    </controls:FormRow>

                    <TextBlock Text="选项" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="RDP 选项">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="全屏启动" IsChecked="{Binding Fullscreen}" VerticalAlignment="Center"
                                      Visibility="{Binding IsRdp, Converter={StaticResource BoolToVis}}"/>
                            <CheckBox Content="自动填充账号密码" IsChecked="{Binding UseLoginCredentials}"
                                      Margin="16,0,0,0" VerticalAlignment="Center"
                                      ToolTip="勾选且已填用户名/密码时，连接前自动登录"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="VNC 查看器" HelpText="留空则自动探测 TigerVNC / TightVNC / RealVNC / UltraVNC"
                                      Visibility="{Binding IsVnc, Converter={StaticResource BoolToVis}}">
                        <controls:PathPicker Value="{Binding ViewerPath, Mode=TwoWay}"
                                             Title="选择 VNC 查看器"
                                             Filter="程序 (*.exe)|*.exe|所有文件|*.*"
                                             Placeholder="留空则自动探测 VNC 查看器"/>
                    </controls:FormRow>

                    <controls:FormRow Label="分辨率" Visibility="{Binding IsRdp, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="150" ItemsSource="{Binding ResolutionOptions}" SelectedIndex="{Binding ResolutionIndex}"
                                      ToolTip="自适应 = 按显示器/窗口"/>
                            <ui:TextBox FontWeight="Normal" Width="60" Margin="6,0,0,0"
                                        Text="{Binding CustomWidthText, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVis}}"
                                        ToolTip="宽 640-7680"/>
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0,4,0"
                                       Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVis}}"/>
                            <ui:TextBox FontWeight="Normal" Width="60"
                                        Text="{Binding CustomHeightText, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVis}}"
                                        ToolTip="高 480-4320"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="分组">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="标签" HelpText="多个标签用逗号分隔">
                        <ui:TextBox FontWeight="Normal" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="描述">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <TextBlock Text="提示：密码仅人工录入并本机 DPAPI 加密保存；连接会写入审计日志。RDP 使用系统 mstsc。"
                               Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Style="{DynamicResource DialogFooterPanelStyle}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="保存" Appearance="Primary" MinWidth="88" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}"/>
                <ui:Button Content="取消" MinWidth="88" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
