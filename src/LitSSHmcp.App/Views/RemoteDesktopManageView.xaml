<UserControl x:Class="LitSSHmcp.App.Views.RemoteDesktopManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <controls:GroupLabelConverter x:Key="GroupLabel"/>
        <controls:TunnelMarkConverter x:Key="TunnelMark"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="TunnelColumn">
            <TextBlock Text="{Binding TunnelServerId, Converter={StaticResource TunnelMark}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Desktop24" FontSize="20" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock Text="远程桌面" Style="{DynamicResource PageTitleStyle}"/>
                </DockPanel>
                <TextBlock Text="RDP / VNC；密码仅本机加密保存；可经 SSH 隧道访问内网桌面"
                           Style="{DynamicResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="卡片视图" IsChecked="{Binding IsCardView}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="搜索名称 / 主机 / 分组…" VerticalAlignment="Center"
                            AutomationProperties.Name="搜索远程桌面"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="远程桌面连接" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding AddCommand}"/>
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding RefreshCommand}"/>
                </WrapPanel>

                <Grid Grid.Row="1">
                    <ListView x:Name="RdList" ItemsSource="{Binding GroupedDesktops}" SelectedItem="{Binding Selected}"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                              Padding="3" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                              ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="连接（内嵌窗口）" Click="OnConnectClick"/>
                                <MenuItem Header="用外部客户端打开" Click="OnOpenExternalClick"/>
                                <MenuItem Header="编辑" Click="OnEditClick"/>
                                <Separator/>
                                <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,8,0,4">
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="14" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource AppAccentBrush}"/>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource GroupLabel}}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="协议" Width="55" DisplayMemberBinding="{Binding ProtocolText}"/>
                                <GridViewColumn Header="主机" Width="160" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="端口" Width="55" DisplayMemberBinding="{Binding Port}"/>
                                <GridViewColumn Header="账号" Width="110" DisplayMemberBinding="{Binding Username}"/>
                                <GridViewColumn Header="隧道" Width="46" CellTemplate="{StaticResource TunnelColumn}"/>
                                <GridViewColumn Header="分组" Width="100" DisplayMemberBinding="{Binding Group}"/>
                                <GridViewColumn Header="最近连接" Width="140" DisplayMemberBinding="{Binding LastConnectedAt}"/>
                                <GridViewColumn Header="描述" Width="180" DisplayMemberBinding="{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding GroupedDesktops}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource CardBorderStyle}" Width="300" Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource AppAccentSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ProtocolText}" FontSize="10"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AppSuccessSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TunnelServerId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TunnelServerId}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="隧道" FontSize="10"
                                                               Foreground="{DynamicResource AppSuccessBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Host}" FontFamily="Consolas" Margin="0,8,0,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <Run Text="端口 "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Username, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="分组 "/><Run Text="{Binding Group, Mode=OneWay}"/>
                                                <Run Text=" · 最近 "/><Run Text="{Binding LastConnectedAt, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <ui:Button Content="连接" Appearance="Primary" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="外部打开" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.OpenExternalItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="编辑" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="删除" Padding="10,3" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource AppDangerBrush}"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding GroupedDesktops.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="还没有远程桌面连接" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="添加 RDP / VNC 连接后即可内嵌打开，或使用外部客户端。"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                        <ui:Button Content="添加远程桌面" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                   HorizontalAlignment="Center" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
