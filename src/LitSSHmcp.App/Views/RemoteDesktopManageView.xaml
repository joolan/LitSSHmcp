<UserControl x:Class="LitSSHmcp.App.Views.RemoteDesktopManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LitSSHmcp.App;component/Themes/GroupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <controls:GroupLabelConverter x:Key="GroupLabel"/>
        <controls:TunnelMarkConverter x:Key="TunnelMark"/>
        <controls:RelativeTimeConverter x:Key="RelativeTime"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="TunnelColumn">
            <TextBlock Text="{Binding TunnelServerId, Converter={StaticResource TunnelMark}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Grid.Row="0" Icon="Desktop24" Title="远程桌面"
                             Subtitle="RDP / VNC；密码仅本机加密保存；可通过 SSH 隧道访问内网桌面">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索名称 / 主机 / 分组" VerticalAlignment="Center"
                                AutomationProperties.Name="搜索远程桌面"/>
                    <CheckBox Content="卡片视图" IsChecked="{Binding IsCardView}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="12,4"
                               Margin="8,0,0,0" Command="{Binding AddCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <Border Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource AppDangerSubtleBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
                        BorderThickness="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="重试" Padding="10,2" Margin="8,0,0,0"
                                   Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                    </DockPanel>
                </Border>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding RefreshCommand}"/>
            <ui:Button Content="列" Padding="12,4" Margin="0,0,6,6" Click="OnChooseColumns" ToolTip="显示/隐藏列"/>
        </WrapPanel>

        <Border Grid.Row="2" Padding="8">
            <Grid>
                <Grid>
                    <ListView x:Name="RdList" ItemsSource="{Binding GroupedDesktops}" SelectedItem="{Binding Selected}"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                              Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.IsVirtualizingWhenGrouping="False" ScrollViewer.CanContentScroll="True" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                              ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True"
                              controls:GroupExpanderBehavior.StorageKey="remoteDesktop.groups">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="连接（内嵌窗口）" Click="OnConnectClick"/>
                                <MenuItem Header="用外部客户端打开" Click="OnOpenExternalClick"/>
                                <MenuItem Header="编辑" Click="OnEditClick"/>
                                <Separator/>
                                <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource CollapsibleAssetGroupContainerStyle}"/>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="协议" Width="55" DisplayMemberBinding="{Binding ProtocolText}"/>
                                <GridViewColumn Header="主机" Width="160" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="端口" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="账号" Width="110" DisplayMemberBinding="{Binding Username}"/>
                                <GridViewColumn Header="隧道" Width="46" CellTemplate="{StaticResource TunnelColumn}"/>
                                <GridViewColumn Header="分组" Width="0">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Group, Converter={StaticResource GroupLabel}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="最近连接" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastConnectedAt, Converter={StaticResource RelativeTime}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="描述" Width="180" DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="操作" Width="104">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                           ToolTip="连接" AutomationProperties.Name="连接远程桌面"
                                                           Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                           ToolTip="编辑" AutomationProperties.Name="编辑远程桌面"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                           Foreground="{DynamicResource AppDangerBrush}" ToolTip="删除"
                                                           AutomationProperties.Name="删除远程桌面"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding GroupedDesktops}" MaxWidth="1000" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource CardBorderStyle}" Width="300" Margin="0,0,10,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource AppAccentSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ProtocolText}" FontSize="10"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Border>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AppSuccessSubtleBrush}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TunnelServerId}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TunnelServerId}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="隧道" FontSize="10"
                                                               Foreground="{DynamicResource AppSuccessBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSubtitle}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Host}" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,8,0,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                                <Run Text="端口 "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Username, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="分组 "/><Run Text="{Binding Group, Mode=OneWay, Converter={StaticResource GroupLabel}}"/>
                                                <Run Text=" · 最近 "/><Run Text="{Binding LastConnectedAt, Mode=OneWay, Converter={StaticResource RelativeTime}}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <ui:Button Content="连接" Appearance="Primary" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="外部打开" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.OpenExternalItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="编辑" Padding="10,3" Margin="0,0,6,6"
                                                           Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="删除" Padding="10,3" Margin="0,0,0,6"
                                                           Foreground="{DynamicResource AppDangerBrush}"
                                                           Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding GroupedDesktops.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding EmptyTitle}" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="{Binding EmptyHint}"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="添加远程桌面" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                       Command="{Binding AddCommand}"
                                       Visibility="{Binding ShowEmptyAction, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button Content="清空搜索" Icon="{ui:SymbolIcon Dismiss24}" Padding="14,5"
                                       Click="OnClearSearch"
                                       Visibility="{Binding ShowClearSearch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource AppCardBrush}" Opacity="0.72" Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
