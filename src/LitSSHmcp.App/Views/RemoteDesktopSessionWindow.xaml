<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteDesktopSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="远程桌面" Height="760" Width="1100" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppCloseHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppCloseHoverTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 仅表头（不含内容区）：内容用常驻控件放在下方 ContentHost，避免 ActiveX/WebView2 被销毁重连 -->
        <ControlTemplate x:Key="HeaderOnlyTabs" TargetType="TabControl">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="Transparent">
                <TabPanel IsItemsHost="True" Background="Transparent" Margin="8,2,8,0"/>
            </ScrollViewer>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 自绘顶部栏 -->
        <Border Grid.Row="0" Height="40" Background="{DynamicResource AppSurfaceBrush}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="远程桌面" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Padding="6,3" Margin="0,0,8,0"
                               ToolTip="新建连接" AutomationProperties.Name="新建远程桌面连接" Click="OnNewConnection"/>
                    <ui:Button Icon="{ui:SymbolIcon Open24}" Appearance="Transparent" Padding="6,3"
                               ToolTip="用外部客户端打开当前标签" AutomationProperties.Name="用外部客户端打开当前远程桌面"
                               Click="OnExternalOpen"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeWindow"
                            AutomationProperties.Name="最小化"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeWindow"
                            AutomationProperties.Name="最大化"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseWindow"
                            AutomationProperties.Name="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签栏（与「SSH 会话管理」一致：文字 + 选中下划线） -->
        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
            <TabControl x:Name="Tabs" ItemsSource="{Binding DockedSessions}" SelectedItem="{Binding SelectedSession}"
                        Template="{StaticResource HeaderOnlyTabs}" Background="Transparent" BorderThickness="0"
                        SelectionChanged="OnTabsSelectionChanged"
                        AllowDrop="True" PreviewMouseLeftButtonDown="OnTabsPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnTabsPreviewMouseMove" QueryContinueDrag="OnDragQueryContinueDrag">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="分离为独立窗口" Click="OnDetachItem"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="✕" Click="OnTabClose" Width="20" Height="20" Padding="0" FontSize="10"
                                    AutomationProperties.Name="关闭标签"
                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    ToolTip="关闭标签（需确认）"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Border>

        <!-- 内容区（常驻控件宿主） -->
        <Grid Grid.Row="2">
            <Grid x:Name="ContentHost"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDockedSessions}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="当前没有已打开的远程桌面。点击标题栏的「＋」新建连接。" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <ui:Button Content="新建连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="16,6"
                           HorizontalAlignment="Center" Click="OnNewConnection"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding SelectedSession.Status, TargetNullValue=就绪}" Margin="12,6,12,6"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</ui:FluentWindow>
