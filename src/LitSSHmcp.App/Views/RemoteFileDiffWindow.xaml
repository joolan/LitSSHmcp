<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteFileDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="文件差异" Height="780" Width="1280" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="文件差异"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="12,6,12,6" Padding="10,7">
            <DockPanel>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                <ui:Button DockPanel.Dock="Right" Content="关闭" Padding="14,4" Click="OnClose"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LeftLabel" Grid.Column="0" Margin="4,0,0,5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="RightLabel" Grid.Column="2" Margin="4,0,0,5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <avalonedit:TextEditor x:Name="LeftEditor" IsReadOnly="True" ShowLineNumbers="True"
                                       FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="12"
                                       WordWrap="False" BorderThickness="0" Background="Transparent"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                       Padding="6"/>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Cursor="SizeWE"/>

            <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <avalonedit:TextEditor x:Name="RightEditor" IsReadOnly="True" ShowLineNumbers="True"
                                       FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="12"
                                       WordWrap="False" BorderThickness="0" Background="Transparent"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                       Padding="6"/>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="12,8,12,10" Padding="10,6"
                Style="{DynamicResource CardBorderStyle}">
            <TextBlock Text="红色：仅左侧（当前编辑器）；绿色：仅右侧（服务器当前版本）；灰色：占位行。"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}"/>
        </Border>
    </Grid>
</ui:FluentWindow>
