<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteFileHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="文件历史备份" Height="520" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="文件历史备份"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="12,6,12,6" Padding="10,7">
            <TextBlock x:Name="PathText" FontFamily="{DynamicResource AppFontMonoFamily}"
                       TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </Border>

        <ListBox Grid.Row="2" x:Name="BackupList" Margin="12,0,12,0" BorderThickness="0"
                 Background="Transparent" ItemsSource="{Binding Backups}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource AppFontMonoFamily}"
                               FontSize="{DynamicResource AppFontSizeCaption}" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="12,8,12,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="关闭" Padding="14,4" Margin="0,0,8,0" IsCancel="True" Click="OnClose"/>
                <ui:Button Content="比较" Padding="14,4" Margin="0,0,8,0" Click="OnCompare"/>
                <ui:Button Content="恢复此备份" Appearance="Primary" Padding="14,4" Click="OnRestore"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
