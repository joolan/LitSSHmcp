<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteFilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="文件属性" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="文件属性"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8,16,0">
                <!-- 基本信息 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameText" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="完整路径:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PathText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="类型:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TypeText" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="大小:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SizeText" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="修改时间:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ModifiedText" Margin="0,0,0,6"/>
                </Grid>

                <Separator Margin="0,6,0,10"/>

                <!-- 权限 -->
                <TextBlock Text="权限" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="所有者" Margin="0,0,6,0" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="OwnerRead" Content="读取" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="OwnerWrite" Content="写入" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="OwnerExec" Content="执行" Margin="0,2" Click="OnPermChanged"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="用户组" Margin="0,0,6,0" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="GroupRead" Content="读取" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="GroupWrite" Content="写入" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="GroupExec" Content="执行" Margin="0,2" Click="OnPermChanged"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="公共" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="OthersRead" Content="读取" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="OthersWrite" Content="写入" Margin="0,2" Click="OnPermChanged"/>
                            <CheckBox x:Name="OthersExec" Content="执行" Margin="0,2" Click="OnPermChanged"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                    <ui:TextBox FontWeight="Normal" x:Name="ModeBox" Width="70" TextChanged="OnModeChanged" ToolTip="八进制权限，如 755"/>
                    <TextBlock Text="权限码" VerticalAlignment="Center" Margin="6,0,16,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="属主:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ui:TextBox FontWeight="Normal" x:Name="OwnerBox" Width="90" Margin="0,0,10,0"/>
                    <TextBlock Text="属组:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ui:TextBox FontWeight="Normal" x:Name="GroupBox" Width="90"/>
                </StackPanel>
                <CheckBox x:Name="RecursiveBox" Content="应用到子目录（递归）" Margin="0,2,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,12">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <ui:Button Content="复制路径" Padding="12,4" Margin="0,0,8,0" Click="OnCopyPath"/>
            <ui:Button Content="应用权限" Padding="16,4" Appearance="Primary" Margin="0,0,8,0" Click="OnApply"/>
            <ui:Button Content="关闭" Padding="16,4" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
