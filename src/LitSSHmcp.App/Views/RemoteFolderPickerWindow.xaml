<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="选择远程目录" Height="620" Width="720" MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="选择远程目录"/>

        <Border Grid.Row="1" Margin="12,0,12,0" Style="{DynamicResource CardBorderStyle}" Padding="6">
            <controls:RemoteFileBrowserView/>
        </Border>

        <DockPanel Grid.Row="2" Margin="12,8,12,12">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="浏览到目标文件夹后点「选择当前目录」；返回的就是当前所在目录路径。"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="选择当前目录" Appearance="Primary" Padding="14,5" Margin="8,0,8,0" Click="OnPick"/>
                <ui:Button Content="取消" Width="80" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
