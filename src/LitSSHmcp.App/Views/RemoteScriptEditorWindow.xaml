<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="编辑脚本" Height="780" Width="1040" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="编辑脚本"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="16,8,16,0" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="PathText" FontFamily="{DynamicResource AppFontMonoFamily}"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="MetaText" Margin="0,4,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="InterpreterText" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="EncodingText" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock x:Name="LineCountText" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,8,16,0" Padding="4" BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6">
            <avalonedit:TextEditor x:Name="Editor" FontFamily="{DynamicResource AppFontMonoFamily}"
                                   FontSize="13" ShowLineNumbers="True" WordWrap="False"
                                   BorderThickness="0" Background="Transparent" Padding="6"
                                   Foreground="{DynamicResource AppCodeTextBrush}"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,10,16,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Padding="14,5" Click="OnCancel"/>
                <ui:Button Content="保存" Appearance="Primary" Padding="14,5" Margin="8,0,0,0" Click="OnSave"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
