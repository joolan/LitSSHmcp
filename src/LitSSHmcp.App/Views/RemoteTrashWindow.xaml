<ui:FluentWindow x:Class="LitSSHmcp.App.Views.RemoteTrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="远程回收站" Height="620" Width="1040" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="远程回收站"/>
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="12,4,12,8">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="12,4" Click="OnRefresh"/>
                    <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold"
                               FontSize="{DynamicResource AppFontSizeSubtitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="默认不自动清理，只提示大小和保留时间；清空回收站后才会释放远程空间。"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="12,0,12,8">
            <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="190" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="原路径" Width="390" DisplayMemberBinding="{Binding OriginalPath}"/>
                        <GridViewColumn Header="类型" Width="70" DisplayMemberBinding="{Binding TypeText}"/>
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="删除时间" Width="150" DisplayMemberBinding="{Binding DeletedAtText}"/>
                        <GridViewColumn Header="保留" Width="80" DisplayMemberBinding="{Binding AgeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="12,0,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="恢复" Padding="12,4" Margin="0,0,6,0"
                           IsEnabled="{Binding HasSelection}" Click="OnRestore"/>
                <ui:Button Content="彻底删除" Padding="12,4" Margin="0,0,6,0"
                           IsEnabled="{Binding HasSelection}" Click="OnDeletePermanently"/>
                <ui:Button Content="清空回收站" Padding="12,4"
                           IsEnabled="{Binding HasItems}" Click="OnEmpty"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
