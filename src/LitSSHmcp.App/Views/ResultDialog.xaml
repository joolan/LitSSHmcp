<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="结果" Height="460" Width="680" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="结果"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,6,16,0">
            <ui:SymbolIcon x:Name="Glyph" Symbol="Info24" FontSize="20" Margin="0,0,8,0"/>
            <TextBlock x:Name="Headline" FontWeight="SemiBold" VerticalAlignment="Center" Text=""/>
        </StackPanel>

        <Border Grid.Row="2" Margin="16,10,16,0" CornerRadius="6" Padding="4"
                BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
            <TextBox x:Name="Body" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,14">
            <ui:Button x:Name="CopyButton" Content="复制全部" Padding="14,5" Click="OnCopy"/>
            <ui:Button Content="关闭" Appearance="Primary" Padding="14,5" Margin="8,0,0,0" IsDefault="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
