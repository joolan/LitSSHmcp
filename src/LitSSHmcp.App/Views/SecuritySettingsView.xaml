<UserControl x:Class="LitSSHmcp.App.Views.SecuritySettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="应用锁（启动密码门卫）" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AppLockStatusText" Text="状态：加载中…" TextWrapping="Wrap" Margin="0,0,0,6"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           ToolTip="每次启动需输入密码（或 Windows Hello）才能进入主界面，防止他人拿到电脑后直接操作；跟随 Windows 锁屏，系统解锁回来时重新上锁。密码哈希加密存储，明文不落盘。定位是防随手操作的门卫，不是凭据金库。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="AppLockSetButton" Content="设置密码…" Padding="10,4" Margin="0,0,8,0" Click="OnAppLockSetPassword"
                            ToolTip="首次设置，或在验证旧密码后修改"/>
                    <Button x:Name="AppLockDisableButton" Content="关闭应用锁" Padding="10,4" Margin="0,0,8,0" Click="OnAppLockDisable"
                            ToolTip="需先验证当前密码"/>
                    <TextBlock x:Name="AppLockHelloText" Text="" VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
                <Separator Margin="0,4,0,8"/>

                <CheckBox Content="启用 MCP 服务（关闭后拒绝所有工具调用）" IsChecked="{Binding McpEnabled}"
                          FontWeight="SemiBold" Margin="0,4,0,10"
                          ToolTip="全局开关：关闭后 MCP 将拒绝所有工具调用；按配置文件热生效，无需重启"/>

                <TextBlock Text="Web 授权矩阵 (security.authorization)" FontWeight="Bold" Margin="0,4,0,4"
                           ToolTip="仅 Web 助手会话强制执行（桌面会话仅归因不限权）。规则按 Web 登录用户名生效；未命中任何规则的用户默认拒绝（fail-closed）。"/>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,6" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="给 Web 助手登录用户分配可操作目标与级别。目标可填 ssh:&lt;服务器Id&gt; / ds:&lt;数据源Id&gt;，或通配 ssh:* / ds:* / *（空格或逗号分隔多个）；级别 read=只读查询/日志/下载，write=允许上传/重启/SQL写，exec=另允许执行命令/docker exec/快照刷新（exec 包含 write）；同一用户可多行分别授权不同目标。* 用户行为未单独成条用户的兜底规则。保存后热生效。"/>
                <CheckBox Content="启用授权矩阵（关闭 = 放弃该 Web 防线，不建议）" IsChecked="{Binding AuthzEnabled}" Margin="0,0,0,6"
                          ToolTip="开启时：Web 用户不在下方规则表中、或目标不在其白名单 → 工具调用直接拒绝并写审计（authorization_denied）"/>
                <ItemsControl ItemsSource="{Binding AuthzRules}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="用户:" VerticalAlignment="Center" Width="44"/>
                                <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"
                                         ToolTip="Web 登录用户名（或用户 Id）；* = 对所有未单独成条的用户生效"/>
                                <TextBlock Text="目标:" VerticalAlignment="Center" Width="36"/>
                                <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,8,0"
                                         ToolTip="ssh:&lt;服务器Id&gt; / ds:&lt;数据源Id&gt; / ssh:* / ds:* / *，空格或逗号分隔多个"/>
                                <TextBlock Text="级别:" VerticalAlignment="Center" Width="36"/>
                                <ComboBox SelectedIndex="{Binding LevelIndex}" Width="112" Margin="0,0,8,0"
                                          ToolTip="read=只读查询/日志/下载; write=上传/重启/SQL写; exec=命令执行/docker exec/快照刷新（包含 write）">
                                    <ComboBoxItem Content="read 只读"/>
                                    <ComboBoxItem Content="write 可写"/>
                                    <ComboBoxItem Content="exec 可执行"/>
                                </ComboBox>
                                <Button Content="✕" Width="26" Padding="0" Click="OnAuthzRemoveRule"
                                        ToolTip="删除此行"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ 添加授权行" Padding="10,3" Margin="0,0,0,8" Click="OnAuthzAddRule"/>

                <TextBlock Text="允许下发 Web 的外部连接器 (security.authorization.webConnectors)" FontWeight="Bold" Margin="0,4,0,4"
                           ToolTip="仅控制外部 MCP 连接器是否随 Web 会话下发；内置 LitSSH 恒可用。未勾选的外部连接器不下发 Web。"/>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,6" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="外部 MCP 默认不下发 Web（其工具绕过 LitSSH 审批，Web 上风险放大）。勾选后仍需在「AI 助手 → MCP 服务器」中全局启用；已停用的连接器不会生效。保存后对新 Web 会话生效。"/>
                <ItemsControl x:Name="WebConnectorList" ItemsSource="{Binding WebConnectors}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,4"
                                      ToolTip="勾选 = 允许该外部连接器随 Web 会话下发（仍受全局启用状态约束）"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,8" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="暂无外部连接器。请先在「AI 助手 → MCP 服务器」添加并启用外部 MCP 服务，保存后点下方「重新加载」再回到此处勾选。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=WebConnectorList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Web 会话工作区根 (web.jobsRoot)" FontWeight="Bold" Margin="0,4,0,4"
                           ToolTip="Web 助手会话目录的固定根：其下为 &lt;用户Id&gt;\s&lt;会话Id&gt;。留空=默认 %APPDATA%\LitSSH\jobs；仅接受绝对路径（非法值回退默认）；改动需重启 Web 生效。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding WebJobsRoot, UpdateSourceTrigger=PropertyChanged}" Width="420"
                             ToolTip="例如 D:\LitSSH-jobs；留空使用默认目录"/>
                    <Button Content="恢复默认" Margin="6,0,0,0" Padding="10,3" Click="OnResetWebJobsRoot"
                            ToolTip="清空为默认 %APPDATA%\LitSSH\jobs（保存后重启 Web 生效）"/>
                </StackPanel>

                <Separator Margin="0,4,0,8"/>

                <TextBlock Text="命令过滤 (每行一条)" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBlock Text="禁止命令 (直接拒绝):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding BlockedCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>
                <TextBlock Text="敏感命令 (需桌面确认):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SensitiveCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>
                <TextBlock Text="敏感正则:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SensitivePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>

                <TextBlock Text="脚本风险规则 (执行/上传脚本时的权威扫描; 在命令过滤之外生效)" FontWeight="Bold" Margin="0,4,0,4"
                           ToolTip="脚本(如 x.sh/a.py)执行或上传时逐行扫描: 命令过滤的禁止/敏感规则 + 下方脚本专用规则。命中禁止规则直接硬拒绝不进审批; 命中可疑规则进审批并展示。保存后热生效。"/>
                <CheckBox Content="启用脚本专用内置规则（fork炸弹/curl|sh/反弹shell/SSH凭据/eval 等）" IsChecked="{Binding ScriptRulesEnabled}" Margin="0,0,0,4"
                          ToolTip="关闭后仅保留命令过滤扫描与下方自定义规则；内置规则标签可在 config.json 的 security.scriptRules.disabledBuiltinRuleLabels 中按需禁用单条"/>
                <TextBlock Text="追加危险规则 (正则, 每行一条; 命中=硬拒绝):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ScriptExtraBlockedPatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,4"/>
                <TextBlock Text="追加可疑规则 (正则, 每行一条; 命中=进审批):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ScriptExtraSensitivePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,4"/>
                <TextBlock Text="禁用的内置规则标签 (每行一个, 精确匹配; 如 eval 动态执行):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding ScriptDisabledRuleLabels, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding BuiltinScriptRuleLabelsHint}" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,8"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           ToolTip="内置脚本规则标签全集（可填入上方禁用框按需关闭单条）"/>

                <TextBlock Text="SQL 过滤 (正则, 每行一条)" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock Text="禁止模式:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SqlBlockedPatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>
                <TextBlock Text="敏感模式:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SqlSensitivePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>

                <TextBlock Text="文件传输" FontWeight="Bold" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="启用文件传输" IsChecked="{Binding FileTransferEnabled}" Margin="0,0,16,0"/>
                    <CheckBox Content="传输需桌面确认" IsChecked="{Binding FileTransferRequireApproval}" Margin="0,0,16,0"/>
                    <TextBlock Text="最大MB:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="允许的本地路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding AllowedLocalPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>
                <TextBlock Text="允许的远程路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding AllowedRemotePaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>

                <TextBlock Text="SSH 主机密钥 / 拓扑发现 / 限流 / 审计" FontWeight="Bold" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="主机密钥校验模式:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="HostKeyModeBox" IsEditable="True" Width="100"
                              Text="{Binding SshHostKeyMode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(Tofu=首连记录, Strict=仅信任已记录, Off=不校验)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="拓扑发现允许路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding DiscoveryPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,4"/>
                <CheckBox Content="自动发现使用提权 (sudo, 以便识别 root 服务的监听端口)" IsChecked="{Binding DiscoveryUseSudo}" Margin="0,0,0,8"
                          ToolTip="仅当该服务器配置了 SudoType 时生效；只读探测，提权密码由服务端注入、不会暴露给 AI"/>
                <TextBlock Text="日志读取允许路径 (每行一条, 供 log_query):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding LogAllowedPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="每目标并发上限:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxConcurrent, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,16,0"/>
                    <TextBlock Text="每分钟调用上限:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxPerMinute, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,16,0"/>
                    <TextBlock Text="数据库备份并发数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxConcurrentBackups, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0"
                             ToolTip="同时运行的数据库备份任务上限(1~16)，防止多任务同时 dump 压垮本机/目标"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="记录SQL原文" IsChecked="{Binding AuditStoreSqlText}" Margin="0,0,16,0"/>
                    <CheckBox Content="SQL字面量脱敏" IsChecked="{Binding AuditMaskLiterals}" Margin="0,0,16,0"/>
                    <TextBlock Text="审计保留天数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AuditRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="授权弹窗强制置顶" IsChecked="{Binding ApprovalTopMost}" Margin="0,0,16,0"/>
                    <TextBlock Text="无操作自动拒绝(秒, 0=不超时):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ApprovalTimeout, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,16,0"/>
                    <TextBlock Text="弹窗样式:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ApprovalStyleBox" IsEditable="True" Width="90" Margin="4,0,0,0"
                              Text="{Binding ApprovalStyle, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="审批模式:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ApprovalModeOptions}" SelectedIndex="{Binding ApprovalModeIndex}"
                              Width="200" Margin="4,0,10,0"
                              ToolTip="手动处理(默认)=敏感操作需人工确认; 自动允许授权(危险)=敏感操作自动放行; 自动拒绝授权=敏感操作直接拒绝。仅影响需人工确认的敏感操作，被命令过滤器硬拒绝(blocked)的不受影响"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="审批通道:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ApprovalChannelOptions}" SelectedIndex="{Binding ApprovalChannelIndex}"
                              Width="200" Margin="4,0,10,0"
                              ToolTip="desktop=本机弹窗; cli=带外(操作员用 litssh approve/deny 决定, 适配无桌面); 首个决定者生效"/>
                </StackPanel>

                <TextBlock Text="服务器快照 (ssh_snapshot_get / ssh_snapshot_refresh)" FontWeight="Bold" Margin="0,8,0,4"/>
                <CheckBox Content="采集快照时使用提权 (sudo, 以便拿到 root 端口/进程/证书视图)" IsChecked="{Binding SnapshotUseSudo}" Margin="0,0,0,6"
                          ToolTip="仅当该服务器配置了 SudoType 时生效；采集命令均为内置固定只读命令、不逐次弹审批；关闭则自动降级采集(端口进程属主等字段缺失)"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="每服务器保留份数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapshotRetention, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,4,0"/>
                    <TextBlock Text="(0=不限)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="采集超时(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapshotTimeout, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="刷新最短间隔(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapshotMinRefresh, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,4,0"/>
                    <TextBlock Text="(间隔内 refresh 直接返回缓存; force=true 可强制重采)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10"/>
                </StackPanel>

                <TextBlock Text="SSH 连接复用 (connectionPool)" FontWeight="Bold" Margin="0,8,0,4"/>
                <CheckBox Content="复用 SSH 连接（每服务器保持连接、空闲自动断开；关闭则每次新建连接）" IsChecked="{Binding ConnectionPoolEnabled}" Margin="0,0,0,6"
                          ToolTip="避免 AI/密集工具调用反复“连-断”触发目标机登录告警；命令/文件传输共用池，连接按配置变更自动失效"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="空闲断开(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ConnectionPoolIdle, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="4,0,16,0"/>
                    <TextBlock Text="keepalive(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ConnectionPoolKeepAlive, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,16,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="连接超时(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ConnectionPoolConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,16,0"/>
                    <TextBlock Text="每服务器连接数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ConnectionPoolMaxPerServer, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0,4,0"/>
                    <TextBlock Text="(1~16, 并发调用分配到不同连接)" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="10"/>
                </StackPanel>

                <TextBlock Text="查询结果脱敏 (列名正则=模式, 每行一条; 模式: full/email/phone/last4)" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBox Text="{Binding MaskingRules, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         Height="50" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,0,0,8"
                         ToolTip="对 mysql_query 结果按列名脱敏后再返回给AI, 如: phone|mobile=phone   idcard=last4   email=email"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新加载" Width="90" Padding="6,4" Margin="0,0,6,0" Click="OnReload"/>
                <Button Content="保存" Width="90" Padding="6,4" Click="OnSave"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</UserControl>
