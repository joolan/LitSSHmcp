<Window x:Class="LitSSHmcp.App.Views.SecuritySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安全设置" Height="680" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox Content="启用 MCP 服务（关闭后拒绝所有工具调用）" IsChecked="{Binding McpEnabled}"
                          FontWeight="SemiBold" Margin="0,4,0,10"
                          ToolTip="全局开关：关闭后 MCP 将拒绝所有工具调用；按配置文件热生效，无需重启"/>

                <TextBlock Text="命令过滤 (每行一条)" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBlock Text="禁止命令 (直接拒绝):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding BlockedCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,8"/>
                <TextBlock Text="敏感命令 (需桌面确认):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SensitiveCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,8"/>
                <TextBlock Text="敏感正则:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SensitivePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="Consolas" Margin="0,0,0,8"/>

                <TextBlock Text="SQL 过滤 (正则, 每行一条)" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock Text="禁止模式:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SqlBlockedPatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,8"/>
                <TextBlock Text="敏感模式:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding SqlSensitivePatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" FontFamily="Consolas" Margin="0,0,0,8"/>

                <TextBlock Text="文件传输" FontWeight="Bold" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="启用文件传输" IsChecked="{Binding FileTransferEnabled}" Margin="0,0,16,0"/>
                    <CheckBox Content="传输需桌面确认" IsChecked="{Binding FileTransferRequireApproval}" Margin="0,0,16,0"/>
                    <TextBlock Text="最大MB:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="允许的本地路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding AllowedLocalPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="Consolas" Margin="0,0,0,8"/>
                <TextBlock Text="允许的远程路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding AllowedRemotePaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" FontFamily="Consolas" Margin="0,0,0,8"/>

                <TextBlock Text="SSH 主机密钥 / 拓扑发现 / 限流 / 审计" FontWeight="Bold" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="主机密钥校验模式:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="HostKeyModeBox" IsEditable="True" Width="100"
                              Text="{Binding SshHostKeyMode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(Tofu=首连记录, Strict=仅信任已记录, Off=不校验)" VerticalAlignment="Center" Foreground="Gray" FontSize="10" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="拓扑发现允许路径 (每行一条):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding DiscoveryPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="Consolas" Margin="0,0,0,4"/>
                <CheckBox Content="自动发现使用提权 (sudo, 以便识别 root 服务的监听端口)" IsChecked="{Binding DiscoveryUseSudo}" Margin="0,0,0,8"
                          ToolTip="仅当该服务器配置了 SudoType 时生效；只读探测，提权密码由服务端注入、不会暴露给 AI"/>
                <TextBlock Text="日志读取允许路径 (每行一条, 供 log_tail/log_grep):" Margin="0,0,0,2"/>
                <TextBox Text="{Binding LogAllowedPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="40" FontFamily="Consolas" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="每目标并发上限:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxConcurrent, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,16,0"/>
                    <TextBlock Text="每分钟调用上限:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MaxPerMinute, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="记录SQL原文" IsChecked="{Binding AuditStoreSqlText}" Margin="0,0,16,0"/>
                    <CheckBox Content="SQL字面量脱敏" IsChecked="{Binding AuditMaskLiterals}" Margin="0,0,16,0"/>
                    <TextBlock Text="审计保留天数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AuditRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="授权弹窗强制置顶" IsChecked="{Binding ApprovalTopMost}" Margin="0,0,16,0"/>
                    <TextBlock Text="无操作自动拒绝(秒, 0=不超时):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ApprovalTimeout, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,16,0"/>
                    <TextBlock Text="弹窗样式:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ApprovalStyleBox" IsEditable="True" Width="90" Margin="4,0,0,0"
                              Text="{Binding ApprovalStyle, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="审批模式:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ApprovalModeOptions}" SelectedIndex="{Binding ApprovalModeIndex}"
                              Width="200" Margin="4,0,10,0"
                              ToolTip="手动处理(默认)=敏感操作需人工确认; 自动允许授权(危险)=敏感操作自动放行; 自动拒绝授权=敏感操作直接拒绝。仅影响需人工确认的敏感操作，被命令过滤器硬拒绝(blocked)的不受影响"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="审批通道:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ApprovalChannelOptions}" SelectedIndex="{Binding ApprovalChannelIndex}"
                              Width="200" Margin="4,0,10,0"
                              ToolTip="desktop=本机弹窗; cli=带外(操作员用 litssh approve/deny 决定, 适配无桌面); 首个决定者生效"/>
                </StackPanel>

                <TextBlock Text="服务器快照 (ssh_snapshot_get / ssh_snapshot_refresh)" FontWeight="Bold" Margin="0,8,0,4"/>
                <CheckBox Content="采集快照时使用提权 (sudo, 以便拿到 root 端口/进程/证书视图)" IsChecked="{Binding SnapshotUseSudo}" Margin="0,0,0,6"
                          ToolTip="仅当该服务器配置了 SudoType 时生效；采集命令均为内置固定只读命令、不逐次弹审批；关闭则自动降级采集(端口进程属主等字段缺失)"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="每服务器保留份数:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapshotRetention, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0,4,0"/>
                    <TextBlock Text="(0=不限)" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,16,0"/>
                    <TextBlock Text="采集超时(秒):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SnapshotTimeout, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock Text="查询结果脱敏 (列名正则=模式, 每行一条; 模式: full/email/phone/last4)" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBox Text="{Binding MaskingRules, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         Height="50" FontFamily="Consolas" Margin="0,0,0,8"
                         ToolTip="对 mysql_query 结果按列名脱敏后再返回给AI, 如: phone|mobile=phone   idcard=last4   email=email"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新加载" Width="90" Padding="6,4" Margin="0,0,6,0" Click="OnReload"/>
                <Button Content="保存" Width="90" Padding="6,4" Click="OnSave"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>
    </Grid>
</Window>
