<Window x:Class="LitSSHmcp.App.Views.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑SSH服务器" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 服务器名称 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器名称:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- 主机地址 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="主机地址:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- 端口 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- 用户名 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="用户名:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- 认证方式 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="认证方式:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding AuthTypeIndex}" Margin="0,0,0,8">
            <ComboBoxItem Content="密码"/>
            <ComboBoxItem Content="密钥文件"/>
        </ComboBox>

        <!-- 密码 -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="密码:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8"/>

        <!-- 密钥文件路径 -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="密钥路径:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding KeyFilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsKeyFileAuth}" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="..." Width="30" Command="{Binding BrowseKeyFileCommand}" IsEnabled="{Binding IsKeyFileAuth}"/>
        </Grid>

        <!-- 密钥密码 -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="密钥密码:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="KeyPasswordBox" Margin="0,0,0,8"/>

        <!-- 描述 -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="描述:" VerticalAlignment="Top" Margin="0,0,10,8"/>
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- 标签 -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="标签:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" 
                 ToolTip="多个标签用逗号分隔" Margin="0,0,0,8"/>

        <!-- 提权配置标题 -->
        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Text="提权配置" 
                   FontWeight="Bold" Margin="0,10,0,8"/>

        <!-- 提权类型 -->
        <TextBlock Grid.Row="11" Grid.Column="0" Text="提权方式:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <ComboBox Grid.Row="11" Grid.Column="1" SelectedIndex="{Binding SudoTypeIndex}" Margin="0,0,0,8">
            <ComboBoxItem Content="不启用"/>
            <ComboBoxItem Content="当前用户sudo"/>
            <ComboBoxItem Content="root用户"/>
            <ComboBoxItem Content="指定用户"/>
        </ComboBox>

        <!-- 提权用户名 -->
        <TextBlock Grid.Row="12" Grid.Column="0" Text="提权用户:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SudoUsername, UpdateSourceTrigger=PropertyChanged}" 
                 IsEnabled="{Binding IsCustomSudoUser}" Margin="0,0,0,8"
                 ToolTip="仅'指定用户'模式需要填写"/>

        <!-- 提权密码 -->
        <TextBlock Grid.Row="13" Grid.Column="0" Text="提权密码:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <PasswordBox Grid.Row="13" Grid.Column="1" x:Name="SudoPasswordBox" Margin="0,0,0,8"
                     ToolTip="当前用户sudo: 填写SSH用户密码; root/指定用户: 填写对应密码"/>

        <!-- 状态消息和测试连接 -->
        <Grid Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="测试连接" Command="{Binding TestConnectionCommand}" 
                    Padding="10,5" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray"/>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="确定" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>