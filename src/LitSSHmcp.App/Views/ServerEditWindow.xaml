<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="编辑 SSH 服务器" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="编辑 SSH 服务器"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Border Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <controls:FormRow Label="服务器名称" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="主机地址" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="端口" IsRequired="True" HelpText="默认 22；经跳板机时仍填目标服务器端口">
                        <ui:TextBox FontWeight="Normal" Width="100" HorizontalAlignment="Left"
                                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="用户名" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="认证方式">
                        <ComboBox SelectedIndex="{Binding AuthTypeIndex}">
                            <ComboBoxItem Content="密码"/>
                            <ComboBoxItem Content="密钥文件"/>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow x:Name="PasswordRow" Label="密码">
                        <PasswordBox FontWeight="Normal"/>
                    </controls:FormRow>

                    <controls:FormRow Label="密钥路径" HelpText="支持 OpenSSH / PEM；不支持 PuTTY .ppk">
                        <controls:PathPicker Value="{Binding KeyFilePath, Mode=TwoWay}"
                                             IsEnabled="{Binding IsKeyFileAuth}"
                                             Title="选择 SSH 密钥文件"
                                             Filter="OpenSSH/PEM 密钥|*.pem;*.key|所有文件|*.*"
                                             Placeholder="密钥文件路径"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="KeyPasswordRow" Label="密钥密码">
                        <PasswordBox FontWeight="Normal"/>
                    </controls:FormRow>

                    <controls:FormRow Label="描述">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="标签" HelpText="多个标签用逗号分隔">
                        <ui:TextBox FontWeight="Normal" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="分组">
                        <ui:TextBox FontWeight="Normal" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="连接管理器分组名（可留空）；相同分组会归为一组"/>
                    </controls:FormRow>

                    <controls:FormRow Label="状态">
                        <CheckBox Content="禁用此服务器"
                                  IsChecked="{Binding Disabled, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="禁用后: 不出现在 MCP 的 ssh_list_servers; 资产拓扑中不可建链/连接; 拓扑发现跳过; 任何按服务器标识的工具调用都返回 server_disabled 而不执行"/>
                    </controls:FormRow>

                    <TextBlock Text="提权配置" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="提权方式">
                        <ComboBox SelectedIndex="{Binding SudoTypeIndex}">
                            <ComboBoxItem Content="不启用"/>
                            <ComboBoxItem Content="当前用户sudo"/>
                            <ComboBoxItem Content="root用户"/>
                            <ComboBoxItem Content="指定用户"/>
                            <ComboBoxItem Content="自动(sudo优先,失败再su)"/>
                        </ComboBox>
                    </controls:FormRow>

                    <controls:FormRow Label="提权用户" HelpText="仅“指定用户”模式需要填写">
                        <ui:TextBox FontWeight="Normal" Text="{Binding SudoUsername, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsCustomSudoUser}"/>
                    </controls:FormRow>

                    <controls:FormRow x:Name="SudoPasswordRow" Label="提权密码" HelpText="当前用户 sudo 填 SSH 密码；root / 指定用户填对应密码">
                        <PasswordBox FontWeight="Normal"/>
                    </controls:FormRow>

                    <TextBlock Text="内网地址（跨机复制用，可留空）" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="内网地址" HelpText="跨机复制时源服务器可用的内网地址；留空则用主机地址">
                        <ui:TextBox FontWeight="Normal" Text="{Binding InternalHost, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="内网端口" HelpText="内网 SSH 端口；留空沿用上面的端口">
                        <ui:TextBox FontWeight="Normal" Text="{Binding InternalPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <TextBlock Text="生成密钥（ed25519 / rsa；生成后把下方公钥加入服务器的 ~/.ssh/authorized_keys）"
                               Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6" TextWrapping="Wrap"/>

                    <controls:FormRow Label="密钥生成">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox SelectedIndex="{Binding KeyGenTypeIndex}" Width="120" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="ed25519"/>
                                <ComboBoxItem Content="rsa(4096)"/>
                            </ComboBox>
                            <ui:Button Content="生成密钥…" Padding="10,3" Margin="6,0,0,0" Command="{Binding GenerateKeyCommand}"/>
                            <ui:Button Content="复制公钥" Padding="10,3" Margin="6,0,0,0" Click="OnCopyPublicKey"
                                       IsEnabled="{Binding HasPublicKey}"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="公钥" HelpText="把以 ssh-ed25519 或 ssh-rsa 开头的一行追加到目标服务器的 ~/.ssh/authorized_keys">
                        <ui:TextBox Text="{Binding PublicKeyText, Mode=OneWay}" IsReadOnly="True"
                                    AcceptsReturn="True" MinHeight="52" FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="11"
                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </controls:FormRow>

                    <controls:FormRow Label="轮换提醒(天)" HelpText="凭据超过该天数未变更则提示轮换；0=关闭提醒">
                        <ui:TextBox FontWeight="Normal" Width="80" HorizontalAlignment="Left"
                                    Text="{Binding CredentialRotateDays, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="凭据时间">
                        <StackPanel>
                            <TextBlock Text="{Binding CredentialAgeText}" Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CredentialWarning}" Foreground="{DynamicResource AppDangerBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding CredentialWarningVisibility}"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="经跳板机" HelpText="仅支持单级跳板；先连跳板机→建本地转发→再连本机">
                        <ComboBox ItemsSource="{Binding JumpOptions}" SelectedItem="{Binding SelectedJumpOption}"
                                  DisplayMemberPath="Name" VerticalContentAlignment="Center"/>
                    </controls:FormRow>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Style="{DynamicResource DialogFooterPanelStyle}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="保存" Appearance="Primary" MinWidth="88" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}"/>
                <ui:Button Content="取消" MinWidth="88" IsCancel="True" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <ui:Button Content="测试连接" Padding="12,4" Margin="0,0,10,0" Command="{Binding TestConnectionCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
