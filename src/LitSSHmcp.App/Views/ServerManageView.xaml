<UserControl x:Class="LitSSHmcp.App.Views.ServerManageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LitSSHmcp.App;component/Themes/GroupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <controls:GroupLabelConverter x:Key="GroupLabel"/>
        <controls:ServerAuthTypeConverter x:Key="ServerAuth"/>
        <controls:BooleanAndToVisibilityConverter x:Key="AllTrueToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource AppPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Grid.Row="0" Icon="Server24" Title="SSH 服务器"
                             Subtitle="双击打开终端；右键更多操作；同一服务器最多 4 个终端">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox Style="{DynamicResource PageSearchBoxStyle}"
                                Text="{Binding ServerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索名称 / 主机 / 标签" VerticalAlignment="Center"
                                AutomationProperties.Name="搜索服务器"/>
                    <CheckBox Content="卡片视图" IsChecked="{Binding IsServerCardView}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="12,4"
                               Margin="8,0,0,0" Command="{Binding AddServerCommand}"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <Border Padding="10,6" CornerRadius="6"
                        Background="{DynamicResource AppDangerSubtleBrush}" BorderBrush="{DynamicResource AppDangerBrush}"
                        BorderThickness="1" Visibility="{Binding HasServersError, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="重试" Padding="10,2" Margin="8,0,0,0"
                                   Command="{Binding LoadServersCommand}"/>
                        <TextBlock Text="{Binding ServersErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                    </DockPanel>
                </Border>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="1" Height="22" Margin="8,0,10,0"
                        Background="{DynamicResource AppBorderBrush}"/>
                <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,0" Command="{Binding LoadServersCommand}"/>
                <ui:Button Content="列" Padding="12,4" Click="OnChooseColumns" ToolTip="显示/隐藏列"/>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <ui:Button Content="站点资产" Icon="{ui:SymbolIcon Globe24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenSiteAssetsCommand}"/>
                <ui:Button Content="批量执行" Icon="{ui:SymbolIcon Play24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenBatchExecCommand}"/>
                <ui:Button Content="会话日志" Icon="{ui:SymbolIcon History24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenTerminalLogsCommand}"/>
                <ui:Button Content="端口转发" Icon="{ui:SymbolIcon Share24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenPortForwardCommand}"/>
                <ui:Button Content="文件/文件夹同步" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenSyncCommand}"/>
                <ui:Button Content="触发事件" Icon="{ui:SymbolIcon Flash24}" Padding="12,4" Margin="0,0,6,6" Command="{Binding OpenTriggerCommand}"/>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                <ListView x:Name="ServerManageList" ItemsSource="{Binding GroupedServers}" SelectedItem="{Binding SelectedServer}"
                          Visibility="{Binding IsServerListView, Converter={StaticResource BoolToVis}}"
                          Padding="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.IsVirtualizingWhenGrouping="False" ScrollViewer.CanContentScroll="False" MouseDoubleClick="OnItemDoubleClick" PreviewMouseRightButtonDown="OnListPreviewRightClick"
                          ContextMenuOpening="OnListContextMenuOpening" controls:GridViewSort.Enabled="True"
                          controls:GroupExpanderBehavior.StorageKey="server.groups">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建 AI 会话" Click="OnNewAiSessionClick"/>
                            <Separator/>
                            <MenuItem Header="打开终端（交互式）" Click="OnOpenTerminalClick"/>
                            <MenuItem Header="SFTP 文件管理" Click="OnSftpManagerClick"/>
                            <MenuItem Header="打开代理浏览器 (SOCKS)…" Click="OnOpenProxiedBrowserClick"/>
                            <MenuItem Header="远程互传（服务器↔服务器）…" Click="OnRemoteCopyClick"/>
                            <MenuItem Header="编辑" Click="OnEditClick"/>
                            <Separator/>
                            <MenuItem Header="采集快照" Click="OnSnapshotRefreshClick"/>
                            <MenuItem Header="快照历史" Click="OnSnapshotHistoryClick"/>
                            <MenuItem Header="资源监控" Click="OnMonitorClick"/>
                            <MenuItem Header="HTTP站点探测" Click="OnSiteDiscoveryClick"/>
                            <MenuItem Header="用户管理" Click="OnUserManagerClick"/>
                            <MenuItem Header="Docker 查看/管理" Click="OnDockerManagerClick"/>
                            <MenuItem Header="系统防火墙" Click="OnFirewallManagerClick"/>
                            <Separator/>
                            <MenuItem Header="删除" Foreground="{DynamicResource AppDangerBrush}" Click="OnDeleteClick"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource CollapsibleAssetGroupContainerStyle}"/>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="160" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="主机" Width="170" DisplayMemberBinding="{Binding Host}"/>
                            <GridViewColumn Header="端口" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Port}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="账号" Width="120" DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="认证" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AuthType, Converter={StaticResource ServerAuth}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="分组" Width="0">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Group, Converter={StaticResource GroupLabel}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="已禁用" Foreground="{DynamicResource AppDangerBrush}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="描述" Width="220" DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="操作" Width="74">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                       ToolTip="编辑" AutomationProperties.Name="编辑服务器"
                                                       Command="{Binding DataContext.EditServerItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Padding="0" Width="26" Height="26" BorderThickness="0"
                                                       Foreground="{DynamicResource AppDangerBrush}" ToolTip="删除"
                                                       AutomationProperties.Name="删除服务器"
                                                       Command="{Binding DataContext.DeleteServerItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsServerCardView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FilteredServers}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource CardBorderStyle}" Width="310" Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="{DynamicResource AppAccentSubtleBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="SSH" FontSize="{DynamicResource AppFontSizeMicro}"
                                                           Foreground="{DynamicResource AppAccentBrush}"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AppDangerSubtleBrush}"
                                                    CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding Disabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="已禁用" FontSize="{DynamicResource AppFontSizeMicro}"
                                                           Foreground="{DynamicResource AppDangerBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppFontSizeSubtitle}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Host}" FontFamily="{DynamicResource AppFontMonoFamily}" Margin="0,8,0,2"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}">
                                            <Run Text="端口 "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Username, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0">
                                            <Run Text="认证 "/><Run Text="{Binding AuthType, Mode=OneWay, Converter={StaticResource ServerAuth}}"/>
                                            <Run Text=" · 分组 "/><Run Text="{Binding Group, Mode=OneWay, Converter={StaticResource GroupLabel}}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <ui:Button Content="终端" Appearance="Primary" Padding="10,3" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.OpenTerminalItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Content="SFTP" Padding="10,3" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.OpenSftpItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Content="监控" Padding="10,3" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.OpenMonitorItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Content="编辑" Padding="10,3" Margin="0,0,6,6"
                                                       Command="{Binding DataContext.EditServerItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Content="更多" Padding="10,3" Margin="0,0,0,6"
                                                       Click="OnServerCardMore"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding GroupedServers.IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Server24" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ServerEmptyTitle}" Style="{DynamicResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="{Binding ServerEmptyHint}"
                               Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="添加服务器" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="14,5"
                                   Command="{Binding AddServerCommand}"
                                   Visibility="{Binding ShowServerEmptyAction, Converter={StaticResource BoolToVis}}"/>
                        <ui:Button Content="清空搜索" Icon="{ui:SymbolIcon Dismiss24}" Padding="14,5"
                                   Click="OnClearSearch"
                                   Visibility="{Binding ShowServerClearSearch, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource AppCardBrush}" Opacity="0.72" Panel.ZIndex="10"
                        Visibility="{Binding IsLoadingServers, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                </Border>
                </Grid>

                <Border Grid.Column="1" Width="320" Margin="8,0,0,0" Padding="14"
                        Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                            <Binding Path="HasSelectedServer"/>
                            <Binding Path="IsServerListView"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Padding="4"
                                       Appearance="Transparent" ToolTip="关闭详情" AutomationProperties.Name="关闭服务器详情"
                                       Click="OnClearServerSelection"/>
                            <TextBlock Text="{Binding SelectedServer.Name}" FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="连接信息" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="地址" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServer.Host}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="端口" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServer.Port}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="账号" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServer.Username}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="认证" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServer.AuthType}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="分组" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServer.Group, Converter={StaticResource GroupLabel}}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="标签" Width="64" Style="{DynamicResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding SelectedServerTagsText}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <TextBlock Text="描述" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding SelectedServer.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <WrapPanel Grid.Row="2">
                            <ui:Button Content="打开终端" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                       Padding="10,4" Margin="0,0,6,6" Command="{Binding OpenTerminalCommand}"/>
                            <ui:Button Content="SFTP" Icon="{ui:SymbolIcon Folder24}"
                                       Padding="10,4" Margin="0,0,6,6" Command="{Binding OpenSftpManagerCommand}"/>
                            <ui:Button Content="资源监控" Icon="{ui:SymbolIcon Pulse24}"
                                       Padding="10,4" Margin="0,0,6,6" Command="{Binding OpenMonitorCommand}"/>
                            <ui:Button Content="编辑" Icon="{ui:SymbolIcon Edit24}"
                                       Padding="10,4" Margin="0,0,6,6" Command="{Binding EditServerCommand}"/>
                            <ui:Button Content="删除" Padding="10,4" Margin="0,0,0,6"
                                       Foreground="{DynamicResource AppDangerBrush}"
                                       Command="{Binding DeleteServerCommand}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Style="{DynamicResource MutedTextStyle}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
