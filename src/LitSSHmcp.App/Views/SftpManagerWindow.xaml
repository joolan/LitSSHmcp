<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SftpManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>

        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Margin="12,6,12,4" Foreground="{DynamicResource AppTextSecondaryBrush}"/>

        <Grid Grid.Row="2" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 本地 -->
            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="本地" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="上级" Padding="8,3" Margin="0,0,4,0" Click="OnLocalUp"/>
                    <Button Content="刷新" Padding="8,3" Margin="0,0,4,0" Click="OnLocalRefresh"/>
                    <Button Content="新建文件夹" Padding="8,3" Margin="0,0,4,0" Click="OnLocalNewFolder"/>
                    <Button Content="删除" Padding="8,3" Click="OnLocalDelete"/>
                </WrapPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Local.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Margin="0,0,0,4" Padding="4,3" KeyDown="OnLocalPathKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Local.StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
                <ListView ItemsSource="{Binding Local.Items}" SelectedItem="{Binding Local.SelectedItem}"
                          MouseDoubleClick="OnLocalDoubleClick" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="修改时间" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <ui:Button Content="上传 →" Padding="10,4" Margin="0,0,0,6" Appearance="Primary" Click="OnUpload"/>
                <ui:Button Content="← 下载" Padding="10,4" Click="OnDownload"/>
            </StackPanel>

            <!-- 远程 -->
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="远程" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="上级" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteUp"/>
                    <Button Content="刷新" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteRefresh"/>
                    <Button Content="新建文件夹" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteNewFolder"/>
                    <Button Content="删除" Padding="8,3" Margin="0,0,4,0" Click="OnRemoteDelete"/>
                    <Button Content="书签" Padding="8,3" Click="OnBookmarks"/>
                </WrapPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Remote.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" Margin="0,0,0,4" Padding="4,3" KeyDown="OnRemotePathKeyDown"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Remote.StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
                <ListView ItemsSource="{Binding Remote.Items}" SelectedItem="{Binding Remote.SelectedItem}"
                          MouseDoubleClick="OnRemoteDoubleClick" Background="Transparent" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="权限" Width="110" DisplayMemberBinding="{Binding OwnerText}"/>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="修改时间" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="10,0,10,10">
            <TextBlock DockPanel.Dock="Top" Text="传输队列" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding Queue.Items}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Direction}" Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding StartedText}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <ProgressBar Grid.Column="4" Height="14" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="5" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
