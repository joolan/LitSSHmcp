<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SiteDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="HTTP站点探测" Height="780" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>

        <Grid Grid.Row="1" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeSubtitle}"/>
                            <Border Background="{DynamicResource AppAccentSubtleBrush}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="直接探测" Padding="12,4" Margin="0,0,6,0" Command="{Binding StartDirectCommand}"/>
                        <ui:Button Content="提权探测" Padding="12,4" Margin="0,0,6,0" Command="{Binding StartElevatedCommand}"/>
                        <ui:Button Content="停止" Padding="12,4" Margin="0,0,6,0" Command="{Binding StopCommand}"/>
                        <ui:Button Content="重试选中步骤" Padding="12,4" Margin="0,0,6,0" Command="{Binding RetryStepCommand}"/>
                        <ui:Button Content="保存结果" Padding="12,4" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                        <ui:Button Content="结果目录" Padding="12,4" Command="{Binding OpenFolderCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ProgressBar Grid.Row="1" Height="4" Minimum="0"
                         Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                         Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,0,0,8"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="280"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="探测进度" FontWeight="SemiBold" Margin="4,2,0,8"/>
                        <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="5"
                                            Background="{DynamicResource AppSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding StateGlyph}" Width="18"
                                                           FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="18,2,0,0"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource AppFontSizeMicro}"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="18,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                <TabControl Grid.Column="2">
                    <TabItem Header="站点">
                        <ListView ItemsSource="{Binding Sites}" BorderThickness="0" Background="Transparent" Padding="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="域名/Host" Width="190" DisplayMemberBinding="{Binding Domain}"/>
                                    <GridViewColumn Header="端口" Width="90" DisplayMemberBinding="{Binding Ports}"/>
                                    <GridViewColumn Header="协议" Width="70" DisplayMemberBinding="{Binding Protocol}"/>
                                    <GridViewColumn Header="服务" Width="100" DisplayMemberBinding="{Binding ServerType}"/>
                                    <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding SiteType}"/>
                                    <GridViewColumn Header="版本" Width="110" DisplayMemberBinding="{Binding ServerVersion}"/>
                                    <GridViewColumn Header="配置来源" Width="120" DisplayMemberBinding="{Binding ConfigSource}"/>
                                    <GridViewColumn Header="站点目录" Width="220" DisplayMemberBinding="{Binding RootPath}"/>
                                    <GridViewColumn Header="代理目标" Width="220" DisplayMemberBinding="{Binding ProxyTarget}"/>
                                    <GridViewColumn Header="上游" Width="220" DisplayMemberBinding="{Binding Upstream}"/>
                                    <GridViewColumn Header="证书" Width="230" DisplayMemberBinding="{Binding CertificatePath}"/>
                                    <GridViewColumn Header="置信度" Width="130" DisplayMemberBinding="{Binding Confidence}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="端口">
                        <ListView ItemsSource="{Binding Ports}" BorderThickness="0" Background="Transparent" Padding="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="端口" Width="70" DisplayMemberBinding="{Binding Port}"/>
                                    <GridViewColumn Header="绑定" Width="130" DisplayMemberBinding="{Binding Bind}"/>
                                    <GridViewColumn Header="进程" Width="120" DisplayMemberBinding="{Binding Process}"/>
                                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                                    <GridViewColumn Header="HTTP" Width="150" DisplayMemberBinding="{Binding HttpStatus}"/>
                                    <GridViewColumn Header="HTTPS" Width="150" DisplayMemberBinding="{Binding HttpsStatus}"/>
                                    <GridViewColumn Header="HTTP 版本" Width="80" DisplayMemberBinding="{Binding HttpVersion}"/>
                                    <GridViewColumn Header="HTTPS 版本" Width="80" DisplayMemberBinding="{Binding HttpsVersion}"/>
                                    <GridViewColumn Header="Server" Width="180" DisplayMemberBinding="{Binding ServerHeader}"/>
                                    <GridViewColumn Header="HTTP 耗时" Width="90" DisplayMemberBinding="{Binding HttpTime}"/>
                                    <GridViewColumn Header="HTTPS 耗时" Width="90" DisplayMemberBinding="{Binding HttpsTime}"/>
                                    <GridViewColumn Header="跳转" Width="180" DisplayMemberBinding="{Binding HttpsLocation}"/>
                                    <GridViewColumn Header="HSTS" Width="130" DisplayMemberBinding="{Binding Hsts}"/>
                                    <GridViewColumn Header="TLS 握手" Width="180" DisplayMemberBinding="{Binding TlsHandshake}"/>
                                    <GridViewColumn Header="TLS 验证" Width="220" DisplayMemberBinding="{Binding TlsStatus}"/>
                                    <GridViewColumn Header="TLS 证书" Width="240" DisplayMemberBinding="{Binding TlsSubject}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="证书">
                        <ListView ItemsSource="{Binding Certificates}" BorderThickness="0" Background="Transparent" Padding="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="路径" Width="260" DisplayMemberBinding="{Binding Path}"/>
                                    <GridViewColumn Header="主题" Width="170" DisplayMemberBinding="{Binding Subject}"/>
                                    <GridViewColumn Header="域名/SAN" Width="220" DisplayMemberBinding="{Binding Domains}"/>
                                    <GridViewColumn Header="到期时间" Width="160" DisplayMemberBinding="{Binding NotAfter}"/>
                                    <GridViewColumn Header="剩余天数" Width="80" DisplayMemberBinding="{Binding DaysRemaining}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="非 HTTP 服务">
                        <ListView ItemsSource="{Binding NonWebServices}" BorderThickness="0" Background="Transparent" Padding="4">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="容器" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="镜像" Width="250" DisplayMemberBinding="{Binding Image}"/>
                                    <GridViewColumn Header="端口映射" Width="220" DisplayMemberBinding="{Binding Ports}"/>
                                    <GridViewColumn Header="类型" Width="110" DisplayMemberBinding="{Binding ServiceType}"/>
                                    <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="证据" Width="160" DisplayMemberBinding="{Binding Evidence}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="历史">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" MinWidth="240"/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:Button Content="刷新历史" Padding="10,3" Margin="0,0,6,0"
                                               Command="{Binding RefreshHistoryCommand}"/>
                                    <ui:Button Content="对比选中" Padding="10,3" Margin="0,0,6,0"
                                               Command="{Binding CompareHistoryCommand}"/>
                                    <ui:Button Content="删除" Padding="10,3" Margin="0,0,6,0"
                                               Command="{Binding DeleteHistoryCommand}"/>
                                    <ui:Button Content="导出" Padding="10,3"
                                               Command="{Binding ExportHistoryCommand}"/>
                                </StackPanel>
                                <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                                          BorderThickness="0" Background="Transparent" Padding="2">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="145" DisplayMemberBinding="{Binding DisplayTime}"/>
                                            <GridViewColumn Header="结果" Width="150" DisplayMemberBinding="{Binding Summary}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                            <DockPanel Grid.Column="2">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,6">
                                    <TextBlock Text="与当前结果对比" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Content="复制对比" Padding="10,3" Margin="12,0,0,0"
                                               Command="{Binding CopyDiffCommand}"/>
                                </StackPanel>
                                <ListView ItemsSource="{Binding Diff}" BorderThickness="0" Background="Transparent" Padding="2">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="变化" Width="80" DisplayMemberBinding="{Binding Change}"/>
                                            <GridViewColumn Header="域名/Host" Width="170" DisplayMemberBinding="{Binding Domain}"/>
                                            <GridViewColumn Header="详情" Width="420" DisplayMemberBinding="{Binding Detail}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="日志">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource AppFontMonoFamily}"
                                 FontSize="{DynamicResource AppFontSizeMicro}"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="16,0,16,10">
            <TextBlock Text="{Binding StatusTextWithMode}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SavedPath}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
