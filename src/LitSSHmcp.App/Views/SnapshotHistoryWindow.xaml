<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.SnapshotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器快照历史" Height="700" Width="1180" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="服务器快照历史"/>
        <Grid Grid.Row="1">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ServerCombo" Width="260" ItemsSource="{Binding Servers}"
                      SelectedItem="{Binding SelectedServer, Mode=TwoWay}" DisplayMemberPath="Name"
                      SelectionChanged="OnServerChanged"
                      ToolTip="可切换其他服务器查看其历史快照"/>
            <Button Content="刷新" Width="70" Padding="6,4" Margin="10,0,0,0" Click="OnRefresh"/>
            <TextBlock Text="左列选择某次快照 → 右侧查看该次的采集维度/事件/原始数据"
                       VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" Margin="14,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="SnapshotList" Grid.Column="0" ItemsSource="{Binding Snapshots}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionChanged="OnSnapshotChanged"
                      FontFamily="Consolas" FontSize="11">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="采集时间" Width="150" DisplayMemberBinding="{Binding CreatedAtText}"/>
                        <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding State}"/>
                        <GridViewColumn Header="耗时(ms)" Width="70" DisplayMemberBinding="{Binding DurationMs}"/>
                        <GridViewColumn Header="提权" Width="70" DisplayMemberBinding="{Binding Escalation}"/>
                        <GridViewColumn Header="错误" Width="90" DisplayMemberBinding="{Binding Error}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#22000000" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
                <TabControl>
                    <TabItem Header="采集概览">
                        <ListView ItemsSource="{Binding Sections}" FontFamily="Consolas" FontSize="11">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="采集维度" Width="120" DisplayMemberBinding="{Binding Dimension}"/>
                                    <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="耗时(ms)" Width="80" DisplayMemberBinding="{Binding DurationMs}"/>
                                    <GridViewColumn Header="说明" Width="420" DisplayMemberBinding="{Binding Note}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="采集事件">
                        <ListView ItemsSource="{Binding Events}" FontFamily="Consolas" FontSize="11">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding Timestamp}"/>
                                    <GridViewColumn Header="事件" Width="150" DisplayMemberBinding="{Binding Kind}"/>
                                    <GridViewColumn Header="维度" Width="100" DisplayMemberBinding="{Binding Collector}"/>
                                    <GridViewColumn Header="信息" Width="400" DisplayMemberBinding="{Binding Message}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="原始数据(JSON)">
                        <TextBox Text="{Binding RawJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,6,0,0"/>
    </Grid>
</Grid>
    </Grid>
</ui:FluentWindow>
