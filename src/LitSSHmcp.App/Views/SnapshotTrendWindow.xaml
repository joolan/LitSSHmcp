<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SnapshotTrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="快照趋势" Height="560" Width="940" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="快照趋势"/>

        <DockPanel Grid.Row="1" Margin="14,4,14,8">
            <ui:Button DockPanel.Dock="Right" Content="刷新" Padding="12,4" Margin="8,0,0,0" Click="OnRefresh"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ServerCombo" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                          DisplayMemberPath="Name" Width="300" Height="30" VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left" Padding="10,4"
                          SelectionChanged="OnServerChanged"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppRadiusS}">
                <controls:TrendChart x:Name="Chart" Margin="4"/>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="2,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
