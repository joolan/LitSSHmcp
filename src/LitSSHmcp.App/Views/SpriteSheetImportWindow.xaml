<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SpriteSheetImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="导入精灵图" Height="520" Width="720" MinHeight="440" MinWidth="620"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="导入精灵图" Margin="-16,-16,-16,10"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="精灵图文件" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="选择…" Padding="12,4" Margin="6,0,0,0" Click="OnChooseFile"/>
                        <ui:TextBox x:Name="PathBox" IsReadOnly="True"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="列数" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="ColumnsBox" Text="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="行数" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="RowsBox" Text="1"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="帧宽（0=自动）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="FrameWidthBox" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="帧高（0=自动）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="FrameHeightBox" Text="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="10">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                <TextBlock x:Name="EmptyHint" Text="选择一张精灵图后在这里预览"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="导入" Appearance="Primary" Padding="14,5" Margin="0,0,8,0" Click="OnImport"/>
                <ui:Button Content="取消" Padding="14,5" Click="OnCancel"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
