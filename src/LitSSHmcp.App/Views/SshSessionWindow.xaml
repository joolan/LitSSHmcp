<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SshSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:LitSSHmcp.App.ViewModels"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SSH 会话管理" Height="820" Width="1280" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:MainPageAppearanceConverter x:Key="LayoutAppearance"/>

        <ControlTemplate x:Key="SessionTabTemplate" TargetType="TabControl">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <TabPanel IsItemsHost="True" x:Name="HeaderPanel" Panel.ZIndex="1" Margin="2,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="SessionCaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionCloseButton" TargetType="Button" BasedOn="{StaticResource SessionCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppCloseHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppCloseHoverTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 会话内容 DataTemplate 已上移到 App 级 Themes/SessionTemplates.xaml（供分离窗口共用） -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="36" Background="{DynamicResource AppSurfaceBrush}"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="SSH 会话管理" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ui:Button Icon="{ui:SymbolIcon Play24}" Appearance="Transparent" Padding="6,3" Margin="0,0,8,0"
                                   IsEnabled="{Binding HasSessions}" ToolTip="批量执行"
                                   AutomationProperties.Name="批量执行" Click="OnBatchExec"/>
                        <ui:Button Icon="{ui:SymbolIcon Eye24}" Appearance="Transparent" Padding="6,3" Margin="0,0,8,0"
                                   IsEnabled="{Binding HasSessions}" ToolTip="布局 / 显示方式"
                                   AutomationProperties.Name="切换会话布局" Click="OnLayoutMenu"/>
                        <ui:Button Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Padding="6,3"
                                   ToolTip="新建连接" AutomationProperties.Name="新建 SSH 连接" Click="OnNewConnection"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource SessionCaptionButton}" Content="&#xE921;" Click="OnMinimizeWindow"
                            AutomationProperties.Name="最小化"/>
                    <Button Style="{StaticResource SessionCaptionButton}" Content="&#xE922;" Click="OnMaximizeWindow"
                            AutomationProperties.Name="最大化"/>
                    <Button Style="{StaticResource SessionCloseButton}" Content="&#xE8BB;" Click="OnCloseWindow"
                            AutomationProperties.Name="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="6">
            <Grid>
                <TabControl x:Name="Tabs" ItemsSource="{Binding DockedSessions}" SelectedItem="{Binding SelectedSession}"
                        Template="{StaticResource SessionTabTemplate}"
                        SelectionChanged="OnTabsSelectionChanged"
                        Visibility="{Binding IsSshTabbed, Converter={StaticResource BoolToVis}}"
                        AllowDrop="True" PreviewMouseLeftButtonDown="OnTabsPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnTabsPreviewMouseMove" QueryContinueDrag="OnDragQueryContinueDrag"
                        DragOver="OnTabsDragOver" Drop="OnTabsDrop"
                        MouseDoubleClick="OnTabsDoubleClick">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="按住拖动可分离为独立窗口；双击重命名">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="分离为独立窗口" Click="OnDetachItem"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="连接状态">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AppTextTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="20" Height="20" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" ToolTip="关闭会话"
                                    AutomationProperties.Name="关闭会话"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <ScrollViewer x:Name="TilingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSshTiled, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding DockedSessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SshTileColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusS}" ClipToBounds="True"
                                    Height="{Binding DataContext.SshTileCardHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="20" Background="{DynamicResource AppSurfaceAltBrush}"
                                            Cursor="SizeAll" ToolTip="按住拖动可分离为独立窗口"
                                            PreviewMouseLeftButtonDown="OnCardGripMouseDown"
                                            PreviewMouseMove="OnCardGripMouseMove"
                                            QueryContinueDrag="OnDragQueryContinueDrag">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="分离为独立窗口" Click="OnDetachItem"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="连接状态">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource AppTextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ContentPresenter Content="{Binding}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDockedSessions}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="Server24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="暂无 SSH 会话" Style="{DynamicResource EmptyStateTitleStyle}"/>
                <TextBlock Text="打开服务器终端后，会话标签会显示在这里。" Style="{DynamicResource EmptyStateHintStyle}"
                           Margin="0,6,0,12"/>
                <ui:Button Content="选择服务器新建连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="16,6"
                           HorizontalAlignment="Center" Click="OnNewConnection"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
