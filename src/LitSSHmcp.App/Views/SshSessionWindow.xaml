<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SshSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:LitSSHmcp.App.ViewModels"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="SSH 会话管理" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:MainPageAppearanceConverter x:Key="LayoutAppearance"/>

        <Style x:Key="TileCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33EF4444"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="SessionTabTemplate" TargetType="TabControl">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <TabPanel IsItemsHost="True" x:Name="HeaderPanel" Panel.ZIndex="1" Margin="2,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Grid>
        </ControlTemplate>

        <!-- 命令会话标签 -->
        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource TileCloseButton}" Margin="4,0,0,0"
                            ToolTip="关闭会话"
                            Visibility="{Binding DataContext.IsSshTiled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <ui:Button DockPanel.Dock="Right" Content="测试连接" Padding="10,3" Margin="6,0,0,0" Command="{Binding TestConnectionCommand}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBox Grid.Row="1" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="6"
                         FontFamily="Consolas" Background="{DynamicResource AppCodeBgBrush}" Foreground="{DynamicResource AppCodeTextBrush}"/>

                <Grid Grid.Row="2" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="5" Margin="0,0,6,0"
                             FontFamily="Consolas" KeyDown="OnCommandKeyDown"/>
                    <ui:Button Grid.Column="1" Content="执行" Padding="16,5" Margin="0,0,6,0" Appearance="Primary" Command="{Binding ExecuteCommand}"/>
                    <ui:Button Grid.Column="2" Content="清空" Padding="12,5" Command="{Binding ClearOutputCommand}"/>
                </Grid>

                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top" Text="最近活动" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding RecentActivity}" FontFamily="Consolas" FontSize="11" Padding="2" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Command, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AppAccentBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- 交互式终端标签（左：远程文件；右：终端） -->
        <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
            <controls:TerminalTabView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SSH 会话管理"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4"
                        Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                <ui:Button Icon="{ui:SymbolIcon Add24}" Appearance="Transparent" Padding="6,3" Margin="0,0,10,0"
                           ToolTip="新建连接…" Click="OnNewConnection"/>
                <ui:Button Icon="{ui:SymbolIcon Play24}" Appearance="Transparent" Padding="6,3" Margin="0,0,10,0"
                           ToolTip="批量执行（发送到会话窗口）" Click="OnBatchExec"/>
                <ui:Button Icon="{ui:SymbolIcon Eye24}" Padding="8,3" ToolTip="布局 / 显示方式" Click="OnLayoutMenu"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <TabControl x:Name="Tabs" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                        Template="{StaticResource SessionTabTemplate}"
                        SelectionChanged="OnTabsSelectionChanged"
                        Visibility="{Binding IsSshTabbed, Converter={StaticResource BoolToVis}}"
                        AllowDrop="True" PreviewMouseLeftButtonDown="OnTabsPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnTabsPreviewMouseMove" DragOver="OnTabsDragOver" Drop="OnTabsDrop"
                        MouseDoubleClick="OnTabsDoubleClick">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="16" Height="16" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" ToolTip="关闭会话"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <ScrollViewer x:Name="TilingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSshTiled, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SshTileColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusS}" ClipToBounds="True"
                                    Height="{Binding DataContext.SshTileCardHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ContentPresenter Content="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSessions}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="当前没有已打开的 SSH 会话标签。" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <ui:Button Content="选择服务器新建连接" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="16,6"
                           HorizontalAlignment="Center" Click="OnNewConnection"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
