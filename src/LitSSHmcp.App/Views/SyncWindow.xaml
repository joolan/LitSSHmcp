<ui:FluentWindow x:Class="LitSSHmcp.App.Views.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="文件 / 文件夹同步" Height="760" Width="1040" MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <controls:BooleanNotToVisibilityConverter x:Key="BoolNotToVis"/>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="文件 / 文件夹同步（单向 · 仅在 App 运行期间执行）"/>

        <controls:PageHeader Grid.Row="1" Margin="12,8,12,0" Icon="ArrowSync24" Title="同步任务"
                             Subtitle="单向同步 · 仅在 App 运行期间执行">
            <controls:PageHeader.Actions>
                <ui:Button Content="新建任务" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Padding="12,4"
                           Command="{Binding NewTaskCommand}"/>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 任务列表 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="删除" Padding="12,3" Command="{Binding DeleteTaskCommand}"/>
                </StackPanel>
                <Grid>
                    <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding LastResult}"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               Text="{Binding LastRunAt, StringFormat='上次: {0:MM-dd HH:mm}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220"
                                Visibility="{Binding HasItems, ElementName=TaskList, Converter={StaticResource BoolNotToVis}}">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="暂无同步任务" Style="{DynamicResource EmptyStateTitleStyle}"/>
                        <TextBlock Text="点击页头「新建任务」创建第一条同步任务。"
                                   Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 编辑区 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <controls:FormRow Label="任务名称" IsRequired="True">
                        <ui:TextBox FontWeight="Normal" Text="{Binding SelectedTask.Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="同步方向">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding DirectionNames}" SelectedIndex="{Binding DirectionIndex}" Width="150"/>
                            <CheckBox Content="启用" IsChecked="{Binding SelectedTask.Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:FormRow>

                    <controls:FormRow Label="本地路径" Visibility="{Binding LocalPathVisibility}">
                        <controls:PathPicker Value="{Binding SelectedTask.LocalPath, Mode=TwoWay}"
                                             PickFolder="True" Title="选择本地文件夹"
                                             Placeholder="如 D:\data\www"/>
                    </controls:FormRow>

                    <controls:FormRow Label="源服务器" Visibility="{Binding SourceVisibility}">
                        <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTask.SourceServerId, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="源远程路径" Visibility="{Binding SourceVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" FontWeight="Normal" Margin="0,0,6,0"
                                        Text="{Binding SelectedTask.SourceRemotePath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="如 /var/www/html"/>
                            <ui:Button Grid.Column="1" Content="浏览远程…" Padding="10,3" Click="OnPickSourcePath"/>
                        </Grid>
                    </controls:FormRow>

                    <controls:FormRow Label="目标服务器" Visibility="{Binding TargetVisibility}">
                        <ComboBox ItemsSource="{Binding Servers}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTask.TargetServerId, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="目标远程路径" Visibility="{Binding TargetVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" FontWeight="Normal" Margin="0,0,6,0"
                                        Text="{Binding SelectedTask.TargetRemotePath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="如 /backup/www"/>
                            <ui:Button Grid.Column="1" Content="浏览远程…" Padding="10,3" Click="OnPickTargetPath"/>
                        </Grid>
                    </controls:FormRow>

                    <controls:FormRow Label="内网地址" Visibility="{Binding InternalAddressVisibility}">
                        <CheckBox Content="使用内网地址连接目标（需目标已配置内网地址）"
                                  IsChecked="{Binding SelectedTask.UseInternalAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="镜像删除" HelpText="勾选后，目标端存在、但同步源中不存在的文件/文件夹会被删除，使目标与源完全一致（镜像）。默认不勾选，仅新增/更新，绝不删除任何文件。">
                        <CheckBox Content="删除目标端多余文件" IsChecked="{Binding SelectedTask.DeleteExtra, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <TextBlock Text="文件过滤" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <controls:FormRow Label="仅同步" HelpText="逗号/空格分隔的 glob，例如 *.conf, nginx/*.log；留空=全部文件">
                        <ui:TextBox FontWeight="Normal" Text="{Binding IncludeText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <controls:FormRow Label="排除" HelpText="逗号/空格分隔的 glob，例如 *.tmp, cache/*；留空=不排除">
                        <ui:TextBox FontWeight="Normal" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <TextBlock Text="调度（三选一）" Style="{DynamicResource SectionTitleStyle}" Margin="0,8,0,6"/>

                    <!-- 固定间隔 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="固定间隔" GroupName="SyncSchedule" VerticalAlignment="Center"
                                     IsChecked="{Binding IsIntervalSchedule, Mode=TwoWay}" Width="110"/>
                        <TextBlock Text="每隔" VerticalAlignment="Center" Margin="6,0,4,0" IsEnabled="{Binding IsIntervalSchedule}"/>
                        <ui:TextBox FontWeight="Normal" Width="70" Text="{Binding SelectedTask.IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsIntervalSchedule}"/>
                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="6,0,0,0" IsEnabled="{Binding IsIntervalSchedule}"/>
                    </StackPanel>

                    <!-- 每周固定时刻 -->
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="每周固定时刻" GroupName="SyncSchedule" VerticalAlignment="Center"
                                         IsChecked="{Binding IsWeeklySchedule, Mode=TwoWay}" Width="110"/>
                            <TextBlock Text="时刻" VerticalAlignment="Center" Margin="0,0,4,0" IsEnabled="{Binding IsWeeklySchedule}"/>
                            <ui:TextBox FontWeight="Normal" Width="70" Text="{Binding SelectedTask.TimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsWeeklySchedule}" ToolTip="HH:mm"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WeekdayOptions}" IsEnabled="{Binding IsWeeklySchedule}" Margin="24,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 每月固定 -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="每月固定" GroupName="SyncSchedule" VerticalAlignment="Center"
                                         IsChecked="{Binding IsMonthlySchedule, Mode=TwoWay}" Width="110"/>
                            <TextBlock Text="时刻" VerticalAlignment="Center" Margin="0,0,4,0" IsEnabled="{Binding IsMonthlySchedule}"/>
                            <ui:TextBox FontWeight="Normal" Width="70" Text="{Binding SelectedTask.TimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsMonthlySchedule}" ToolTip="HH:mm"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MonthDayOptions}" IsEnabled="{Binding IsMonthlySchedule}" Margin="24,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,0,10,4" MinWidth="26"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="（日期 1-28；多选）" FontSize="{DynamicResource AppFontSizeMicro}" Margin="24,0,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <controls:FormRow Label="失败重试" HelpText="0-5 次；指数退避。远程↔远程需两端安装 rsync">
                        <ui:TextBox FontWeight="Normal" Width="80" HorizontalAlignment="Left"
                                    Text="{Binding SelectedTask.MaxRetries, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:FormRow>

                    <!-- 触发事件配置 -->
                    <TextBlock Text="触发事件配置（本同步任务结束后触发）" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding EventHookOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" MinWidth="180" VerticalAlignment="Center"/>
                                    <CheckBox Content="仅同步成功时触发（不勾=无条件触发，失败也触发）" Margin="12,0,0,0" VerticalAlignment="Center"
                                              IsEnabled="{Binding Selected}" IsChecked="{Binding OnlyOnSuccess, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="列表为空时：请先在「触发事件」窗口创建触发事件并勾选「允许被同步任务事件触发」。触发事件可配置为「无条件触发」或「仅同步成功时触发」。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="3" Margin="12,10,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="测试（传探针）" Padding="12,5" Margin="0,0,8,0" Command="{Binding TestCommand}"/>
                <ui:Button Content="保存" Appearance="Primary" Padding="14,5" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
                <ui:Button Content="立即运行" Padding="12,5" Margin="0,0,8,0" Command="{Binding RunNowCommand}"/>
                <ui:Button Content="关闭" Width="80" IsCancel="True" Click="OnClose"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
