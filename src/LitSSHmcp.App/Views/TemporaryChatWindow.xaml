<ui:FluentWindow x:Class="LitSSHmcp.App.Views.TemporaryChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="临时聊天（不保存）" Height="620" Width="860" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Grid.IsSharedSizeScope="True" AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" PreviewKeyDown="OnWindowPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="临时聊天（不保存）"/>

        <DockPanel Grid.Row="1" Margin="12,0,12,6">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Text="模型:"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" Text="{Binding StatusMessage}"/>
            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                      DisplayMemberPath="Name" Width="220" Height="32" VerticalContentAlignment="Center"
                      ToolTip="临时聊天也可切换模型（保留已聊内容）"/>
        </DockPanel>

        <Border Grid.Row="2" Margin="12,0,12,0" Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2,0,0,0" CornerRadius="{DynamicResource AppRadiusM}" Padding="10">
            <Grid>
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Turns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Border Style="{DynamicResource UserBubbleStyle}" MaxWidth="640">
                                        <StackPanel>
                                            <TextBlock Text="{Binding UserText}" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding Images}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:ImageThumb SourcePath="{Binding}" Width="72" Height="72" Margin="0,0,6,6"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding UserTime}" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource AssistantCardStyle}" Margin="0,9,0,0"
                                            Visibility="{Binding AssistantVisibility}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Chat24" FontSize="14" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock Text="临时聊天" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <controls:MarkdownBox Markdown="{Binding AssistantText}"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"
                                                       FontSize="12" Margin="0,3,0,0" Visibility="{Binding NoteVisibility}"/>
                                            <TextBlock Text="运行中…" Foreground="{DynamicResource AppAccentBrush}" FontSize="11"
                                                       Margin="0,2,0,0" Visibility="{Binding RunningVisibility}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <ui:SymbolIcon Symbol="Chat24" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="临时聊天（不保存、无工具/技能）" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="仅用于普通问答/闲聊，与主运维任务互不影响；关闭本窗口即清空。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource AppRadiusM}" Padding="8" Margin="12,8,12,12"
                AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True"
                           Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource ActionRowButton}" Padding="6,2" Margin="8,0,0,6"
                            VerticalAlignment="Top" Click="OnClearAttachments" ToolTip="清除全部附件">
                        <TextBlock Text="清除全部" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="6,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                        <Button Style="{DynamicResource ActionRowButton}" Padding="2" Margin="6,0,0,0"
                                                Click="OnRemoveAttachment" ToolTip="移除">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Appearance="Transparent" Padding="6" Margin="0,0,6,0"
                               Icon="{ui:SymbolIcon Add24}" ToolTip="添加图片 / 文件" Click="OnAddAttachment"/>
                    <ui:TextBox Grid.Column="1" x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" MinHeight="44" MaxHeight="200" TextWrapping="Wrap"
                                FontFamily="Microsoft YaHei" FontSize="13" VerticalContentAlignment="Top"
                                PlaceholderText="输入消息…（Enter 发送 / Shift+Enter 换行）" PreviewKeyDown="OnInputKeyDown"/>
                    <ui:Button Grid.Column="2" Appearance="Primary" Width="60" Height="34" Padding="0" Margin="6,0,0,0"
                               Command="{Binding SendOrStopCommand}" ToolTip="{Binding SendButtonText}">
                        <TextBlock Text="{Binding SendButtonText}" FontSize="12"/>
                    </ui:Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
