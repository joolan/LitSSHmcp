<UserControl x:Class="LitSSHmcp.App.Views.TerminalSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="终端外观设置（全局，对所有 SSH 终端生效，保存后立即应用）。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="配色主题:" VerticalAlignment="Center" Width="80"/>
                    <ComboBox x:Name="ThemeBox" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="字体:" VerticalAlignment="Center" Width="80"/>
                    <ComboBox x:Name="FontBox" Width="240" IsEditable="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="字号:" VerticalAlignment="Center" Width="80"/>
                    <ui:TextBox FontWeight="Normal" x:Name="FontSizeBox" Width="70"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="光标样式:" VerticalAlignment="Center" Width="80"/>
                    <ComboBox x:Name="CursorBox" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="回看行数:" VerticalAlignment="Center" Width="80"/>
                    <ui:TextBox FontWeight="Normal" x:Name="ScrollbackBox" Width="90"/>
                </StackPanel>
                <CheckBox x:Name="CopyOnSelectBox" Content="选中即复制" Margin="0,4,0,0"/>
                <CheckBox x:Name="RecordSessionsBox" Content="记录会话日志（可回放，存于 %APPDATA%\LitSSH\terminal-logs）" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="保存并应用" Padding="16,4" Appearance="Primary" Click="OnSave"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
