<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="输入"/>
        <Grid Grid.Row="1" Margin="16,0,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PromptText" Text="请输入:" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <ui:TextBox x:Name="ValueBox" Grid.Row="1" MinHeight="30" VerticalContentAlignment="Center"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="确定" Appearance="Primary" Width="86" Margin="0,0,8,0" Click="OnOk" IsDefault="True"/>
                <ui:Button Content="取消" Width="86" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
