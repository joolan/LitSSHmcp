<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ToolGroupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择工具分组" Height="560" Width="440" MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="选择工具分组"/>

        <TextBlock Grid.Row="1" Margin="16,4,16,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="会话级限制：只勾选需要的工具分组。**不勾选任何分组 = 不限制（全部工具）**。该限制会写入系统提示并在后续对话（含压缩后）持续生效。"/>

        <Border Grid.Row="2" Margin="16,0,16,0" Style="{DynamicResource CardBorderStyle}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OptionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="4,6"
                                      Content="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,10,16,12">
            <ui:Button DockPanel.Dock="Left" Content="清除限制" Click="OnClear" ToolTip="不限制（全部工具）"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Width="80" IsCancel="True" Margin="0,0,8,0" Click="OnCancel"/>
                <ui:Button Content="确定" Appearance="Primary" Width="90" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
