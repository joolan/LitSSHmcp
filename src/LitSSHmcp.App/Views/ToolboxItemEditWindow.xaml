<ui:FluentWindow x:Class="LitSSHmcp.App.Views.ToolboxItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="添加工具" Height="620" Width="580" MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,0">
            <StackPanel>
                <TextBlock Text="名称" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                            PlaceholderText="例如：Notepad++、运维平台、清理脚本"/>

                <TextBlock Text="类型" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Text"
                          SelectedValuePath="Type" SelectedValue="{Binding Type, Mode=TwoWay}"
                          Margin="0,0,0,10"/>

                <TextBlock Text="目标" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,2">
                    <ui:Button DockPanel.Dock="Right" Content="浏览…" Padding="10,3" Margin="8,0,0,0"
                               Click="OnBrowseTarget"/>
                    <ui:TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding TargetHint}"/>
                </DockPanel>
                <TextBlock Text="{Binding TargetHint}" Foreground="{DynamicResource AppTextTertiaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,0,0,10"/>

                <StackPanel Visibility="{Binding IsScript, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="脚本类型" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ScriptShells}" SelectedItem="{Binding ScriptShell, Mode=TwoWay}"
                              Margin="0,0,0,10"/>
                </StackPanel>

                <TextBlock Text="参数" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                            PlaceholderText="可选，例如：--profile default"/>

                <TextBlock Text="工作目录" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="浏览…" Padding="10,3" Margin="8,0,0,0"
                               Click="OnBrowseWorkingDirectory"/>
                    <ui:TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="可选；留空使用程序默认目录"/>
                </DockPanel>

                <TextBlock Text="说明" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="110"
                            VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                            PlaceholderText="可选，显示在工具卡片上"/>

                <TextBlock Text="分组" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                            PlaceholderText="可选，例如：日常、数据库、网络"/>

                <TextBlock Text="标签" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                            PlaceholderText="可选，逗号分隔，例如：常用, 生产, 排查"/>

                <CheckBox Content="以管理员身份运行（每次启动会弹出 UAC）"
                          IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" Margin="0,0,0,8"/>
                <CheckBox Content="固定到「常用」" IsChecked="{Binding IsPinned, Mode=TwoWay}" Margin="0,0,0,16"/>

                <Border Background="{DynamicResource AppWarningSubtleBrush}" BorderBrush="{DynamicResource AppWarningBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="脚本片段每次执行前都会展示完整内容并要求确认；URL 仅支持 http / https / mailto。"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="16,10,16,14" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Content="保存" Appearance="Primary" Padding="20,5"
                       Margin="8,0,0,0" Click="OnSave"/>
            <ui:Button DockPanel.Dock="Right" Content="取消" Padding="20,5" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
