<UserControl x:Class="LitSSHmcp.App.Views.ToolboxView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="224"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderHoverBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Opacity" Value="0.62"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ViewToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolListRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Opacity" Value="0.62"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="SearchBox" Width="280" Height="34" Margin="0,0,8,0"
                                PlaceholderText="搜索工具…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                VerticalContentAlignment="Center" KeyDown="OnSearchBoxKeyDown"/>
                    <ComboBox Width="128" Height="34" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Padding="8,2"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
                    <ComboBox Width="128" Height="34" Margin="0,0,8,0"
                              VerticalContentAlignment="Center" Padding="8,2"
                              ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="卡片视图" Click="OnCardView">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="Grid24" FontSize="15"/>
                        </Button>
                        <Button ToolTip="列表视图" Click="OnListView">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ui:SymbolIcon Symbol="List24" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent" BorderThickness="0"
                               Padding="6,0" Height="34" Margin="0,0,8,0" ToolTip="刷新工具箱"
                               Command="{Binding RefreshCommand}"/>
                    <ui:Button x:Name="DetachButton" Content="独立窗口" Icon="{ui:SymbolIcon WindowNew24}"
                               Padding="10,4" Height="34" Margin="0,0,8,0" Click="OnDetachWindow"/>
                    <ui:Button Content="添加" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Padding="14,4" Height="34" Click="OnAdd"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="2,0,2,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ToolCardStyle}" Tag="ToolboxCard" ToolTip="{Binding MetaToolTip}"
                                    MouseLeftButtonUp="OnCardActivate"
                                    PreviewMouseLeftButtonDown="OnCardMouseDown"
                                    PreviewMouseMove="OnCardMouseMove">
                                <Border.ContextMenu>
                                    <ContextMenu Opened="OnItemContextMenuOpened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="打开" Click="OnMenuLaunch"/>
                                        <MenuItem Header="编辑" Tag="edit" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuEdit"/>
                                        <MenuItem Header="固定 / 取消固定" Click="OnMenuPin"/>
                                        <MenuItem Header="设置分组…" Click="OnMenuSetGroup"/>
                                        <Separator/>
                                        <MenuItem Header="打开所在位置" Tag="openlocation" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuOpenLocation"/>
                                        <MenuItem Header="删除" Tag="delete" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="9"
                                                Background="{DynamicResource AppSurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                                <ui:SymbolIcon Symbol="{Binding FallbackSymbol}" FontSize="24"
                                                               Foreground="{DynamicResource AppAccentBrush}">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,6,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource AppFontSizeBody}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Style="{StaticResource TypeBadgeStyle}">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="9"
                                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="7"
                                                        Padding="6,1" Margin="6,0,0,0"
                                                        Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Group}" FontSize="9"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="路径不存在" Margin="7,0,0,0"
                                                           Foreground="{DynamicResource AppDangerBrush}"
                                                           FontSize="9" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="Pin24" FontSize="12" Margin="0,2,2,0"
                                                           Foreground="{DynamicResource AppWarningBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <Button x:Name="MoreButton" Padding="2,0" Width="24" Height="22"
                                                    Background="Transparent" BorderThickness="0" Click="OnMoreClick"
                                                    ToolTip="更多操作">
                                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Model.Target}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}"
                                               FontFamily="{DynamicResource AppFontMonoFamily}"
                                               FontSize="9" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Bottom"/>

                                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource AppAccentBrush}" Panel.ZIndex="10"
                                            Visibility="{Binding ShowInsertBefore, Converter={StaticResource BoolToVis}}"/>
                                    <Border Width="3" HorizontalAlignment="Right" CornerRadius="2"
                                            Background="{DynamicResource AppAccentBrush}" Panel.ZIndex="10"
                                            Visibility="{Binding ShowInsertAfter, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Tag="ToolboxCard" Style="{StaticResource ToolListRowStyle}" ToolTip="{Binding MetaToolTip}"
                                    MouseLeftButtonUp="OnCardActivate"
                                    PreviewMouseLeftButtonDown="OnCardMouseDown"
                                    PreviewMouseMove="OnCardMouseMove">
                                <Border.ContextMenu>
                                    <ContextMenu Opened="OnItemContextMenuOpened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="打开" Click="OnMenuLaunch"/>
                                        <MenuItem Header="编辑" Tag="edit" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuEdit"/>
                                        <MenuItem Header="固定 / 取消固定" Click="OnMenuPin"/>
                                        <MenuItem Header="设置分组…" Click="OnMenuSetGroup"/>
                                        <Separator/>
                                        <MenuItem Header="打开所在位置" Tag="openlocation" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuOpenLocation"/>
                                        <MenuItem Header="删除" Tag="delete" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Click="OnMenuDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="7"
                                            Background="{DynamicResource AppSurfaceAltBrush}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                            <ui:SymbolIcon Symbol="{Binding FallbackSymbol}" FontSize="18"
                                                           Foreground="{DynamicResource AppAccentBrush}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Model.Target}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   FontFamily="{DynamicResource AppFontMonoFamily}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource TypeBadgeStyle}">
                                        <TextBlock Text="{Binding TypeText}" FontSize="9"
                                                   Foreground="{DynamicResource AppAccentBrush}"/>
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="7"
                                            Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Group}" FontSize="9"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </Border>
                                    <ui:SymbolIcon Grid.Column="4" Symbol="Pin24" FontSize="12" Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppWarningBrush}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <Button Grid.Column="5" Padding="2,0" Width="24" Height="22"
                                            Background="Transparent" BorderThickness="0" Click="OnMoreClick"
                                            ToolTip="更多操作">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14"/>
                                    </Button>
                                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource AppAccentBrush}" Panel.ZIndex="10"
                                            Visibility="{Binding ShowInsertBefore, Converter={StaticResource BoolToVis}}"/>
                                    <Border Width="3" HorizontalAlignment="Right" CornerRadius="2"
                                            Background="{DynamicResource AppAccentBrush}" Panel.ZIndex="10"
                                            Visibility="{Binding ShowInsertAfter, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="Toolbox24" FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="还没有工具" Style="{DynamicResource EmptyStateTitleStyle}"/>
                <TextBlock Text="把程序、文件或文件夹拖到这里，或点击右上角「添加」。"
                           Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="{DynamicResource AppAccentSubtleBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                    CornerRadius="{DynamicResource AppRadiusM}" Margin="6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Add24" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock Text="松开以添加到工具箱" FontSize="{DynamicResource AppFontSizeSubtitle}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
