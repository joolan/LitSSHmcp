<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.DnsRecordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="本地记录" Height="500" Width="500" MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="本地记录"/>

        <ScrollViewer Grid.Row="1" Margin="16,4,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,6,0,4"/>
                <TextBox x:Name="NameBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                         ToolTip="例如 nas.lab；支持 *.lab 通配"/>

                <TextBlock Text="类型" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ComboBox x:Name="TypeBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                          SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Content="A（IPv4）" Tag="A"/>
                    <ComboBoxItem Content="AAAA（IPv6）" Tag="AAAA"/>
                    <ComboBoxItem Content="CNAME（别名）" Tag="CNAME"/>
                    <ComboBoxItem Content="PTR（反向解析）" Tag="PTR"/>
                </ComboBox>

                <TextBlock Text="值" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox x:Name="ValueBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="TTL（秒）" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox x:Name="TtlBox" Height="34" Width="140" HorizontalAlignment="Left"
                         VerticalContentAlignment="Center" Padding="8,0" Text="300"/>

                <CheckBox x:Name="EnabledCheck" Content="启用该记录" Margin="0,14,0,0" IsChecked="True"/>

                <TextBlock x:Name="HintText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="16,0,16,14" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"
                       MaxWidth="300"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Padding="14,4" Margin="0,0,8,0" Click="OnCancel"/>
                <ui:Button Content="保存" Padding="16,4" Appearance="Primary" Click="OnOk"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
