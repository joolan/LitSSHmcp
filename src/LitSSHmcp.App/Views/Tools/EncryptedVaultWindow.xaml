<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.EncryptedVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="加密文件柜" Height="700" Width="1040" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="加密文件柜"/>

        <Grid Grid.Row="1" Margin="14,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,2">
                        <Button Content="新建文件柜" Padding="10,6" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" Click="OnCreateVault"/>
                        <Button Content="导入加密包…" Padding="10,6"
                                HorizontalAlignment="Stretch" Click="OnImportPackage"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="文件柜" FontWeight="SemiBold" Margin="6,2,6,8"/>
                    <ListBox x:Name="VaultList" BorderThickness="0" Background="Transparent" PreviewMouseRightButtonDown="OnVaultListRightClick" SelectionChanged="OnVaultSelectionChanged"
                             ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding}">
                                            <MenuItem Header="重命名文件柜" Click="OnRenameVault"/>
                                            <MenuItem Header="修改主密码…" Click="OnChangePassword"/>
                                            <MenuItem Header="打开所在目录" Click="OnOpenVaultFolder"/>
                                            <MenuItem Header="复制文件柜路径" Click="OnCopyVaultPath"/>
                                            <Separator/>
                                            <MenuItem Header="删除文件柜…" Click="OnDeleteVault"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                               FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="42" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="选择或新建文件柜" Style="{DynamicResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="文件柜中的文件在本机磁盘上保持加密，解锁后才能导入或导出。"
                               Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Width="420" Padding="28,26"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Text="{Binding VaultName}" FontSize="{DynamicResource AppFontSizeTitle}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="输入主密码解锁文件柜" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeBody}" Margin="0,6,0,22"/>

                        <TextBlock Text="主密码" FontSize="{DynamicResource AppFontSizeCaption}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="UnlockPassword" Height="38" Padding="10,6"
                                     Margin="0,0,0,14" PasswordChar="●"
                                     KeyDown="OnUnlockKeyDown"/>
                        <ui:Button Content="解锁" Appearance="Primary" Height="38"
                                   HorizontalAlignment="Stretch" Click="OnUnlock"/>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding AutoLockText}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="锁定" Icon="{ui:SymbolIcon LockClosed24}"
                                           Padding="12,4" Click="OnLock"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="18"
                                                   Foreground="{DynamicResource AppSuccessBrush}"/>
                                    <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource AppFontSizeSubtitle}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="导入文件" Icon="{ui:SymbolIcon Document24}" Padding="12,4" Margin="0,0,6,6" Click="OnImportFiles"/>
                                <ui:Button Content="导入文件夹" Icon="{ui:SymbolIcon Folder24}" Padding="12,4" Margin="0,0,6,6" Click="OnImportFolder"/>
                                <ui:Button Content="导出加密包…" Padding="12,4" Margin="0,0,0,6" Click="OnExportPackage"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <ui:TextBox DockPanel.Dock="Right" Width="220" Height="30"
                                    PlaceholderText="搜索文件柜…"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="文件列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="双击打开 · 右键更多操作" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                        <Grid>
                        <ListView x:Name="EntriesList" ItemsSource="{Binding Entries}" SelectionMode="Extended"
                                  MouseDoubleClick="OnOpenEntry" PreviewMouseRightButtonDown="OnEntriesRightClick"
                                  BorderThickness="0" Background="Transparent">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="内存打开" Click="OnOpenEntryButton"/>
                                    <MenuItem Header="临时打开…" Click="OnTempOpen"/>
                                    <Separator/>
                                    <MenuItem Header="导出选中…" Click="OnExport"/>
                                    <MenuItem Header="重命名" Click="OnRename"/>
                                    <MenuItem Header="删除" Click="OnDelete"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="相对路径" Width="300" DisplayMemberBinding="{Binding RelativePath}"/>
                                    <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Folder24" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="文件柜还是空的" Style="{DynamicResource EmptyStateTitleStyle}"/>
                            <TextBlock Text="点击「导入文件」或「导入文件夹」添加内容。"
                                       Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ProgressBar Width="120" Height="4" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ProgressText}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,0"
                                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <ui:Button Content="取消" Padding="8,2" Margin="0,0,8,0"
                                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                       Click="OnCancelOperation"/>
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="自动锁定" Foreground="{DynamicResource AppTextTertiaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox Width="118" Height="32" VerticalAlignment="Center"
                                      VerticalContentAlignment="Center" Padding="8,0"
                                      ItemsSource="{Binding AutoLockOptions}"
                                      SelectedItem="{Binding AutoLockMode, Mode=TwoWay}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="DropOverlay" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource AppAccentSubtleBrush}"
                BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                CornerRadius="{DynamicResource AppRadiusM}" Margin="18">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="松开以导入到加密文件柜" FontSize="{DynamicResource AppFontSizeSubtitle}"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
