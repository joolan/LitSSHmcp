<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.EnvironmentVariableEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="环境变量" Height="560" Width="620" MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <ScrollViewer Grid.Row="1" Margin="16,4,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="范围" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <TextBlock x:Name="ScopeText" Margin="0,0,0,10"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <TextBlock Text="变量名" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="NameBox" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                            TextChanged="OnNameChanged"
                            PlaceholderText="例如 JAVA_HOME；只能使用字母、数字、下划线"/>
                <TextBlock x:Name="NameHint" Margin="0,3,0,10" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>

                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock x:Name="ValueLabel" DockPanel.Dock="Left" Text="值" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ValueHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"/>
                </DockPanel>
                <ui:TextBox x:Name="ValueBox" Height="150" Padding="8,6" AcceptsReturn="True"
                            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                            PlaceholderText="环境变量值"/>

                <TextBlock Text="类型" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ComboBox x:Name="KindBox" Height="34" Padding="8,0">
                    <ComboBoxItem Content="字符串（REG_SZ）"/>
                    <ComboBoxItem Content="可展开字符串（REG_EXPAND_SZ，保留 %VAR%）"/>
                </ComboBox>

                <Border x:Name="CriticalPanel" Visibility="Collapsed" Margin="0,12,0,0"
                        Padding="10,8" Background="{DynamicResource AppWarningSubtleBrush}"
                        BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource AppRadiusS}">
                    <TextBlock x:Name="CriticalText" TextWrapping="Wrap"
                               FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </Border>

                <TextBlock Text="保存后写入注册表并通知系统；已运行的程序/终端/服务需要重启才能读取新值。"
                           Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="16,0,16,14" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Padding="16,4" Margin="0,0,8,0" Click="OnCancel"/>
                <ui:Button Content="保存" Padding="18,4" Appearance="Primary" Click="OnOk"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
