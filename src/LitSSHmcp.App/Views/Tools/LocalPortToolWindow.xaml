<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.LocalPortToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="本地端口 / 进程检查" Height="720" Width="1280" MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="本地端口 / 进程检查"/>

        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <ui:Button DockPanel.Dock="Left" Content="刷新" Padding="12,4" Margin="0,0,6,0"
                               Click="OnRefresh"/>
                    <CheckBox x:Name="AutoRefreshCheck" DockPanel.Dock="Left" Content="自动刷新"
                              VerticalAlignment="Center" Margin="4,0,12,0" Checked="OnAutoRefreshChanged"
                              Unchecked="OnAutoRefreshChanged"/>
                    <ComboBox x:Name="FilterBox" DockPanel.Dock="Left" Width="130" Height="36"
                              SelectedIndex="0" SelectionChanged="OnFilterChanged"
                              VerticalContentAlignment="Center" Padding="8,0"
                              HorizontalContentAlignment="Left" MaxDropDownHeight="180">
                        <ComboBoxItem Content="仅监听端口"/>
                        <ComboBoxItem Content="全部连接"/>
                    </ComboBox>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="220" Height="32" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Padding="8,0"
                             TextChanged="OnSearchChanged" ToolTip="搜索端口、地址、PID、进程名或路径"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="结束进程" Padding="10,4" Margin="0,0,6,0" Click="OnKillProcess"/>
                        <ui:Button Content="打开位置" Padding="10,4" Margin="0,0,6,0" Click="OnOpenLocation"/>
                        <ui:Button Content="复制" Padding="10,4" Margin="0,0,6,0" Click="OnCopy"/>
                        <ui:Button Content="导出 CSV" Padding="10,4" Click="OnExportCsv"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataGrid x:Name="PortGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                      RowHeight="30">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1,0,1,0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                    <DataGridTextColumn Header="本地地址" Binding="{Binding LocalEndpoint}" Width="190"/>
                    <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteEndpoint}" Width="190"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="76"/>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding ProcessPath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="2,8,2,0" LastChildFill="False">
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Left" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Padding="12,6" Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock Text="监听端口与活动连接来自本机 netstat；PID/进程信息可能因权限无法读取路径。结束进程不可撤销，请确认 PID 与进程路径后再操作。"
                       FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</ui:FluentWindow>
