<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="随机密码生成器" Height="560" Width="620" MinHeight="500" MinWidth="540"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="随机密码生成器"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,4,16,0">
            <StackPanel>
                <Border Style="{DynamicResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Key24" FontSize="18"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="生成的密码" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StrengthText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppSuccessBrush}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ui:TextBox x:Name="PasswordBox" Margin="0,10,0,8" IsReadOnly="True"
                                    FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="18"
                                    TextWrapping="Wrap" MinHeight="58" MaxHeight="120"
                                    VerticalScrollBarVisibility="Auto"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="StrengthBar" Height="4" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center" Foreground="{DynamicResource AppSuccessBrush}"
                                         Background="{DynamicResource AppBorderSubtleBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <ui:Button Content="复制" Icon="{ui:SymbolIcon Copy24}" Padding="12,4"
                                           Margin="0,0,6,0" Click="OnCopy"/>
                                <ui:Button Content="重新生成" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                           Padding="12,4" Click="OnGenerate"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DetailText" FontSize="{DynamicResource AppFontSizeMicro}"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="密码长度" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LengthText" DockPanel.Dock="Right"
                                       FontFamily="{DynamicResource AppFontMonoFamily}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Value="20"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLengthChanged" Margin="0,8,0,14"/>

                        <WrapPanel>
                            <CheckBox x:Name="UpperCheck" Content="大写字母 A-Z" IsChecked="True" Margin="0,0,18,8"/>
                            <CheckBox x:Name="LowerCheck" Content="小写字母 a-z" IsChecked="True" Margin="0,0,18,8"/>
                            <CheckBox x:Name="DigitsCheck" Content="数字 0-9" IsChecked="True" Margin="0,0,18,8"/>
                            <CheckBox x:Name="SymbolsCheck" Content="符号 !@#$" IsChecked="True" Margin="0,0,18,8"/>
                            <CheckBox x:Name="AmbiguousCheck" Content="排除易混淆字符 0/O/1/l/I" IsChecked="True"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AppAccentSubtleBrush}" BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="10,8">
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="密码使用系统密码学安全随机数生成，仅在当前窗口内存中存在；关闭窗口后不会保存。请复制到密码管理器或目标系统。"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,8,16,12"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   FontSize="{DynamicResource AppFontSizeMicro}"/>
    </Grid>
</ui:FluentWindow>
