<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.PasswordItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="账号条目" Height="760" Width="560" MinHeight="620" MinWidth="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="账号条目"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,4,18,0">
            <StackPanel>
                <TextBlock Text="标题" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TitleBox" Margin="0,0,0,10" PlaceholderText="例如：GitHub"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="类型" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TypeBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="分组" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="GroupBox" PlaceholderText="例如：工作"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="用户名 / 账号" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="UsernameBox" Margin="0,0,0,10"/>

                <TextBlock Text="密码" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PasswordBoxInput" Height="34" Padding="8,4" PasswordChar="●"
                                     PasswordChanged="OnPasswordChanged"/>
                        <ui:TextBox x:Name="PasswordVisibleBox" Height="34" Padding="8,4" Visibility="Collapsed"
                                    FontFamily="Consolas" TextChanged="OnPasswordTextChanged"/>
                    </Grid>
                    <ui:Button x:Name="PasswordRevealButton" Grid.Column="1" Content="显示" Padding="12,5"
                               Margin="8,0,0,0" Click="OnTogglePasswordVisibility"/>
                    <ui:Button Grid.Column="2" Content="生成" Padding="14,5" Margin="6,0,0,0" Click="OnGeneratePassword"/>
                </Grid>
                <UniformGrid Columns="4" Margin="0,2,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,10,3">
                        <TextBlock Text="长度" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ui:TextBox x:Name="PasswordLengthBox" Width="58" Height="30" Text="20"/>
                    </StackPanel>
                    <CheckBox x:Name="IncludeUpperBox" Content="大写" IsChecked="True" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <CheckBox x:Name="IncludeLowerBox" Content="小写" IsChecked="True" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <CheckBox x:Name="IncludeDigitsBox" Content="数字" IsChecked="True" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <CheckBox x:Name="IncludeSymbolsBox" Content="符号" IsChecked="True" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <CheckBox x:Name="SafeSymbolsBox" Content="仅 _ -" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <CheckBox x:Name="ExcludeAmbiguousBox" Content="排除易混淆" IsChecked="True" VerticalAlignment="Center" Margin="0,3,10,3"/>
                    <Border/>
                </UniformGrid>
                <TextBlock x:Name="GeneratedHintText" FontSize="{DynamicResource AppFontSizeMicro}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="网址" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="UrlBox" Margin="0,0,0,10" PlaceholderText="https://"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="安全手机" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="PhoneBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="绑定邮箱" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="EmailBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="标签（用逗号分隔）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="TagsBox" Margin="0,0,0,10" PlaceholderText="工作, 重要"/>

                <TextBlock Text="TOTP / HOTP（粘贴 otpauth:// URI 或 Secret）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TotpBox" Grid.Column="0" PlaceholderText="otpauth://totp/... 或 BASE32SECRET"/>
                    <ui:Button Grid.Column="1" Content="从图片导入" Margin="8,0,0,0" Padding="12,3"
                               Click="OnImportQrCode"/>
                    <ui:Button Grid.Column="2" Content="从剪贴板图片" Margin="6,0,0,0" Padding="12,3"
                               Click="OnImportQrCodeFromClipboard"/>
                </Grid>
                <TextBlock x:Name="TotpInfoText" FontSize="{DynamicResource AppFontSizeMicro}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="验证码类型" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TotpModeBox" Height="38" Padding="8,0" VerticalContentAlignment="Center" SelectionChanged="OnTotpModeChanged">
                            <ComboBoxItem Content="TOTP（基于时间）"/>
                            <ComboBoxItem Content="HOTP（基于计数器）"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="HotpPanel" Grid.Column="2">
                        <TextBlock Text="HOTP 计数器" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="HotpCounterBox" Text="0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="自定义字段（每行一个：标签=值）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="CustomFieldsBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                <TextBlock Text="备注" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="NotesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDangerBrush}"
                           FontSize="{DynamicResource AppFontSizeMicro}" TextWrapping="Wrap" Margin="0,2,0,6"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="18,10,18,14" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Content="保存" Appearance="Primary" Padding="20,5"
                       Margin="8,0,0,0" Click="OnSave"/>
            <ui:Button DockPanel.Dock="Right" Content="取消" Padding="20,5" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
