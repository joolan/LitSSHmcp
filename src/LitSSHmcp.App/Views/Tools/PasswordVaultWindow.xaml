<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.PasswordVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="密码保管箱" Height="740" Width="1120" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        PreviewMouseDown="OnActivity" PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="密码保管箱"/>

        <Grid Grid.Row="1" Margin="14,0,14,12">
            <Border x:Name="UnlockCard" Width="440" Padding="28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="38" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock x:Name="UnlockTitle" Text="解锁密码保管箱" FontSize="{DynamicResource AppFontSizeTitle}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="UnlockHint" Text="输入独立主密码后查看账号、验证码和附件。"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeBody}" Margin="0,6,0,22"/>

                    <StackPanel x:Name="UnlockPanel">
                        <TextBlock Text="主密码" FontSize="{DynamicResource AppFontSizeCaption}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="UnlockPassword" Height="38" Padding="10,6"
                                     Margin="0,0,0,14" PasswordChar="●" KeyDown="OnUnlockKeyDown"/>
                        <ui:Button Content="解锁" Appearance="Primary" Height="38"
                                   HorizontalAlignment="Stretch" Click="OnUnlock"/>
                    </StackPanel>

                    <StackPanel x:Name="CreatePanel" Visibility="Collapsed">
                        <ui:Button Content="创建密码保管箱…" Appearance="Primary" Height="38"
                                   HorizontalAlignment="Stretch" Click="OnCreateVault"/>
                        <TextBlock Text="首次使用需要设置独立主密码。主密码无法找回。"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="新增账号" Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Primary" Padding="12,4" Margin="0,0,8,0" Click="OnAddItem"/>
                            <ui:Button Content="锁定" Icon="{ui:SymbolIcon LockClosed24}"
                                       Padding="12,4" Margin="0,0,8,0" Click="OnLock"/>
                            <ui:Button Content="更多" Padding="12,4" Click="OnMoreClick">
                                <ui:Button.ContextMenu>
                                    <ContextMenu Opened="OnMoreMenuOpened">
                                        <MenuItem Header="修改主密码…" Click="OnChangePassword"/>
                                        <MenuItem Header="导出加密备份…" Click="OnExportPackage"/>
                                        <MenuItem Header="恢复加密备份…" Click="OnRestorePackage"/>
                                        <Separator/>
                                        <MenuItem Header="自动锁定">
                                            <MenuItem Header="1 分钟" Tag="autolock:1 分钟" IsCheckable="True" Click="OnSetAutoLock"/>
                                            <MenuItem Header="3 分钟" Tag="autolock:3 分钟" IsCheckable="True" Click="OnSetAutoLock"/>
                                            <MenuItem Header="5 分钟" Tag="autolock:5 分钟" IsCheckable="True" Click="OnSetAutoLock"/>
                                            <MenuItem Header="10 分钟" Tag="autolock:10 分钟" IsCheckable="True" Click="OnSetAutoLock"/>
                                            <MenuItem Header="15 分钟" Tag="autolock:15 分钟" IsCheckable="True" Click="OnSetAutoLock"/>
                                            <MenuItem Header="永不" Tag="autolock:永不" IsCheckable="True" Click="OnSetAutoLock"/>
                                        </MenuItem>
                                        <MenuItem Header="剪贴板清空">
                                            <MenuItem Header="15 秒" Tag="clipboard:15 秒" IsCheckable="True" Click="OnSetClipboardClear"/>
                                            <MenuItem Header="30 秒" Tag="clipboard:30 秒" IsCheckable="True" Click="OnSetClipboardClear"/>
                                            <MenuItem Header="60 秒" Tag="clipboard:60 秒" IsCheckable="True" Click="OnSetClipboardClear"/>
                                            <MenuItem Header="永不" Tag="clipboard:永不" IsCheckable="True" Click="OnSetClipboardClear"/>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18"
                                           Foreground="{DynamicResource AppSuccessBrush}"/>
                            <TextBlock Text="密码保管箱" FontWeight="SemiBold"
                                       FontSize="{DynamicResource AppFontSizeSubtitle}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ui:TextBox x:Name="SearchBox" Grid.Row="1" Height="36" Margin="0,0,0,8" Padding="10,0"
                            VerticalContentAlignment="Center"
                            PlaceholderText="搜索标题、账号、网址、标签…"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="OnSearchKeyDown"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                                <ComboBox Height="32" Padding="8,0" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding TypeFilters}"
                                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"/>
                                <ComboBox Height="32" Padding="8,0" VerticalContentAlignment="Center" Margin="0,6,0,0"
                                          ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="复制用户名" Click="OnItemCopyUsername"/>
                                                <MenuItem Header="复制密码" Click="OnItemCopyPassword"/>
                                                <MenuItem Header="复制验证码" Click="OnItemCopyTotp"/>
                                                <Separator/>
                                                <MenuItem Header="编辑" Click="OnItemEdit"/>
                                                <MenuItem Header="收藏 / 取消收藏" Click="OnItemToggleFavorite"/>
                                                <MenuItem Header="删除" Click="OnItemDelete"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="4"
                                                    Background="{DynamicResource AppAccentSubtleBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTotp}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="MFA" FontSize="10" Foreground="{DynamicResource AppAccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Username}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding GroupText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="Key24" FontSize="42" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="选择一个账号条目" Style="{DynamicResource EmptyStateTitleStyle}"/>
                            <TextBlock Text="账号、密码、TOTP 和附件都在本机加密保存。"
                                       Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border Padding="18,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusM}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="编辑" Padding="12,4" Margin="0,0,6,0" Click="OnEditItem"/>
                                            <ui:Button Content="删除" Padding="12,4" Click="OnDeleteItem"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedItem.Title}" FontSize="{DynamicResource AppFontSizeTitle}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0">
                                                <Run Text="{Binding SelectedItem.TypeText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SelectedItem.GroupText, Mode=OneWay}"/>
                                                <Run Text="{Binding SelectedItem.TagsText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                            Padding="12,10" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Content="复制" Padding="12,3" Click="OnCopyUsername"/>
                                                <TextBlock Text="用户名 / 账号" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding SelectedItem.Username}" FontSize="{DynamicResource AppFontSizeBody}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                            Padding="12,10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:Button Content="{Binding SelectedItem.PasswordActionText}" Padding="10,3" Margin="0,0,6,0" Click="OnTogglePassword"/>
                                                    <ui:Button Content="复制" Padding="12,3" Click="OnCopyPassword"/>
                                                </StackPanel>
                                                <TextBlock Text="密码" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding SelectedItem.PasswordDisplay}" FontFamily="Consolas"
                                                       FontSize="{DynamicResource AppFontSizeBody}" TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="密码历史" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                    <ItemsControl ItemsSource="{Binding SelectedItem.PasswordHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                                        CornerRadius="{DynamicResource AppRadiusS}" Padding="10,7" Margin="0,0,0,5">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <ui:Button Content="复制" Padding="9,2" Margin="0,0,4,0"
                                                                       Click="OnCopyHistoryPassword"/>
                                                            <ui:Button Content="恢复" Padding="9,2"
                                                                       Click="OnRestoreHistoryPassword"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="••••••••" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding ChangedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{DynamicResource AppSurfaceAltBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                            Padding="12,10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Content="复制" Padding="12,3" Click="OnCopyUrl"/>
                                                <TextBlock Text="网址" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding SelectedItem.Url}" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource AppFontSizeBody}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AppSurfaceAltBrush}"
                                                CornerRadius="{DynamicResource AppRadiusS}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="安全手机" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                <TextBlock Text="{Binding SelectedItem.SecurityPhone}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource AppFontSizeBody}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource AppSurfaceAltBrush}"
                                                CornerRadius="{DynamicResource AppRadiusS}" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="绑定邮箱" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}"/>
                                                <TextBlock Text="{Binding SelectedItem.RecoveryEmail}" TextWrapping="Wrap"
                                                           FontSize="{DynamicResource AppFontSizeBody}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource AppAccentSubtleBrush}" CornerRadius="{DynamicResource AppRadiusS}"
                                            Padding="12,10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:Button Content="下一组" Padding="10,3" Margin="0,0,6,0"
                                                               Visibility="{Binding IsHotp, Converter={StaticResource BoolToVis}}"
                                                               Click="OnAdvanceHotp"/>
                                                    <ui:Button Content="复制验证码" Padding="12,3" Click="OnCopyTotp"/>
                                                </StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="TOTP 验证码"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHotp}" Value="True">
                                                                    <Setter Property="Text" Value="HOTP 验证码"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <StackPanel x:Name="TotpContent">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTotp}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding TotpCode}" FontFamily="Consolas" FontSize="30"
                                                           FontWeight="SemiBold" Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTotpUrgent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotpRemaining}"
                                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <ProgressBar Height="6" Minimum="0" Maximum="1"
                                                                 Value="{Binding TotpProgress, Mode=OneWay}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding TotpCaption}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TotpEmptyHint" Text="未配置 TOTP"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTotp}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="自定义字段" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <ItemsControl ItemsSource="{Binding SelectedItem.CustomFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Label}" DockPanel.Dock="Left"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Value}" Margin="10,0,0,0"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,10,0,6"/>
                                    <TextBlock Text="{Binding SelectedItem.Notes}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                    <DockPanel Margin="0,14,0,6">
                                        <ui:Button DockPanel.Dock="Right" Content="添加附件" Padding="12,3" Click="OnAddAttachment"/>
                                        <TextBlock Text="{Binding SelectedItem.AttachmentCountText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                                        CornerRadius="{DynamicResource AppRadiusS}" Padding="10,7" Margin="0,0,0,5"
                                                        PreviewMouseLeftButtonDown="OnAttachmentMouseDown"
                                                        PreviewMouseMove="OnAttachmentMouseMove">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <ui:Button Content="预览" Padding="9,2" Margin="0,0,4,0" Click="OnPreviewAttachment"/>
                                                            <ui:Button Content="导出" Padding="9,2" Margin="0,0,4,0" Click="OnExportAttachment"/>
                                                            <ui:Button Content="临时打开" Padding="9,2" Margin="0,0,4,0" Click="OnOpenAttachment"/>
                                                            <ui:Button Content="删除" Padding="9,2" Click="OnDeleteAttachment"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Size, StringFormat={}{0:N0} 字节}"
                                                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                                       FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
