<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.ProxyAccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="代理账号" Height="560" Width="480" MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="代理账号"/>

        <ScrollViewer Grid.Row="1" Margin="16,4,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="用户名" FontWeight="SemiBold" Margin="0,6,0,4"/>
                <TextBox x:Name="UsernameBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock x:Name="PasswordLabel" Text="密码" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Margin="0,6,0,0"
                             VerticalContentAlignment="Center" Padding="8,0"/>

                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <ui:Button DockPanel.Dock="Left" Content="生成随机密码" Padding="10,4" Click="OnGeneratePassword"/>
                    <ui:Button DockPanel.Dock="Left" Content="复制生成密码" Padding="10,4" Margin="6,0,0,0"
                               Click="OnCopyGeneratedPassword"/>
                </DockPanel>

                <Border x:Name="GeneratedPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource AppRadiusS}">
                    <StackPanel>
                        <TextBlock Text="新密码（只显示这一次，请立即复制保存）"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="{DynamicResource AppFontSizeCaption}"/>
                        <TextBox x:Name="GeneratedPasswordBox" IsReadOnly="True" Margin="0,4,0,0"
                                 FontFamily="{DynamicResource AppFontMonoFamily}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBox x:Name="NoteBox" Height="62" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Padding="8,6"/>

                <CheckBox x:Name="EnabledCheck" Content="启用该账号" Margin="0,12,0,0" IsChecked="True"/>

                <TextBlock x:Name="HintText" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="16,0,16,14" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                       MaxWidth="250"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="取消" Padding="14,4" Margin="0,0,8,0" Click="OnCancel"/>
                <ui:Button Content="保存" Padding="16,4" Appearance="Primary" Click="OnOk"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
