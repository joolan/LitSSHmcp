<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.ProxyToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="局域网 HTTP / SOCKS5 代理" Height="820" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="局域网 HTTP / SOCKS5 代理"/>

        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="StatusTitle" Text="代理未启动" FontWeight="SemiBold"
                                   FontSize="{DynamicResource AppFontSizeSubtitle}"/>
                        <TextBlock x:Name="StatusDetail" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock x:Name="StatusError" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppDangerBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="StartButton" Content="启动代理" Appearance="Primary"
                                   Padding="16,4" Margin="0,0,8,0" Click="OnStart"/>
                        <ui:Button x:Name="StopButton" Content="停止" Padding="16,4" Margin="0,0,8,0"
                                   Click="OnStop" IsEnabled="False"/>
                        <ui:Button Content="打开配置目录" Padding="12,4" Click="OnOpenConfigFolder"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="MainTabs" SelectionChanged="OnTabChanged">
                <TabItem Header="监听与策略">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,8,2,2">
                        <StackPanel>
                            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="监听地址" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BindAddressBox" Height="34"
                                              Margin="0,4,12,4" IsEditable="True"
                                              DisplayMemberPath="Display" SelectedValuePath="Value"
                                              VerticalContentAlignment="Center" Padding="8,0"
                                              ToolTip="可输入 127.0.0.1、0.0.0.0 或选择本机局域网 IPv4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="HTTP 端口" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="HttpPortBox" Height="34"
                                             Margin="0,4,0,4" VerticalContentAlignment="Center" Padding="8,0"/>

                                    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="HttpEnabledCheck"
                                              Content="启用 HTTP 代理" Margin="0,6,12,2" IsChecked="True"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="SOCKS5 端口" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="Socks5PortBox" Height="34"
                                             Margin="0,4,0,4" VerticalContentAlignment="Center" Padding="8,0"/>

                                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="Socks5EnabledCheck"
                                              Content="启用 SOCKS5" Margin="0,2,12,2" IsChecked="True"/>
                                    <CheckBox Grid.Row="2" Grid.Column="3" x:Name="EnabledCheck"
                                              Content="随 App 启动自动开启" Margin="0,4,0,2"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                              x:Name="AnonymousCheck"
                                              Content="允许匿名访问（默认关闭；开启后仍受白名单与目标策略限制）"
                                              Margin="0,8,0,2" Checked="OnAnonymousChanged"
                                              Unchecked="OnAnonymousChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="客户端与目标策略" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="客户端白名单（每行一个 IP 或 CIDR；留空表示不限制）"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeCaption}"/>
                                    <TextBox x:Name="AllowedClientsBox" Height="62" Margin="0,4,0,10"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Padding="8,6"
                                             ToolTip="例如 192.168.1.0/24 或 192.168.1.50"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="允许目标端口" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AllowedPortsBox" Height="34"
                                                 Margin="0,0,12,0" VerticalContentAlignment="Center"
                                                 Padding="8,0" ToolTip="逗号/空格分隔，例如 80,443,8443"/>
                                        <CheckBox Grid.Column="2" x:Name="AllowAllPortsCheck"
                                                  Content="允许所有端口" VerticalAlignment="Center"
                                                  Checked="OnAllowAllPortsChanged" Unchecked="OnAllowAllPortsChanged"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="域名白名单（每行一个；留空不限制）"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="{DynamicResource AppFontSizeCaption}"/>
                                            <TextBox x:Name="AllowedDomainsBox" Height="58" Margin="0,4,0,0"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Padding="8,6"
                                                     ToolTip="example.com 匹配自身及子域；*.example.com 只匹配子域；* 匹配所有"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="域名黑名单（每行一个；优先于白名单）"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="{DynamicResource AppFontSizeCaption}"/>
                                            <TextBox x:Name="BlockedDomainsBox" Height="58" Margin="0,4,0,0"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Padding="8,6"
                                                     ToolTip="例如 *.doubleclick.net 或 tracker.example.com"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="BlockPrivateCheck" Margin="0,10,0,0"
                                              Content="阻止访问内网 / 回环 / 链路本地 / 保留地址（默认开启）"
                                              IsChecked="True"/>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeCaption}"
                                               Text="关闭后，局域网设备可经本机访问内网服务；仅在排障时临时使用。"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="临时开启与限制" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="临时开启" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TemporaryBox" Height="34"
                                                 Margin="0,4,12,4" VerticalContentAlignment="Center" Padding="8,0"
                                                 ToolTip="分钟；0 表示不自动关闭；默认 120 分钟"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="分钟（0=不自动关）"
                                                   VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeCaption}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="默认 120 分钟" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   FontSize="{DynamicResource AppFontSizeCaption}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="并发 / 超时" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                    Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="总并发" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="MaxTotalBox" Width="64" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="单 IP" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="MaxPerClientBox" Width="64" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="空闲超时" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="IdleTimeoutBox" Width="64" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="认证保护" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                    Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="失败上限" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="AuthFailureLimitBox" Width="56" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="次 / 窗口" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="AuthFailureWindowBox" Width="64" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="秒 / 封禁" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox x:Name="AuthFailureBlockBox" Width="64" Height="32" Padding="6,0"
                                                     VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="秒（0=关闭限速）" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       FontSize="{DynamicResource AppFontSizeCaption}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="UpstreamEnabledCheck"
                                              Content="经上游代理访问目标（代理链）"
                                              Checked="OnUpstreamChanged" Unchecked="OnUpstreamChanged"/>
                                    <Grid x:Name="UpstreamPanel" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="上游类型" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="UpstreamTypeBox" Height="32"
                                                  Margin="0,3,12,3" VerticalContentAlignment="Center" Padding="8,0">
                                            <ComboBoxItem Content="HTTP" Tag="http"/>
                                            <ComboBoxItem Content="SOCKS5" Tag="socks5"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="上游端口" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="UpstreamPortBox" Height="32"
                                                 Margin="0,3,0,3" VerticalContentAlignment="Center" Padding="8,0"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="上游地址" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UpstreamHostBox" Height="32"
                                                 Margin="0,3,12,3" VerticalContentAlignment="Center" Padding="8,0"
                                                 ToolTip="上游 HTTP/SOCKS5 代理主机名或 IP"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="用户名" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="UpstreamUsernameBox" Height="32"
                                                 Margin="0,3,0,3" VerticalContentAlignment="Center" Padding="8,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center"/>
                                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="UpstreamPasswordBox" Height="32"
                                                     Margin="0,3,12,3" VerticalContentAlignment="Center" Padding="8,0"/>
                                        <ui:Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="清除已保存密码"
                                                   Padding="10,4" HorizontalAlignment="Left" Margin="0,3,0,3"
                                                   Click="OnClearUpstreamPassword"/>
                                    </Grid>
                                    <TextBlock x:Name="UpstreamPasswordHint" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeCaption}"
                                               Text="密码留空表示保持已保存密码；保存时使用 DPAPI 加密。"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardBorderStyle}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Windows 防火墙" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               Text="绑定 0.0.0.0 或局域网地址时，需要放行入站 TCP 端口。自动添加会弹出 UAC，仅对 private 配置文件放行。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                        <ui:Button Content="自动添加规则" Padding="12,4" Margin="0,0,6,0"
                                                   Click="OnAddFirewall"/>
                                        <ui:Button Content="删除规则" Padding="12,4" Margin="0,0,6,0"
                                                   Click="OnRemoveFirewall"/>
                                        <ui:Button Content="检测状态" Padding="12,4" Margin="0,0,6,0"
                                                   Click="OnCheckFirewall"/>
                                        <ui:Button Content="复制命令" Padding="12,4" Margin="0,0,6,0"
                                                   Click="OnCopyFirewall"/>
                                        <ui:Button Content="保存设置" Padding="14,4" Appearance="Primary"
                                                   Click="OnSave"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FirewallStatusText" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox x:Name="FirewallCommandsBox" IsReadOnly="True" Height="78"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="{DynamicResource AppFontMonoFamily}"
                                             FontSize="{DynamicResource AppFontSizeCaption}" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="代理账号">
                    <Grid Margin="2,8,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="账号与密码" FontWeight="SemiBold"/>
                                    <TextBlock Text="HTTP Basic 与 SOCKS5 RFC1929 共用；密码只保存 PBKDF2 哈希。"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="新增" Padding="14,4" Margin="0,0,6,0" Click="OnAddAccount"/>
                                    <ui:Button Content="编辑" Padding="14,4" Margin="0,0,6,0" Click="OnEditAccount"/>
                                    <ui:Button Content="重置密码" Padding="14,4" Margin="0,0,6,0"
                                               Click="OnResetPassword"/>
                                    <ui:Button Content="删除" Padding="14,4" Click="OnDeleteAccount"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="AccountsGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="160"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                                <DataGridTextColumn Header="启用" Binding="{Binding Enabled}" Width="64"/>
                                <DataGridTextColumn Header="最近使用" Binding="{Binding LastUsedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="150"/>
                                <DataGridTextColumn Header="请求数" Binding="{Binding RequestCount}" Width="80"/>
                                <DataGridTextColumn Header="流入" Binding="{Binding BytesIn, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="流出" Binding="{Binding BytesOut, StringFormat={}{0:N0}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" x:Name="AccountsHint" Margin="2,8,2,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="匿名模式关闭时，至少需要一个启用账号；修改账号后需要保存并重启代理才会生效。"/>
                    </Grid>
                </TabItem>

                <TabItem Header="客户端配置">
                    <Grid Margin="2,8,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="复制 HTTP" Padding="12,4" Margin="0,0,6,0"
                                           Click="OnCopyHttpConfig"/>
                                <ui:Button Content="复制 SOCKS5" Padding="12,4" Margin="0,0,6,0"
                                           Click="OnCopySocksConfig"/>
                                <ui:Button Content="复制全部" Padding="12,4" Appearance="Primary"
                                           Click="OnCopyAllConfig"/>
                            </StackPanel>
                        </Border>
                        <TextBox Grid.Row="1" x:Name="ClientConfigBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource AppFontMonoFamily}"
                                 Padding="10,8"/>
                    </Grid>
                </TabItem>

                <TabItem Header="活动连接">
                    <Grid Margin="2,8,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="显示当前 HTTP / SOCKS5 连接；可断开选中或全部断开。"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="刷新" Padding="12,4" Margin="0,0,6,0" Click="OnRefreshConnections"/>
                                    <ui:Button Content="断开选中" Padding="12,4" Margin="0,0,6,0"
                                               Click="OnDisconnectSelected"/>
                                    <ui:Button Content="全部断开" Padding="12,4" Click="OnDisconnectAll"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="开始" Binding="{Binding StartedText}" Width="76"/>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="72"/>
                                <DataGridTextColumn Header="客户端" Binding="{Binding Client}" Width="140"/>
                                <DataGridTextColumn Header="账号" Binding="{Binding Username}" Width="110"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="持续" Binding="{Binding DurationText}" Width="84"/>
                                <DataGridTextColumn Header="上行" Binding="{Binding BytesIn, StringFormat={}{0:N0}}" Width="90"/>
                                <DataGridTextColumn Header="下行" Binding="{Binding BytesOut, StringFormat={}{0:N0}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="最近日志">
                    <Grid Margin="2,8,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="只保留最近 500 条；不记录密码和 Authorization 原文。"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="刷新" Padding="12,4" Margin="0,0,6,0" Click="OnRefreshLogs"/>
                                    <ui:Button Content="复制" Padding="12,4" Margin="0,0,6,0" Click="OnCopyLogs"/>
                                    <ui:Button Content="清空" Padding="12,4" Click="OnClearLogs"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"/>
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="72"/>
                                <DataGridTextColumn Header="客户端" Binding="{Binding Client}" Width="130"/>
                                <DataGridTextColumn Header="账号" Binding="{Binding Username}" Width="110"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="220"/>
                                <DataGridTextColumn Header="流入" Binding="{Binding BytesIn}" Width="80"/>
                                <DataGridTextColumn Header="流出" Binding="{Binding BytesOut}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <DockPanel Grid.Row="2" Margin="14,0,14,12" LastChildFill="False">
            <TextBlock x:Name="FooterStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                       MaxWidth="760"/>
            <TextBlock x:Name="FooterVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
