<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.TextCodecToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="文本 / 编码转换" Height="760" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="文本 / 编码转换"/>

        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="转换模式" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="ModeBox" DockPanel.Dock="Left" Width="220" Height="36"
                                  MinWidth="220" DisplayMemberPath="Title" SelectionChanged="OnModeChanged"
                                  VerticalContentAlignment="Center" Padding="10,0"/>
                        <TextBlock x:Name="ModeHint" DockPanel.Dock="Left" Margin="12,0,0,0"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="导入文件" Padding="10,4" Margin="0,0,6,0" Click="OnImportFile"/>
                            <ui:Button Content="清空" Padding="10,4" Click="OnClear"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="TimestampPanel" Grid.Row="1" Margin="0,8,0,0" Padding="8,6"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppRadiusS}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimestampText" FontFamily="{DynamicResource AppFontMonoFamily}"
                                       FontSize="{DynamicResource AppFontSizeCaption}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <ui:Button Content="复制秒" Padding="8,3" Margin="0,0,5,0" Click="OnCopyTimestampSeconds"/>
                                <ui:Button Content="复制毫秒" Padding="8,3" Margin="0,0,5,0" Click="OnCopyTimestampMilliseconds"/>
                                <ui:Button Content="复制北京时间" Padding="8,3" Click="OnCopyBeijingTime"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="输入" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputStatsText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                        </DockPanel>
                        <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource AppFontMonoFamily}"
                                 FontSize="{DynamicResource AppFontSizeCaption}" Padding="8"
                                 SpellCheck.IsEnabled="False" TextChanged="OnInputChanged"
                                 AllowDrop="True" PreviewDragOver="OnInputDragOver" PreviewDrop="OnInputDrop"
                                 ToolTip="输入文本、JSON、XML、Base64、JWT 或时间戳"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="输出" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OutputStatsText" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}"/>
                        </DockPanel>
                        <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource AppFontMonoFamily}"
                                 FontSize="{DynamicResource AppFontSizeCaption}" Padding="8"
                                 SpellCheck.IsEnabled="False"/>
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="转换" Appearance="Primary" Padding="16,5"
                           Margin="0,0,6,0" Click="OnTransform"/>
                <ui:Button DockPanel.Dock="Left" Content="交换输入/输出" Padding="12,5" Margin="0,0,6,0"
                           Click="OnSwap"/>
                <ui:Button DockPanel.Dock="Left" Content="复制输出" Padding="12,5" Margin="0,0,6,0"
                           Click="OnCopy"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Padding="12,6" Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock Text="全部转换在本机内存中完成，不上传、不保存输入内容；JWT 仅解码显示 header/payload，不验证签名。"
                       FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</ui:FluentWindow>
