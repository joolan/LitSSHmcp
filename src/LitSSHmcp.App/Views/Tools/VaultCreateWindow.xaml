<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.VaultCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新建加密文件柜" Height="380" Width="480" MinHeight="340" MinWidth="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="新建加密文件柜"/>
        <StackPanel Grid.Row="1" Margin="18,4,18,0">
            <TextBlock x:Name="NameLabel" Text="文件柜名称" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" PlaceholderText="例如：运维资料"/>
            <TextBlock Text="主密码（至少 8 位）" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBoxInput" Height="34" Padding="8,4" Margin="0,0,0,10" PasswordChar="●"/>
            <TextBlock Text="确认主密码" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmBox" Height="34" Padding="8,4" PasswordChar="●"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDangerBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource AppWarningSubtleBrush}" BorderBrush="{DynamicResource AppWarningBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="10,8" Margin="0,12,0,0">
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           Text="主密码无法找回。请确认已妥善保存；文件柜中的文件只在本机保持加密。"/>
            </Border>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="18,10,18,14" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Content="创建" Appearance="Primary" Padding="20,5"
                       Margin="8,0,0,0" Click="OnCreate"/>
            <ui:Button DockPanel.Dock="Right" Content="取消" Padding="20,5" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
