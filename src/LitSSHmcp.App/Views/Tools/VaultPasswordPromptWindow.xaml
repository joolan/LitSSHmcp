<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.VaultPasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="验证主密码" Height="300" Width="440" MinHeight="260" MinWidth="380"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="验证主密码"/>
        <StackPanel Grid.Row="1" Margin="18,4,18,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="主密码" FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBoxInput" Height="34" Padding="8,4" PasswordChar="●"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDangerBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="18,10,18,14" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Content="确认" Appearance="Primary" Padding="20,5"
                       Margin="8,0,0,0" Click="OnConfirm"/>
            <ui:Button DockPanel.Dock="Right" Content="取消" Padding="20,5" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
