<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.VaultTextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="文本编辑" Height="720" Width="980" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="文本编辑"/>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="14,0,14,8" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="搜索" Icon="{ui:SymbolIcon Search24}" Padding="10,4"
                               Margin="0,0,6,0" Click="OnShowFind"/>
                    <ui:Button Content="转到行" Padding="10,4" Margin="0,0,6,0" Click="OnGoToLine"/>
                    <ui:Button Content="保存并加密" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                               Padding="14,4" Click="OnSave"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="FileNameText" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EncodingText" Foreground="{DynamicResource AppTextTertiaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="14,0,14,8" Padding="0" ClipToBounds="True">
            <Grid>
                <avalonedit:TextEditor x:Name="Editor" ShowLineNumbers="True" WordWrap="False"
                                       FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="13"
                                       Background="{DynamicResource AppCodeBgBrush}"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       BorderThickness="0" Padding="6"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                       TextChanged="OnEditorTextChanged"/>

                <Border x:Name="FindPanel" Visibility="Collapsed" Panel.ZIndex="5"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="8,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="FindBox" Width="200" Height="32" Margin="0,0,6,0"
                                        VerticalContentAlignment="Center" Padding="8,0"
                                        PlaceholderText="查找内容…" TextChanged="OnFindTextChanged"
                                        KeyDown="OnFindKeyDown"/>
                            <CheckBox x:Name="CaseSensitiveCheck" Content="Aa" VerticalAlignment="Center"
                                      Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged"
                                      Margin="0,0,6,0" ToolTip="区分大小写"/>
                            <CheckBox x:Name="WholeWordCheck" Content="全词" VerticalAlignment="Center"
                                      Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged"
                                      Margin="0,0,8,0" ToolTip="全词匹配"/>
                            <Button Content="↑" Width="28" Height="28" Padding="0" Margin="0,0,2,0"
                                    Click="OnFindPrevious" ToolTip="上一个"/>
                            <Button Content="↓" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                    Click="OnFindNext" ToolTip="下一个"/>
                            <TextBlock x:Name="FindCountText" MinWidth="64" VerticalAlignment="Center"
                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <Button Content="✕" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                    Click="OnCloseFind" ToolTip="关闭搜索"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBox x:Name="ReplaceBox" Width="200" Height="32" Margin="0,0,6,0"
                                        VerticalContentAlignment="Center" Padding="8,0"
                                        PlaceholderText="替换为…"/>
                            <Button Content="替换" Height="28" Padding="10,0" Margin="0,0,6,0"
                                    Click="OnReplace"/>
                            <Button Content="全部替换" Height="28" Padding="10,0"
                                    Click="OnReplaceAll"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,0,16,12">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CaretText" DockPanel.Dock="Right" Margin="0,0,12,0"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="内存编辑 · 保存时重新加密并原子替换"
                       Foreground="{DynamicResource AppTextTertiaryBrush}"
                       FontSize="{DynamicResource AppFontSizeMicro}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
