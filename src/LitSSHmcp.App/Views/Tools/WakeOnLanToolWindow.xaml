<ui:FluentWindow x:Class="LitSSHmcp.App.Views.Tools.WakeOnLanToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="网络唤醒 (Wake-on-LAN)" Height="780" Width="1160" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="网络唤醒 (Wake-on-LAN)"/>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,4,12,8">
            <TabItem Header="唤醒设备">
                <Grid Margin="4,10,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*" MinWidth="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <ui:Button Content="新增设备" Icon="{ui:SymbolIcon Add24}" Padding="10,4"
                                               Margin="0,0,6,0" Click="OnNewHost"/>
                                    <ui:Button Content="唤醒选中" Icon="{ui:SymbolIcon Power24}" Appearance="Primary"
                                               Padding="10,4" Margin="0,0,6,0" Click="OnWakeSelected"/>
                                    <ui:Button Content="删除" Icon="{ui:SymbolIcon Delete24}" Padding="10,4"
                                               Margin="0,0,6,0" Click="OnDeleteHost"/>
                                    <ui:Button Content="导入 CSV" Padding="10,4" Margin="0,0,6,0" Click="OnImportCsv"/>
                                    <ui:Button Content="导出 CSV" Padding="10,4" Margin="0,0,6,0" Click="OnExportCsv"/>
                                    <ui:Button Content="刷新" Padding="10,4" Click="OnRefreshHosts"/>
                                </StackPanel>
                                <TextBlock x:Name="HostSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </DockPanel>

                            <DataGrid x:Name="HostGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                                      RowHeight="34" SelectionChanged="OnHostSelectionChanged"
                                      MouseDoubleClick="OnHostDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1,0,1,0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="MAC 地址" Binding="{Binding MacAddress}" Width="150"/>
                                    <DataGridTextColumn Header="IP 地址" Binding="{Binding IpAddress}" Width="120"/>
                                    <DataGridTextColumn Header="广播地址" Binding="{Binding BroadcastAddress}" Width="130"/>
                                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                                    <DataGridTextColumn Header="SecureOn" Binding="{Binding SecureOnText}" Width="90"/>
                                    <DataGridTextColumn Header="定时" Binding="{Binding ScheduleText}" Width="90"/>
                                    <DataGridTextColumn Header="最近唤醒" Binding="{Binding LastWokenAt, StringFormat={}{0:MM-dd HH:mm}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Margin="2,8,2,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       FontSize="{DynamicResource AppFontSizeMicro}"
                                       Text="双击设备可直接唤醒。未填写广播地址时，会根据 IP 所在网卡自动选择定向广播；无法匹配时向所有本机 IPv4 网段广播。"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="EditorTitleText" Text="新增设备" FontWeight="SemiBold"
                                               FontSize="15" VerticalAlignment="Center"/>
                                    <ui:Button DockPanel.Dock="Right" Content="清空表单" Padding="10,4"
                                               Click="OnClearEditor"/>
                                </DockPanel>

                                <TextBlock Text="名称" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="NameBox" Height="34" VerticalContentAlignment="Center"
                                            PlaceholderText="例如：书房主机 / NAS"/>

                                <TextBlock Text="MAC 地址" Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="MacBox" Height="34" VerticalContentAlignment="Center"
                                            FontFamily="{DynamicResource AppFontMonoFamily}"
                                            PlaceholderText="AA:BB:CC:DD:EE:FF"/>

                                <TextBlock Text="IP 地址（可选）" Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="IpBox" Height="34" VerticalContentAlignment="Center"
                                            PlaceholderText="用于自动选择同网段广播地址"/>

                                <TextBlock Text="广播地址（可选）" Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="BroadcastBox" Height="34" VerticalContentAlignment="Center"
                                            PlaceholderText="留空自动推断，例如 192.168.1.255"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="端口" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="PortBox" Height="34" VerticalContentAlignment="Center"
                                                    Text="9"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="重复发送" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="RepeatBox" Height="34" SelectedIndex="1"
                                                  VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="1 次"/>
                                            <ComboBoxItem Content="3 次"/>
                                            <ComboBoxItem Content="5 次"/>
                                            <ComboBoxItem Content="10 次"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SecureOn 密码（可选，6 字节十六进制）" Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="SecureOnBox" Height="34" VerticalContentAlignment="Center"
                                            FontFamily="{DynamicResource AppFontMonoFamily}"
                                            PlaceholderText="AA:BB:CC:DD:EE:FF，留空表示未启用"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ScheduleEnabledBox" Content="每日定时唤醒" VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    <ui:TextBox x:Name="ScheduleTimeBox" Grid.Column="1" Height="34"
                                                VerticalContentAlignment="Center" Text="08:00"
                                                PlaceholderText="HH:mm，例如 08:00"/>
                                </Grid>
                                <TextBlock Text="定时唤醒仅在 App 运行期间执行；关闭 App 后不会自动唤醒。"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextTertiaryBrush}"
                                           FontSize="{DynamicResource AppFontSizeMicro}"/>

                                <TextBlock Text="备注" Margin="0,10,0,4"/>
                                <ui:TextBox x:Name="NotesBox" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            PlaceholderText="可选，例如位置、用途、SecureOn 说明"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ui:Button Content="保存设备" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                               Padding="14,5" Margin="0,0,6,0" Click="OnSaveHost"/>
                                    <ui:Button Content="唤醒" Icon="{ui:SymbolIcon Power24}" Padding="12,4"
                                               Click="OnWakeSelected"/>
                                </StackPanel>

                                <Border Background="{DynamicResource AppAccentSubtleBrush}"
                                        BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource AppRadiusS}" Padding="10,8" Margin="0,14,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource AppFontSizeMicro}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               Text="魔术包通过 UDP 广播发送。目标机必须已在 BIOS/UEFI 和网卡属性中开启网络唤醒，并处于睡眠、休眠或关机（S3/S4/S5，且未断电）状态。"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="扫描同网段">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="扫描网卡" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="AdapterBox" DockPanel.Dock="Left" Width="380" Height="34"
                                          DisplayMemberPath="Display" VerticalContentAlignment="Center"
                                          SelectionChanged="OnAdapterChanged"/>
                                <ui:Button x:Name="ScanButton" DockPanel.Dock="Left" Content="开始扫描"
                                           Icon="{ui:SymbolIcon Search24}" Padding="12,4" Margin="10,0,6,0"
                                           Click="OnScan"/>
                                <ui:Button x:Name="StopScanButton" DockPanel.Dock="Left" Content="停止"
                                           Padding="12,4" IsEnabled="False" Click="OnStopScan"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:Button Content="添加选中" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                               Padding="12,4" Margin="0,0,6,0" Click="OnAddScanSelected"/>
                                    <ui:Button Content="全选" Padding="10,4" Click="OnSelectAllScan"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <TextBlock x:Name="SubnetText" DockPanel.Dock="Left"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScanStatusText" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100"
                                         Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ScanGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding IpAddress}" Width="170"/>
                            <DataGridTextColumn Header="MAC 地址" Binding="{Binding MacAddress}" Width="180"/>
                            <DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="2,8,2,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               FontSize="{DynamicResource AppFontSizeMicro}"
                               Text="扫描先并发 ping 网段内地址，再读取本机 ARP 缓存，因此只能发现当前在线或近期通信过的设备；已关机或休眠的目标通常不会出现在结果中，请用已知 MAC 手动添加。"/>
                </Grid>
            </TabItem>

            <TabItem Header="原理与条件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="实现原理" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="22">
                                    <Run Text="网络唤醒使用一个 102 字节的 Wake-on-LAN 魔术包：前 6 字节为 "/>
                                    <Run Text="FF FF FF FF FF FF" FontFamily="{DynamicResource AppFontMonoFamily}"/>
                                    <Run Text="，随后把目标网卡的 6 字节 MAC 地址重复 16 次。魔术包封装在 UDP 中，通常发送到端口 7 或 9 的二层广播地址。"/>
                                    <LineBreak/>
                                    <Run Text="设备配置里的「端口」就是魔术包的目标 UDP 端口，默认 9，部分老设备或网卡只监听 7。端口不匹配时目标网卡收不到魔术包；它只影响 UDP 目标端口，与广播地址、MAC 地址无关。"/>
                                    <LineBreak/>
                                    <Run Text="目标主机关机或休眠时，网卡仍由主板备用电源供电并监听网络。网卡固件识别到匹配自身 MAC 的魔术包后，向主板发出开机信号（PCI/PCIe PME），从而唤醒系统。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="被唤醒端必须具备" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="23">
                                    <Run Text="1. 主板 BIOS/UEFI 开启 Wake on LAN / Power On By PCI-E / Resume by LAN。"/>
                                    <LineBreak/>
                                    <Run Text="2. 有线网卡驱动属性启用「Wake on Magic Packet」「关机 网络唤醒」等相关选项。"/>
                                    <LineBreak/>
                                    <Run Text="3. Windows 设备管理器 → 网卡 → 电源管理：勾选「允许此设备唤醒计算机」，优先选择「只允许幻数据包唤醒计算机」。"/>
                                    <LineBreak/>
                                    <Run Text="4. 关闭 Windows 快速启动（控制面板 → 电源选项 → 选择电源按钮的功能 → 更改当前不可用的设置），避免混合关机跳过网卡初始化。"/>
                                    <LineBreak/>
                                    <Run Text="5. 使用有线以太网。多数无线网卡仅在睡眠状态支持 WoWLAN，关机后无法监听魔术包。"/>
                                    <LineBreak/>
                                    <Run Text="6. 目标机不能处于断电状态（插排开关关闭、电源线拔出）或交换机端口被关闭。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="网络条件与限制" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="23">
                                    <Run Text="发送端与目标机应处于同一二层广播域（同一 VLAN / 同一交换机）。跨网段唤醒需要在路由器或三层交换机上配置定向广播或 WOL 中继，并放行 UDP 7/9。"/>
                                    <LineBreak/>
                                    <Run Text="本工具默认向目标 IP 所在网段的定向广播地址发送；匹配不到时向本机所有 IPv4 网段的广播地址发送。也可为每台设备手动填写广播地址。"/>
                                    <LineBreak/>
                                    <Run Text="VLAN 隔离、Wi-Fi 客户端隔离、主机防火墙或交换机风暴抑制可能拦截广播包。部分企业网络会禁用定向广播，此时需要改用支持 WOL 中继的网关。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="扫描的边界" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="23">
                                    <Run Text="扫描通过并发 ICMP ping 发现在线主机，然后读取 Windows ARP 缓存获得 IP 与 MAC 对应关系，再反查主机名。它不会主动对每个 MAC 发送探测，也无法唤醒未知 MAC 的设备。"/>
                                    <LineBreak/>
                                    <Run Text="已关机或休眠的设备通常不在 ARP 缓存中，扫描不到属于正常现象；请从路由器 DHCP 客户端列表、交换机 MAC 表或设备标签获取 MAC 后手动添加。扫描范围限制为 /22 以内，避免对大型网络造成压力。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="安全与隐私" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="23"
                                           Text="设备名称、MAC、IP 与备注仅保存在本机 %LOCALAPPDATA% 数据目录的 wake-on-lan.json 中，不会上传。魔术包本身不包含账号或密码，但局域网内任何能发送广播的程序都可以构造同样的包，因此 WOL 不应作为访问控制手段；敏感设备请配合网络准入、VLAN 与开机认证使用。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="12,6" Background="{DynamicResource AppSurfaceAltBrush}">
            <TextBlock x:Name="StatusText" Text="选择设备即可发送魔术包；首次使用请先阅读「原理与条件」。"
                       FontSize="{DynamicResource AppFontSizeMicro}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</ui:FluentWindow>
