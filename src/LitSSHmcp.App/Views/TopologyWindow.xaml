<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="LitSSHmcp.App.Views.TopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资产拓扑" Height="680" Width="1040"
        WindowStartupLocation="CenterOwner" KeyDown="OnWindowKeyDown"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="资产拓扑"/>
        <Grid Grid.Row="1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="MoreActionsButton" DockPanel.Dock="Right" Content="更多操作 ▾" Width="96" Padding="8,4" Margin="6,0,0,0"
                    Click="OnMoreActions" ToolTip="缩放 / 刷新等快捷操作">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="＋ 放大" Click="OnZoomIn" ToolTip="放大"/>
                        <MenuItem Header="－ 缩小" Click="OnZoomOut" ToolTip="缩小"/>
                        <MenuItem Header="适应" Click="OnZoomFit" ToolTip="缩放到适合窗口"/>
                        <MenuItem Header="100%" Click="OnZoomReset" InputGestureText="Ctrl+0" ToolTip="重置缩放"/>
                        <Separator/>
                        <MenuItem Header="刷新" Click="OnRefresh"/>
                        <MenuItem Header="发现报告" Click="OnDiscoveryReport"
                                  ToolTip="查看最近一次自动发现的说明/未匹配端点(含来源文件)/错误"/>
                        <MenuItem Header="导出图片…" Click="OnExportImage"
                                  ToolTip="把画布有效区域(全部内容+边距)导出为 PNG 图片"/>
                        <Separator Tag="stress" Visibility="Collapsed"/>
                        <MenuItem Header="压测" Click="OnStress" Tag="stress" Visibility="Collapsed"
                                  ToolTip="DEBUG: 生成合成大图(约208节点/340边)用于性能测量，不落盘"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button DockPanel.Dock="Right" Content="自动发现" Width="90" Padding="6,4" Margin="6,0,0,0" Click="OnDiscover"/>
            <Button DockPanel.Dock="Right" Content="重新自动布局" Width="110" Padding="6,4" Margin="6,0,0,0" Click="OnResetLayout"
                    ToolTip="清除手动布局, 恢复自动排列"/>
            <TextBlock DockPanel.Dock="Left" Text="服务器ID(逗号分隔, 留空=全部):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ServerFilterBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,0,0">
                    <TextBlock Text="图例:" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,0"/>
                    <Border Background="#EEF3FB" BorderBrush="#9BB7E0" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="SSH服务器(内含 应用/数据库 = runsOn)" FontSize="11" Foreground="#222222"/>
                    </Border>
                    <Border Background="#FFF4E5" BorderBrush="#E08A00" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="应用" FontSize="11" Foreground="#222222"/>
                    </Border>
                    <Border Background="#E6F4EA" BorderBrush="#1E8E3E" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="数据库" FontSize="11" Foreground="#222222"/>
                    </Border>
                    <TextBlock Text="— connectsTo(应用→库) / canAccess(服务器→库)" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="- - 自动发现" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="(鼠标悬浮节点查看详情)" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>

                <Grid x:Name="CanvasHost" Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource AppSurfaceAltBrush}" ClipToBounds="True"
                      PreviewMouseLeftButtonDown="OnCanvasMouseDown"
                      PreviewMouseLeftButtonUp="OnCanvasMouseUp"
                      PreviewMouseRightButtonDown="OnCanvasRightDown"
                      MouseMove="OnCanvasMouseMove"
                      PreviewMouseWheel="OnCanvasWheel">
                    <Rectangle x:Name="GridLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="GraphCanvas" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                            Background="Transparent">
                    <!-- 层级(从下到上): 服务器区块背景 -> 连线 -> 连线标签 -> 内嵌/独立节点 -->
                    <ItemsControl ItemsSource="{Binding Boxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF3FB"/>
                                            <Setter Property="BorderBrush" Value="#9BB7E0"/>
                                            <Style.Triggers>
                                                <!-- 已禁用的服务器: 灰化 + 角标, 且不可拖线建链 -->
                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#C0C0C0"/>
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="已禁用" Foreground="{DynamicResource AppDangerBrush}"
                                                       FontSize="10" FontWeight="SemiBold" Margin="0,7,10,0"
                                                       ToolTip="该服务器已禁用: 不可建链/连接, 不出现在 MCP 的 ssh_list_servers, 拓扑发现跳过">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="10,6,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF1F1F1F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SubLabel}" FontSize="10" Margin="10,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CC1F1F1F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 连线(折线 + 圆点 + 箭头, 每个元素一个 Canvas 内叠加) -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Path Data="{Binding Line}" Stroke="{Binding Stroke}" StrokeThickness="2" StrokeLineJoin="Round">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDiscovered}" Value="True">
                                                        <Setter Property="StrokeDashArray" Value="4 3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{Binding Dot}" Fill="{Binding Stroke}"/>
                                    <Path Data="{Binding Arrow}" Fill="{Binding Stroke}"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 交叉过桥(白盘 + 下层补段 + 上层拱线, 一个元素) -->
                    <ItemsControl ItemsSource="{Binding Hops}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Path Data="{Binding Disc}" Fill="{DynamicResource AppSurfaceBrush}"/>
                                    <Path Data="{Binding Bridge}" Stroke="{Binding BridgeStroke}" StrokeThickness="2"/>
                                    <Path Data="{Binding Arc}" Stroke="{Binding ArcStroke}" StrokeThickness="2"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 连线标签(只收非空标签, 避免空容器) -->
                    <ItemsControl ItemsSource="{Binding Labels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#FF1F1F1F"
                                           Background="#F0F0F0" Padding="3,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Label}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}">
                                    <Border CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF4E5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="datasource">
                                                        <Setter Property="Background" Value="#E6F4EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <!-- runsOn 托管节点: 用点线边框区分(选中框为蓝色长虚线) -->
                                    <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="1 3">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Stroke" Value="#E08A00"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="datasource">
                                                        <Setter Property="Stroke" Value="#1E8E3E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="#FF1F1F1F"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}" BorderThickness="1" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA"/>
                                            <Setter Property="BorderBrush" Value="#1E8E3E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="application">
                                                    <Setter Property="Background" Value="#FFF4E5"/>
                                                    <Setter Property="BorderBrush" Value="#E08A00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="#FF1F1F1F"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 选择框 -->
                    <Rectangle Width="{Binding SelW}" Height="{Binding SelH}" Stroke="#2F6FEB" StrokeThickness="1.5"
                               StrokeDashArray="3 2" Fill="Transparent" IsHitTestVisible="False"
                               Canvas.Left="{Binding SelX}" Canvas.Top="{Binding SelY}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <!-- 缩放手柄 -->
                    <ItemsControl ItemsSource="{Binding Handles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding Shape}" Fill="White" Stroke="#2F6FEB" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 建边端口(选中节点时显示) -->
                    <ItemsControl ItemsSource="{Binding Ports}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding Shape}" Fill="White" Stroke="#2F6FEB" StrokeThickness="1.5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 拖动建边时的临时线 -->
                    <Path Data="{Binding LinkGeometry}" Stroke="#2F6FEB" StrokeThickness="2" StrokeDashArray="3 2">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLinking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- 选中连线高亮 -->
                    <Path Data="{Binding SelectedEdgeLine}" Stroke="#F5A623" StrokeThickness="6" Opacity="0.35" IsHitTestVisible="False">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEdge}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- 连线端点锚点(选中连线时显示, 可拖动设置端点位置) -->
                    <ItemsControl ItemsSource="{Binding EdgeAnchors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding Shape}" Fill="#F5A623" Stroke="White" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Canvas>

                    <!-- 叠加层: 关系属性面板(可拖动) -->
                    <Canvas x:Name="OverlayCanvas" Background="{x:Null}">
                        <Border x:Name="EdgePanel" Width="264"
                                Background="#F7FFFFFF" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="4" Padding="10"
                                Canvas.Left="700" Canvas.Top="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedEdge}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border x:Name="EdgePanelHeader" Background="#EEEEEE" Margin="-10,-10,-10,8" Padding="10,6"
                                        MouseLeftButtonDown="OnPanelHeaderDown" MouseMove="OnPanelHeaderMove" MouseLeftButtonUp="OnPanelHeaderUp"
                                        Cursor="SizeAll">
                                    <TextBlock Text="关系属性（可拖动）" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedEdgeSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <TextBlock Text="关系类型" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding RelationTypes}" SelectedItem="{Binding SelectedEdgeType}"
                                          IsEnabled="{Binding SelectedEdgeEditable}" Margin="0,2,0,8"/>
                                <TextBlock Text="备注" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBox Text="{Binding SelectedEdgeNote, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"
                                         IsEnabled="{Binding SelectedEdgeEditable}" Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding SelectedEdgeHint}" Foreground="{DynamicResource AppDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="保存" Width="72" Padding="6,4" Margin="0,0,6,0" Click="OnSaveEdge"
                                            IsEnabled="{Binding SelectedEdgeEditable}"/>
                                    <Button Content="删除" Width="72" Padding="6,4" Click="OnDeleteEdge"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,6,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
