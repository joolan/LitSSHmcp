<Window x:Class="LitSSHmcp.App.Views.TopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资产拓扑" Height="680" Width="1040"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="刷新" Width="70" Padding="6,4" Margin="6,0,0,0" Click="OnRefresh"/>
            <Button DockPanel.Dock="Right" Content="自动发现" Width="90" Padding="6,4" Margin="6,0,0,0" Click="OnDiscover"/>
            <TextBlock DockPanel.Dock="Left" Text="服务器ID(逗号分隔, 留空=全部):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ServerFilterBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,0,0">
                    <TextBlock Text="图例:" Foreground="Gray" Margin="0,0,8,0"/>
                    <Border Background="#EEF3FB" BorderBrush="#9BB7E0" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="SSH服务器(内含 应用/数据库 = runsOn)" FontSize="11"/>
                    </Border>
                    <Border Background="#FFF4E5" BorderBrush="#E08A00" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="应用" FontSize="11"/>
                    </Border>
                    <Border Background="#E6F4EA" BorderBrush="#1E8E3E" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="数据库" FontSize="11"/>
                    </Border>
                    <TextBlock Text="— connectsTo(应用→库) / canAccess(服务器→库)" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="- - 自动发现" FontSize="11" VerticalAlignment="Center" Foreground="#888" Margin="0,0,8,0"/>
                    <TextBlock Text="(鼠标悬浮节点查看详情)" FontSize="11" VerticalAlignment="Center" Foreground="#888"/>
                </StackPanel>

                <Canvas Grid.Row="1" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}">
                                    <Line.Style>
                                        <Style TargetType="Line">
                                            <Setter Property="Stroke" Value="#0A66C2"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="canAccess">
                                                    <Setter Property="Stroke" Value="#1E8E3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDiscovered}" Value="True">
                                                    <Setter Property="StrokeDashArray" Value="4 3"/>
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Line.Style>
                                </Line>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding LabelY}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#555"
                                           Background="#F0F0F0" Padding="3,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Boxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}"
                                        Background="#EEF3FB" BorderBrush="#9BB7E0" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="10,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubLabel}" FontSize="10" Foreground="#5A6B85" Margin="10,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}" BorderThickness="1" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF4E5"/>
                                            <Setter Property="BorderBrush" Value="#E08A00"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="datasource">
                                                    <Setter Property="Background" Value="#E6F4EA"/>
                                                    <Setter Property="BorderBrush" Value="#1E8E3E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tooltip}" BorderThickness="1" CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA"/>
                                            <Setter Property="BorderBrush" Value="#1E8E3E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="application">
                                                    <Setter Property="Background" Value="#FFF4E5"/>
                                                    <Setter Property="BorderBrush" Value="#E08A00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,6,0,0" Foreground="Gray"/>
    </Grid>
</Window>
