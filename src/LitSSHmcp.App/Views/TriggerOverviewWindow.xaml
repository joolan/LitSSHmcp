<ui:FluentWindow x:Class="LitSSHmcp.App.Views.TriggerOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:LitSSHmcp.App.Controls"
        Title="触发事件总览" Height="700" Width="900" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <controls:BooleanNotToVisibilityConverter x:Key="BoolNotToVis"/>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="触发事件总览（调度 · 下次运行 · 动作流水线）"/>

        <controls:PageHeader Grid.Row="1" Margin="14,4,14,0" Icon="Flash24" Title="运行概览"
                             Subtitle="调度 · 下次运行 · 动作流水线">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,4" Margin="0,0,8,0"
                               Click="OnRefresh"/>
                    <ui:Button Content="编辑触发事件" Appearance="Primary" Padding="12,4" Click="OnEdit"/>
                </StackPanel>
            </controls:PageHeader.Actions>
            <controls:PageHeader.StatusContent>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </controls:PageHeader.StatusContent>
        </controls:PageHeader>

        <Grid Grid.Row="2" Margin="14,0,14,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TriggerList" ItemsSource="{Binding Triggers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastResultText}" FontSize="{DynamicResource AppFontSizeMicro}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=" " />
                                </DockPanel>
                                <TextBlock FontSize="{DynamicResource AppFontSizeMicro}" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding EnabledText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TargetText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SyncTriggerText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="{DynamicResource AppFontSizeCaption}" Margin="0,6,0,0">
                                    <Run Text="调度: "/><Run Text="{Binding ScheduleText, Mode=OneWay}"/><Run Text="   下次: "/><Run Text="{Binding NextRunText, Mode=OneWay}"/><Run Text="   上次: "/><Run Text="{Binding LastRunText, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- 动作流水线可视化 -->
                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                                <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource AppRadiusS}" Padding="8,4" ToolTip="{Binding Detail}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="{DynamicResource AppFontSizeCaption}">
                                                            <Run Text="{Binding Order, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding Label, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ContinueText}" FontSize="9"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasItems, ElementName=TriggerList, Converter={StaticResource BoolNotToVis}}">
                <ui:SymbolIcon Symbol="Flash24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="还没有触发事件" Style="{DynamicResource EmptyStateTitleStyle}"/>
                <TextBlock Text="点击右上角「编辑触发事件」创建 git、webhook 或备份触发任务。"
                           Style="{DynamicResource EmptyStateHintStyle}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
