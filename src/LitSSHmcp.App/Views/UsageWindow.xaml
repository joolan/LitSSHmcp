<ui:FluentWindow x:Class="LitSSHmcp.App.Views.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="用量 / 成本" Height="420" Width="620" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="用量 / 成本"/>

        <TextBox x:Name="ReportBox" Grid.Row="1" Margin="14,4,14,0" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="{DynamicResource AppFontMonoFamily}" FontSize="{DynamicResource AppFontSizeCaption}" BorderThickness="0" Background="Transparent"/>

        <DockPanel Grid.Row="2" Margin="14,10,14,14">
            <ui:Button DockPanel.Dock="Right" Content="关闭" Width="72" Click="OnClose"/>
            <ui:Button DockPanel.Dock="Right" Content="复制" Width="72" Margin="0,0,8,0" Click="OnCopy"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
